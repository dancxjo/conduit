panel 0

# This authored cycle stays visible to Patchbay, but no scheduler may admit it:
# neither panel is an explicit state or delay boundary.
left: conduit.media/control/slew { initial = 0 maximum_delta = 64 }
right: conduit.media/control/slew { initial = 0 maximum_delta = 64 }

left.control > right.control { capacity = 1 max_value_bytes = 16 max_queued_bytes = 16 low_watermark = 0 high_watermark = 1 pressure = block }
right.control > left.control { capacity = 1 max_value_bytes = 16 max_queued_bytes = 16 low_watermark = 0 high_watermark = 1 pressure = block }
