# The source remains host-neutral. Resolution places preprocess in an exact
# browser AudioWorklet profile and speech on an exact Linux remote endpoint.
panel 0

media: std/literal {
    value = "browser media frame\n"
}
preprocess: text/uppercase
speech: display/text

media.value > preprocess.text {
    capacity = 2
    max_value_bytes = 4096
    max_queued_bytes = 8192
    low_watermark = 0
    high_watermark = 2
    pressure = block
}
preprocess.text > speech.text {
    capacity = 4
    max_value_bytes = 4096
    max_queued_bytes = 16384
    low_watermark = 1
    high_watermark = 4
    pressure = block
}
