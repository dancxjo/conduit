# A finite proof of typed resolution and execution.
panel 0

greeting: std/literal {
    value = "Hello from Conduit.\n"
}

shout: text/uppercase
output: display/text

greeting.value > shout.text {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}

shout.text > output.text {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}
