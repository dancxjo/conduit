# A finite proof of typed resolution and execution.
panel 0

node greeting : std/literal {
    value = "Hello from Conduit.\n"
}

node shout : text/uppercase
node output : display/text

cord greeting.value -> shout.text {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}

cord shout.text -> output.text {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}
