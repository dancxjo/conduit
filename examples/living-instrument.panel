panel 0

clock: time/ticker {
    duration_ticks = 1000
    time_basis = ref("conduit.clock/monotonic-ticks")
    maximum_pending = 1
}
pulse: conduit.media/event/from-ticker
layers: conduit.media/event/tee
fast_divider: conduit.media/control/clock-divider {
    divisor = 2
    phase = 0
}
slow_divider: conduit.media/control/clock-divider {
    divisor = 4
    phase = 0
}
fast_sequence: conduit.media/control/sequencer {
    pattern = "1024,256,768,128"
    maximum_steps = 4
    lane = 0
    repeat = "repeat"
}
slow_sequence: conduit.media/control/sequencer {
    pattern = "512,0,256,0"
    maximum_steps = 4
    lane = 1
    repeat = "repeat"
}
fast_shape: conduit.media/control/slew {
    initial = 0
    maximum_delta = 256
}
slow_shape: conduit.media/control/slew {
    initial = 0
    maximum_delta = 128
}
combine: conduit.media/control/merge {
    ordering = "round-robin"
}
blend: conduit.media/control/mixer {
    gain_numerator = 1
    gain_denominator = 2
    maximum_value = 1024
}
memory: conduit.media/control/register {
    initial = 0
    maximum_value = 1024
}
memory_outputs: conduit.media/control/tee
audio: conduit.media/audio/from-control {
    lifecycle = "standing"
    numeric_profile = "pcm-s16-q15-round-nearest-away-saturate-no-nan-no-denormal-bit-exact"
    sample_rate_hz = 48000
    layout = "stereo-lr"
    frames_per_control = 8
    maximum_work = 16
}
audio_gain: conduit.media/audio/gain {
    lifecycle = "standing"
    numeric_profile = "pcm-s16-q15-round-nearest-away-saturate-no-nan-no-denormal-bit-exact"
    curve = "linear-q15-absolute-frame"
    start_gain_q15 = 0
    end_gain_q15 = 0
    ramp_start_frame = 0
    ramp_end_frame = 0
    discontinuity = "absolute-timeline"
    maximum_automation_points = 2
    maximum_retained_samples = 0
    maximum_frames = 8
}
playback: conduit.media/audio/playback {
    device_resource = secret("conduit.audio/device/virtual-playback-0")
    device_label = "Virtual Loopback Playback"
    provider_observation = "conduit.audio/observation/virtual-loopback"
    observation_generation = 1
    observation_valid_until_tick = 1000000
    backend_identity = "conduit.audio/backend/deterministic-loopback"
    sample_format = "pcm-s16le-interleaved"
    sample_rate_hz = 48000
    layout = "stereo-lr"
    sample_clock = "conduit.clock/virtual-audio-48000"
    clock_correlation = "exact"
    requested_period_frames = 8
    admitted_period_frames = 8
    requested_buffer_frames = 8
    admitted_buffer_frames = 8
    requested_latency_frames = 8
    admitted_latency_frames = 8
    latency_classification = "enforced"
    sharing_mode = "exclusive"
    maximum_concurrent_streams = 1
    workload_class = "deterministic-bounded"
    lifecycle = "standing"
    underrun = "wait-evidenced"
    overrun = "fail-terminal-evidenced"
    drift = "reject-evidenced"
    discontinuity = "fail-terminal-evidenced"
    provider_loss = "fail-terminal-evidenced"
    cancellation = "before-open-after-open-running-drain-distinct"
    drain = "flush-bounded"
    commit_point = "frame-accepted-by-device"
    device_grant = secret("conduit.audio/grant/virtual-playback")
    lease_ticks = 1000000
    revocation_grace_ticks = 1
    cleanup_ticks = 2
    sensitivity = "restricted-audio"
    maximum_frames_per_step = 8
    maximum_host_queue_frames = 8
    maximum_work = 16
    maximum_evidence_events = 64
}
scope: conduit.media/control/scope
drain: flow/discard

clock.tick > pulse.tick {
    capacity = 1
    max_value_bytes = 32
    max_queued_bytes = 32
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
pulse.event > layers.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
layers.fast > fast_divider.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
layers.slow > slow_divider.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
fast_divider.event > fast_sequence.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
slow_divider.event > slow_sequence.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
fast_sequence.control > fast_shape.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
slow_sequence.control > slow_shape.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
fast_shape.control > combine.left {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
slow_shape.control > combine.right {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
combine.control > blend.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
blend.control > memory.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
memory.control > memory_outputs.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
memory_outputs.left > scope.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
memory_outputs.right > audio.level {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
audio.frame > audio_gain.frame {
    capacity = 1
    max_value_bytes = 56
    max_queued_bytes = 56
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
audio_gain.frame > playback.frame {
    capacity = 1
    max_value_bytes = 56
    max_queued_bytes = 56
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
scope.text > drain.item {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
