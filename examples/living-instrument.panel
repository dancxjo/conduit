panel 0

node clock : time/ticker {
    duration_ticks = 1000
    time_basis = ref("conduit.clock/monotonic-ticks")
    maximum_pending = 1
}
node pulse : conduit.media/event/from-ticker
node layers : conduit.media/event/tee
node fast_divider : conduit.media/control/clock-divider {
    divisor = 2
    phase = 0
}
node slow_divider : conduit.media/control/clock-divider {
    divisor = 4
    phase = 0
}
node fast_sequence : conduit.media/control/sequencer {
    pattern = "1024,256,768,128"
    maximum_steps = 4
    lane = 0
}
node slow_sequence : conduit.media/control/sequencer {
    pattern = "512,0,256,0"
    maximum_steps = 4
    lane = 1
}
node fast_shape : conduit.media/control/slew {
    initial = 0
    maximum_delta = 256
}
node slow_shape : conduit.media/control/slew {
    initial = 0
    maximum_delta = 128
}
node combine : conduit.media/control/merge {
    ordering = "round-robin"
}
node blend : conduit.media/control/mixer {
    gain_numerator = 1
    gain_denominator = 2
    maximum_value = 1024
}
node memory : conduit.media/control/register {
    initial = 0
    maximum_value = 1024
}
node scope : conduit.media/control/scope
node drain : flow/discard

cord clock.tick -> pulse.tick {
    capacity = 1
    max_value_bytes = 32
    max_queued_bytes = 32
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord pulse.event -> layers.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord layers.fast -> fast_divider.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord layers.slow -> slow_divider.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord fast_divider.event -> fast_sequence.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord slow_divider.event -> slow_sequence.event {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord fast_sequence.control -> fast_shape.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord slow_sequence.control -> slow_shape.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord fast_shape.control -> combine.left {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord slow_shape.control -> combine.right {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord combine.control -> blend.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord blend.control -> memory.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord memory.control -> scope.control {
    capacity = 1
    max_value_bytes = 16
    max_queued_bytes = 16
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord scope.text -> drain.item {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
