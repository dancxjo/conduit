panel 0

first: std/literal {
    value = ""
}
second: std/literal {
    value = "selected"
}
command: std/literal {
    value = "right"
}
first_lines: std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
second_lines: std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
commands: std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
select: conduit.std/select {
    initial = "left"
    inactive = "block"
}
selected_text: std/text/join { separator = "" maximum_items = 8 maximum_item_bytes = 1024 maximum_separator_bytes = 64 maximum_output_bytes = 4096 }
encoded: std/data/encode-utf8 {
    codec = ref("conduit.codec/utf-8")
    codec_schema_version = 0
    codec_hash = bytes("f219297cb276bc91eccddb346a8b21e7edd4414b8844014108513747ae11bf53")
    maximum_input_bytes = 4096
    maximum_output_bytes = 4096
}
output: io/stdout

first.value > first_lines.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
second.value > second_lines.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
command.value > commands.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
first_lines.line > select.left { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
second_lines.line > select.right { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
commands.line > select.selector { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
select.selected > selected_text.item {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
selected_text.text > encoded.text { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
encoded.bytes > output.bytes { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
