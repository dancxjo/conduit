# This source contains no browser-specific node kind. A browser report and
# exact implementation manifest select the WASM placement outside the panel.
panel 0

node greeting : std/literal {
    value = "Browser-local semantics stay portable.\n"
}
node transform : text/uppercase
node output : display/text

cord greeting.value -> transform.text {
    capacity = 2
    max_value_bytes = 1024
    max_queued_bytes = 2048
    low_watermark = 0
    high_watermark = 2
    pressure = block
}
cord transform.text -> output.text {
    capacity = 2
    max_value_bytes = 1024
    max_queued_bytes = 2048
    low_watermark = 0
    high_watermark = 2
    pressure = block
}
