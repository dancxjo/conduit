panel 0

composite example/upper-line {
    node source : std/literal
    node upper : text/uppercase

    cord source.value -> upper.text {
        capacity = 2
        max_value_bytes = 1024
        max_queued_bytes = 2048
        low_watermark = 0
        high_watermark = 2
        pressure = block
    }

    export text > = upper.text
    bind value = source.value
}

node line : example/upper-line {
    value = "Composite nodes stay ordinary."
}
node output : display/text

cord line.text -> output.text {
    capacity = 2
    max_value_bytes = 1024
    max_queued_bytes = 2048
    low_watermark = 0
    high_watermark = 2
    pressure = block
}
