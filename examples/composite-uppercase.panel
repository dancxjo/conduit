panel 0

example/upper-line {
    source: std/literal
    upper: text/uppercase

    source.value > upper.text {
        capacity = 2
        max_value_bytes = 1024
        max_queued_bytes = 2048
        low_watermark = 0
        high_watermark = 2
        pressure = block
    }

    export text > = upper.text
    bind value = source.value
}

line: example/upper-line {
    value = "Composite nodes stay ordinary."
}
output: display/text

line.text > output.text {
    capacity = 2
    max_value_bytes = 1024
    max_queued_bytes = 2048
    low_watermark = 0
    high_watermark = 2
    pressure = block
}
