panel 0

source: conduit.media/audio-frame/literal { fixture = "tone-s16le-stereo-48000" }
trim: conduit.media/audio/trim {
    lifecycle = "finite"
    numeric_profile = "pcm-s16-q15-round-nearest-away-saturate-no-nan-no-denormal-bit-exact"
    interval_basis = "absolute-input-frame-half-open"
    start_frame = 2
    end_frame = 14
    open_ended = "false"
    boundary_rounding = "ceil-start-floor-end"
    discontinuity = "preserve-if-first-retained"
    fade_in_frames = 2
    fade_out_frames = 2
    maximum_frames = 16
}
inspect: conduit.media/audio-frame/inspect
output: display/text

source.frame > trim.frame { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
trim.frame > inspect.frame { capacity = 1 max_value_bytes = 120 max_queued_bytes = 120 low_watermark = 0 high_watermark = 1 pressure = block }
inspect.summary > output.text { capacity = 1 max_value_bytes = 96 max_queued_bytes = 96 low_watermark = 0 high_watermark = 1 pressure = block }
