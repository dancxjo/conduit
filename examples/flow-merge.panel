panel 3

node first : std/literal {
    value = "first"
}
node second : std/literal {
    value = "second"
}
node first_lines : std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
node second_lines : std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
node merge : conduit.std/merge {
    ordering = "round-robin"
}
node merged_text : std/text/join { separator = "" maximum_items = 8 maximum_item_bytes = 1024 maximum_separator_bytes = 64 maximum_output_bytes = 4096 }
node output : io/stdout

cord first.out -> first_lines.in {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord second.out -> second_lines.in {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord first_lines.line -> merge.in1 { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
cord second_lines.line -> merge.in2 { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
cord merge.out -> merged_text.item {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord merged_text.out -> output.in { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
