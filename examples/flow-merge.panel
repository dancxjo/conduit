panel 0

node first : std/literal {
    value = "first"
}
node second : std/literal {
    value = "second"
}
node first_lines : std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
node second_lines : std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
node merge : conduit.std/merge {
    ordering = "round-robin"
}
node merged_text : std/text/join { separator = "" maximum_items = 8 maximum_item_bytes = 1024 maximum_separator_bytes = 64 maximum_output_bytes = 4096 }
node encoded : text/encode-utf8
node output : io/stdout

cord first.value -> first_lines.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord second.value -> second_lines.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord first_lines.line -> merge.left { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
cord second_lines.line -> merge.right { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
cord merge.value -> merged_text.item {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord merged_text.text -> encoded.text { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
cord encoded.bytes -> output.bytes { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
