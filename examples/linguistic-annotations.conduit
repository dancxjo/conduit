form linguistic-annotations (
    label: Text >
) {
    tokenize: language/tokenize-four(text = "Bright stars shine.")
    annotate: language/annotate-four
    tokenize.tokens > annotate.tokens
    annotate.annotations > project(AnnotationBundleFour.annotations) > index(LinguisticAnnotationsFour[0]) > project(LinguisticAnnotation.label) > label
}
