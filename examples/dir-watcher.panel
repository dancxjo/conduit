# Directory watcher and file processing pipeline.
panel 0

node watcher : std/file-read {
    path = "watch_directory"
}

node filter : conduit/passthrough
node processor : text/uppercase
node logger : observe/log

cord watcher.contents -> filter.value {
    capacity = 16
    max_value_bytes = 4096
    max_queued_bytes = 65536
    low_watermark = 2
    high_watermark = 16
    pressure = block
}

cord filter.value -> processor.text {
    capacity = 16
    max_value_bytes = 4096
    max_queued_bytes = 65536
    low_watermark = 2
    high_watermark = 16
    pressure = block
}

cord processor.text -> logger.message {
    capacity = 16
    max_value_bytes = 4096
    max_queued_bytes = 65536
    low_watermark = 2
    high_watermark = 16
    pressure = block
}
