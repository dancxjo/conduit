panel 3

composite patchbay/authoring {
    node editor : text/uppercase
    node parser : text/uppercase
    export > source = editor.text
    export parsed > = parser.text
    cord editor.text -> parser.text {
        capacity = 1
        max_value_bytes = 1024
        max_queued_bytes = 1024
        low_watermark = 0
        high_watermark = 1
        pressure = block
    }
}

composite patchbay/presentation {
    node layout : text/uppercase
    node canvas : text/uppercase
    export > positions = layout.text
    export rendered > = canvas.text
    cord layout.text -> canvas.text {
        capacity = 1
        max_value_bytes = 1024
        max_queued_bytes = 1024
        low_watermark = 0
        high_watermark = 1
        pressure = block
    }
}

composite patchbay/observation {
    node resolver : text/uppercase
    node evidence_feed : text/uppercase
    export > plan = resolver.text
    export telemetry > = evidence_feed.text
    cord resolver.text -> evidence_feed.text {
        capacity = 1
        max_value_bytes = 1024
        max_queued_bytes = 1024
        low_watermark = 0
        high_watermark = 1
        pressure = block
    }
}

node nav_selection : std/literal { value = "tour/meta-lesson\n" }
node authoring_surface : patchbay/authoring
node presentation_surface : patchbay/presentation
node observation_surface : patchbay/observation
node console_sink : display/text

cord nav_selection.value -> authoring_surface.source {
    capacity = 4
    max_value_bytes = 1024
    max_queued_bytes = 4096
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

cord authoring_surface.parsed -> presentation_surface.positions {
    capacity = 4
    max_value_bytes = 4096
    max_queued_bytes = 16384
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

cord presentation_surface.rendered -> observation_surface.plan {
    capacity = 4
    max_value_bytes = 4096
    max_queued_bytes = 16384
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

cord observation_surface.telemetry -> console_sink.text {
    capacity = 8
    max_value_bytes = 8192
    max_queued_bytes = 65536
    low_watermark = 1
    high_watermark = 8
    pressure = block
}
