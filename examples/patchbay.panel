panel 0

patchbay/authoring {
    editor: text/uppercase
    parser: text/uppercase
    export > source = editor.text
    export parsed > = parser.text
    editor.text > parser.text {
        capacity = 1
        max_value_bytes = 1024
        max_queued_bytes = 1024
        low_watermark = 0
        high_watermark = 1
        pressure = block
    }
}

patchbay/presentation {
    layout: text/uppercase
    canvas: text/uppercase
    export > positions = layout.text
    export rendered > = canvas.text
    layout.text > canvas.text {
        capacity = 1
        max_value_bytes = 1024
        max_queued_bytes = 1024
        low_watermark = 0
        high_watermark = 1
        pressure = block
    }
}

patchbay/observation {
    resolver: text/uppercase
    evidence_feed: text/uppercase
    export > plan = resolver.text
    export telemetry > = evidence_feed.text
    resolver.text > evidence_feed.text {
        capacity = 1
        max_value_bytes = 1024
        max_queued_bytes = 1024
        low_watermark = 0
        high_watermark = 1
        pressure = block
    }
}

nav_selection: std/literal { value = "tour/meta-lesson\n" }
authoring_surface: patchbay/authoring
presentation_surface: patchbay/presentation
observation_surface: patchbay/observation
console_sink: display/text

nav_selection.value > authoring_surface.source {
    capacity = 4
    max_value_bytes = 1024
    max_queued_bytes = 4096
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

authoring_surface.parsed > presentation_surface.positions {
    capacity = 4
    max_value_bytes = 4096
    max_queued_bytes = 16384
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

presentation_surface.rendered > observation_surface.plan {
    capacity = 4
    max_value_bytes = 4096
    max_queued_bytes = 16384
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

observation_surface.telemetry > console_sink.text {
    capacity = 8
    max_value_bytes = 8192
    max_queued_bytes = 65536
    low_watermark = 1
    high_watermark = 8
    pressure = block
}
