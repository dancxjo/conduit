# With a panel read from a file, process stdin remains available to this node.
panel 0

node input : io/stdin
node decoder : text/decode-utf8
node transform : text/uppercase
node encoder : text/encode-utf8
node output : io/stdout

cord input.bytes -> decoder.bytes {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}

cord decoder.text -> transform.text {
    capacity = 4
    max_value_bytes = 65536
    max_queued_bytes = 262144
    low_watermark = 2
    high_watermark = 4
    pressure = block
}

cord transform.text -> encoder.text {
    capacity = 4
    max_value_bytes = 65536
    max_queued_bytes = 262144
    low_watermark = 2
    high_watermark = 4
    pressure = block
}

cord encoder.bytes -> output.bytes {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}
