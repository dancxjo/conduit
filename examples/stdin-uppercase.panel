# With a panel read from a file, process stdin remains available to this node.
panel 0

input: io/stdin
decoder: std/data/decode-utf8 {
    codec = ref("conduit.codec/utf-8")
    codec_schema_version = 0
    codec_hash = bytes("f219297cb276bc91eccddb346a8b21e7edd4414b8844014108513747ae11bf53")
    maximum_input_bytes = 4096
    maximum_output_bytes = 4096
}
transform: text/uppercase
encoder: std/data/encode-utf8 {
    codec = ref("conduit.codec/utf-8")
    codec_schema_version = 0
    codec_hash = bytes("f219297cb276bc91eccddb346a8b21e7edd4414b8844014108513747ae11bf53")
    maximum_input_bytes = 4096
    maximum_output_bytes = 4096
}
output: io/stdout

input.bytes > decoder.bytes {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}

decoder.text > transform.text {
    capacity = 4
    max_value_bytes = 65536
    max_queued_bytes = 262144
    low_watermark = 2
    high_watermark = 4
    pressure = block
}

transform.text > encoder.text {
    capacity = 4
    max_value_bytes = 65536
    max_queued_bytes = 262144
    low_watermark = 2
    high_watermark = 4
    pressure = block
}

encoder.bytes > output.bytes {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 8
    pressure = block
}
