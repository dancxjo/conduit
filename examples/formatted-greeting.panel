# Typed template + values -> text formatting with exact finite cords.
panel 0

template: std/literal {
    value = "Hello, {name}. Payload: {{status = {status}}}\n"
}

values: std/format-values/literal {
    values = list(
        record(name="name", value="operator"),
        record(name="status", value="ready")
    )
}

greeting: std/text/format
output: display/text

template.value > greeting.template {
    capacity = 1
    max_value_bytes = 4096
    max_queued_bytes = 4096
    low_watermark = 0
    high_watermark = 1
    pressure = block
}

values.values > greeting.values {
    capacity = 1
    max_value_bytes = 16384
    max_queued_bytes = 16384
    low_watermark = 0
    high_watermark = 1
    pressure = block
}

greeting.text > output.text {
    capacity = 1
    max_value_bytes = 16384
    max_queued_bytes = 16384
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
