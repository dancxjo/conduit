# File copier panel with bounded buffer and cancellation/pressure controls.
panel 0

node reader : std/file-read {
    path = "source.txt"
}

node writer : std/file-write {
    path = "destination.txt"
}

cord reader.contents -> writer.contents {
    capacity = 8
    max_value_bytes = 65536
    max_queued_bytes = 524288
    low_watermark = 2
    high_watermark = 8
    pressure = block
}
