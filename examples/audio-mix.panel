panel 0

left: conduit.media/audio-frame/literal { fixture = "tone-s16le-stereo-48000" }
right: conduit.media/audio-frame/literal { fixture = "silence-s16le-stereo-48000" }
mix: conduit.media/audio/mix {
    lifecycle = "finite"
    numeric_profile = "pcm-s16-q15-round-nearest-away-saturate-no-nan-no-denormal-bit-exact"
    alignment = "exact-start-rate-layout-frames"
    missing_late = "wait-then-fail-terminal"
    left_gain_q15 = 32768
    right_gain_q15 = 32768
    headroom = "none"
    clipping = "saturate-s16"
    output_layout = "same-as-aligned-inputs"
    latency_frames = 0
    terminal_drain = "no-retained-samples"
    maximum_inputs = 2
    maximum_frames = 16
    maximum_work = 64
}
inspect: conduit.media/audio-frame/inspect
output: display/text

left.frame > mix.left { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
right.frame > mix.right { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
mix.frame > inspect.frame { capacity = 1 max_value_bytes = 152 max_queued_bytes = 152 low_watermark = 0 high_watermark = 1 pressure = block }
inspect.summary > output.text { capacity = 1 max_value_bytes = 96 max_queued_bytes = 96 low_watermark = 0 high_watermark = 1 pressure = block }
