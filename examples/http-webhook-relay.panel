# HTTP webhook relay panel.
panel 0

receiver: conduit/http-server {
    port = 8080
}

filter: conduit/passthrough
forwarding_client: conduit/http-client {
    endpoint = "https://hooks.example.com/relay"
}

receiver.request > filter.value {
    capacity = 16
    max_value_bytes = 32768
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 16
    pressure = block
}

filter.value > forwarding_client.request {
    capacity = 16
    max_value_bytes = 32768
    max_queued_bytes = 524288
    low_watermark = 4
    high_watermark = 16
    pressure = block
}
