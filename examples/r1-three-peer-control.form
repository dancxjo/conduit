form 0

r1-three-peer-control {
    terminal: interaction/level
    browser-a: interaction/level
    browser-b: interaction/level
    merge: flow/merge-three-signal
    show: presentation/show

    terminal.signal -> merge.terminal
    browser-a.signal -> merge.browser-a
    browser-b.signal -> merge.browser-b
    merge.signal -> show.signal
}
