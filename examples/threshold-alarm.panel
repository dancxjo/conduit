# Sensor threshold alarm and LED control panel.
panel 0

sensor_pin: device/gpio/pin {
    pin = 14
    mode = "read"
}

filter: std/deduplicate
alarm_counter: std/counter
led_pin: device/gpio/pin {
    pin = 15
    mode = "write"
}

sensor_pin.state > filter.candidate {
    capacity = 8
    max_value_bytes = 1024
    max_queued_bytes = 8192
    low_watermark = 2
    high_watermark = 8
    pressure = drop_disposable
}

filter.unique > alarm_counter.event {
    capacity = 8
    max_value_bytes = 1024
    max_queued_bytes = 8192
    low_watermark = 2
    high_watermark = 8
    pressure = block
}

alarm_counter.count > led_pin.command {
    capacity = 8
    max_value_bytes = 1024
    max_queued_bytes = 8192
    low_watermark = 2
    high_watermark = 8
    pressure = block
}
