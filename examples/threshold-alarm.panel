# Sensor threshold alarm and LED control panel.
panel 3

node sensor_pin : device/gpio/pin {
    pin = 14
    mode = "read"
}

node filter : std/deduplicate
node alarm_counter : std/counter
node led_pin : device/gpio/pin {
    pin = 15
    mode = "write"
}

cord sensor_pin.state -> filter.candidate {
    capacity = 8
    max_value_bytes = 1024
    max_queued_bytes = 8192
    low_watermark = 2
    high_watermark = 8
    pressure = drop_disposable
}

cord filter.unique -> alarm_counter.event {
    capacity = 8
    max_value_bytes = 1024
    max_queued_bytes = 8192
    low_watermark = 2
    high_watermark = 8
    pressure = block
}

cord alarm_counter.count -> led_pin.command {
    capacity = 8
    max_value_bytes = 1024
    max_queued_bytes = 8192
    low_watermark = 2
    high_watermark = 8
    pressure = block
}
