# Isolated Wi-Fi access point configuration panel.
panel 3

node wifi_ap : net/wifi/access-point {
    ssid = "Conduit-AP"
}

node status_logger : observe/log

cord wifi_ap.state -> status_logger.message {
    capacity = 4
    max_value_bytes = 1024
    max_queued_bytes = 4096
    low_watermark = 1
    high_watermark = 4
    pressure = block
}
