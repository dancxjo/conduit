panel 0

audio: conduit.media/audio-frame/literal { fixture = "tone-s16le-stereo-48000" }
inspect_audio: conduit.media/audio-frame/inspect
video: conduit.media/video-frame/literal { fixture = "rgb24-2x2" }
inspect_video: conduit.media/video-frame/inspect
audio_output: display/text
video_output: display/text

audio.frame > inspect_audio.frame { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
video.frame > inspect_video.frame { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
inspect_audio.summary > audio_output.text { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
inspect_video.summary > video_output.text { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
