panel 0

node source : conduit.media/audio-frame/literal { fixture = "tone-s16le-stereo-48000" }
node map : conduit.media/audio/channel-map {
    lifecycle = "finite"
    numeric_profile = "pcm-s16-q15-round-nearest-away-saturate-no-nan-no-denormal-bit-exact"
    input_layout = "stereo-lr"
    output_layout = "mono-center"
    matrix_q15 = "mono=(16384*L+16384*R)/32768"
    maximum_channels = 2
    maximum_frames = 16
}
node inspect : conduit.media/audio-frame/inspect
node output : display/text

cord source.frame -> map.frame { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
cord map.frame -> inspect.frame { capacity = 1 max_value_bytes = 88 max_queued_bytes = 88 low_watermark = 0 high_watermark = 1 pressure = block }
cord inspect.summary -> output.text { capacity = 1 max_value_bytes = 96 max_queued_bytes = 96 low_watermark = 0 high_watermark = 1 pressure = block }
