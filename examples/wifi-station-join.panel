# Wi-Fi station join effect request. This remains contract-only until a host
# installs an exact provider and supplies current use-time authority.
panel 0

wifi_sta: net/wifi/join {
    lifecycle = "standing"
    interface = 1
    profile = "ConduitNet"
    mtu = 1500
    maximum_events_per_step = 1
    maximum_evidence_events = 64
}
