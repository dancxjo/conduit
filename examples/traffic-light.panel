# Traffic light state machine sequencer panel.
panel 0

node clock_ticks : std/counter
node state_selector : std/cell {
    initial = "RED"
}
node light_controller : device/gpio/pin {
    pin = 16
    mode = "write"
}

cord clock_ticks.count -> state_selector.update {
    capacity = 4
    max_value_bytes = 256
    max_queued_bytes = 1024
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

cord state_selector.current -> light_controller.command {
    capacity = 4
    max_value_bytes = 256
    max_queued_bytes = 1024
    low_watermark = 1
    high_watermark = 4
    pressure = block
}
