# Traffic light state machine sequencer panel.
panel 0

clock_ticks: std/counter
state_selector: std/cell {
    initial = "RED"
}
light_controller: device/gpio/pin {
    pin = 16
    mode = "write"
}

clock_ticks.count > state_selector.update {
    capacity = 4
    max_value_bytes = 256
    max_queued_bytes = 1024
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

state_selector.current > light_controller.command {
    capacity = 4
    max_value_bytes = 256
    max_queued_bytes = 1024
    low_watermark = 1
    high_watermark = 4
    pressure = block
}
