}
body_to_camera_inverse: spatial/transform/literal {
  source_frame = "body" target_frame = "camera"
  unit = "um" handedness = "right" axes = "x-right-y-forward-z-up"
  translation_x_um = 100 translation_y_um = 200 translation_z_um = 300 quarter_turns_z = 0
  clock = "clock/fixture" stamp_tick = 10 valid_from_tick = 0 valid_until_tick = 20
  uncertainty_um = 0
  calibration_identity = "sha256:5151515151515151515151515151515151515151515151515151515151515151"
  provenance_identity = "sha256:5252525252525252525252525252525252525252525252525252525252525252"
