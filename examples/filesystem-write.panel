# Write one bounded literal chunk to an opaque provider-owned file resource.
panel 0

node source : fs/chunk/literal {
    value = bytes("636f6e6475697420626f756e6465642066696c6573797374656d0a")
    maximum_bytes = 64
}

node writer : fs/write {
    resource = secret("conduit.resource/filesystem-example-write")
    grant = secret("conduit.grant/filesystem-write")
    mode = "replace"
    maximum_bytes = 64
    partial = "fail-without-commit"
    flush = "provider-accepted"
    cleanup = "close"
    cancellation = "close"
}

cord source.chunk -> writer.chunk {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
