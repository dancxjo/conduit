# Network health monitor panel with circuit breaker and backoff.
panel 3

node probe_ping : std/udp-socket {
    port = 53
}

node health_check : std/health-gate
node breaker : std/circuit-breaker
node backoff_retry : std/backoff

cord probe_ping.datagram -> health_check.observation {
    capacity = 8
    max_value_bytes = 2048
    max_queued_bytes = 16384
    low_watermark = 2
    high_watermark = 8
    pressure = block
}

cord health_check.healthy -> breaker.request {
    capacity = 8
    max_value_bytes = 2048
    max_queued_bytes = 16384
    low_watermark = 2
    high_watermark = 8
    pressure = block
}

cord breaker.admitted -> backoff_retry.request {
    capacity = 8
    max_value_bytes = 2048
    max_queued_bytes = 16384
    low_watermark = 2
    high_watermark = 8
    pressure = block
}
