# Network health monitor panel with circuit breaker and backoff.
panel 1

node probe_ping : conduit.std/udp-socket {
    port = 53
}

node health_check : conduit.std/health-gate
node breaker : conduit.std/circuit-breaker
node backoff_retry : conduit.std/backoff

cord probe_ping.out -> health_check.in {
    capacity = 8
    max_value_bytes = 2048
    max_queued_bytes = 16384
    low_watermark = 2
    high_watermark = 8
    pressure = block
}

cord health_check.out -> breaker.in {
    capacity = 8
    max_value_bytes = 2048
    max_queued_bytes = 16384
    low_watermark = 2
    high_watermark = 8
    pressure = block
}

cord breaker.out -> backoff_retry.in {
    capacity = 8
    max_value_bytes = 2048
    max_queued_bytes = 16384
    low_watermark = 2
    high_watermark = 8
    pressure = block
}
