form 0

signal-composite {
    pulse: flow/pulse
    show: presentation/show

    pulse.count = 3
    pulse.period-ms = 0
    pulse.initial = false

    pulse > show
    export run-signal: demonstration/run-signal {
        input signal-in: value/signal = show.signal terminal independent
        output signal: value/signal = pulse.signal terminal independent
    }
}
