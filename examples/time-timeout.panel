panel 0

source: std/literal { value = "before timeout\n" }
lines: std/text/lines {
    maximum_line_bytes = 64
    maximum_retained_prefix_bytes = 64
}
timeout: time/timeout {
    clock = ref("conduit.clock/monotonic-ticks")
    clock_schema_version = 0
    clock_hash = bytes("6b9c687226d4a1965e780b63b4bdc0922de2a686c3c1365f4f68f7219f30cc48")
    resolution_ticks = 1
    duration_ticks = 8
    condition = "inactivity"
    reset = "each-value"
    late = "timeout"
    discontinuity = "fail"
}
join: std/text/join {
    separator = ""
    maximum_items = 4
    maximum_item_bytes = 64
    maximum_separator_bytes = 1
    maximum_output_bytes = 64
}
display: display/text

source.value > lines.text { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
lines.line > timeout.item { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
timeout.completed > join.item { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
join.text > display.text { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
