# Scheduled bounded backup pipeline panel.
panel 3

node trigger : std/counter
node reader : std/file-read {
    path = "data/db.sqlite"
}
node backup_store : storage/blob/store {
    bucket = "backups"
}

cord trigger.count -> reader.path {
    capacity = 4
    max_value_bytes = 1024
    max_queued_bytes = 4096
    low_watermark = 1
    high_watermark = 4
    pressure = drop_disposable
}

cord reader.contents -> backup_store.blob {
    capacity = 4
    max_value_bytes = 1048576
    max_queued_bytes = 4194304
    low_watermark = 1
    high_watermark = 4
    pressure = block
}
