# One semantic chat node; the exact plan chooses one compatible implementation.
panel 0

message: std/literal {
  value = "Explain the implementation boundary."
}

chat: ai/chat {
  mode = "conduit.ai/chat/quick-local"
  maximum_message_bytes = 4096
  maximum_context_bytes = 8192
  maximum_output_bytes = 4096
  maximum_chunk_bytes = 1024
  maximum_chunks = 8
  maximum_concurrency = 4
  timeout_millis = 1000
  sensitivity = "public"
  conversation_state = "caller-supplied-only"
  retention = "none"
  tools = "forbidden"
  structured_output = "unsupported"
}

join: std/text/join {
  separator = ""
  maximum_items = 8
  maximum_item_bytes = 1024
  maximum_separator_bytes = 64
  maximum_output_bytes = 4096
}
output: display/text

message.value > chat.message {
  capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096
  low_watermark = 0 high_watermark = 1 pressure = block
}

chat.chunks > join.item {
  capacity = 8 max_value_bytes = 1024 max_queued_bytes = 8192
  low_watermark = 1 high_watermark = 8 pressure = block
}

join.text > output.text {
  capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096
  low_watermark = 0 high_watermark = 1 pressure = block
}
