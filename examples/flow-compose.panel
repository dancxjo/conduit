panel 3

node first : std/literal {
    value = ""
}
node second : std/literal {
    value = "right"
}
node command : std/literal {
    value = "right"
}
node first_lines : std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
node second_lines : std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
node commands : std/text/lines { maximum_line_bytes = 1024 maximum_retained_prefix_bytes = 1024 }
node select : conduit.std/select {
    initial = "left"
    inactive = "block"
}
node tee : conduit.std/tee {
    mode = "coupled"
}
node left_text : std/text/join { separator = "" maximum_items = 8 maximum_item_bytes = 1024 maximum_separator_bytes = 64 maximum_output_bytes = 4096 }
node right_text : std/text/join { separator = "" maximum_items = 8 maximum_item_bytes = 1024 maximum_separator_bytes = 64 maximum_output_bytes = 4096 }
node left_bytes : text/encode-utf8
node right_bytes : text/encode-utf8
node left : io/stdout
node right : io/stderr

cord first.value -> first_lines.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord second.value -> second_lines.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord command.value -> commands.text {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord first_lines.line -> select.left { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
cord second_lines.line -> select.right { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
cord commands.line -> select.selector { capacity = 1 max_value_bytes = 1024 max_queued_bytes = 1024 low_watermark = 0 high_watermark = 1 pressure = block }
cord select.selected -> tee.value {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord tee.left -> left_text.item {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord tee.right -> right_text.item {
    capacity = 1
    max_value_bytes = 1024
    max_queued_bytes = 1024
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord left_text.text -> left_bytes.text { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
cord right_text.text -> right_bytes.text { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
cord left_bytes.bytes -> left.bytes { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
cord right_bytes.bytes -> right.bytes { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
