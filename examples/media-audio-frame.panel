panel 0

node frame : conduit.media/audio-frame/literal
node inspect : conduit.media/audio-frame/inspect
node output : display/text

cord frame.frame -> inspect.frame {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}

cord inspect.summary -> output.text { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
