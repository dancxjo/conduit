panel 0

frame: conduit.media/audio-frame/literal { fixture = "tone-s16le-stereo-48000" }
inspect: conduit.media/audio-frame/inspect
output: display/text

frame.frame > inspect.frame {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}

inspect.summary > output.text { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
