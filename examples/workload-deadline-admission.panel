panel 0

message: std/literal {
    value = "Deadline guarantees stay separate from measurements.\n"
}
emphasize: text/uppercase
output: display/text

message.value > emphasize.text {
    capacity = 1
    max_value_bytes = 128
    max_queued_bytes = 128
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
emphasize.text > output.text {
    capacity = 1
    max_value_bytes = 128
    max_queued_bytes = 128
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
