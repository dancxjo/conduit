# Local Ollama LLM text generation request via HTTP client.
panel 1

node prompt : std/format {
    template = "{{\"model\": \"{}\", \"prompt\": \"{}\", \"stream\": false}}"
    parameters = list("llama3", "Summarize Conduit architecture.")
}

node ollama_api : conduit/http-client {
    endpoint = "http://127.0.0.1:11434/api/generate"
}

node output : std/stdout

cord prompt.out -> ollama_api.in {
    capacity = 4
    max_value_bytes = 8192
    max_queued_bytes = 32768
    low_watermark = 1
    high_watermark = 4
    pressure = block
}

cord ollama_api.out -> output.in {
    capacity = 4
    max_value_bytes = 65536
    max_queued_bytes = 262144
    low_watermark = 1
    high_watermark = 4
    pressure = block
}
