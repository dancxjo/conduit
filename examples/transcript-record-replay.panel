# Chat transcript recording and replay pipeline.
panel 0

node input_stream : io/stdin
node decoder : std/data/decode-utf8 {
    codec = ref("conduit.codec/utf-8")
    codec_schema_version = 0
    codec_hash = bytes("f219297cb276bc91eccddb346a8b21e7edd4414b8844014108513747ae11bf53")
    maximum_input_bytes = 4096
    maximum_output_bytes = 4096
}
node recorder : std/record {
    session = "transcript-001"
}
node store : storage/blob/store {
    bucket = "transcripts"
}

cord input_stream.bytes -> decoder.bytes {
    capacity = 16
    max_value_bytes = 4096
    max_queued_bytes = 65536
    low_watermark = 2
    high_watermark = 16
    pressure = block
}

cord decoder.text -> recorder.observed {
    capacity = 16
    max_value_bytes = 8192
    max_queued_bytes = 131072
    low_watermark = 4
    high_watermark = 16
    pressure = block
}

cord recorder.recorded -> store.blob {
    capacity = 16
    max_value_bytes = 4096
    max_queued_bytes = 65536
    low_watermark = 2
    high_watermark = 16
    pressure = block
}
