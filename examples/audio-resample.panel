panel 0

source: conduit.media/audio-frame/literal { fixture = "tone-s16le-stereo-48000" }
resample: conduit.media/audio/resample {
    lifecycle = "finite"
    numeric_profile = "pcm-s16-q15-round-nearest-away-saturate-no-nan-no-denormal-bit-exact"
    input_rate_hz = 48000
    output_rate_hz = 24000
    quality_profile = "nearest-hold-bit-exact"
    group_delay_frames = 0
    timestamp_mapping = "absolute-rational-grid"
    drift = "reject-rate-or-discontinuity"
    flush = "no-pending-output"
    maximum_history_frames = 0
    maximum_frames = 16
    maximum_work = 64
}
inspect: conduit.media/audio-frame/inspect
output: display/text

source.frame > resample.frame { capacity = 1 max_value_bytes = 64 max_queued_bytes = 64 low_watermark = 0 high_watermark = 1 pressure = block }
resample.frame > inspect.frame { capacity = 1 max_value_bytes = 88 max_queued_bytes = 88 low_watermark = 0 high_watermark = 1 pressure = block }
inspect.summary > output.text { capacity = 1 max_value_bytes = 96 max_queued_bytes = 96 low_watermark = 0 high_watermark = 1 pressure = block }
