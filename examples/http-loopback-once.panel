# One exact bounded loopback HTTP route. The production provider binds an
# ephemeral port, serves one request, records terminal evidence, and exits.
panel 1

node server : net/http/serve-once {
    listen = "127.0.0.1:0"
    method = "GET"
    path = "/health"
    response = "conduit http ready\n"
    deadline_ms = "5000"
}
