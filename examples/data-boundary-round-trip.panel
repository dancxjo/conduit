}
node display : display/text

cord message.value -> encoded.text {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord encoded.bytes -> framed.payload {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord framed.bytes -> deframed.chunk {
    capacity = 1
    max_value_bytes = 68
    max_queued_bytes = 68
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord deframed.payload -> decoded.bytes {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
cord decoded.text -> display.text {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
