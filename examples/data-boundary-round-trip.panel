panel 0

node message : std/literal {
    value = "representation boundaries stay explicit"
}
node encoded : std/data/encode-utf8 {
    codec = ref("conduit.codec/utf-8")
    codec_schema_version = 0
    codec_hash = bytes("f219297cb276bc91eccddb346a8b21e7edd4414b8844014108513747ae11bf53")
    maximum_input_bytes = 64
    maximum_output_bytes = 64
}
node framed : std/data/frame-length-u32be {
