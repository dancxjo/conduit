panel 1

node template : std/literal {
    value = "{first}\r\n{second}\n"
}
node values : std/format-values/literal {
    values = list(
        record(name="first", value="alpha"),
        record(name="second", value="beta")
    )
}
node formatted : std/text/format
node lines : std/text/lines {
    maximum_line_bytes = 1024
    maximum_retained_prefix_bytes = 1024
}
node joined : std/text/join {
    separator = " / "
    maximum_items = 8
    maximum_item_bytes = 1024
    maximum_separator_bytes = 64
    maximum_output_bytes = 4096
}
node output : io/stdout

cord template.out -> formatted.template { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
cord values.out -> formatted.values { capacity = 1 max_value_bytes = 16384 max_queued_bytes = 16384 low_watermark = 0 high_watermark = 1 pressure = block }
cord formatted.out -> lines.in { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
cord lines.line -> joined.item { capacity = 8 max_value_bytes = 1024 max_queued_bytes = 8192 low_watermark = 1 high_watermark = 8 pressure = block }
cord joined.out -> output.in { capacity = 1 max_value_bytes = 4096 max_queued_bytes = 4096 low_watermark = 0 high_watermark = 1 pressure = block }
