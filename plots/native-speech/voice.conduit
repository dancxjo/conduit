 closure: 180 } : (. is b ? { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 0, frames: 640, closure: 180 } : { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 0, frames: 640, closure: 180 })) : (. is d ? { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 0, frames: 640, closure: 180 } : (. is k ? { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 0, frames: 640, closure: 180 } : { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 0, frames: 640, closure: 180 }))))) : ((((. is f || . is v) || (. is th || (. is dh || . is s))) || ((. is z || (. is sh || . is zh)) || (. is ch || (. is jh || . is m)))) ? (((. is f || . is v) || (. is th || (. is dh || . is s))) ? ((. is f || . is v) ? (. is f ? { f1: 1000, f2: 2800, f3: 3600, b1: 20195, b2: -15827, b3: -24144, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 0 } : { f1: 1000, f2: 2800, f3: 3600, b1: 20195, b2: -15827, b3: -24144, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 1, frames: 640, closure: 0 }) : (. is th ? { f1: 900, f2: 2500, f3: 3300, b1: 21717, b2: -10304, b3: -21645, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 0 } : (. is dh ? { f1: 900, f2: 2500, f3: 3300, b1: 21717, b2: -10304, b3: -21645, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 1, frames: 640, closure: 0 } : { f1: 1200, f2: 3200, f3: 3800, b1: 16787, b2: -21784, b3: -25073, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 0 }))) : ((. is z || (. is sh || . is zh)) ? (. is z ? { f1: 1200, f2: 3200, f3: 3800, b1: 16787, b2: -21784, b3: -25073, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 1, frames: 640, closure: 0 } : (. is sh ? { f1: 1000, f2: 2100, f3: 3000, b1: 20195, b2: -2113, b3: -17951, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 0 } : { f1: 1000, f2: 2100, f3: 3000, b1: 20195, b2: -2113, b3: -17951, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 1, frames: 640, closure: 0 })) : (. is ch ? { f1: 1000, f2: 2100, f3: 3000, b1: 20195, b2: -2113, b3: -17951, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 180 } : (. is jh ? { f1: 1000, f2: 2100, f3: 3000, b1: 20195, b2: -2113, b3: -17951, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 1, frames: 640, closure: 180 } : { f1: 250, f2: 1000, f3: 2200, b1: 30901, b2: 21759, b3: -4702, c1: -15146, c2: -14449, c3: -13784, gain1: 631, gain2: 332, gain3: 339, voiced: 1, frication: 0, frames: 640, closure: 0 })))) : (((. is n || . is ng) || (. is l || (. is r || . is w))) ? ((. is n || . is ng) ? (. is n ? { f1: 270, f2: 1700, f3: 2600, b1: 30800, b2: 7184, b3: -13645, c1: -15146, c2: -14449, c3: -13784, gain1: 631, gain2: 332, gain3: 339, voiced: 1, frication: 0, frames: 640, closure: 0 } : { f1: 300, f2: 1800, f3: 2500, b1: 30636, b2: 4814, b3: -11502, c1: -15146, c2: -14449, c3: -13784, gain1: 631, gain2: 332, gain3: 339, voiced: 1, frication: 0, frames: 640, closure: 0 }) : (. is l ? { f1: 400, f2: 1200, f3: 2600, b1: 29964, b2: 18088, b3: -13645, c1: -15146, c2: -14449, c3: -13784, gain1: 631, gain2: 998, gain3: 1356, voiced: 1, frication: 0, frames: 640, closure: 0 } : (. is r ? { f1: 350, f2: 1300, f3: 1600, b1: 30323, b2: 16079, b3: 9288, c1: -15146, c2: -14449, c3: -13784, gain1: 631, gain2: 998, gain3: 1356, voiced: 1, frication: 0, frames: 640, closure: 0 } : { f1: 300, f2: 700, f3: 2200, b1: 30636, b2: 26238, b3: -4702, c1: -15146, c2: -14449, c3: -13784, gain1: 631, gain2: 998, gain3: 1356, voiced: 1, frication: 0, frames: 640, closure: 0 }))) : ((. is y || (. is h || . is p_aspirated)) ? (. is y ? { f1: 270, f2: 2200, f3: 3000, b1: 30800, b2: -4814, b3: -21253, c1: -15146, c2: -14449, c3: -13784, gain1: 631, gain2: 998, gain3: 1356, voiced: 1, frication: 0, frames: 640, closure: 0 } : (. is h ? { f1: 500, f2: 1500, f3: 2500, b1: 26386, b2: 10304, b3: -9715, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 0 } : { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 180 })) : (. is t_aspirated ? { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 180 } : (. is k_aspirated ? { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 0, frication: 1, frames: 640, closure: 180 } : { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, voiced: 1, frication: 0, frames: 640, closure: 0 }))))))

type DriveInput = {
    sample: I64
    gain: I64
}
plot speech/drive (
    >> value: DriveInput
    result: I64 >>
) = (.sample * .gain)

type EnvelopeInput = {
    frame: I64
    total: I64
    closure: I64
}
plot speech/envelope (
    >> value: EnvelopeInput
    result: I64 >>
) = (.frame < .closure ? 0 : .frame - .closure < 64 ? (.frame - .closure) * 4 : .total - .frame < 64 ? (.total - .frame) * 4 : 256)

# A boundary is not a phone and an absence is not silence.
type VoiceBoundary =
    word
    | phrase
    | turn

type VoiceEvent =
    segment RealizationInput
    | boundary VoiceBoundary

plot speech/pause (
    >> value: VoiceBoundary
    result: I64 >>
) = (. is word ? 240 : . is phrase ? 1200 : 2000)

plot speech/pitch-period (
    >> value: EnglishStress
    result: I64 >>
) = (. is primary ? 61 : . is secondary ? 64 : 67)
