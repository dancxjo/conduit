# Fixed reusable storage with an explicit actual length. No padding is data.
type BinaryFrame4 = {
    bytes: collection U8 = 4
    length: U8
}
type BinaryFrame8 = {
    bytes: collection U8 = 8
    length: U8
}
type BinaryByteQuery = {
    frame: BinaryFrame8
    index: U8
}
type BinaryByteResult =
    byte U8
    | short
    | malformed
type BinaryConcatQuery = {
    left: BinaryFrame4
    right: BinaryFrame4
}
type BinaryConcatResult =
    frame BinaryFrame8
    | malformed

plot binary-frame-byte (
    query: BinaryByteQuery >> result: BinaryByteResult
) = (.frame.length > 8 ? malformed(unit) : (.index >= .frame.length ? short(unit) : (.index == 0 ? byte(.frame.bytes.0) : (.index == 1 ? byte(.frame.bytes.1) : (.index == 2 ? byte(.frame.bytes.2) : (.index == 3 ? byte(.frame.bytes.3) : (.index == 4 ? byte(.frame.bytes.4) : (.index == 5 ? byte(.frame.bytes.5) : (.index == 6 ? byte(.frame.bytes.6) : (.index == 7 ? byte(.frame.bytes.7) : (malformed(unit))))))))))))

plot binary-frame-concat (
    query: BinaryConcatQuery >> result: BinaryConcatResult
) = (.left.length > 4 || .right.length > 4 ? malformed(unit) : frame({ bytes: [(0 < .left.length ? .left.bytes.0 : (0 < .left.length + .right.length ? (0 - .left.length == 0 ? .right.bytes.0 : (0 - .left.length == 1 ? .right.bytes.1 : (0 - .left.length == 2 ? .right.bytes.2 : (0 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0)), (1 < .left.length ? .left.bytes.1 : (1 < .left.length + .right.length ? (1 - .left.length == 0 ? .right.bytes.0 : (1 - .left.length == 1 ? .right.bytes.1 : (1 - .left.length == 2 ? .right.bytes.2 : (1 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0)), (2 < .left.length ? .left.bytes.2 : (2 < .left.length + .right.length ? (2 - .left.length == 0 ? .right.bytes.0 : (2 - .left.length == 1 ? .right.bytes.1 : (2 - .left.length == 2 ? .right.bytes.2 : (2 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0)), (3 < .left.length ? .left.bytes.3 : (3 < .left.length + .right.length ? (3 - .left.length == 0 ? .right.bytes.0 : (3 - .left.length == 1 ? .right.bytes.1 : (3 - .left.length == 2 ? .right.bytes.2 : (3 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0)), (4 < .left.length + .right.length ? (4 - .left.length == 0 ? .right.bytes.0 : (4 - .left.length == 1 ? .right.bytes.1 : (4 - .left.length == 2 ? .right.bytes.2 : (4 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0), (5 < .left.length + .right.length ? (5 - .left.length == 0 ? .right.bytes.0 : (5 - .left.length == 1 ? .right.bytes.1 : (5 - .left.length == 2 ? .right.bytes.2 : (5 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0), (6 < .left.length + .right.length ? (6 - .left.length == 0 ? .right.bytes.0 : (6 - .left.length == 1 ? .right.bytes.1 : (6 - .left.length == 2 ? .right.bytes.2 : (6 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0), (7 < .left.length + .right.length ? (7 - .left.length == 0 ? .right.bytes.0 : (7 - .left.length == 1 ? .right.bytes.1 : (7 - .left.length == 2 ? .right.bytes.2 : (7 - .left.length == 3 ? .right.bytes.3 : (0))))) : 0)], length: .left.length + .right.length }))
