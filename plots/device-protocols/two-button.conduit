# A pair is committed only after both candidate levels remain unchanged for 20 ms.
# Edges occur once on commitment; holding a contact does not repeat a press.
# Failure 1 stale sequence/time; 3 lifetime exhausted.
# A failures 10 unsupported/11 provider-lost/12 refused; B 20/21/22.
# Clock 30 unavailable/31 provider-lost/32 unsupported-deadline/33 malformed/34 timeout.
# Earlier contacts take precedence when more than one provider fails in a sample.
plot two-button-initialize (
    start: Boolean...| >> state: TwoButtonState...|
) = ({ candidate_a: false, candidate_b: false, stable_a: false, stable_b: false, since: 0, clock: 0, sequence: 0, a_pressed: false, b_pressed: false, a_released: false, b_released: false, failure: 0 })

plot two-button-transition (
    input: TwoButtonTransition...| >> state: TwoButtonState...|
) = (.state.failure != 0 ? .state : (.state.sequence >= 1048576 ? { candidate_a: .state.candidate_a, candidate_b: .state.candidate_b, stable_a: .state.stable_a, stable_b: .state.stable_b, since: .state.since, clock: .state.clock, sequence: .state.sequence, a_pressed: false, b_pressed: false, a_released: false, b_released: false, failure: 3 } : (.sample.sequence != .state.sequence ? { candidate_a: .state.candidate_a, candidate_b: .state.candidate_b, stable_a: .state.stable_a, stable_b: .state.stable_b, since: .state.since, clock: .state.clock, sequence: .state.sequence, a_pressed: false, b_pressed: false, a_released: false, b_released: false, failure: 1 } : (.sample.a is completed && .sample.b is completed && .sample.clock is completed ? (.sample.clock.completed < .state.clock || .sample.clock.completed < .state.since ? { candidate_a: .state.candidate_a, candidate_b: .state.candidate_b, stable_a: .state.stable_a, stable_b: .state.stable_b, since: .state.since, clock: .state.clock, sequence: .state.sequence, a_pressed: false, b_pressed: false, a_released: false, b_released: false, failure: 1 } : ((! .sample.a.completed.high) != .state.candidate_a || (! .sample.b.completed.high) != .state.candidate_b ? { candidate_a: ! .sample.a.completed.high, candidate_b: ! .sample.b.completed.high, stable_a: .state.stable_a, stable_b: .state.stable_b, since: .sample.clock.completed, clock: .sample.clock.completed, sequence: .state.sequence + 1, a_pressed: false, b_pressed: false, a_released: false, b_released: false, failure: 0 } : (.sample.clock.completed - .state.since >= 20 ? { candidate_a: .state.candidate_a, candidate_b: .state.candidate_b, stable_a: .state.candidate_a, stable_b: .state.candidate_b, since: .state.since, clock: .sample.clock.completed, sequence: .state.sequence + 1, a_pressed: .state.candidate_a && ! .state.stable_a, b_pressed: .state.candidate_b && ! .state.stable_b, a_released: ! .state.candidate_a && .state.stable_a, b_released: ! .state.candidate_b && .state.stable_b, failure: 0 } : { candidate_a: .state.candidate_a, candidate_b: .state.candidate_b, stable_a: .state.stable_a, stable_b: .state.stable_b, since: .state.since, clock: .sample.clock.completed, sequence: .state.sequence + 1, a_pressed: false, b_pressed: false, a_released: false, b_released: false, failure: 0 }))) : { candidate_a: .state.candidate_a, candidate_b: .state.candidate_b, stable_a: .state.stable_a, stable_b: .state.stable_b, since: .state.since, clock: .state.clock, sequence: .state.sequence, a_pressed: false, b_pressed: false, a_released: false, b_released: false, failure: (.sample.a is completed ? (.sample.b is completed ? (.sample.clock is unavailable ? 30 : (.sample.clock is provider-lost ? 31 : (.sample.clock is unsupported-deadline ? 32 : (.sample.clock is malformed ? 33 : 34)))) : (.sample.b is unsupported ? 20 : (.sample.b is provider-lost ? 21 : 22))) : (.sample.a is unsupported ? 10 : (.sample.a is provider-lost ? 11 : 12))) }))))
