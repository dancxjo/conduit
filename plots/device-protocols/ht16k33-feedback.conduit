with flow/zip/feedback/paired as Ht16k33Pair

# Legacy single-specialization adapters. Combined workloads load the generic
# ht16k33-exchanges library and supply their exact typed selections instead.
plot ht16k33-default-state-cell (
    >> seed: Ht16k33ProtocolFrame...|
    >> next: Ht16k33ProtocolFrame...|
    current: Ht16k33ProtocolFrame...| >>
) {
    cell: state/seeded/flow/until
    seed >> cell.seed
    next >> cell.next
    cell.current >> current
}
plot ht16k33-default-pairing (
    >> left: Ht16k33State...|
    >> right: I2cResult...|
    paired: Ht16k33Pair...| >>
) {
    join: flow/zip/feedback
    left >> join.left
    right >> join.right
    join.paired >> paired
}
plot ht16k33-default-error-merge (
    >> left: Ht16k33Failure...|
    >> right: Ht16k33Failure...|
    merged: Ht16k33Failure...| >>
) {
    errors: flow/merge/finite
    left >> errors.left
    right >> errors.right
    errors.merged >> merged
}
plot ht16k33-join (
    pair: Ht16k33Pair...| >> transition: Ht16k33Transition...|
) {
    pair >> ht16k33-join-selected(pair-type = Ht16k33Pair) >> transition
}
plot ht16k33-initialize-exchange (
    >> configuration: Ht16k33Configuration...|
    >> result: I2cResult...|
    request: I2cTransaction...| >>
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| >>
) {
    protocol: ht16k33-initialize-exchange-selected(pair-type = Ht16k33Pair, state-cell = ht16k33-default-state-cell, pairing = ht16k33-default-pairing)
    configuration >> protocol.configuration
    result >> protocol.result
    protocol.request >> request
    protocol.acknowledged >> acknowledged
    protocol.refused >> refused
}
plot ht16k33-write-exchange (
    >> frame: Ht16k33Frame...|
    >> result: I2cResult...|
    request: I2cTransaction...| >>
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| <= 4096B >>
) {
    protocol: ht16k33-write-exchange-selected(error-merge = ht16k33-default-error-merge)
    frame >> protocol.frame
    result >> protocol.result
    protocol.request >> request
    protocol.acknowledged >> acknowledged
    protocol.refused >> refused
}

# Single-client composition. Shared-controller compositions connect the same
# exchange Fores through an explicitly selected request/result router instead.
plot ht16k33-initialize-display (
    >> configuration: Ht16k33Configuration...|
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| >>
) {
    protocol: ht16k33-initialize-exchange
    bus: machine/i2c/transact
    configuration >> protocol.configuration
    protocol.request >> bus.request
    bus.result >> protocol.result
    protocol.acknowledged >> acknowledged
    protocol.refused >> refused
}

plot ht16k33-write-display (
    >> frame: Ht16k33Frame...|
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| <= 4096B >>
) {
    protocol: ht16k33-write-exchange
    bus: machine/i2c/transact
    frame >> protocol.frame
    protocol.request >> bus.request
    bus.result >> protocol.result
    protocol.acknowledged >> acknowledged
    protocol.refused >> refused
}
