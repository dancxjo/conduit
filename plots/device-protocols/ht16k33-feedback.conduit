with flow/zip/feedback/paired as Ht16k33Pair

type Ht16k33ProtocolFrame = {
    value: Ht16k33State
    terminal: Boolean
}
plot ht16k33-protocol-frame (
    state: Ht16k33State...| >> frame: Ht16k33ProtocolFrame...|
) = ({ value: ., terminal: .phase >= 5 })
plot ht16k33-protocol-state (
    frame: Ht16k33ProtocolFrame...| >> state: Ht16k33State...|
) = (.value)
plot ht16k33-join (
    pair: Ht16k33Pair...| >> transition: Ht16k33Transition...|
) = ({ state: .0, result: .1 })

# Only the selected bus result advances the feedback cell. The terminal frame
# is published before closing, including failures; there is no host-side retry.
plot ht16k33-initialize-exchange (
    >> configuration: Ht16k33Configuration...|
    >> result: I2cResult...|
    request: I2cTransaction...| >>
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| >>
) {
    cell: state/seeded/flow/until
    states: ht16k33-protocol-state
    actions: ht16k33-action
    join: flow/zip/feedback
    configuration >> ht16k33-initialize() >> ht16k33-protocol-frame() >> cell.seed
    cell.current >> states
    states >> join.left
    states >> actions
    actions >> select(Ht16k33Action.transact, unmatched=drop) >> request
    actions >> select(Ht16k33Action.acknowledged, unmatched=drop) >> acknowledged
    actions >> select(Ht16k33Action.refused, unmatched=drop) >> refused
    result >> join.right
    join.paired >> ht16k33-join() >> ht16k33-transition() >> ht16k33-protocol-frame() >> cell.next
}

# Mapping a Face to RAM is a separate Mask responsibility. This Plot transfers
# that RAM once and reports only the selected bus's write outcome.
plot ht16k33-write-exchange (
    >> frame: Ht16k33Frame...|
    >> result: I2cResult...|
    request: I2cTransaction...| >>
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| <= 4096B >>
) {
    requests: ht16k33-frame-request
    outcomes: ht16k33-write-outcome
    errors: flow/merge/finite
    frame >> requests
    requests >> select(Ht16k33Action.transact, unmatched=drop) >> request
    requests >> select(Ht16k33Action.refused, unmatched=drop) >> errors.left
    result >> outcomes
    outcomes >> select(Ht16k33Action.acknowledged, unmatched=drop) >> acknowledged
    outcomes >> select(Ht16k33Action.refused, unmatched=drop) >> errors.right
    errors.merged >> refused
}

# Single-client composition. Shared-controller compositions connect the same
# exchange Fores through an explicitly selected request/result router instead.
plot ht16k33-initialize-display (
    >> configuration: Ht16k33Configuration...|
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| >>
) {
    protocol: ht16k33-initialize-exchange
    bus: machine/i2c/transact
    configuration >> protocol.configuration
    protocol.request >> bus.request
    bus.result >> protocol.result
    protocol.acknowledged >> acknowledged
    protocol.refused >> refused
}

plot ht16k33-write-display (
    >> frame: Ht16k33Frame...|
    acknowledged: Ht16k33Acknowledgement...| >>
    refused: Ht16k33Failure...| <= 4096B >>
) {
    protocol: ht16k33-write-exchange
    bus: machine/i2c/transact
    frame >> protocol.frame
    protocol.request >> bus.request
    bus.result >> protocol.result
    protocol.acknowledged >> acknowledged
    protocol.refused >> refused
}
