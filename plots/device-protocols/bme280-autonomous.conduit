# Explicit isolated-device selection. Combined instruments load the generic
# exchange library and supply their own exact typed selections instead.
with flow/zip/feedback/paired as BmePair
with flow/zip/finite/paired as BmeClockPair

plot bme280-default-cell (
    >> seed: BmeProtocolFrame...|
    >> next: BmeProtocolFrame...|
    current: BmeProtocolFrame...| >>
) {
    cell: state/seeded/flow/until
    seed >> cell.seed
    next >> cell.next
    cell.current >> current
}
plot bme280-default-feedback (
    >> left: BmeProtocolState...|
    >> right: BmeProtocolEvent...|
    paired: BmePair...| >>
) {
    pair: flow/zip/feedback
    left >> pair.left
    right >> pair.right
    pair.paired >> paired
}
plot bme280-default-contexts (
    >> left: BmeClockContext...|
    >> right: BmeClockContext...|
    merged: BmeClockContext...| >>
) {
    merge: flow/merge/finite
    left >> merge.left
    right >> merge.right
    merge.merged >> merged
}
plot bme280-default-clock-pair (
    >> left: BmeClockContext...|
    >> right: ClockResult...|
    paired: BmeClockPair...| >>
) {
    pair: flow/zip/finite
    left >> pair.left
    right >> pair.right
    pair.paired >> paired
}
plot bme280-exchange (
    >> begin: BmeProtocolBegin...|
    >> result: I2cResult...|
    request: I2cTransaction...| >>
    captured: BmeProtocolState...| >>
    observation: BmeObservationResult...| >>
    refused: BmeProtocolFailure...| >>
    clock_failed: ClockResult...| >>
) {
    protocol: bme280-exchange-selected(feedback-type = BmePair, clock-pair-type = BmeClockPair, state-cell = bme280-default-cell, feedback-pairing = bme280-default-feedback, context-merge = bme280-default-contexts, clock-pairing = bme280-default-clock-pair)
    begin >> protocol.begin
    result >> protocol.result
    protocol.request >> request
    protocol.captured >> captured
    protocol.observation >> observation
    protocol.refused >> refused
    protocol.clock_failed >> clock_failed
}

# The protocol owns its deadlines; the surrounding composition selects the bus.
plot bme280-autonomous (
    >> begin: BmeProtocolBegin...|
    captured: BmeProtocolState...| >>
    observation: BmeObservationResult...| >>
    refused: BmeProtocolFailure...| >>
    clock_failed: ClockResult...| >>
) {
    protocol: bme280-exchange
    bus: machine/i2c/transact
    begin >> protocol.begin
    protocol.request >> bus.request
    bus.result >> protocol.result
    protocol.captured >> captured
    protocol.observation >> observation
    protocol.refused >> refused
    protocol.clock_failed >> clock_failed
}
