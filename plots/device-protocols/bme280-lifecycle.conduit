plot bme280-step-sample (
 input: BmeProtocolStep...| >> output: BmeProtocolStep...|
) = (.handled ? . : (.state.phase == 12 ? { state: (sequence/length(.event.bus.result.completed.input) == 1 ? ((.event.bus.result.completed.input.0 & 8) == 0 ? { address: .state.address, phase: 13, index: 0, polls: 0, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: .state.failure } : (.state.polls < 7 ? { address: .state.address, phase: .state.phase, index: .state.index, polls: .state.polls + 1, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: .state.failure } : { address: .state.address, phase: 15, index: .state.index, polls: .state.polls, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: timeout(unit) })) : { address: .state.address, phase: 15, index: .state.index, polls: .state.polls, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: malformed(unit) }), event: .event, handled: true } : (.state.phase == 13 ? { state: (sequence/length(.event.bus.result.completed.input) == 1 ? (.state.index < 8 ? (.state.index == 7 ? { address: .state.address, phase: 14, index: 0, polls: .state.polls, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: [(.state.index == 0 ? .event.bus.result.completed.input.0 : .state.sample.0), (.state.index == 1 ? .event.bus.result.completed.input.0 : .state.sample.1), (.state.index == 2 ? .event.bus.result.completed.input.0 : .state.sample.2), (.state.index == 3 ? .event.bus.result.completed.input.0 : .state.sample.3), (.state.index == 4 ? .event.bus.result.completed.input.0 : .state.sample.4), (.state.index == 5 ? .event.bus.result.completed.input.0 : .state.sample.5), (.state.index == 6 ? .event.bus.result.completed.input.0 : .state.sample.6), (.state.index == 7 ? .event.bus.result.completed.input.0 : .state.sample.7)], failure: .state.failure } : { address: .state.address, phase: .state.phase, index: .state.index + 1, polls: .state.polls, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: [(.state.index == 0 ? .event.bus.result.completed.input.0 : .state.sample.0), (.state.index == 1 ? .event.bus.result.completed.input.0 : .state.sample.1), (.state.index == 2 ? .event.bus.result.completed.input.0 : .state.sample.2), (.state.index == 3 ? .event.bus.result.completed.input.0 : .state.sample.3), (.state.index == 4 ? .event.bus.result.completed.input.0 : .state.sample.4), (.state.index == 5 ? .event.bus.result.completed.input.0 : .state.sample.5), (.state.index == 6 ? .event.bus.result.completed.input.0 : .state.sample.6), (.state.index == 7 ? .event.bus.result.completed.input.0 : .state.sample.7)], failure: .state.failure }) : { address: .state.address, phase: 15, index: .state.index, polls: .state.polls, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: unexpected(unit) }) : { address: .state.address, phase: 15, index: .state.index, polls: .state.polls, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: malformed(unit) }), event: .event, handled: true } : (.))))

plot bme280-step-finish (
 input: BmeProtocolStep...| >> output: BmeProtocolState...|
) = (.handled ? .state : { address: .state.address, phase: 15, index: .state.index, polls: .state.polls, deadline: .state.deadline, clock: (variant/is(.event, "tick") ? .event.tick : .event.bus.now), ready: true, first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: unexpected(unit) })

plot bme280-protocol-transition (
 transition: BmeProtocolTransition...| >> state: BmeProtocolState...|
) {
 transition >> bme280-step-begin() >> bme280-step-address() >> bme280-step-time() >> bme280-step-clock() >> bme280-step-bus() >> bme280-step-probe-reset() >> bme280-step-nvm-sleep() >> bme280-step-humidity-config() >> bme280-step-calibration() >> bme280-step-humidity-conversion() >> bme280-step-sample() >> bme280-step-finish() >> state
}
