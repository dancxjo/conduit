# Source-owned fixed-point observation assembly. Inputs are decoded wire values.
# Arithmetic remains checked I128. A failed stage cannot publish its numeric scratch.
# Units are explicit in the observation fields; disabled raw samples are refused.
type BmeObservationInput = {
    calibration: BmeCalibration
    sample: BmeRawSample
}
type BmeObservationFailure =
    none
    | malformed
    | sample-disabled
    | invalid-calibration
type BmeObservation = {
    temperature_centidegrees: I128
    pressure_q24_8_pa: I128
    humidity_q22_10_percent: I128
}
type BmeObservationResult =
    observation BmeObservation
    | unavailable BmeObservationFailure

type BmeObservationWork = {
    calibration: BmeCalibration
    sample: BmeRawSample
    fine: I128
    temperature: I128
    v1: I128
    v2: I128
    numerator: I128
    denominator: I128
    pressure: I128
    humidity: I128
    failure: BmeObservationFailure
}

plot bme280-observation-begin (
    input: BmeObservationInput >> output: BmeObservationWork
) = ({ calibration: .calibration, sample: .sample, fine: 0, temperature: 0, v1: 0, v2: 0, numerator: 0, denominator: 0, pressure: 0, humidity: 0, failure: (((((.sample.pressure < 0 || .sample.pressure > 1048575) || (.sample.temperature < 0 || .sample.temperature > 1048575)) || ((.sample.humidity < 0 || .sample.humidity > 65535) || ((.calibration.t1 < 0 || .calibration.t1 > 65535) || (.calibration.p1 < 0 || .calibration.p1 > 65535)))) || (((.calibration.h1 < 0 || .calibration.h1 > 255) || (.calibration.h3 < 0 || .calibration.h3 > 255)) || ((.calibration.t2 < -32768 || .calibration.t2 > 32767) || ((.calibration.t3 < -32768 || .calibration.t3 > 32767) || (.calibration.p2 < -32768 || .calibration.p2 > 32767))))) || ((((.calibration.p3 < -32768 || .calibration.p3 > 32767) || (.calibration.p4 < -32768 || .calibration.p4 > 32767)) || ((.calibration.p5 < -32768 || .calibration.p5 > 32767) || ((.calibration.p6 < -32768 || .calibration.p6 > 32767) || (.calibration.p7 < -32768 || .calibration.p7 > 32767)))) || (((.calibration.p8 < -32768 || .calibration.p8 > 32767) || ((.calibration.p9 < -32768 || .calibration.p9 > 32767) || (.calibration.h2 < -32768 || .calibration.h2 > 32767))) || ((.calibration.h4 < -2048 || .calibration.h4 > 2047) || ((.calibration.h5 < -2048 || .calibration.h5 > 2047) || (.calibration.h6 < -128 || .calibration.h6 > 127)))))) ? malformed(unit) : .sample.pressure == 524288 || .sample.temperature == 524288 || .sample.humidity == 32768 ? sample-disabled(unit) : (.calibration.p1 == 0 ? invalid-calibration(unit) : none(unit)) })

plot bme280-observation-fine (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: ((((.sample.temperature >>> 3) - (.calibration.t1 <<< 1)) * .calibration.t2) >>> 11) + (((((.sample.temperature >>> 4) - .calibration.t1) * ((.sample.temperature >>> 4) - .calibration.t1)) >>> 12) * .calibration.t3 >>> 14), temperature: .temperature, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: .pressure, humidity: .humidity, failure: .failure } : .)

plot bme280-observation-temperature (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: (.fine * 5 + 128) >>> 8, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: .pressure, humidity: .humidity, failure: .failure } : .)

plot bme280-observation-pressure-polynomial (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .fine - 128000, v2: (.fine - 128000) * (.fine - 128000) * .calibration.p6 + (((.fine - 128000) * .calibration.p5) <<< 17) + (.calibration.p4 <<< 35), numerator: .numerator, denominator: .denominator, pressure: .pressure, humidity: .humidity, failure: .failure } : .)

plot bme280-observation-pressure-division (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .v1, v2: .v2, numerator: (((1048576 - .sample.pressure) <<< 31) - .v2) * 3125, denominator: (((1 <<< 47) + ((.v1 * .v1 * .calibration.p3) >>> 8) + ((.v1 * .calibration.p2) <<< 12)) * .calibration.p1) >>> 33, pressure: .pressure, humidity: .humidity, failure: .failure } : .)

plot bme280-observation-pressure-check (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: .pressure, humidity: .humidity, failure: .denominator == 0 ? invalid-calibration(unit) : .failure } : .)

plot bme280-observation-pressure-quotient (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: .numerator / .denominator, humidity: .humidity, failure: .failure } : .)

plot bme280-observation-pressure-correction (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: ((.pressure + ((.calibration.p9 * (.pressure >>> 13) * (.pressure >>> 13)) >>> 25) + ((.calibration.p8 * .pressure) >>> 19)) >>> 8) + (.calibration.p7 <<< 4), humidity: .humidity, failure: .failure } : .)

plot bme280-observation-humidity-polynomial (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: .pressure, humidity: ((((.sample.humidity <<< 14) - (.calibration.h4 <<< 20) - .calibration.h5 * (.fine - 76800) + 16384) >>> 15) * (((((((.fine - 76800) * .calibration.h6) >>> 10) * ((((.fine - 76800) * .calibration.h3) >>> 11) + 32768)) >>> 10) + 2097152) * .calibration.h2 + 8192 >>> 14)), failure: .failure } : .)

plot bme280-observation-humidity-correction (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: .pressure, humidity: .humidity - (((((.humidity >>> 15) * (.humidity >>> 15)) >>> 7) * .calibration.h1) >>> 4), failure: .failure } : .)

plot bme280-observation-humidity-clamp (
    input: BmeObservationWork >> output: BmeObservationWork
) = (variant/is(.failure, "none") ? { calibration: .calibration, sample: .sample, fine: .fine, temperature: .temperature, v1: .v1, v2: .v2, numerator: .numerator, denominator: .denominator, pressure: .pressure, humidity: .humidity < 0 ? (.humidity & 0) : (.humidity > 419430400 ? ((.humidity & 0) + 102400) : .humidity >>> 12), failure: .failure } : .)

plot bme280-observation-finish (
    input: BmeObservationWork >> result: BmeObservationResult
) = (variant/is(.failure, "none") ? observation({ temperature_centidegrees: .temperature, pressure_q24_8_pa: .pressure, humidity_q22_10_percent: .humidity }) : unavailable(.failure))

plot bme280-observation (
    input: BmeObservationInput >> result: BmeObservationResult
) {
    begin: bme280-observation-begin
    fine: bme280-observation-fine
    temperature: bme280-observation-temperature
    pressure-polynomial: bme280-observation-pressure-polynomial
    pressure-division: bme280-observation-pressure-division
    pressure-check: bme280-observation-pressure-check
    pressure-quotient: bme280-observation-pressure-quotient
    pressure-correction: bme280-observation-pressure-correction
    humidity-polynomial: bme280-observation-humidity-polynomial
    humidity-correction: bme280-observation-humidity-correction
    humidity-clamp: bme280-observation-humidity-clamp
    finish: bme280-observation-finish
    input >> begin >> fine >> temperature >> pressure-polynomial >> pressure-division >> pressure-check >> pressure-quotient >> pressure-correction >> humidity-polynomial >> humidity-correction >> humidity-clamp >> finish >> result
}
