# One finite init/frame, no retries or implicit pixel generation.
# Monotonic clock units are milliseconds. Every action completion echoes its ordinal.
# A chunk event is accepted only in phase5, at its exact zero-based frame index.
plot st7789-protocol-initialize (
    begin: St7789Begin...| >> state: St7789State...|
) = ({ bank: .bank, wire: bytes/window(.bank, 0, 0), phase: ((bytes/length(.bank) != 20 ? false : (((((bytes/at(.bank, 0) == 1 && bytes/at(.bank, 1) == 17) && (bytes/at(.bank, 2) == 58 && (bytes/at(.bank, 3) == 85 && bytes/at(.bank, 4) == 54))) && ((bytes/at(.bank, 5) == 192 && bytes/at(.bank, 6) == 33) && (bytes/at(.bank, 7) == 19 && (bytes/at(.bank, 8) == 41 && bytes/at(.bank, 9) == 42)))) && (((bytes/at(.bank, 10) == 0 && bytes/at(.bank, 11) == 0) && (bytes/at(.bank, 12) == 0 && (bytes/at(.bank, 13) == 239 && bytes/at(.bank, 14) == 43))) && ((bytes/at(.bank, 15) == 0 && bytes/at(.bank, 16) == 80) && (bytes/at(.bank, 17) == 1 && (bytes/at(.bank, 18) == 63 && bytes/at(.bank, 19) == 44))))))) ? 0 : 9), step: 0, chunks: 0, ordinal: 0, clock: 0, deadline: 0, delay: 0, failure: ((bytes/length(.bank) != 20 ? false : (((((bytes/at(.bank, 0) == 1 && bytes/at(.bank, 1) == 17) && (bytes/at(.bank, 2) == 58 && (bytes/at(.bank, 3) == 85 && bytes/at(.bank, 4) == 54))) && ((bytes/at(.bank, 5) == 192 && bytes/at(.bank, 6) == 33) && (bytes/at(.bank, 7) == 19 && (bytes/at(.bank, 8) == 41 && bytes/at(.bank, 9) == 42)))) && (((bytes/at(.bank, 10) == 0 && bytes/at(.bank, 11) == 0) && (bytes/at(.bank, 12) == 0 && (bytes/at(.bank, 13) == 239 && bytes/at(.bank, 14) == 43))) && ((bytes/at(.bank, 15) == 0 && bytes/at(.bank, 16) == 80) && (bytes/at(.bank, 17) == 1 && (bytes/at(.bank, 18) == 63 && bytes/at(.bank, 19) == 44))))))) ? 0 : 1) })

plot st7789-step-begin (
    input: St7789Transition...| >> output: St7789Step...|
) = (.state.phase == 10 ? { state: .state, event: .event, handled: true } : (.event.ordinal != .state.ordinal ? { state: { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 2 }, event: .event, handled: true } : (.state.ordinal >= 4096 && .state.phase != 9 ? { state: { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 1 }, event: .event, handled: true } : { state: .state, event: .event, handled: false })))

plot st7789-step-safe-off (
    input: St7789Step...| >> output: St7789Step...|
) = (.handled ? . : (.state.phase == 9 ? { state: (.event.outcome is backlight ? (.event.outcome.backlight is completed ? (!.event.outcome.backlight.completed.high ? { bank: .state.bank, wire: .state.wire, phase: 10, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: .state.failure } : { bank: .state.bank, wire: .state.wire, phase: 10, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: (.event.outcome.backlight is completed ? 40 : (.event.outcome.backlight is unsupported ? 41 : (.event.outcome.backlight is provider-lost ? 42 : 43))) }) : { bank: .state.bank, wire: .state.wire, phase: 10, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: (.event.outcome.backlight is completed ? 40 : (.event.outcome.backlight is unsupported ? 41 : (.event.outcome.backlight is provider-lost ? 42 : 43))) }) : { bank: .state.bank, wire: .state.wire, phase: 10, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 3 }), event: .event, handled: true } : .))

plot st7789-step-backlight (
    input: St7789Step...| >> output: St7789Step...|
) = (.handled ? . : (.state.phase == 0 || .state.phase == 7 ? { state: (.event.outcome is backlight ? (.event.outcome.backlight is completed ? (.event.outcome.backlight.completed.high == (.state.phase == 7) ? { bank: .state.bank, wire: .state.wire, phase: (.state.phase == 0 ? 1 : (.state.phase == 7 ? 8 : 10)), step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal + 1, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: .state.failure } : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 13 }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: (.event.outcome.backlight is unsupported ? 10 : (.event.outcome.backlight is provider-lost ? 11 : 12)) }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 3 }), event: .event, handled: true } : .))

plot st7789-step-command-data (
    input: St7789Step...| >> output: St7789Step...|
) = (.handled ? . : (.state.phase == 1 ? { state: (.event.outcome is command-data ? (.event.outcome.command-data is completed ? (.event.outcome.command-data.completed.high == (.state.step == 3 || .state.step == 5 || .state.step == 10 || .state.step == 12 || .state.step == 14) ? { bank: .state.bank, wire: .state.wire, phase: (.state.step == 14 ? 5 : 2), step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal + 1, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: .state.failure } : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 13 }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: (.event.outcome.command-data is unsupported ? 10 : (.event.outcome.command-data is provider-lost ? 11 : 12)) }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 3 }), event: .event, handled: true } : .))

plot st7789-step-spi (
    input: St7789Step...| >> output: St7789Step...|
) = (.handled ? . : (.state.phase == 2 || .state.phase == 6 ? { state: (.event.outcome is spi ? (.event.outcome.spi is completed ? (bytes/length(.event.outcome.spi.completed.input) == (.state.phase == 6 ? 512 : (.state.step == 10 || .state.step == 12 ? 4 : 1)) ? (.state.phase == 6 ? { bank: .state.bank, wire: .state.wire, phase: (.state.chunks == 224 ? 7 : 5), step: .state.step, chunks: .state.chunks + 1, ordinal: .state.ordinal + 1, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: .state.failure } : ((.state.step == 0 || .state.step == 1 || .state.step == 3 || .state.step == 7 || .state.step == 8) ? { bank: .state.bank, wire: .state.wire, phase: 3, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal + 1, clock: .state.clock, deadline: .state.deadline, delay: (.state.step == 0 ? 150 : (.state.step == 1 || .state.step == 8 ? 500 : 10)), failure: .state.failure } : { bank: .state.bank, wire: .state.wire, phase: 1, step: .state.step + 1, chunks: .state.chunks, ordinal: .state.ordinal + 1, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: .state.failure })) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 1 }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: (.event.outcome.spi is timed-out ? 30 : (.event.outcome.spi is provider-lost ? 31 : (.event.outcome.spi is unsupported ? 32 : (.event.outcome.spi is stale-attachment ? 33 : 34)))) }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 3 }), event: .event, handled: true } : .))

plot st7789-step-clock (
    input: St7789Step...| >> output: St7789Step...|
) = (.handled ? . : (.state.phase == 3 || .state.phase == 4 ? { state: (.event.outcome is clock ? (.event.outcome.clock is completed ? (.event.outcome.clock.completed >= .state.clock ? (.state.phase == 3 ? (.event.outcome.clock.completed <= 18446744073709551115 ? { bank: .state.bank, wire: .state.wire, phase: 4, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal + 1, clock: .event.outcome.clock.completed, deadline: .event.outcome.clock.completed + .state.delay, delay: .state.delay, failure: .state.failure } : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 1 }) : (.event.outcome.clock.completed >= .state.deadline ? { bank: .state.bank, wire: .state.wire, phase: 1, step: .state.step + 1, chunks: .state.chunks, ordinal: .state.ordinal + 1, clock: .event.outcome.clock.completed, deadline: 0, delay: 0, failure: .state.failure } : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 1 })) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 2 }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: (.event.outcome.clock is unavailable ? 20 : (.event.outcome.clock is provider-lost ? 21 : (.event.outcome.clock is unsupported-deadline ? 22 : (.event.outcome.clock is malformed ? 23 : 24)))) }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 3 }), event: .event, handled: true } : .))

plot st7789-step-chunk (
    input: St7789Step...| >> output: St7789Step...|
) = (.handled ? . : (.state.phase == 5 ? { state: (.event.outcome is chunk ? (.state.chunks < 225 && .event.outcome.chunk.index == .state.chunks && bytes/length(.event.outcome.chunk.wire) == 512 ? { bank: .state.bank, wire: .event.outcome.chunk.wire, phase: 6, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal + 1, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: .state.failure } : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 1 }) : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 3 }), event: .event, handled: true } : .))

plot st7789-step-finish (
    input: St7789Step...| >> output: St7789State...|
) = (.handled ? .state : { bank: .state.bank, wire: .state.wire, phase: 9, step: .state.step, chunks: .state.chunks, ordinal: .state.ordinal, clock: .state.clock, deadline: .state.deadline, delay: .state.delay, failure: 3 })

plot st7789-protocol-transition (
    transition: St7789Transition...| >> state: St7789State...|
) {
    transition >> st7789-step-begin() >> st7789-step-safe-off() >> st7789-step-backlight() >> st7789-step-command-data() >> st7789-step-spi() >> st7789-step-clock() >> st7789-step-chunk() >> st7789-step-finish() >> state
}
