plot greet (
    greeting: Text = "Welcome"
    name: Text >> text: Text
) {
    join: text/join(greeting)
    name >> join >> text
}

plot default-welcome {
    hello: greet
    literal: text/literal("Hello")
    show: face/text("Welcome message")

    "Travis" >> hello >> face/text("Welcome message")
    literal.text >> show.text
}
