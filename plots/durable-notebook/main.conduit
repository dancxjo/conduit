plot durable-note (
    >> write: Text <= 4KiB
    >> save-request: SaveRequest...
    current: $Text <= 4KiB >>
    saved: &Text... >>
    loaded: Text >>
    save-failed: data/save-text-terminal@c9caf46f9958aa5b274309038c97d1bfb003fa64b48e043cf71cfcc57364994d >>
    load-failed: data/load-text-terminal@ff523b61dc5d92d3547903df737494fa74567db1a70581be1b70b9ea7048bb6e >>
) {
    note: keep Text("") <= 4KiB for life
    save: data/save/text
    load: data/load/text

    write >> note
    note >> current

    note @ save-request >> save.value
    save.data >> saved
    save.data! >> save-failed
    save.data >> load.data
    load.value >> loaded
    load.value! >> load-failed
}
