# Reusable minimal evolution from explicit prior state and clock observation.
plot garden-state-step (
    >> prior: GardenState
    >> clock: GardenClockObservation
    next: GardenState >>
) {
    evolve: state/garden-step
    prior >> evolve.prior
    clock >> evolve.clock
    evolve.next >> next
}

# Contact enrichment is a second exact front, not an optional or erased input.
plot garden-state-step-contact (
    >> prior: GardenState
    >> clock: GardenClockObservation
    >> contact: GardenContactObservation
    next: GardenState >>
) {
    combine: observation/garden-clock-contact
    evolve: state/garden-step-enriched-reducer
    prior >> evolve.prior
    clock >> combine.clock
    contact >> combine.contact
    combine.observation >> evolve.observation
    evolve.next >> next
}

# A meaningful minimal Garden has only its explicitly required clock source.
plot signal-garden-minimal (
    state: GardenState >>
) {
    observations: garden/deterministic-observations
    evolve: garden-state-step
    observations.prior >> evolve.prior
    observations.clock >> evolve.clock
    evolve.next >> state
}

# Contact enriches the same state family through a distinct mandatory typed port.
plot signal-garden-interactive (
    state: GardenState >>
) {
    observations: garden/deterministic-observations
    evolve: garden-state-step-contact
    observations.prior >> evolve.prior
    observations.clock >> evolve.clock
    observations.contact >> evolve.contact
    evolve.next >> state
}

# Presentation consumes the semantic state after evolution and does not own the reducer.
plot signal-garden-interactive-display {
    # Transactional display specimen: one admitted Garden transition.
    observations: garden/deterministic-observations
    evolve: garden-state-step-contact
    show: presentation/garden-state
    observations.prior >> evolve.prior
    observations.clock >> evolve.clock
    observations.contact >> evolve.contact
    evolve.next >> show.state
}.
