plot house-spoken-response (
    >> detection: AddressDetection
    >> context: HouseContext
    response: Text >>
) {
    conversation: house-conversation
    synthesize: speech/synthesize(language-request = { language: "language/english", variety: none(""), variety_policy: language_sufficient("") }, maximum-output-bytes = 32768)
    speaker: audio/play

    detection >> conversation.detection
    context >> conversation.context
    conversation.response >> response
    conversation.response >> synthesize.text
    synthesize.audio >> speaker.audio
}
