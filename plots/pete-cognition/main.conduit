# Current explicit evidence drives one bounded interpretation per committed update.
# Autobiographical selection and feedback join this Plot through typed Cords.
plot pete-cognition (
    >> updates: ExperienceIntegrationUpdate...|
    responses: PeteCognitionResponse...| >>
) {
    experience: experience/integrate-current
    evidence: experience/project-evidence-flow
    context: experience/context-to-prompt
    interpretation: llm/generate-flow(maximum-input-bytes = 4096, maximum-context-items = 1, maximum-output-bytes = 512, maximum-work-units = 4096, maximum-history-items = 0)

    updates >> experience.update
    experience.request >> evidence.request
    evidence.context >> context.context
    context.request >> interpretation.request
    interpretation.result >> responses
}
