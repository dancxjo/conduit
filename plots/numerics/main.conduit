# One exact source with independently declared consumer precision.
plot numerics {
    exact: math/realize(request={value:0.3,maximum-error:0})
    loose: math/realize(request={value:0.3,maximum-error:1})
    exact-show: face/numerical-result("Exact numerical result")
    loose-show: face/numerical-result("Approximate numerical result")
    exact.result >> exact-show.input
    loose.result >> loose-show.input
}.
