# Bench consumes the reviewed bounded measurement-plot Back. Device decoding,
# windowing, thresholding, acquisition, recording, commands, and presentation
# remain separate Plots and Host truth; this slice owns one telemetry component.
plot bench-telemetry (
    >> window: MeasurementWindow
    series: MeasurementPlotSeries >>
) {
    plot: data/bounded-measurement-plot

    window >> plot.window
    plot.series >> series
}
