plot experience-response (
    >> evidence: ExperienceEvidenceRequest...|
    responses: ExperienceModelResult...| >>
) {
    prepare: experience/prepare-model-request
    model: llm/generate-flow(maximum-input-bytes = 4096, maximum-context-items = 1, maximum-output-bytes = 2560, maximum-work-units = 4096, maximum-history-items = 0)

    evidence >> prepare.evidence
    prepare.request >> model.request
    model.result >> responses
}
