# Canonical external WebSocket client front. The demo root supplies a concrete
# local address; host admission still decides whether it can be realized.
plot echo-client (
    url: Url
    >> send: WebSocketMessage...|
    recv: WebSocketMessage...| >>
    live: $Boolean >>
) {
    sock: net/websocket(url)
    send >> sock.send
    sock.recv >> recv
    sock.live >> live
}

plot echo-client-demo {
    client: echo-client("ws://127.0.0.1:4178")
}
