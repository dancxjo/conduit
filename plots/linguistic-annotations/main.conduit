plot linguistic-annotations (
    label: LinguisticLabel >>
) {
    tokenize: language/tokenize-four(material = { identity: "text/linguistic-specimen", language: "language/english", revision: "source/1", text: "Bright stars shine." })
    annotate: language/annotate-four(language-request = { language: "language/english", variety: none(""), variety_policy: language_sufficient("") })
    tokenize.tokens >> annotate.tokens
    annotate.annotations >> project(AnnotationBundleFour.annotations) >> index(LinguisticAnnotationsFour[0]) >> project(LinguisticAnnotation.label) >> label
}
