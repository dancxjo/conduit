+    .unwrap();
+    let entry = LanguageLexicalEntry::new(
+        BoundedSequence::try_from_iter([LanguageLexicalCandidate::new(
+            "hello".into(),
+            BoundedSequence::new(),
+            LanguageLexicalPos::Interjection,
+        )
+        .unwrap()])
+        .unwrap(),
+        "Hello".into(),
+    )
+    .unwrap();
+    let profile = LanguageLexicalProfile::new(
