new file mode 100644
index 000000000..70c4b9595
--- /dev/null
+++ b/semantics/language/src/analysis_round_machine.rs
@@ -0,0 +1,310 @@
+//! The existing bounded round ordering, with canonical registers instead of Native clones.
+use super::{material::*, storage::*, *};
+use alloc::vec::Vec;
+use conduit_core::*;
+use conduit_plot::rust_binding::NativeRustBinding;
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum Phase {
+    Seed,
+    SeedAdmit,
+    Slot,
+    Complete,
+    ProbeProposal,
+    ProbeTransition,
+    Mask,
+    Choice,
+    Branch,
+    BranchAdmit,
+    Score,
+    Features,
+    Numerical,
+    LearnedRank,
+    Rank,
+    RankedProposal,
+    Transition,
+    Expand,
+    CandidateAdmit,
+    Merge,
+    NextRank,
+    Done,
+}
+#[derive(Clone, Copy)]
+pub(super) enum Work {
+    Source(&'static str, &'static str, Option<&'static str>),
+    Native(&'static str),
+    Numerical,
+    Complete,
+}
+pub(super) struct Machine {
+    phase: Phase,
+    slot: usize,
+    choice: u64,
+    probe: usize,
+    ranked: usize,
+    complete_merge: bool,
+    pub identity: u64,
+    pub invocation: u64,
+    pub mode: AnalysisRoundMode,
+    pub prior_beam: Vec<u8>,
+    pub lexical: Vec<u8>,
+    pub initial_raw: Vec<u8>,
+    pub query: Vec<u8>,
+    pub next: Vec<u8>,
+    prior: Vec<u8>,
+    branch: Vec<u8>,
+    mask: Vec<u8>,
+    rank: Vec<u8>,
+    proposal: Vec<u8>,
+    result: Vec<u8>,
+    raw: Vec<u8>,
+    candidate: Vec<u8>,
+    numeric: Vec<u8>,
+    scalar: Vec<u8>,
+    slots: [Vec<u8>; 4],
+    probes: [Vec<u8>; 5],
+    zero: Vec<u8>,
+    zero_i64: Vec<u8>,
+    false_value: Vec<u8>,
+    relation: Vec<u8>,
+    pub features: Vec<u8>,
+    pub feature_query: Vec<u8>,
+    pub numerical_input: Vec<u8>,
+    pub numerical_scores: Vec<u8>,
+}
+impl Machine {
+    pub fn prepare(
+        owner: &AnalysisEpochOwner<'_>,
+        mode: AnalysisRoundMode,
+        invocation: u64,
+    ) -> R<Self> {
+        let lexical = LanguageParserAvailableLexical::new(
+            owner.lexical().tape().clone(),
+            *owner.beam().candidate0().parser().state().token_count(),
+        )
+        .map_err(|_| CursorRefusal::Preparation)?
+        .encode()
+        .map_err(|_| CursorRefusal::Preparation)?;
+        let prior_beam = owner
+            .beam()
+            .clone()
+            .encode()
+            .map_err(|_| CursorRefusal::Preparation)?;
+        let initial_raw = super::super::raw_beam(owner.beam())
+            .map_err(|_| CursorRefusal::Preparation)?
+            .encode()
+            .map_err(|_| CursorRefusal::Preparation)?;
+        if [lexical.len(), prior_beam.len(), initial_raw.len()]
+            .into_iter()
+            .any(|v| v > BYTES)
+        {
+            return Err(CursorRefusal::Bounds);
+        }
+        Ok(Self {
+            phase: Phase::Seed,
+            slot: 0,
+            choice: 0,
+            probe: 0,
+            ranked: 0,
+            complete_merge: false,
+            identity: owner.identity_cursor,
+            invocation,
+            mode,
+            lexical,
+            prior_beam,
+            initial_raw,
+            query: buffer(),
+            next: buffer(),
+            prior: buffer(),
+            branch: buffer(),
+            mask: buffer(),
+            rank: buffer(),
+            proposal: buffer(),
+            result: buffer(),
+            raw: buffer(),
+            candidate: buffer(),
+            numeric: buffer(),
+            scalar: buffer(),
+            slots: core::array::from_fn(|_| buffer()),
+            probes: core::array::from_fn(|_| buffer()),
+            zero: scalar("value/u64", &0u64)?,
+            zero_i64: scalar("value/i64", &0i64)?,
+            false_value: scalar("value/bool", &false)?,
+            relation: LanguageParserRelation::new(
+                LanguageUniversalDependencyRelation::Dep,
+                LanguageParserSubtype::new(String::new())
+                    .map_err(|_| CursorRefusal::Preparation)?,
+            )
+            .map_err(|_| CursorRefusal::Preparation)?
+            .encode()
+            .map_err(|_| CursorRefusal::Preparation)?,
+            features: buffer(),
+            feature_query: buffer(),
+            numerical_input: buffer(),
+            numerical_scores: buffer(),
+        })
+    }
+    pub fn branch_identity(&self) -> (usize, u64) {
+        (self.slot, self.choice)
+    }
+    fn alternative_count(&self) -> R<u64> {
+        Ok(
+            if number(member(&self.prior, &["parser", "state", "unread"])?)?
+                < number(member(&self.lexical, &["token_count"])?)?
+            {
+                4
+            } else {
+                1
+            },
+        )
+    }
+    fn next_choice(&mut self) -> R<()> {
+        self.choice += 1;
+        if self.choice >= self.alternative_count()? {
+            self.slot += 1;
+            self.phase = Phase::Slot;
+        } else {
+            self.phase = Phase::Choice;
+        }
+        Ok(())
+    }
+    pub fn native_complete(&mut self) -> R<()> {
+        use Phase::*;
+        match self.phase {
+            SeedAdmit => {
+                put(&mut self.next, &self.query)?;
+                self.phase = Slot;
+            }
+            BranchAdmit => {
+                put(&mut self.branch, &self.query)?;
+                self.phase = Score;
+            }
+            CandidateAdmit => {
+                put(&mut self.candidate, &self.query)?;
+                self.complete_merge = false;
+                self.phase = Merge;
+            }
+            LearnedRank => {
+                put(&mut self.rank, &self.query)?;
+                self.phase = Rank;
+            }
+            _ => return Err(CursorRefusal::Lifecycle),
+        }
+        Ok(())
+    }
+    pub fn receive(&mut self, bytes: &[u8]) -> R<()> {
+        use Phase::*;
+        match self.phase {
+            Seed => {
+                put(&mut self.raw, bytes)?;
+                self.phase = SeedAdmit;
+            }
+            Complete => match bytes {
+                [1] => {
+                    put(&mut self.candidate, &self.prior)?;
+                    self.complete_merge = true;
+                    self.phase = Merge;
+                }
+                [0] => self.phase = ProbeProposal,
+                _ => return Err(CursorRefusal::Canonical),
+            },
+            ProbeProposal => {
+                put(&mut self.proposal, bytes)?;
+                self.phase = ProbeTransition;
+            }
+            RankedProposal => {
+                put(&mut self.proposal, bytes)?;
+                self.phase = Transition;
+            }
+            ProbeTransition => {
+                put(&mut self.probes[self.probe], bytes)?;
+                self.probe += 1;
+                self.phase = if self.probe == 5 { Mask } else { ProbeProposal };
+            }
+            Mask => {
+                put(&mut self.mask, bytes)?;
+                self.phase = Choice;
+            }
+            Branch => {
+                put(&mut self.raw, bytes)?;
+                if boolean(member(bytes, &["accepted"])?)? {
+                    self.phase = BranchAdmit;
+                } else {
+                    self.next_choice()?;
+                }
+            }
+            Score => {
+                put(&mut self.rank, bytes)?;
+                self.phase = Rank;
+            }
+            Features => {
+                put(&mut self.features, bytes)?;
+                self.phase = Numerical;
+            }
+            Rank => {
+                put(&mut self.rank, bytes)?;
+                if boolean(member(bytes, &["found"])?)? {
+                    self.phase = RankedProposal;
+                } else {
+                    self.next_choice()?;
+                }
+            }
+            Transition => {
+                put(&mut self.result, bytes)?;
+                self.identity = self.identity.checked_add(1).ok_or(CursorRefusal::Bounds)?;
+                self.phase = Expand;
+            }
+            Expand => {
+                put(&mut self.raw, bytes)?;
+                if boolean(member(bytes, &["parser", "active"])?)? {
+                    self.phase = CandidateAdmit;
+                } else {
+                    self.phase = NextRank;
+                }
+            }
+            Merge => {
+                put(&mut self.next, bytes)?;
+                if self.complete_merge {
+                    self.slot += 1;
+                    self.phase = Slot;
+                } else {
+                    self.phase = NextRank;
+                }
+            }
+            NextRank => {
+                put(&mut self.rank, bytes)?;
+                self.ranked += 1;
+                if self.ranked == 4 {
+                    self.next_choice()?;
+                } else {
+                    self.phase = Rank;
+                }
+            }
+            _ => return Err(CursorRefusal::Lifecycle),
+        }
+        Ok(())
+    }
+    pub fn numerical_complete(&mut self) -> R<()> {
+        if self.phase != Phase::Numerical {
+            return Err(CursorRefusal::Lifecycle);
+        }
+        self.invocation = self
+            .invocation
+            .checked_add(1)
+            .ok_or(CursorRefusal::Bounds)?;
+        self.phase = Phase::LearnedRank;
+        Ok(())
+    }
+}
+
+fn scalar<T: conduit_plot::rust_binding::NativePrimitive>(kind: &str, value: &T) -> R<Vec<u8>> {
+    conduit_plot::rust_binding::primitive_into_structured(
+        StructuredInfoType::leaf(kind_id(kind)).map_err(|_| CursorRefusal::Preparation)?,
+        value,
+    )
+    .map_err(|_| CursorRefusal::Preparation)?
+    .canonical_bytes()
+    .map_err(|_| CursorRefusal::Preparation)
+}
+
+#[path = "analysis_round_build.rs"]
+mod build;
diff --git a/semantics/language/src/analysis_round_build.rs b/semantics/language/src/analysis_round_build.rs
new file mode 100644
index 000000000..ce1dc04cd
--- /dev/null
+++ b/semantics/language/src/analysis_round_build.rs
@@ -0,0 +1,258 @@
+//! Canonical query construction for the one retained round machine.
+use super::*;
+impl Machine {
+    fn scored(&mut self, mat: &mut Materializer, probe: bool) -> R<()> {
+        let prior = if probe { &self.prior } else { &self.branch };
+        mat.numeric(member(prior, &["parser", "state"])?, &mut self.numeric)?;
+        if probe {
+            mat.unsigned([0, 1, 2, 39, 73][self.probe], &mut self.scalar)?;
+        }
+        let score = if probe {
+            view(&self.zero_i64)?
+        } else {
+            member(&self.rank, &["score"])?
+        };
+        mat.record(
+            "LanguageParserScoredClass",
+            &[
+                ("basis", member(prior, &["parser", "state", "basis"])?),
+                (
+                    "class",
+                    if probe {
+                        view(&self.scalar)?
+                    } else {
+                        member(&self.rank, &["class"])?
+                    },
+                ),
+                ("default_relation", view(&self.relation)?),
+                ("score", score),
+                ("state", view(&self.numeric)?),
+            ],
+            &mut self.query,
+        )
+    }
+    pub fn build(&mut self, mat: &mut Materializer) -> R<Work> {
+        use Phase::*;
+        loop {
+            match self.phase {
+                Seed => {
+                    put(&mut self.query, &self.initial_raw)?;
+                    return Ok(Work::Source(
+                        "language/analysis-round-empty",
+                        "LanguageAnalysisInitialRawBeam",
+                        Some("LanguageAnalysisInitialRawBeam"),
+                    ));
+                }
+                SeedAdmit => {
+                    let raw = view(&self.raw)?;
+                    for (index, name) in ["candidate0", "candidate1", "candidate2", "candidate3"]
+                        .into_iter()
+                        .enumerate()
+                    {
+                        mat.hypothesis(field(raw, name)?, &mut self.slots[index])?;
+                    }
+                    mat.record(
+                        "LanguageParserScorerBeam",
+                        &[
+                            ("candidate0", view(&self.slots[0])?),
+                            ("candidate1", view(&self.slots[1])?),
+                            ("candidate2", view(&self.slots[2])?),
+                            ("candidate3", view(&self.slots[3])?),
+                        ],
+                        &mut self.query,
+                    )?;
+                    return Ok(Work::Native("LanguageParserScorerBeam"));
+                }
+                Slot => {
+                    if self.slot == 4 {
+                        self.phase = Done;
+                        continue;
+                    }
+                    let name = ["candidate0", "candidate1", "candidate2", "candidate3"][self.slot];
+                    let prior = member(&self.prior_beam, &[name])?;
+                    if !boolean(field(field(prior, "parser")?, "active")?)? {
+                        self.slot += 1;
+                        continue;
+                    }
+                    copy_value(&mut self.prior, prior)?;
+                    self.choice = 0;
+                    self.probe = 0;
+                    self.phase = Complete;
+                }
+                Complete => {
+                    copy_value(&mut self.query, member(&self.prior, &["parser", "state"])?)?;
+                    return Ok(Work::Source(
+                        "language-parser-decode-complete",
+                        "LanguageParserState",
+                        None,
+                    ));
+                }
+                ProbeProposal | RankedProposal => {
+                    self.scored(mat, self.phase == ProbeProposal)?;
+                    return Ok(Work::Source(
+                        "language-parser-score-proposal",
+                        "LanguageParserScoredClass",
+                        Some("LanguageParserScoredProposal"),
+                    ));
+                }
+                ProbeTransition | Transition => {
+                    copy_value(&mut self.query, member(&self.proposal, &["request"])?)?;
+                    return Ok(Work::Source(
+                        "language-parser-transition",
+                        "LanguageParserRequest",
+                        Some("LanguageParserResult"),
+                    ));
+                }
+                Mask => {
+                    mat.record(
+                        "LanguageParserScorerLegality",
+                        &[
+                            ("basis", member(&self.prior, &["parser", "state", "basis"])?),
+                            ("left", view(&self.probes[2])?),
+                            ("reduce", view(&self.probes[1])?),
+                            ("right", view(&self.probes[3])?),
+                            ("root", view(&self.probes[4])?),
+                            ("shift", view(&self.probes[0])?),
+                        ],
+                        &mut self.query,
+                    )?;
+                    return Ok(Work::Source(
+                        "language-parser-scorer-legality",
+                        "LanguageParserScorerLegality",
+                        Some("LanguageParserScorerRanking"),
+                    ));
+                }
+                Choice => {
+                    self.ranked = 0;
+                    if self.alternative_count()? == 1 {
+                        put(&mut self.branch, &self.prior)?;
+                        self.phase = Score;
+                        continue;
+                    }
+                    mat.unsigned(self.choice, &mut self.scalar)?;
+                    mat.record(
+                        "LanguageParserScorerBranch",
+                        &[
+                            ("choice", view(&self.scalar)?),
+                            ("lexical", view(&self.lexical)?),
+                            ("prior", view(&self.prior)?),
+                        ],
+                        &mut self.query,
+                    )?;
+                    self.phase = Branch;
+                    return Ok(Work::Source(
+                        "language-parser-scorer-branch",
+                        "LanguageParserScorerBranch",
+                        Some("LanguageParserScorerBranchResult"),
+                    ));
+                }
+                BranchAdmit => {
+                    mat.hypothesis(member(&self.raw, &["candidate"])?, &mut self.query)?;
+                    return Ok(Work::Native("LanguageParserScorerHypothesis"));
+                }
+                Score => {
+                    if self.mode == AnalysisRoundMode::AuthenticatedCategorical {
+                        self.phase = Features;
+                        continue;
+                    }
+                    put(&mut self.query, &self.mask)?;
+                    return Ok(Work::Source(
+                        "language-parser-scorer-fallback",
+                        "LanguageParserScorerRanking",
+                        Some("LanguageParserScorerRanking"),
+                    ));
+                }
+                Features => {
+                    mat.unsigned(self.invocation, &mut self.scalar)?;
+                    mat.record(
+                        "LanguageParserScorerChoiceQuery",
+                        &[
+                            ("choices", member(&self.branch, &["choices"])?),
+                            (
+                                "epoch",
+                                member(&self.lexical, &["tape", "source", "sequence"])?,
+                            ),
+                            ("invocation", view(&self.scalar)?),
+                            ("lexical", view(&self.lexical)?),
+                            ("state", member(&self.branch, &["parser", "state"])?),
+                        ],
+                        &mut self.query,
+                    )?;
+                    put(&mut self.feature_query, &self.query)?;
+                    return Ok(Work::Source(
+                        "language-parser-scorer-model-features",
+                        "LanguageParserScorerChoiceQuery",
+                        Some("LanguageParserScorerFeatures"),
+                    ));
+                }
+                Numerical => return Ok(Work::Numerical),
+                LearnedRank => {
+                    mat.record(
+                        "LanguageParserScorerRanking",
+                        &[
+                            ("allowed", member(&self.mask, &["allowed"])?),
+                            ("class", view(&self.zero)?),
+                            ("cursor", view(&self.zero)?),
+                            ("found", view(&self.false_value)?),
+                            ("score", member(&self.mask, &["score"])?),
+                            ("scores", view(&self.numerical_scores)?),
+                        ],
+                        &mut self.query,
+                    )?;
+                    return Ok(Work::Native("LanguageParserScorerRanking"));
+                }
+                Rank | NextRank => {
+                    put(&mut self.query, &self.rank)?;
+                    return Ok(Work::Source(
+                        if self.phase == Rank {
+                            "language-parser-scorer-rank"
+                        } else {
+                            "language-parser-scorer-ranking-next"
+                        },
+                        "LanguageParserScorerRanking",
+                        Some("LanguageParserScorerRanking"),
+                    ));
+                }
+                Expand => {
+                    mat.unsigned(self.identity, &mut self.scalar)?;
+                    mat.record(
+                        "LanguageParserScorerExpansion",
+                        &[
+                            ("identity", view(&self.scalar)?),
+                            ("prior", view(&self.branch)?),
+                            ("result", view(&self.result)?),
+                            ("score", member(&self.rank, &["score"])?),
+                        ],
+                        &mut self.query,
+                    )?;
+                    return Ok(Work::Source(
+                        "language-parser-scorer-expand",
+                        "LanguageParserScorerExpansion",
+                        Some("LanguageParserScorerRawHypothesis"),
+                    ));
+                }
+                CandidateAdmit => {
+                    mat.hypothesis(view(&self.raw)?, &mut self.query)?;
+                    return Ok(Work::Native("LanguageParserScorerHypothesis"));
+                }
+                Merge => {
+                    mat.record(
+                        "LanguageParserScorerMerge",
+                        &[
+                            ("beam", view(&self.next)?),
+                            ("candidate", view(&self.candidate)?),
+                        ],
+                        &mut self.query,
+                    )?;
+                    return Ok(Work::Source(
+                        "language-parser-scorer-merge",
+                        "LanguageParserScorerMerge",
+                        Some("LanguageParserScorerBeam"),
+                    ));
+                }
+                Done => return Ok(Work::Complete),
+                Branch => return Err(CursorRefusal::Lifecycle),
+            }
+        }
+    }
+}
diff --git a/semantics/language/src/analysis_round_numeric.rs b/semantics/language/src/analysis_round_numeric.rs
new file mode 100644
index 000000000..3650cdac0
--- /dev/null
+++ b/semantics/language/src/analysis_round_numeric.rs
@@ -0,0 +1,413 @@
+//! Opt-in ordinary-kernel numerical dispatch; no public score/token acceptance entrance.
+use super::super::learned::ParserRoundModel;
+use super::*;
+use conduit_ai::integer_categorical_step::{channel::*, PreparedCategoricalStep};
+use conduit_composite::KernelCompositeDefinition;
+use conduit_core::{PreparedStructuredComposer, PreparedStructuredValueValidator};
+use conduit_plot::{CheckedPlot, ProfileCatalog};
+pub struct CursorNumericLease {
+    pub(super) identity: Arc<RoundIdentity>,
+    pub(super) slot: usize,
+    pub(super) choice: u64,
+    pub(super) ordinal: usize,
+    pub(super) source: usize,
+    pub(super) invocation: u64,
+}
+impl CursorNumericLease {
+    pub fn context(&self) -> &[String; 5] {
+        &self.identity.context
+    }
+    pub fn generation(&self) -> u64 {
+        self.identity.generation
+    }
+    pub fn survivor_slot(&self) -> usize {
+        self.slot
+    }
+    pub fn lexical_choice(&self) -> u64 {
+        self.choice
+    }
+    pub fn request_ordinal(&self) -> usize {
+        self.ordinal
+    }
+    pub fn source_ordinal(&self) -> usize {
+        self.source
+    }
+    pub fn invocation(&self) -> u64 {
+        self.invocation
+    }
+    pub fn prior_canonical(&self) -> &[u8] {
+        &self.identity.prior
+    }
+}
+pub struct CursorNumericalEvidence {
+    pub(super) lease: CursorNumericLease,
+    pub(super) numerical: DispatchedCategoricalInvocation,
+    pub(super) selection: ParserRoundModel,
+    pub(super) profile: Arc<PreparedCategoricalStep>,
+    pub(super) definition: Arc<KernelCompositeDefinition>,
+}
+impl CursorNumericalEvidence {
+    pub fn request(&self) -> &CursorNumericLease {
+        &self.lease
+    }
+    pub fn profile(&self) -> &PreparedCategoricalStep {
+        &self.profile
+    }
+    pub fn definition(&self) -> &KernelCompositeDefinition {
+        &self.definition
+    }
+    pub fn numerical(&self) -> &DispatchedCategoricalInvocation {
+        &self.numerical
+    }
+    pub fn selection(&self) -> ParserRoundModel {
+        self.selection
+    }
+    pub fn source_ordinal(&self) -> usize {
+        self.lease.source
+    }
+    pub fn survivor_slot(&self) -> usize {
+        self.lease.slot
+    }
+    pub fn lexical_choice(&self) -> u64 {
+        self.lease.choice
+    }
+}
+pub struct PreparedCursorLearnedChannel {
+    identity: Arc<()>,
+    definition: Arc<KernelCompositeDefinition>,
+    numerical: PreparedCategoricalChannel<CursorNumericLease>,
+    profile: Arc<PreparedCategoricalStep>,
+    selection: ParserRoundModel,
+    next: u64,
+    held: Option<CursorNumericLease>,
+    stopped: bool,
+    context: Option<[String; 5]>,
+    composer: PreparedStructuredComposer,
+    output_shape: PreparedStructuredValueValidator,
+    input: Vec<u8>,
+    output: Vec<u8>,
+}
+impl PreparedCursorLearnedChannel {
+    pub fn prepare(
+        plot: &CheckedPlot,
+        definition: KernelCompositeDefinition,
+        profile: Arc<PreparedCategoricalStep>,
+        selection: ParserRoundModel,
+        capacity: usize,
+    ) -> Result<Self, FallbackRoundRefusal> {
+        validate_model(&profile, selection)?;
+        let retained_definition = Arc::new(definition.clone());
+        let numerical =
+            PreparedCategoricalChannel::prepare(plot, definition, profile.clone(), capacity)
+                .map_err(|_| FallbackRoundRefusal::Model)?;
+        Self::finish_prepare(numerical, profile, selection, retained_definition)
+    }
+    pub fn prepare_canonical(
+        document: &CheckedSyntaxDocument,
+        entry: &str,
+        catalog: &ProfileCatalog,
+        definition: KernelCompositeDefinition,
+        profile: Arc<PreparedCategoricalStep>,
+        selection: ParserRoundModel,
+        capacity: usize,
+    ) -> Result<Self, FallbackRoundRefusal> {
+        validate_model(&profile, selection)?;
+        let retained_definition = Arc::new(definition.clone());
+        let numerical = PreparedCategoricalChannel::prepare_canonical(
+            document,
+            entry,
+            catalog,
+            definition,
+            profile.clone(),
+            capacity,
+        )
+        .map_err(|_| FallbackRoundRefusal::Model)?;
+        Self::finish_prepare(numerical, profile, selection, retained_definition)
+    }
+    fn finish_prepare(
+        numerical: PreparedCategoricalChannel<CursorNumericLease>,
+        profile: Arc<PreparedCategoricalStep>,
+        selection: ParserRoundModel,
+        definition: Arc<KernelCompositeDefinition>,
+    ) -> Result<Self, FallbackRoundRefusal> {
+        let composer = PreparedStructuredComposer::new(profile.indices_type(), BYTES)
+            .map_err(|_| FallbackRoundRefusal::Model)?;
+        let output_shape = PreparedStructuredValueValidator::new(profile.scores_type(), BYTES)
+            .map_err(|_| FallbackRoundRefusal::Model)?;
+        let mut output = buffer();
+        output.resize(BYTES, 0);
+        Ok(Self {
+            identity: Arc::new(()),
+            definition,
+            numerical,
+            profile,
+            selection,
+            next: 1,
+            held: None,
+            stopped: false,
+            context: None,
+            composer,
+            output_shape,
+            input: buffer(),
+            output,
+        })
+    }
+    pub(super) fn stop_hosted(&mut self) {
+        self.stopped = true;
+    }
+    pub fn is_stopped(&self) -> bool {
+        self.stopped
+    }
+    pub fn pending(&self) -> Option<&CursorNumericLease> {
+        self.held.as_ref().or_else(|| self.numerical.pending())
+    }
+    pub fn numerical(&self) -> &PreparedCategoricalChannel<CursorNumericLease> {
+        &self.numerical
+    }
+    pub fn cancel(&mut self) -> Result<(), FallbackRoundRefusal> {
+        self.stopped = true;
+        self.numerical
+            .cancel()
+            .map_err(FallbackRoundRefusal::NumericalChannel)
+    }
+    /// One actual kernel step, with ingress only after an exact private pending request.
+    pub fn step(&mut self, cursor: &mut PreparedRoundCursor<'_>) -> R<bool> {
+        // Reject foreign/stale request ownership before touching either real Play.
+        if !cursor
+            .numeric_binding
+            .as_ref()
+            .is_some_and(|identity| Arc::ptr_eq(identity, &self.identity))
+            || self
+                .pending()
+                .is_some_and(|pending| !Arc::ptr_eq(&pending.identity, &cursor.identity))
+            || self
+                .context
+                .as_ref()
+                .is_some_and(|context| context != &cursor.identity.context)
+            || cursor.machine.invocation != self.next
+        {
+            return Err(CursorRefusal::ForeignLease);
+        }
+        let result = self.step_inner(cursor);
+        if let Err(reason) = &result {
+            if *reason != CursorRefusal::Pressure {
+                self.stopped = true;
+                cursor.failure = Some(reason.clone());
+                cursor.stage = Stage::Failed;
+            }
+        }
+        result
+    }
+    fn step_inner(&mut self, cursor: &mut PreparedRoundCursor<'_>) -> R<bool> {
+        if !cursor
+            .numeric_binding
+            .as_ref()
+            .is_some_and(|identity| Arc::ptr_eq(identity, &self.identity))
+        {
+            return Err(CursorRefusal::ForeignLease);
+        }
+        if self.stopped
+            || self.numerical.is_closed()
+            || !matches!(cursor.stage, Stage::Numerical)
+            || cursor.failure.is_some()
+        {
+            return Err(CursorRefusal::Lifecycle);
+        }
+        if self
+            .context
+            .as_ref()
+            .is_some_and(|c| c != &cursor.identity.context)
+            || cursor.machine.invocation != self.next
+        {
+            return Err(CursorRefusal::ForeignLease);
+        }
+        if cursor.numerical.len() >= learned::MAX_LEARNED_REQUESTS_PER_ROUND
+            || self.next > learned::MAX_LEARNED_REQUESTS_PER_EPOCH
+        {
+            return Err(CursorRefusal::Bounds);
+        }
+        if let Some(pending) = self.pending() {
+            if !Arc::ptr_eq(&pending.identity, &cursor.identity) {
+                return Err(CursorRefusal::ForeignLease);
+            }
+        }
+        if self.numerical.pending().is_none() {
+            if self.held.is_none() {
+                let indices = member(&cursor.machine.features, &["indices"])?;
+                if indices
+                    .collection_length()
+                    .map_err(|_| CursorRefusal::Canonical)?
+                    != 25
+                {
+                    return Err(CursorRefusal::Model);
+                }
+                let placeholder = indices
+                    .collection_index(0)
+                    .map_err(|_| CursorRefusal::Canonical)?
+                    .ok_or(CursorRefusal::Canonical)?;
+                let mut values = [placeholder; 25];
+                for (index, value) in values.iter_mut().enumerate() {
+                    *value = indices
+                        .collection_index(index as u16)
+                        .map_err(|_| CursorRefusal::Canonical)?
+                        .ok_or(CursorRefusal::Canonical)?;
+                }
+                put(
+                    &mut self.input,
+                    self.composer
+                        .collection(&values)
+                        .map_err(|_| CursorRefusal::Model)?,
+                )?;
+                put(&mut cursor.machine.numerical_input, &self.input)?;
+                let (slot, choice) = cursor.machine.branch_identity();
+                self.held = Some(CursorNumericLease {
+                    identity: cursor.identity.clone(),
+                    slot,
+                    choice,
+                    ordinal: cursor.numerical.len(),
+                    source: cursor
+                        .io
+                        .len()
+                        .checked_sub(1)
+                        .ok_or(CursorRefusal::Lifecycle)?,
+                    invocation: self.next,
+                });
+            }
+            let lease = self.held.take().ok_or(CursorRefusal::Lifecycle)?;
+            match self.numerical.submit(lease, &self.input) {
+                Ok(CategoricalChannelSubmission::Accepted) => (),
+                Ok(CategoricalChannelSubmission::TerminalRetained(_)) => {
+                    return Err(CursorRefusal::Numerical)
+                }
+                Err(failure) => {
+                    let pressure = failure.refusal == CategoricalChannelRefusal::Pressure;
+                    self.held = Some(failure.lease);
+                    return Err(if pressure {
+                        CursorRefusal::Pressure
+                    } else {
+                        CursorRefusal::Numerical
+                    });
+                }
+            }
+        }
+        let Some(completed) = self
+            .numerical
+            .step()
+            .map_err(|_| CursorRefusal::Numerical)?
+        else {
+            return Ok(false);
+        };
+        let (lease, numerical) = completed.into_parts();
+        cursor.numerical.push(CursorNumericalEvidence {
+            lease,
+            numerical,
+            selection: self.selection,
+            profile: self.profile.clone(),
+            definition: self.definition.clone(),
+        });
+        let evidence = cursor.numerical.last().ok_or(CursorRefusal::Numerical)?;
+        let (slot, choice) = cursor.machine.branch_identity();
+        if !Arc::ptr_eq(&evidence.lease.identity, &cursor.identity)
+            || evidence.lease.slot != slot
+            || evidence.lease.choice != choice
+            || evidence.lease.ordinal + 1 != cursor.numerical.len()
+            || evidence.lease.invocation != self.next
+            || evidence.numerical.invocation() != self.next
+        {
+            return Err(CursorRefusal::ForeignLease);
+        }
+        let input_length = evidence.numerical.input_len();
+        if input_length > self.output.len() {
+            return Err(CursorRefusal::Bounds);
+        }
+        evidence
+            .numerical
+            .copy_input_into(&mut self.output[..input_length])
+            .map_err(|_| CursorRefusal::Numerical)?;
+        if self.output[..input_length] != cursor.machine.numerical_input {
+            return Err(CursorRefusal::ForeignLease);
+        }
+        let length = evidence.numerical.output_len();
+        if length > self.output.len() {
+            return Err(CursorRefusal::Bounds);
+        }
+        evidence
+            .numerical
+            .copy_output_into(&mut self.output[..length])
+            .map_err(|_| CursorRefusal::Numerical)?;
+        self.output_shape
+            .validate(&self.output[..length])
+            .map_err(|_| CursorRefusal::Model)?;
+        put(&mut cursor.machine.numerical_scores, &self.output[..length])?;
+        cursor.machine.numerical_complete()?;
+        self.next = self.next.checked_add(1).ok_or(CursorRefusal::Bounds)?;
+        cursor.stage = Stage::Build;
+        Ok(true)
+    }
+}
+impl<'d> PreparedRoundCursor<'d> {
+    pub fn prepare_learned(
+        owner: &AnalysisEpochOwner<'_>,
+        document: &'d CheckedSyntaxDocument,
+        programs: &PreparedFallbackRoundPrograms,
+        channel: &mut PreparedCursorLearnedChannel,
+    ) -> R<Self> {
+        if channel.stopped
+            || channel.pending().is_some()
+            || channel.numerical.is_closed()
+            || channel
+                .context
+                .as_ref()
+                .is_some_and(|c| c != &round_context(owner))
+        {
+            return Err(CursorRefusal::Lifecycle);
+        }
+        let mut result = Self::prepare(
+            owner,
+            document,
+            programs,
+            AnalysisRoundMode::AuthenticatedCategorical,
+            channel.next,
+        )?;
+        result.numeric_binding = Some(channel.identity.clone());
+        if channel.context.is_none() {
+            channel.context = Some(round_context(owner));
+        }
+        Ok(result)
+    }
+    pub fn numerical_evidence(&self) -> &[CursorNumericalEvidence] {
+        &self.numerical
+    }
+}
+fn validate_model(
+    profile: &PreparedCategoricalStep,
+    selection: ParserRoundModel,
+) -> Result<(), FallbackRoundRefusal> {
+    use crate::{parser_model::*, parser_punctuation_model::*};
+    let (artifact, signature, bytes) = match selection {
+        ParserRoundModel::AcceptedEnglishV2 => {
+            let (a, s) = english_parser_scorer_descriptor();
+            (a, s, ENGLISH_PARSER_WEIGHTS)
+        }
+        ParserRoundModel::UnacceptedPunctuationV3 => {
+            let (a, s) = punctuation_parser_scorer_descriptor();
+            (a, s, PUNCTUATION_PARSER_WEIGHTS)
+        }
+    };
+    let selected = profile
+        .resource()
+        .signature()
+        .semantic_digest()
+        .map_err(|_| FallbackRoundRefusal::Model)?;
+    let required = signature
+        .semantic_digest()
+        .map_err(|_| FallbackRoundRefusal::Model)?;
+    if profile.dimensions() != ENGLISH_PARSER_DIMENSIONS
+        || profile.resource().artifact() != &artifact
+        || selected != required
+        || profile.resource().bytes() != bytes
+    {
+        return Err(FallbackRoundRefusal::Model);
+    }
+    Ok(())
+}
diff --git a/semantics/language/src/analysis_round_hosted.rs b/semantics/language/src/analysis_round_hosted.rs
new file mode 100644
index 000000000..29815a2ae
--- /dev/null
+++ b/semantics/language/src/analysis_round_hosted.rs
@@ -0,0 +1,291 @@
+//! Allocating hosted adapters drive the same retained cursor; never a second traversal.
+use super::*;
+use alloc::string::ToString;
+use conduit_plot::rust_binding::NativeRustBinding;
+pub(super) fn source_step(
+    cursor: &mut PreparedRoundCursor<'_>,
+    provider: &mut dyn FallbackObservationProvider,
+) -> Result<(), FallbackRoundRefusal> {
+    match cursor.progress() {
+        CursorProgress::ReadySource => {
+            let lease = cursor.issue_source().map_err(refusal)?;
+            let request = cursor.source_request(&lease).map_err(refusal)?;
+            let output = provider.observe(request.operation, request.input)?;
+            cursor
+                .submit_source(lease, &output)
+                .map_err(|v| FallbackRoundRefusal::Cursor(v.refusal))?;
+        }
+        CursorProgress::ReadyNumerical => return Err(FallbackRoundRefusal::PendingNumerical),
+        CursorProgress::AwaitingSource => return Err(FallbackRoundRefusal::ForeignObservation),
+        _ => {
+            cursor.step().map_err(refusal)?;
+        }
+    }
+    Ok(())
+}
+fn observations(cursor: &PreparedRoundCursor<'_>) -> Vec<FallbackOperationObservation> {
+    (0..cursor.observation_count())
+        .filter_map(|i| cursor.observation(i))
+        .map(|v| FallbackOperationObservation {
+            operation: v.operation.to_string(),
+            input: v.input.to_vec(),
+            output: v.output.to_vec(),
+        })
+        .collect()
+}
+pub(super) fn fallback(
+    owner: &AnalysisEpochOwner<'_>,
+    programs: &PreparedFallbackRoundPrograms,
+    provider: &mut dyn FallbackObservationProvider,
+) -> Result<PreparedFallbackRound, FallbackRoundPreparationFailure> {
+    let mut cursor =
+        PreparedRoundCursor::prepare_fallback(owner, programs.checked_document(), programs)
+            .map_err(|v| FallbackRoundPreparationFailure {
+                refusal: refusal(v),
+                observations: Vec::new(),
+            })?;
+    while cursor.progress() != CursorProgress::Complete {
+        if let Err(refusal) = source_step(&mut cursor, provider) {
+            cursor.cancel();
+            return Err(FallbackRoundPreparationFailure {
+                refusal,
+                observations: observations(&cursor),
+            });
+        }
+    }
+    finish_owned(owner, &cursor).map_err(|(refusal, observations)| {
+        FallbackRoundPreparationFailure {
+            refusal,
+            observations,
+        }
+    })
+}
+fn finish_owned(
+    owner: &AnalysisEpochOwner<'_>,
+    cursor: &PreparedRoundCursor<'_>,
+) -> Result<PreparedFallbackRound, (FallbackRoundRefusal, Vec<FallbackOperationObservation>)> {
+    let observations = observations(&cursor);
+    let result = cursor
+        .result_canonical()
+        .map_err(refusal)
+        .and_then(|v| LanguageParserScorerBeam::decode(v).map_err(FallbackRoundRefusal::Native));
+    let result = match result {
+        Ok(result) => result,
+        Err(reason) => return Err((reason, observations)),
+    };
+    Ok(PreparedFallbackRound {
+        mode: cursor.mode(),
+        context: cursor.identity.context.clone(),
+        generation: cursor.identity.generation,
+        prior: owner.beam.clone(),
+        lexical: owner.lexical().tape().clone(),
+        result,
+        next_identity: cursor.next_identity(),
+        observations: io::compact_observations(observations),
+        #[cfg(all(
+            feature = "parser-model",
+            target_has_atomic = "8",
+            target_has_atomic = "ptr"
+        ))]
+        learned: Vec::new(),
+    })
+}
+struct Trace<'a> {
+    observations: &'a [FallbackOperationObservation],
+    next: usize,
+}
+impl FallbackObservationProvider for Trace<'_> {
+    fn observe(&mut self, operation: &str, input: &[u8]) -> Result<Vec<u8>, FallbackRoundRefusal> {
+        let frame = self.observations.get(self.next).ok_or_else(|| {
+            FallbackRoundRefusal::IncompleteTrace {
+                operation: operation.to_string(),
+                input: input.to_vec(),
+            }
+        })?;
+        if frame.operation != operation || frame.input != input {
+            return Err(FallbackRoundRefusal::ForeignObservation);
+        }
+        self.next += 1;
+        Ok(frame.output.clone())
+    }
+}
+pub(super) fn trace(
+    owner: &AnalysisEpochOwner<'_>,
+    programs: &PreparedFallbackRoundPrograms,
+    observations: Vec<FallbackOperationObservation>,
+) -> Result<PreparedFallbackRound, FallbackRoundPreparationFailure> {
+    if let Err(refusal) = io::Replay::new(programs, &observations) {
+        return Err(FallbackRoundPreparationFailure {
+            refusal,
+            observations,
+        });
+    }
+    let mut provider = Trace {
+        observations: &observations,
+        next: 0,
+    };
+    let result = fallback(owner, programs, &mut provider);
+    let extra = provider.next != observations.len();
+    match result {
+        Ok(_) if extra => Err(FallbackRoundPreparationFailure {
+            refusal: FallbackRoundRefusal::ExtraObservation,
+            observations,
+        }),
+        Err(failure) => Err(FallbackRoundPreparationFailure {
+            refusal: failure.refusal,
+            observations,
+        }),
+        other => other,
+    }
+}
+#[cfg(all(
+    feature = "parser-model",
+    target_has_atomic = "8",
+    target_has_atomic = "ptr"
+))]
+pub(super) fn learned(
+    owner: &AnalysisEpochOwner<'_>,
+    programs: &PreparedFallbackRoundPrograms,
+    provider: &mut dyn FallbackObservationProvider,
+    channel: &mut learned::PreparedLearnedRoundChannel,
+) -> Result<PreparedFallbackRound, learned::LearnedRoundPreparationFailure> {
+    use learned::*;
+    if channel.is_stopped() || channel.pending().is_some() || channel.numerical().is_closed() {
+        return Err(LearnedRoundPreparationFailure {
+            refusal: FallbackRoundRefusal::PendingNumerical,
+            observations: Vec::new(),
+            learned: Vec::new(),
+            retained_numerical: Vec::new(),
+        });
+    }
+    if owner.session.is_closed() {
+        return Err(LearnedRoundPreparationFailure {
+            refusal: FallbackRoundRefusal::Closed,
+            observations: Vec::new(),
+            learned: Vec::new(),
+            retained_numerical: Vec::new(),
+        });
+    }
+    if owner.rounds.len() >= owner.round_limit || owner.rounds.len() >= owner.rounds.capacity() {
+        return Err(LearnedRoundPreparationFailure {
+            refusal: FallbackRoundRefusal::Capacity,
+            observations: Vec::new(),
+            learned: Vec::new(),
+            retained_numerical: Vec::new(),
+        });
+    }
+    let mut cursor =
+        PreparedRoundCursor::prepare_learned(owner, programs.checked_document(), programs, channel)
+            .map_err(|v| LearnedRoundPreparationFailure {
+                refusal: refusal(v),
+                observations: Vec::new(),
+                learned: Vec::new(),
+                retained_numerical: Vec::new(),
+            })?;
+    let mut polls = 0;
+    while cursor.progress() != CursorProgress::Complete {
+        let result = if cursor.progress() == CursorProgress::ReadyNumerical {
+            polls += 1;
+            match channel.step(&mut cursor) {
+                Ok(true) => {
+                    polls = 0;
+                    Ok(())
+                }
+                Ok(false) if polls < MAX_KERNEL_POLLS_PER_REQUEST => Ok(()),
+                Ok(false) => Err(FallbackRoundRefusal::PendingNumerical),
+                Err(reason) => Err(FallbackRoundRefusal::Cursor(reason)),
+            }
+        } else {
+            source_step(&mut cursor, provider)
+        };
+        if let Err(refusal) = result {
+            channel.stop_hosted();
+            cursor.cancel();
+            let observations = observations(&cursor);
+            let learned = owned_learned(&mut cursor).unwrap_or_default();
+            return Err(LearnedRoundPreparationFailure {
+                refusal,
+                observations,
+                learned,
+                retained_numerical: core::mem::take(&mut cursor.numerical),
+            });
+        }
+    }
+    let mut prepared = finish_owned(owner, &cursor).map_err(|(refusal, observations)| {
+        LearnedRoundPreparationFailure {
+            refusal,
+            observations,
+            learned: Vec::new(),
+            retained_numerical: core::mem::take(&mut cursor.numerical),
+        }
+    })?;
+    prepared.learned =
+        owned_learned(&mut cursor).map_err(|refusal| LearnedRoundPreparationFailure {
+            refusal,
+            observations: observations(&cursor),
+            learned: Vec::new(),
+            retained_numerical: core::mem::take(&mut cursor.numerical),
+        })?;
+    Ok(prepared)
+}
+#[cfg(all(
+    feature = "parser-model",
+    target_has_atomic = "8",
+    target_has_atomic = "ptr"
+))]
+fn owned_learned(
+    cursor: &mut PreparedRoundCursor<'_>,
+) -> Result<Vec<learned::LearnedBranchEvidence>, FallbackRoundRefusal> {
+    let mut requests = Vec::with_capacity(cursor.numerical.len());
+    for evidence in &cursor.numerical {
+        let frame = cursor
+            .io
+            .observation(evidence.lease.source)
+            .ok_or(FallbackRoundRefusal::ForeignObservation)?;
+        if frame.operation != "language-parser-scorer-model-features" || !frame.admitted {
+            return Err(FallbackRoundRefusal::ForeignObservation);
+        }
+        let query = LanguageParserScorerChoiceQuery::decode(frame.input)
+            .map_err(FallbackRoundRefusal::Native)?;
+        let features = LanguageParserScorerFeatures::decode(frame.output)
+            .map_err(FallbackRoundRefusal::Native)?;
+        let prior = LanguageParserScorerBeam::decode(&evidence.lease.identity.prior)
+            .map_err(FallbackRoundRefusal::Native)?;
+        let mut input = alloc::vec![0;evidence.numerical.input_len()];
+        evidence
+            .numerical
+            .copy_input_into(&mut input)
+            .map_err(|_| FallbackRoundRefusal::Numerical)?;
+        requests.push(learned::PendingParserScore {
+            context: evidence.lease.identity.context.clone(),
+            generation: evidence.lease.identity.generation,
+            prior,
+            slot: evidence.lease.slot,
+            choice: evidence.lease.choice,
+            ordinal: evidence.lease.ordinal,
+            query,
+            features,
+            input,
+        });
+    }
+    Ok(requests
+        .into_iter()
+        .zip(core::mem::take(&mut cursor.numerical))
+        .map(|(request, evidence)| learned::LearnedBranchEvidence {
+            request,
+            numerical: evidence.numerical,
+            selection: evidence.selection,
+            profile: evidence.profile,
+            definition: evidence.definition,
+        })
+        .collect())
+}
+
+fn refusal(reason: CursorRefusal) -> FallbackRoundRefusal {
+    match reason {
+        CursorRefusal::Closed => FallbackRoundRefusal::Closed,
+        CursorRefusal::ForeignLease => FallbackRoundRefusal::Stale,
+        CursorRefusal::Bounds => FallbackRoundRefusal::Bound,
+        other => FallbackRoundRefusal::Cursor(other),
+    }
+}
