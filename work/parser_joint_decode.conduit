) = { candidate0: (((.candidate0.hypothesis.parser.active && !.candidate1.hypothesis.parser.active) || (.candidate0.hypothesis.parser.active == .candidate1.hypothesis.parser.active && (.candidate0.hypothesis.parser.score > .candidate1.hypothesis.parser.score || (.candidate0.hypothesis.parser.score == .candidate1.hypothesis.parser.score && .candidate0.hypothesis.parser.identity <= .candidate1.hypothesis.parser.identity)))) ? .candidate0 : .candidate1), candidate1: (((.candidate0.hypothesis.parser.active && !.candidate1.hypothesis.parser.active) || (.candidate0.hypothesis.parser.active == .candidate1.hypothesis.parser.active && (.candidate0.hypothesis.parser.score > .candidate1.hypothesis.parser.score || (.candidate0.hypothesis.parser.score == .candidate1.hypothesis.parser.score && .candidate0.hypothesis.parser.identity <= .candidate1.hypothesis.parser.identity)))) ? .candidate1 : .candidate0), candidate2: .candidate2, candidate3: .candidate3 }
