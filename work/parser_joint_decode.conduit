type LanguageParserJointRuntimeBeam = {
    beam: LanguageParserJointBeam
    selected: collection U64 = 4
    where .selected.0 <= 4
    where .selected.0 >= .beam.candidate0.parser.state.unread
    where .selected.0 <= .beam.candidate0.parser.state.token_count
    where .selected.0 <= .beam.candidate0.parser.state.unread + 1
    where .selected.1 <= 4
    where .selected.1 >= .beam.candidate1.parser.state.unread
    where .selected.1 <= .beam.candidate1.parser.state.token_count
    where .selected.1 <= .beam.candidate1.parser.state.unread + 1
    where .selected.2 <= 4
    where .selected.2 >= .beam.candidate2.parser.state.unread
    where .selected.2 <= .beam.candidate2.parser.state.token_count
    where .selected.2 <= .beam.candidate2.parser.state.unread + 1
    where .selected.3 <= 4
    where .selected.3 >= .beam.candidate3.parser.state.unread
    where .selected.3 <= .beam.candidate3.parser.state.token_count
    where .selected.3 <= .beam.candidate3.parser.state.unread + 1
}
