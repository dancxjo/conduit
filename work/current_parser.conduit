 (!(.request.state.heads.0 == 4 && .request.state.heads.2 == 4)) && (!(.request.state.heads.0 == 4 && .request.state.heads.3 == 4)) && (!(.request.state.heads.1 == 4 && .request.state.heads.2 == 4)) && (!(.request.state.heads.1 == 4 && .request.state.heads.3 == 4)))) && ((!(.request.state.heads.2 == 4 && .request.state.heads.3 == 4)) && (!(.request.state.heads.0 == 1 && .request.state.heads.1 == 0)) && (!(.request.state.heads.0 == 2 && .request.state.heads.2 == 0)) && (!(.request.state.heads.0 == 3 && .request.state.heads.3 == 0)) && ((!(.request.state.heads.1 == 2 && .request.state.heads.2 == 1)) && (!(.request.state.heads.1 == 3 && .request.state.heads.3 == 1)) && (!(.request.state.heads.2 == 3 && .request.state.heads.3 == 2)) && (!(.request.state.heads.0 == 1 && .request.state.heads.1 == 2 && .request.state.heads.2 == 0)) && (!(.request.state.heads.0 == 1 && .request.state.heads.1 == 3 && .request.state.heads.3 == 0)) && (!(.request.state.heads.0 == 2 && .request.state.heads.2 == 1 && .request.state.heads.1 == 0)) && (!(.request.state.heads.0 == 2 && .request.state.heads.2 == 3 && .request.state.heads.3 == 0)) && (!(.request.state.heads.0 == 3 && .request.state.heads.3 == 1 && .request.state.heads.1 == 0))))) && (((!(.request.state.heads.0 == 3 && .request.state.heads.3 == 2 && .request.state.heads.2 == 0)) && (!(.request.state.heads.1 == 2 && .request.state.heads.2 == 3 && .request.state.heads.3 == 1)) && (!(.request.state.heads.1 == 3 && .request.state.heads.3 == 2 && .request.state.heads.2 == 1)) && (!(.request.state.heads.0 == 1 && .request.state.heads.1 == 2 && .request.state.heads.2 == 3 && .request.state.heads.3 == 0)) && ((!(.request.state.heads.0 == 1 && .request.state.heads.1 == 3 && .request.state.heads.3 == 2 && .request.state.heads.2 == 0)) && (!(.request.state.heads.0 == 2 && .request.state.heads.2 == 1 && .request.state.heads.1 == 3 && .request.state.heads.3 == 0)) && (!(.request.state.heads.0 == 2 && .request.state.heads.2 == 3 && .request.state.h