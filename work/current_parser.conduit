) = ({ accepted: (.legal && !.cycle), refusal: (((((.request.basis.text.length != .request.state.basis.text.length || .request.basis.text.words.0 != .request.state.basis.text.words.0) || (.request.basis.text.words.1 != .request.state.basis.text.words.1 || .request.basis.text.words.2 != .request.state.basis.text.words.2)) || ((.request.basis.text.words.3 != .request.state.basis.text.words.3 || .request.basis.text.words.4 != .request.state.basis.text.words.4) || (.request.basis.text.words.5 != .request.state.basis.text.words.5 || (.request.basis.text.words.6 != .request.state.basis.text.words.6 || .request.basis.text.words.7 != .request.state.basis.text.words.7)))) || ((((.request.basis.source_revision.length != .request.state.basis.source_revision.length || .request.basis.source_revision.words.0 != .request.state.basis.source_revision.words.0) || (.request.basis.source_revision.words.1 != .request.state.basis.source_revision.words.1 || .request.basis.source_revision.words.2 != .request.state.basis.source_revision.words.2)) || ((.request.basis.source_revision.words.3 != .request.state.basis.source_revision.words.3 || .request.basis.source_revision.words.4 != .request.state.basis.source_revision.words.4) || (.request.basis.source_revision.words.5 != .request.state.basis.source_revision.words.5 || (.request.basis.source_revision.words.6 != .request.state.basis.source_revision.words.6 || .request.basis.source_revision.words.7 != .request.state.basis.source_revision.words.7)))) || (((.request.basis.analysis_revision.length != .request.state.basis.analysis_revision.length || .request.basis.analysis_revision.words.0 != .request.state.basis.analysis_revision.words.0) || (.request.basis.analysis_revision.words.1 != .request.state.basis.analysis_revision.words.1 || .request.basis.analysis_revision.words.2 != .request.state.basis.analysis_revision.words.2)) || ((.request.basis.analysis_revision.words.3 != .request.state.basis.analysis_revision.words.3 || .request.basis.analysis