plot language-parser-legal (
    input: LanguageParserContext...| >> output: LanguageParserContext...|
) = ({ request: .request, top: .top, admitted: .admitted, legal: (.admitted && (((((.request.basis.text.length == .request.state.basis.text.length && .request.basis.text.words.0 == .request.state.basis.text.words.0) && (.request.basis.text.words.1 == .request.state.basis.text.words.1 && .request.basis.text.words.2 == .request.state.basis.text.words.2)) && ((.request.basis.text.words.3 == .request.state.basis.text.words.3 && .request.basis.text.words.4 == .request.state.basis.text.words.4) && (.request.basis.text.words.5 == .request.state.basis.text.words.5 && (.request.basis.text.words.6 == .request.state.basis.text.words.6 && .request.basis.text.words.7 == .request.state.basis.text.words.7)))) && ((((.request.basis.source_revision.length == .request.state.basis.source_revision.length && .request.basis.source_revision.words.0 == .request.state.basis.source_revision.words.0) && (.request.basis.source_revision.words.1 == .request.state.basis.source_revision.words.1 && .request.basis.source_revision.words.2 == .request.state.basis.source_revision.words.2)) && ((.request.basis.source_revision.words.3 == .request.state.basis.source_revision.words.3 && .request.basis.source_revision.words.4 == .request.state.basis.source_revision.words.4) && (.request.basis.source_revision.words.5 == .request.state.basis.source_revision.words.5 && (.request.basis.source_revision.words.6 == .request.state.basis.source_revision.words.6 && .request.basis.source_revision.words.7 == .request.state.basis.source_revision.words.7)))) && (((.request.basis.analysis_revision.length == .request.state.basis.analysis_revision.length && .request.basis.analysis_revision.words.0 == .request.state.basis.analysis_revision.words.0) && (.request.basis.analysis_revision.words.1 == .request.state.basis.analysis_revision.words.1 && .request.basis.analysis_revision.words.2 == .request.state.basis.analysis_revision.words.2)) && ((.request.basis.analysis_revision.words.3 == .request.state.basis.analysis_revision.words.3 && .request.basis.analysis_revision.words.4 == .request.state.basis.analysis_revision.words.4) && (.request.basis.analysis_revision.words.5 == .request.state.basis.analysis_revision.words.5 && (.request.basis.analysis_revision.words.6 == .request.state.basis.analysis_revision.words.6 && .request.basis.analysis_revision.words.7 == .request.state.basis.analysis_revision.words.7)))))) && (((variant/is(.request.action,"shift") && (.request.state.unread < .request.state.token_count && .request.state.depth < 5)) || (variant/is(.request.action,"reduce") && (.request.state.depth > 1 && (.top < 4 && sequence/at(.request.state.heads,.top) < 5)))) || ((variant/is(.request.action,"left_arc") && ((.request.state.unread < .request.state.token_count && (.request.state.depth > 1 && .top < 4)) && (.top >= .request.state.committed && (sequence/at(.request.state.heads,.top) == 5 && !variant/is(.request.relation.base,"root"))))) || (variant/is(.request.action,"right_arc") && ((.request.state.unread < .request.state.token_count && .request.state.depth < 5) && (.request.state.unread >= .request.state.committed && (sequence/at(.request.state.heads,.request.state.unread) == 5 && (((.top == 4 && (variant/is(.request.relation.base,"root") && .request.state.heads.0 != 4)) && (.request.state.heads.1 != 4 && (.request.state.heads.2 != 4 && .request.state.heads.3 != 4))) || (.top < 4 && !variant/is(.request.relation.base,"root"))))))))))), dependent: .dependent, ancestor: .ancestor, cycle: .cycle })

plot language-parser-follow (
    input: LanguageParserContext...| >> output: LanguageParserContext...|
) = ({ request: .request, top: .top, admitted: .admitted, legal: .legal, dependent: .dependent, ancestor: (.ancestor < 5 ? sequence/at(.request.state.heads,.ancestor) : 5), cycle: (.cycle || .ancestor == .dependent) })

plot language-parser-apply (
