# Four-token symbolic profile. Proposed actions and raw plotting state are not
# admitted linguistic truth. Checked plots validate states and own graph mutation.
# Root=4, unassigned=5. No beam, learned scorer, lexical analysis or speech claim.
# Empty subtype encodes absence; nonempty suffixes are admitted canonically later.
type LanguageParserSubtype = Text <= 32B
type LanguageParserRelation = {
    base: LanguageUniversalDependencyRelation
    subtype: LanguageParserSubtype
}
type LanguageParserBasis = {
    text: LanguageTextId
    source_revision: LanguageTextRevisionId
    analysis_revision: LanguageAnalysisRevisionId
}
type LanguageParserBegin = {
    basis: LanguageParserRawBasis
    token_count: U64 in 1..=4
    default_relation: LanguageParserRawRelation
}
type LanguageParserState = {
    basis: LanguageParserBasis
    token_count: U64 in 1..=4
    unread: U64 in 0..=4
    depth: U64 in 1..=5
    stack: collection U64 = 5
    heads: collection U64 = 5
    relation0: LanguageParserRelation
    relation1: LanguageParserRelation
    relation2: LanguageParserRelation
    relation3: LanguageParserRelation
    committed: U64 in 0..=4
    where (.unread <= .token_count) && (.committed <= .unread) && (.stack.0 <= 4) && (.heads.0 <= 5)
    where (.stack.1 <= 4) && (.heads.1 <= 5) && (.stack.2 <= 4) && (.heads.2 <= 5)
    where (.stack.3 <= 4) && (.heads.3 <= 5) && (.stack.4 <= 4) && (.heads.4 <= 5)
    where (.stack.0 == 4) && (.heads.4 == 4) && (.depth <= .unread + 1) && (0 >= .unread ? .heads.0 == 5 : true)
    where (.heads.0 == 4 ? .relation0.base is root : !(.relation0.base is root)) && (0 < .committed ? .heads.0 < 5 : true) && (1 >= .unread ? .heads.1 == 5 : true) && (.heads.1 == 4 ? .relation1.base is root : !(.relation1.base is root))
    where (1 < .committed ? .heads.1 < 5 : true) && (2 >= .unread ? .heads.2 == 5 : true) && (.heads.2 == 4 ? .relation2.base is root : !(.relation2.base is root)) && (2 < .committed ? .heads.2 < 5 : true)
    where (3 >= .unread ? .heads.3 == 5 : true) && (.heads.3 == 4 ? .relation3.base is root : !(.relation3.base is root)) && (3 < .committed ? .heads.3 < 5 : true) && (!(.heads.0 == 4 && .heads.1 == 4))
    where (!(.heads.0 == 4 && .heads.2 == 4)) && (!(.heads.0 == 4 && .heads.3 == 4)) && (!(.heads.1 == 4 && .heads.2 == 4)) && (!(.heads.1 == 4 && .heads.3 == 4))
    where (!(.heads.2 == 4 && .heads.3 == 4)) && (!(.heads.0 == 1 && .heads.1 == 0)) && (!(.heads.0 == 2 && .heads.2 == 0)) && (!(.heads.0 == 3 && .heads.3 == 0))
    where (!(.heads.1 == 2 && .heads.2 == 1)) && (!(.heads.1 == 3 && .heads.3 == 1)) && (!(.heads.2 == 3 && .heads.3 == 2)) && (!(.heads.0 == 1 && .heads.1 == 2 && .heads.2 == 0))
    where (!(.heads.0 == 1 && .heads.1 == 3 && .heads.3 == 0)) && (!(.heads.0 == 2 && .heads.2 == 1 && .heads.1 == 0)) && (!(.heads.0 == 2 && .heads.2 == 3 && .heads.3 == 0)) && (!(.heads.0 == 3 && .heads.3 == 1 && .heads.1 == 0))
    where (!(.heads.0 == 3 && .heads.3 == 2 && .heads.2 == 0)) && (!(.heads.1 == 2 && .heads.2 == 3 && .heads.3 == 1)) && (!(.heads.1 == 3 && .heads.3 == 2 && .heads.2 == 1)) && (!(.heads.0 == 1 && .heads.1 == 2 && .heads.2 == 3 && .heads.3 == 0))
    where (!(.heads.0 == 1 && .heads.1 == 3 && .heads.3 == 2 && .heads.2 == 0)) && (!(.heads.0 == 2 && .heads.2 == 1 && .heads.1 == 3 && .heads.3 == 0)) && (!(.heads.0 == 2 && .heads.2 == 3 && .heads.3 == 1 && .heads.1 == 0)) && (!(.heads.0 == 3 && .heads.3 == 1 && .heads.1 == 2 && .heads.2 == 0))
    where (!(.heads.0 == 3 && .heads.3 == 2 && .heads.2 == 1 && .heads.1 == 0)) && (.heads.0 != 0) && (.heads.0 < .token_count || .heads.0 >= 4) && (.heads.1 != 1)
    where (.heads.1 < .token_count || .heads.1 >= 4) && (.heads.2 != 2) && (.heads.2 < .token_count || .heads.2 >= 4) && (.heads.3 != 3)
    where (.heads.3 < .token_count || .heads.3 >= 4) && (.depth > 1 ? .stack.1 < .unread : true) && (.depth > 2 ? .stack.2 < .unread : true) && (.depth > 3 ? .stack.3 < .unread : true)
    where (.depth > 4 ? .stack.4 < .unread : true) && (.depth > 2 ? .stack.1 < .stack.2 : true) && (.depth > 3 ? .stack.2 < .stack.3 : true) && (.depth > 4 ? .stack.3 < .stack.4 : true)
}

# Private plotting carrier; the checked admission predicate below owns its laws.
# Exact zero-padded UTF-8 bytes packed little endian; generic typed admission
# decodes and validates the native identities. These are bytes, never hashes.
type LanguageParserRawIdentity = {
    length: U64
    words: collection U64 = 8
}
type LanguageParserRawBasis = {
    text: LanguageParserRawIdentity
    source_revision: LanguageParserRawIdentity
    analysis_revision: LanguageParserRawIdentity
}
type LanguageParserRawRelation = {
    base: LanguageUniversalDependencyRelation
    subtype: LanguageParserRawIdentity
}
type LanguageParserNumericState = {
    basis: LanguageParserRawBasis
    token_count: U64
    unread: U64
    depth: U64
    stack: collection U64 = 5
    heads: collection U64 = 5
    relation0: LanguageParserRawRelation
    relation1: LanguageParserRawRelation
    relation2: LanguageParserRawRelation
    relation3: LanguageParserRawRelation
    committed: U64
}
type LanguageParserAction =
    shift
    | reduce
    | left_arc
    | right_arc

type LanguageParserRequest = {
    basis: LanguageParserRawBasis
    state: LanguageParserNumericState
    action: LanguageParserAction
    relation: LanguageParserRawRelation
}

type LanguageParserContext = {
    request: LanguageParserRequest
    top: U64
    admitted: Boolean
    legal: Boolean
    dependent: U64
    ancestor: U64
    cycle: Boolean
}

type LanguageParserRefusal =
    none
    | stale_basis
    | illegal_action
    | cycle
    | invalid_state

type LanguageParserResult = {
    state: LanguageParserNumericState
    accepted: Boolean
    refusal: LanguageParserRefusal
}

plot language-parser-initialize (
    input: LanguageParserBegin...| >> output: LanguageParserNumericState...|
) = ({ basis: .basis, token_count: .token_count, unread: 0, depth: 1, stack: [4,4,4,4,4], heads: [5,5,5,5,4], relation0: .default_relation, relation1: .default_relation, relation2: .default_relation, relation3: .default_relation, committed: 0 })

plot language-parser-context (
    input: LanguageParserRequest...| >> output: LanguageParserContext...|
) = ({ request: ., top: (.state.depth >= 1 && .state.depth <= 5 ? sequence/at(.state.stack, .state.depth - 1) : 4), admitted: false, legal: false, dependent: (variant/is(.action,"left_arc") ? (.state.depth >= 1 && .state.depth <= 5 ? sequence/at(.state.stack, .state.depth - 1) : 4) : (variant/is(.action,"right_arc") ? .state.unread : 5)), ancestor: (variant/is(.action,"left_arc") ? .state.unread : (variant/is(.action,"right_arc") ? (.state.depth >= 1 && .state.depth <= 5 ? sequence/at(.state.stack, .state.depth - 1) : 4) : 4)), cycle: false })

plot language-parser-state-valid (
    input: LanguageParserNumericState...| >> output: Boolean...|
) = (((((.token_count >= 1 && .token_count <= 4) && (.unread <= 4 && (.depth >= 1 && .depth <= 5))) && ((.committed <= 4 && ((.unread <= .token_count) && (.committed <= .unread) && (.stack.0 <= 4) && (.heads.0 <= 5) && (.stack.1 <= 4) && (.heads.1 <= 5) && (.stack.2 <= 4) && (.heads.2 <= 5))) && ((.stack.3 <= 4) && (.heads.3 <= 5) && (.stack.4 <= 4) && (.heads.4 <= 5) && ((.stack.0 == 4) && (.heads.4 == 4) && (.depth <= .unread + 1) && (0 >= .unread ? .heads.0 == 5 : true) && (.heads.0 == 4 ? variant/is(.relation0.base,"root") : !(variant/is(.relation0.base,"root"))) && (0 < .committed ? .heads.0 < 5 : true) && (1 >= .unread ? .heads.1 == 5 : true) && (.heads.1 == 4 ? variant/is(.relation1.base,"root") : !(variant/is(.relation1.base,"root"))))))) && ((((1 < .committed ? .heads.1 < 5 : true) && (2 >= .unread ? .heads.2 == 5 : true) && (.heads.2 == 4 ? variant/is(.relation2.base,"root") : !(variant/is(.relation2.base,"root"))) && (2 < .committed ? .heads.2 < 5 : true) && ((3 >= .unread ? .heads.3 == 5 : true) && (.heads.3 == 4 ? variant/is(.relation3.base,"root") : !(variant/is(.relation3.base,"root"))) && (3 < .committed ? .heads.3 < 5 : true) && (!(.heads.0 == 4 && .heads.1 == 4)) && (!(.heads.0 == 4 && .heads.2 == 4)) && (!(.heads.0 == 4 && .heads.3 == 4)) && (!(.heads.1 == 4 && .heads.2 == 4)) && (!(.heads.1 == 4 && .heads.3 == 4)))) && ((!(.heads.2 == 4 && .heads.3 == 4)) && (!(.heads.0 == 1 && .heads.1 == 0)) && (!(.heads.0 == 2 && .heads.2 == 0)) && (!(.heads.0 == 3 && .heads.3 == 0)) && ((!(.heads.1 == 2 && .heads.2 == 1)) && (!(.heads.1 == 3 && .heads.3 == 1)) && (!(.heads.2 == 3 && .heads.3 == 2)) && (!(.heads.0 == 1 && .heads.1 == 2 && .heads.2 == 0)) && (!(.heads.0 == 1 && .heads.1 == 3 && .heads.3 == 0)) && (!(.heads.0 == 2 && .heads.2 == 1 && .heads.1 == 0)) && (!(.heads.0 == 2 && .heads.2 == 3 && .heads.3 == 0)) && (!(.heads.0 == 3 && .heads.3 == 1 && .heads.1 == 0))))) && (((!(.heads.0 == 3 && .heads.3 == 2 && .heads.2 == 0)) && (!(.heads.1 == 2 && .heads.2 == 3 && .heads.3 == 1)) && (!(.heads.1 == 3 && .heads.3 == 2 && .heads.2 == 1)) && (!(.heads.0 == 1 && .heads.1 == 2 && .heads.2 == 3 && .heads.3 == 0)) && ((!(.heads.0 == 1 && .heads.1 == 3 && .heads.3 == 2 && .heads.2 == 0)) && (!(.heads.0 == 2 && .heads.2 == 1 && .heads.1 == 3 && .heads.3 == 0)) && (!(.heads.0 == 2 && .heads.2 == 3 && .heads.3 == 1 && .heads.1 == 0)) && (!(.heads.0 == 3 && .heads.3 == 1 && .heads.1 == 2 && .heads.2 == 0)) && (!(.heads.0 == 3 && .heads.3 == 2 && .heads.2 == 1 && .heads.1 == 0)) && (.heads.0 != 0) && (.heads.0 < .token_count || .heads.0 >= 4) && (.heads.1 != 1))) && ((.heads.1 < .token_count || .heads.1 >= 4) && (.heads.2 != 2) && (.heads.2 < .token_count || .heads.2 >= 4) && (.heads.3 != 3) && ((.heads.3 < .token_count || .heads.3 >= 4) && (.depth > 1 ? .stack.1 < .unread : true) && (.depth > 2 ? .stack.2 < .unread : true) && (.depth > 3 ? .stack.3 < .unread : true) && (.depth > 4 ? .stack.4 < .unread : true) && (.depth > 2 ? .stack.1 < .stack.2 : true) && (.depth > 3 ? .stack.2 < .stack.3 : true) && (.depth > 4 ? .stack.3 < .stack.4 : true)))))))

