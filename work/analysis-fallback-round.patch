diff --git a/semantics/language/src/analysis_fallback_frontier.rs b/semantics/language/src/analysis_fallback_frontier.rs
new file mode 100644
index 000000000..bd864201e
--- /dev/null
+++ b/semantics/language/src/analysis_fallback_frontier.rs
@@ -0,0 +1,186 @@
+//! True all-survivor contiguous stability; no caller-supplied stable Boolean.
+use super::FallbackObservationProvider;
+use super::{
+    io::Replay, FallbackOperationObservation, FallbackRoundRefusal, PreparedFallbackRoundPrograms,
+};
+use crate::{
+    analysis_epoch_owner::{AnalysisEpochOwner, AnalysisEpochRefusal},
+    revision::*,
+    *,
+};
+use alloc::vec::Vec;
+use conduit_core::revision::*;
+pub struct PreparedFallbackFrontier {
+    generation: u64,
+    beam: LanguageParserScorerBeam,
+    lexical: LanguageLexicalTape,
+    frontier: LanguageParserRawFrontier,
+    observations: Vec<FallbackOperationObservation>,
+    cancelled: bool,
+    pressure: bool,
+}
+pub struct FrontierPreparationFailure {
+    pub refusal: FallbackRoundRefusal,
+    pub observations: Vec<FallbackOperationObservation>,
+}
+pub struct FrontierApplyFailure {
+    pub refusal: AnalysisEpochRefusal,
+    pub prepared: PreparedFallbackFrontier,
+}
+impl PreparedFallbackFrontier {
+    pub fn frontier(&self) -> &LanguageParserRawFrontier {
+        &self.frontier
+    }
+    pub fn observations(&self) -> &[FallbackOperationObservation] {
+        &self.observations
+    }
+    pub fn source_id(&self) -> &'static str {
+        crate::parser_commitment::COMMITMENT_SOURCE_ID
+    }
+}
+impl<'a> AnalysisEpochOwner<'a> {
+    pub fn prepare_fallback_frontier(
+        &self,
+        programs: &PreparedFallbackRoundPrograms,
+        observations: Vec<FallbackOperationObservation>,
+        cancelled: bool,
+        pressure: bool,
+    ) -> Result<PreparedFallbackFrontier, FrontierPreparationFailure> {
+        let result = (|| {
+            if self.session.is_closed() {
+                return Err(FallbackRoundRefusal::Closed);
+            }
+            let mut replay = Replay::new(programs, &observations)?;
+            let result = self.run_frontier(&mut replay, cancelled, pressure)?;
+            replay.finish()?;
+            Ok(result)
+        })();
+        match result {
+            Ok(frontier) => Ok(PreparedFallbackFrontier {
+                generation: self.generation,
+                beam: self.beam.clone(),
+                lexical: self.lexical().tape().clone(),
+                frontier,
+                observations,
+                cancelled,
+                pressure,
+            }),
+            Err(refusal) => Err(FrontierPreparationFailure {
+                refusal,
+                observations,
+            }),
+        }
+    }
+    pub fn prepare_fallback_frontier_with(
+        &self,
+        programs: &PreparedFallbackRoundPrograms,
+        provider: &mut dyn FallbackObservationProvider,
+        cancelled: bool,
+        pressure: bool,
+    ) -> Result<PreparedFallbackFrontier, FrontierPreparationFailure> {
+        if self.session.is_closed() {
+            return Err(FrontierPreparationFailure {
+                refusal: FallbackRoundRefusal::Closed,
+                observations: Vec::new(),
+            });
+        }
+        let mut replay = Replay::with_provider(programs, provider);
+        let result = self.run_frontier(&mut replay, cancelled, pressure);
+        let observations = replay.into_captured();
+        match result {
+            Ok(frontier) => Ok(PreparedFallbackFrontier {
+                generation: self.generation,
+                beam: self.beam.clone(),
+                lexical: self.lexical().tape().clone(),
+                frontier,
+                observations,
+                cancelled,
+                pressure,
+            }),
+            Err(refusal) => Err(FrontierPreparationFailure {
+                refusal,
+                observations,
+            }),
+        }
+    }
+    fn run_frontier(
+        &self,
+        replay: &mut Replay<'_>,
+        cancelled: bool,
+        pressure: bool,
+    ) -> Result<LanguageParserRawFrontier, FallbackRoundRefusal> {
+        use FallbackRoundRefusal::Native;
+        let basis = self.beam.candidate0().parser().state().basis().clone();
+        let beam = LanguageParserAdmittedBeam::new(
+            basis.clone(),
+            self.beam.candidate0().parser().clone(),
+            self.beam.candidate1().parser().clone(),
+            self.beam.candidate2().parser().clone(),
+            self.beam.candidate3().parser().clone(),
+        )
+        .map_err(Native)?;
+        let committed = self.frontiers().committed.0;
+        let mut frontier =
+            LanguageParserRawFrontier::new(basis, committed, committed).map_err(Native)?;
+        for dependent in committed..*self.beam.candidate0().parser().state().token_count() {
+            let query = LanguageParserAdmittedAgreementQuery::new(beam.clone(), dependent)
+                .map_err(Native)?;
+            let agreement: LanguageParserAgreement =
+                replay.run("language-parser-admitted-agreement", &query)?;
+            let input =
+                LanguageParserAdvanceRequest::new(agreement, cancelled, frontier.clone(), pressure)
+                    .map_err(Native)?;
+            let actual: LanguageParserFrontierResult =
+                replay.run("language-parser-advance-stable", &input)?;
+            frontier = actual.frontier().clone();
+            if !*actual.accepted() {
+                break;
+            }
+        }
+        Ok(frontier)
+    }
+    pub fn append_fallback_frontier(
+        &mut self,
+        event: &'a RevisionEvent<'a, DependencyRevisions<'a>>,
+        prepared: PreparedFallbackFrontier,
+    ) -> Result<(), FrontierApplyFailure> {
+        let generation = self.generation.checked_add(1);
+        let refusal = if self.session.is_closed() {
+            Some(AnalysisEpochRefusal::Closed)
+        } else if self.frontier_receipts.len() >= self.round_limit
+            || self.frontier_receipts.len() >= self.frontier_receipts.capacity()
+        {
+            Some(AnalysisEpochRefusal::Capacity)
+        } else if prepared.generation != self.generation
+            || prepared.beam != self.beam
+            || &prepared.lexical != self.lexical().tape()
+        {
+            Some(AnalysisEpochRefusal::Replay)
+        } else if !matches!(event.change(),RevisionChange::Stable{through,..} if through.0==*prepared.frontier.stable())
+        {
+            Some(AnalysisEpochRefusal::FrontierCustody)
+        } else if generation.is_none() {
+            Some(AnalysisEpochRefusal::Generation)
+        } else {
+            None
+        };
+        if let Some(refusal) = refusal {
+            return Err(FrontierApplyFailure { refusal, prepared });
+        }
+        if let Err(e) = self
+            .session
+            .append(event, None, prepared.cancelled, prepared.pressure)
+        {
+            return Err(FrontierApplyFailure {
+                refusal: AnalysisEpochRefusal::Session(e),
+                prepared,
+            });
+        }
+        self.generation = generation.unwrap_or(self.generation);
+        self.frontier_receipts.push(prepared);
+        Ok(())
+    }
+    pub fn fallback_frontier_receipts(&self) -> &[PreparedFallbackFrontier] {
+        &self.frontier_receipts
+    }
+}
diff --git a/semantics/language/src/analysis_fallback_io.rs b/semantics/language/src/analysis_fallback_io.rs
new file mode 100644
index 000000000..39d09b587
--- /dev/null
+++ b/semantics/language/src/analysis_fallback_io.rs
@@ -0,0 +1,240 @@
+//! Bounded actual-operation observations and replay of existing expression chains.
+use super::FallbackRoundRefusal;
+use alloc::{
+    string::{String, ToString},
+    vec::Vec,
+};
+use conduit_plot::{rust_binding::NativeRustBinding, PortableExpressionProgram};
+include!(concat!(env!("OUT_DIR"), "/fallback_round_programs.rs"));
+pub const MAXIMUM_ROUND_OBSERVATIONS: usize = 1024;
+pub const MAXIMUM_ROUND_BYTES: usize = 32 * 1024 * 1024;
+#[derive(Clone)]
+pub struct FallbackOperationObservation {
+    pub operation: String,
+    pub input: Vec<u8>,
+    pub output: Vec<u8>,
+}
+/// Supplies only actual output of the exact requested pure Source operation.
+/// Implementing this trait is not an installed-execution attestation.
+pub trait FallbackObservationProvider {
+    fn observe(&mut self, operation: &str, input: &[u8]) -> Result<Vec<u8>, FallbackRoundRefusal>;
+}
+pub struct PreparedFallbackRoundPrograms {
+    operations: Vec<(&'static str, Vec<PortableExpressionProgram>)>,
+}
+impl PreparedFallbackRoundPrograms {
+    pub fn prepare() -> Result<Self, FallbackRoundRefusal> {
+        let mut operations = Vec::new();
+        for (name, hexes) in FALLBACK_ROUND_PROGRAMS {
+            let programs = hexes
+                .iter()
+                .map(|hex| {
+                    PortableExpressionProgram::from_canonical_hex(hex)
+                        .map_err(|_| FallbackRoundRefusal::Program)
+                })
+                .collect::<Result<Vec<_>, _>>()?;
+            operations.push((*name, programs));
+        }
+        Ok(Self { operations })
+    }
+    pub fn programs(&self) -> &'static [(&'static str, &'static [&'static str])] {
+        FALLBACK_ROUND_PROGRAMS
+    }
+}
+pub(crate) struct Replay<'a> {
+    programs: &'a PreparedFallbackRoundPrograms,
+    observations: &'a [FallbackOperationObservation],
+    cursor: usize,
+    provider: Option<&'a mut dyn FallbackObservationProvider>,
+    captured: Vec<FallbackOperationObservation>,
+    captured_bytes: usize,
+}
+impl<'a> Replay<'a> {
+    pub fn new(
+        programs: &'a PreparedFallbackRoundPrograms,
+        observations: &'a [FallbackOperationObservation],
+    ) -> Result<Self, FallbackRoundRefusal> {
+        use FallbackRoundRefusal::*;
+        if observations.len() > MAXIMUM_ROUND_OBSERVATIONS {
+            return Err(Bound);
+        }
+        let mut bytes = 0usize;
+        for frame in observations {
+            if frame.operation.len() > 128
+                || frame.input.len() > 65536
+                || frame.output.len() > 65536
+            {
+                return Err(Bound);
+            }
+            bytes = bytes
+                .checked_add(frame.input.len())
+                .and_then(|v| v.checked_add(frame.output.len()))
+                .ok_or(Bound)?;
+            if bytes > MAXIMUM_ROUND_BYTES {
+                return Err(Bound);
+            }
+        }
+        Ok(Self {
+            programs,
+            observations,
+            cursor: 0,
+            provider: None,
+            captured: Vec::new(),
+            captured_bytes: 0,
+        })
+    }
+    pub fn with_provider(
+        programs: &'a PreparedFallbackRoundPrograms,
+        provider: &'a mut dyn FallbackObservationProvider,
+    ) -> Self {
+        Self {
+            programs,
+            observations: &[],
+            cursor: 0,
+            provider: Some(provider),
+            captured: Vec::with_capacity(MAXIMUM_ROUND_OBSERVATIONS),
+            captured_bytes: 0,
+        }
+    }
+    pub fn into_captured(self) -> Vec<FallbackOperationObservation> {
+        self.captured
+    }
+    pub fn run<I: NativeRustBinding + Clone, O: NativeRustBinding>(
+        &mut self,
+        name: &str,
+        input: &I,
+    ) -> Result<O, FallbackRoundRefusal> {
+        let bytes = input
+            .clone()
+            .encode()
+            .map_err(FallbackRoundRefusal::Native)?;
+        O::decode(&self.run_encoded(name, bytes)?).map_err(FallbackRoundRefusal::Native)
+    }
+    pub fn run_bool<I: NativeRustBinding + Clone>(
+        &mut self,
+        name: &str,
+        input: &I,
+    ) -> Result<bool, FallbackRoundRefusal> {
+        let bytes = input
+            .clone()
+            .encode()
+            .map_err(FallbackRoundRefusal::Native)?;
+        match self.run_encoded(name, bytes)?.as_slice() {
+            [0] => Ok(false),
+            [1] => Ok(true),
+            _ => Err(FallbackRoundRefusal::Admission),
+        }
+    }
+    fn run_encoded(&mut self, name: &str, bytes: Vec<u8>) -> Result<Vec<u8>, FallbackRoundRefusal> {
+        use FallbackRoundRefusal::*;
+        if bytes.len() > 65536 {
+            return Err(Bound);
+        }
+        let frame = if let Some(provider) = self.provider.as_mut() {
+            if self.captured.len() >= MAXIMUM_ROUND_OBSERVATIONS {
+                return Err(Bound);
+            }
+            let output = provider.observe(name, &bytes)?;
+            if output.len() > 65536 {
+                return Err(Bound);
+            }
+            let total = self
+                .captured_bytes
+                .checked_add(bytes.len())
+                .and_then(|v| v.checked_add(output.len()))
+                .ok_or(Bound)?;
+            if total > MAXIMUM_ROUND_BYTES {
+                return Err(Bound);
+            }
+            self.captured.push(FallbackOperationObservation {
+                operation: name.to_string(),
+                input: bytes.clone(),
+                output,
+            });
+            self.captured_bytes = total;
+            self.captured.last().ok_or(Bound)?
+        } else {
+            self.observations
+                .get(self.cursor)
+                .ok_or_else(|| IncompleteTrace {
+                    operation: name.to_string(),
+                    input: bytes.clone(),
+                })?
+        };
+        if frame.operation != name || frame.input != bytes {
+            return Err(ForeignObservation);
+        }
+        let programs = &self
+            .programs
+            .operations
+            .iter()
+            .find(|(n, _)| *n == name)
+            .ok_or(Program)?
+            .1;
+        let mut actual = bytes;
+        for program in programs {
+            actual = program.evaluate(&actual).map_err(|_| Evaluation)?;
+            if actual.len() > 65536 {
+                return Err(Bound);
+            }
+        }
+        if actual != frame.output {
+            return Err(ForeignObservation);
+        }
+        self.cursor += 1;
+        Ok(actual)
+    }
+    pub fn finish(self) -> Result<(), FallbackRoundRefusal> {
+        if self.provider.is_some() || self.cursor == self.observations.len() {
+            Ok(())
+        } else {
+            Err(FallbackRoundRefusal::ExtraObservation)
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn empty_programs() -> PreparedFallbackRoundPrograms {
+        PreparedFallbackRoundPrograms {
+            operations: Vec::new(),
+        }
+    }
+    #[test]
+    fn missing_foreign_and_extra_observations_refuse_without_execution() {
+        let programs = empty_programs();
+        let mut missing = Replay::new(&programs, &[]).unwrap();
+        assert!(matches!(
+            missing.run_encoded("expected", Vec::new()),
+            Err(FallbackRoundRefusal::IncompleteTrace { .. })
+        ));
+        let frames = [FallbackOperationObservation {
+            operation: "foreign".into(),
+            input: Vec::new(),
+            output: Vec::new(),
+        }];
+        let mut foreign = Replay::new(&programs, &frames).unwrap();
+        assert!(matches!(
+            foreign.run_encoded("expected", Vec::new()),
+            Err(FallbackRoundRefusal::ForeignObservation)
+        ));
+        assert!(matches!(
+            foreign.finish(),
+            Err(FallbackRoundRefusal::ExtraObservation)
+        ));
+    }
+    #[test]
+    fn oversized_frame_refuses_before_program_lookup_or_replay() {
+        let programs = empty_programs();
+        let frames = [FallbackOperationObservation {
+            operation: "expected".into(),
+            input: alloc::vec![0;65537],
+            output: Vec::new(),
+        }];
+        assert!(matches!(
+            Replay::new(&programs, &frames),
+            Err(FallbackRoundRefusal::Bound)
+        ));
+    }
+}
diff --git a/semantics/language/src/analysis_fallback_round.rs b/semantics/language/src/analysis_fallback_round.rs
new file mode 100644
index 000000000..5b455de9a
--- /dev/null
+++ b/semantics/language/src/analysis_fallback_round.rs
@@ -0,0 +1,354 @@
+//! One complete deterministic fallback round, never learned model evidence.
+//! Existing authored Source owns legality, lexical branching, rank and merge.
+use super::AnalysisEpochOwner;
+use crate::{analysis_epoch_initialization::admit, generated::LanguageAnalysisInitialRawBeam, *};
+use alloc::vec::Vec;
+use conduit_plot::rust_binding::NativeBindingRefusal;
+#[path = "analysis_fallback_io.rs"]
+pub(super) mod io;
+use io::Replay;
+pub use io::{
+    FallbackObservationProvider, FallbackOperationObservation, PreparedFallbackRoundPrograms,
+    MAXIMUM_ROUND_BYTES, MAXIMUM_ROUND_OBSERVATIONS,
+};
+#[derive(Debug)]
+pub enum FallbackRoundRefusal {
+    Native(NativeBindingRefusal),
+    Program,
+    Evaluation,
+    Bound,
+    IncompleteTrace {
+        operation: alloc::string::String,
+        input: Vec<u8>,
+    },
+    ExtraObservation,
+    ForeignObservation,
+    Admission,
+    Generation,
+    Stale,
+    Capacity,
+    Closed,
+}
+pub struct PreparedFallbackRound {
+    generation: u64,
+    prior: LanguageParserScorerBeam,
+    lexical: LanguageLexicalTape,
+    result: LanguageParserScorerBeam,
+    next_identity: u64,
+    observations: Vec<FallbackOperationObservation>,
+}
+pub struct FallbackRoundPreparationFailure {
+    pub refusal: FallbackRoundRefusal,
+    pub observations: Vec<FallbackOperationObservation>,
+}
+pub struct FallbackRoundApplyFailure {
+    pub refusal: FallbackRoundRefusal,
+    pub prepared: PreparedFallbackRound,
+}
+impl PreparedFallbackRound {
+    pub fn profile(&self) -> &'static str {
+        "language/complete-round/beam4/zero-score-fallback@1"
+    }
+    pub fn prior(&self) -> &LanguageParserScorerBeam {
+        &self.prior
+    }
+    pub fn result(&self) -> &LanguageParserScorerBeam {
+        &self.result
+    }
+    pub fn observations(&self) -> &[FallbackOperationObservation] {
+        &self.observations
+    }
+    pub fn source_id(&self) -> &'static str {
+        crate::parser_commitment::COMMITMENT_SOURCE_ID
+    }
+}
+impl<'a> AnalysisEpochOwner<'a> {
+    pub fn prepare_fallback_round(
+        &self,
+        programs: &PreparedFallbackRoundPrograms,
+        observations: Vec<FallbackOperationObservation>,
+    ) -> Result<PreparedFallbackRound, FallbackRoundPreparationFailure> {
+        let result = (|| {
+            if self.session.is_closed() {
+                return Err(FallbackRoundRefusal::Closed);
+            }
+            let mut replay = Replay::new(programs, &observations)?;
+            let result = self.run_fallback_round(&mut replay)?;
+            replay.finish()?;
+            Ok(result)
+        })();
+        match result {
+            Ok((result, next_identity)) => Ok(PreparedFallbackRound {
+                generation: self.generation,
+                prior: self.beam.clone(),
+                lexical: self.lexical().tape().clone(),
+                result,
+                next_identity,
+                observations,
+            }),
+            Err(refusal) => Err(FallbackRoundPreparationFailure {
+                refusal,
+                observations,
+            }),
+        }
+    }
+    pub fn prepare_fallback_round_with(
+        &self,
+        programs: &PreparedFallbackRoundPrograms,
+        provider: &mut dyn FallbackObservationProvider,
+    ) -> Result<PreparedFallbackRound, FallbackRoundPreparationFailure> {
+        if self.session.is_closed() {
+            return Err(FallbackRoundPreparationFailure {
+                refusal: FallbackRoundRefusal::Closed,
+                observations: Vec::new(),
+            });
+        }
+        let mut replay = Replay::with_provider(programs, provider);
+        let result = self.run_fallback_round(&mut replay);
+        let observations = replay.into_captured();
+        match result {
+            Ok((result, next_identity)) => Ok(PreparedFallbackRound {
+                generation: self.generation,
+                prior: self.beam.clone(),
+                lexical: self.lexical().tape().clone(),
+                result,
+                next_identity,
+                observations,
+            }),
+            Err(refusal) => Err(FallbackRoundPreparationFailure {
+                refusal,
+                observations,
+            }),
+        }
+    }
+    fn run_fallback_round(
+        &self,
+        replay: &mut Replay<'_>,
+    ) -> Result<(LanguageParserScorerBeam, u64), FallbackRoundRefusal> {
+        use FallbackRoundRefusal::*;
+        let lexical = LanguageParserAvailableLexical::new(
+            self.lexical().tape().clone(),
+            *self.beam.candidate0().parser().state().token_count(),
+        )
+        .map_err(Native)?;
+        let raw = raw_beam(&self.beam)?;
+        let seed: LanguageAnalysisInitialRawBeam =
+            replay.run("language/analysis-round-empty", &raw)?;
+        let mut next = admit_beam(&seed)?;
+        let mut identity = self.identity_cursor;
+        for prior in slots(&self.beam) {
+            if !*prior.parser().active() {
+                continue;
+            }
+            let complete =
+                replay.run_bool("language-parser-decode-complete", prior.parser().state())?;
+            if complete {
+                next = merge(replay, next, prior.clone())?;
+                continue;
+            }
+            let mut results = Vec::new();
+            for class in [0, 1, 2, 39, 73] {
+                let scored = scored(prior, class, 0)?;
+                let proposal: LanguageParserScoredProposal =
+                    replay.run("language-parser-score-proposal", &scored)?;
+                let actual: LanguageParserResult =
+                    replay.run("language-parser-transition", proposal.request())?;
+                results.push(actual);
+            }
+            let legality = LanguageParserScorerLegality::new(
+                prior.parser().state().basis().clone(),
+                results[2].clone(),
+                results[1].clone(),
+                results[3].clone(),
+                results[4].clone(),
+                results[0].clone(),
+            )
+            .map_err(Native)?;
+            let mask: LanguageParserScorerRanking =
+                replay.run("language-parser-scorer-legality", &legality)?;
+            // Enumerate every bounded alternative; only checked branch Source
+            // decides acceptance. No caller-selected candidate list is accepted.
+            let alternatives = if prior.parser().state().unread() < lexical.token_count() {
+                4
+            } else {
+                1
+            };
+            for choice in 0..alternatives {
+                let branch = if prior.parser().state().unread() < lexical.token_count() {
+                    let query =
+                        LanguageParserScorerBranch::new(choice, lexical.clone(), prior.clone())
+                            .map_err(Native)?;
+                    let actual: LanguageParserScorerBranchResult =
+                        replay.run("language-parser-scorer-branch", &query)?;
+                    if !*actual.accepted() {
+                        continue;
+                    }
+                    admit(actual.candidate()).map_err(|_| Admission)?
+                } else {
+                    prior.clone()
+                };
+                // Fallback Source overwrites every score; no numerical/model
+                // result can enter this deliberately reduced proof profile.
+                let mut rank: LanguageParserScorerRanking =
+                    replay.run("language-parser-scorer-fallback", &mask)?;
+                for _ in 0..4 {
+                    rank = replay.run("language-parser-scorer-rank", &rank)?;
+                    if !*rank.found() {
+                        break;
+                    }
+                    let scored = scored(&branch, *rank.class(), *rank.score())?;
+                    let proposal: LanguageParserScoredProposal =
+                        replay.run("language-parser-score-proposal", &scored)?;
+                    let actual: LanguageParserResult =
+                        replay.run("language-parser-transition", proposal.request())?;
+                    identity = identity.checked_add(1).ok_or(Generation)?;
+                    let query = LanguageParserScorerExpansion::new(
+                        identity,
+                        branch.clone(),
+                        actual,
+                        *rank.score(),
+                    )
+                    .map_err(Native)?;
+                    let raw: LanguageParserScorerRawHypothesis =
+                        replay.run("language-parser-scorer-expand", &query)?;
+                    if *raw.parser().active() {
+                        let candidate = admit(&raw).map_err(|_| Admission)?;
+                        next = merge(replay, next, candidate)?;
+                    }
+                    rank = replay.run("language-parser-scorer-ranking-next", &rank)?;
+                }
+            }
+        }
+        Ok((next, identity))
+    }
+
+    pub fn apply_fallback_round(
+        &mut self,
+        prepared: PreparedFallbackRound,
+    ) -> Result<(), FallbackRoundApplyFailure> {
+        let refusal = if self.session.is_closed() {
+            Some(FallbackRoundRefusal::Closed)
+        } else if self
+            .frontiers()
+            .stable_through
+            .is_some_and(|stable| stable > self.frontiers().committed)
+            || prepared.generation != self.generation
+            || prepared.prior != self.beam
+            || &prepared.lexical != self.lexical().tape()
+        {
+            Some(FallbackRoundRefusal::Stale)
+        } else if self.rounds.len() >= self.round_limit
+            || self.rounds.len() >= self.rounds.capacity()
+        {
+            Some(FallbackRoundRefusal::Capacity)
+        } else if self.generation.checked_add(1).is_none() {
+            Some(FallbackRoundRefusal::Generation)
+        } else {
+            None
+        };
+        if let Some(refusal) = refusal {
+            return Err(FallbackRoundApplyFailure { refusal, prepared });
+        }
+        self.beam = prepared.result.clone();
+        self.identity_cursor = prepared.next_identity;
+        self.generation += 1;
+        self.rounds.push(prepared);
+        Ok(())
+    }
+    pub fn fallback_rounds(&self) -> &[PreparedFallbackRound] {
+        &self.rounds
+    }
+}
+fn slots(beam: &LanguageParserScorerBeam) -> [&LanguageParserScorerHypothesis; 4] {
+    [
+        beam.candidate0(),
+        beam.candidate1(),
+        beam.candidate2(),
+        beam.candidate3(),
+    ]
+}
+fn numeric(s: &LanguageParserState) -> Result<LanguageParserNumericState, FallbackRoundRefusal> {
+    LanguageParserNumericState::new(
+        s.basis().clone(),
+        *s.committed(),
+        *s.depth(),
+        *s.heads(),
+        s.relation0().clone(),
+        s.relation1().clone(),
+        s.relation2().clone(),
+        s.relation3().clone(),
+        *s.stack(),
+        *s.token_count(),
+        *s.unread(),
+    )
+    .map_err(FallbackRoundRefusal::Native)
+}
+fn raw_hyp(
+    s: &LanguageParserScorerHypothesis,
+) -> Result<LanguageParserScorerRawHypothesis, FallbackRoundRefusal> {
+    use FallbackRoundRefusal::Native;
+    let p = s.parser();
+    let raw = LanguageParserRawHypothesis::new(
+        *p.active(),
+        *p.identity(),
+        *p.score(),
+        numeric(p.state())?,
+    )
+    .map_err(Native)?;
+    LanguageParserScorerRawHypothesis::new(*s.choices(), raw, *s.selected()).map_err(Native)
+}
+fn raw_beam(
+    b: &LanguageParserScorerBeam,
+) -> Result<LanguageAnalysisInitialRawBeam, FallbackRoundRefusal> {
+    LanguageAnalysisInitialRawBeam::new(
+        raw_hyp(b.candidate0())?,
+        raw_hyp(b.candidate1())?,
+        raw_hyp(b.candidate2())?,
+        raw_hyp(b.candidate3())?,
+    )
+    .map_err(FallbackRoundRefusal::Native)
+}
+fn admit_beam(
+    b: &LanguageAnalysisInitialRawBeam,
+) -> Result<LanguageParserScorerBeam, FallbackRoundRefusal> {
+    let conv = |h| admit(h).map_err(|_| FallbackRoundRefusal::Admission);
+    LanguageParserScorerBeam::new(
+        conv(b.candidate0())?,
+        conv(b.candidate1())?,
+        conv(b.candidate2())?,
+        conv(b.candidate3())?,
+    )
+    .map_err(FallbackRoundRefusal::Native)
+}
+fn scored(
+    h: &LanguageParserScorerHypothesis,
+    class: u64,
+    score: i64,
+) -> Result<LanguageParserScoredClass, FallbackRoundRefusal> {
+    use FallbackRoundRefusal::Native;
+    let relation = LanguageParserRelation::new(
+        LanguageUniversalDependencyRelation::Dep,
+        LanguageParserSubtype::new("".into()).map_err(Native)?,
+    )
+    .map_err(Native)?;
+    LanguageParserScoredClass::new(
+        h.parser().state().basis().clone(),
+        class,
+        relation,
+        score,
+        numeric(h.parser().state())?,
+    )
+    .map_err(Native)
+}
+fn merge(
+    replay: &mut Replay<'_>,
+    beam: LanguageParserScorerBeam,
+    candidate: LanguageParserScorerHypothesis,
+) -> Result<LanguageParserScorerBeam, FallbackRoundRefusal> {
+    let input =
+        LanguageParserScorerMerge::new(beam, candidate).map_err(FallbackRoundRefusal::Native)?;
+    replay.run("language-parser-scorer-merge", &input)
+}
