form greet (
    greeting: Text = "Hello"
    name: Text >> text: Text
) {
    join: text/join(greeting)
    name >> join >> text
}

form welcome {
    hello: greet("Welcome")
    "Travis" >> hello >> face/text("Message")
}

form default-welcome {
    hello: greet
    "Travis" >> hello >> face/text("Message")
}
