plot root (
    >> trigger: MathematicalValue
    result: MathematicalValue >>
) = (math/sqrt(2))

plot shift (
    >> value: MathematicalValue
    result: MathematicalValue >>
) = (. + math/radians(1°))

plot scale (
    >> value: MathematicalValue
    result: MathematicalValue >>
) = ((. * 3) / 2)

plot explain (
    >> value: MathematicalEnclosure <= 65536B
    result: Text >>
) = (.source == (((math/sqrt(2) + math/radians(1°)) * 3) / 2) ? (.maximum-width == 0.00000000000000001 ? "certified dynamic enclosure" : "wrong limit") : "wrong source")

plot main {
    seed: math/realize(request={value:0,maximum-error:0})
    coordinate: root
    translated: shift
    scaled: scale
    interval: math/enclose(request={maximum-width:0.00000000000000001})
    inspect: explain
    show: face/text("Certified composed symbolic value")
    seed.result >> (.source) >> coordinate.trigger
    coordinate.result >> translated.value
    translated.result >> scaled.value
    scaled.result >> interval.value
    interval.result >> inspect.value
    inspect.result >> show
}.
