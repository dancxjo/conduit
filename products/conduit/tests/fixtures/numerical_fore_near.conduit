plot frequency (
    >> trigger: MathematicalValue
    result: Quantity >>
) = (1Hz)

plot divide (
    >> value: Quantity
    result: Quantity >>
) = (. / 3)

plot explain (
    >> value: Frequency near 0.1Hz
    result: Text >>
) = (.source == 1 / 3 && .maximum-error == 1 / 100663296 ? "certified" : "wrong")

plot main {
    seed: math/realize(request={value:0,maximum-error:0})
    original: frequency
    third: divide
    boundary: math/near(limit=0.01Hz)
    check: explain
    show: face/text("Near frequency")
    seed.result >> (.source) >> original.trigger
    original.result >> third.value
    third.result >> boundary.value
    boundary.result >> check.value
    check.result >> show
}.
