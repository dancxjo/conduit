{
  "schema": "conduit.browser/application-package-template@1",
  "application_id": "conduit.application/home",
  "state_compatibility": { "identity": "conduit.application/home-state", "version": 1 },
  "host_implementations": ["browser/indexeddb@1"],
  "resources": [
    { "role": "application-module", "kind": "module", "path": "home.mjs", "maximum_bytes": 16384, "dependencies": [] },
    { "role": "application-style", "kind": "style", "path": "home.css", "maximum_bytes": 16384, "dependencies": [] },
    { "role": "hello-form", "kind": "content", "path": "hello.conduit", "maximum_bytes": 4096, "dependencies": [] },
    { "role": "runtime", "kind": "wasm", "path": "runtime.wasm", "maximum_bytes": 16777216, "dependencies": [] }
  ]
}
