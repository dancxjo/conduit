&& ret=0
;;
(unpack)
_arguments "${_arguments_options[@]}" : \
'--output-dir=[]:DIRECTORY:_files' \
'--format=[Select human, finite JSON, or streaming NDJSON primary output]:FORMAT:(human json ndjson)' \
'--diagnostic-format=[Select human or lossless JSON diagnostics on stderr]:DIAGNOSTIC_FORMAT:(human json)' \
