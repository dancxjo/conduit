'--verbose-diagnostics[Include related spans, notes, paths, and causes]' \
'-h[Print help]' \
'--help[Print help]' \
":: :_conduct__subcmd__capsule_commands" \
"*::: :->capsule" \
&& ret=0

    case $state in
    (capsule)
        words=($line[1] "${words[@]}")
        (( CURRENT += 1 ))
        curcontext="${curcontext%:*:*}:conduct-capsule-command-$line[1]:"
        case $line[1] in
            (pack)
_arguments "${_arguments_options[@]}" : \
'--lock=[]:LOCK:_files' \
'--presentation=[]:PRESENTATION:_files' \
'--references=[]:REFERENCES:_files' \
'--output=[]:CAPSULE:_files' \
'--format=[Select human, finite JSON, or streaming NDJSON primary output]:FORMAT:(human json ndjson)' \
