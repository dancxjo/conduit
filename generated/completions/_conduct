(( $+functions[_conduct_commands] )) ||
_conduct_commands() {
    local commands; commands=(
'inspect:Validate and describe one artifact without executing it' \
'compile:Compile source against explicit immutable inputs into one exact plan' \
'package:Create, verify, or extract a bounded content-addressed package' \
'capsule:Pack, inspect, check, unpack, or diff an authored panel capsule' \
    )
    _describe -t commands 'conduct commands' commands "$@"
}
(( $+functions[_conduct__subcmd__capsule_commands] )) ||
_conduct__subcmd__capsule_commands() {
    local commands; commands=(
'pack:Create one canonical capsule JSON document without fetching artifacts' \
'inspect:Validate and describe a capsule without executing its source' \
'check:Validate the capsule and parse its authored panel offline' \
'explain:Resolve and explain the capsule source without fetching artifacts' \
'unpack:Write source and optional auxiliary documents to a new directory' \
'diff:Compare authored, lock, reference, and presentation identities' \
    )
    _describe -t commands 'conduct capsule commands' commands "$@"
}
