# V2 preserves the v1 action labels but extends features from the exact
# admitted available prefix. Future candidate membership is not a POS choice.
type LanguageParserV2ChoiceQuery = {
    lexical: LanguageParserAvailableLexical
    state: LanguageParserState
    choices: collection U64 = 4
    epoch: U64
    invocation: U64
    where .epoch == .lexical.tape.source.sequence
    where .state.token_count == .lexical.token_count
    where .state.basis.text == .lexical.tape.source.material.identity
    where .state.basis.source_revision == .lexical.tape.source.material.revision
    where .lexical.token_count <= 0 ? true : (.choices.0 < sequence/length(sequence/at(.lexical.tape.tokens, 0).candidates))
    where .lexical.token_count <= 1 ? true : (.choices.1 < sequence/length(sequence/at(.lexical.tape.tokens, 1).candidates))
    where .lexical.token_count <= 2 ? true : (.choices.2 < sequence/length(sequence/at(.lexical.tape.tokens, 2).candidates))
    where .lexical.token_count <= 3 ? true : (.choices.3 < sequence/length(sequence/at(.lexical.tape.tokens, 3).candidates))
}
# Raw POS projection must be admitted as PosEvidence and joined to this State.
type LanguageParserV2PosContext = {
    query: LanguageParserV2ChoiceQuery
    pos: collection U64 = 4
    selected: LanguageLexicalPos
}
plot language-parser-v2-pos-begin (
    query: LanguageParserV2ChoiceQuery...| >> context: LanguageParserV2PosContext...|
) = { query: ., pos: [16,16,16,16], selected: other(unit) }
plot language-parser-v2-pos-select-0 (
    context: LanguageParserV2PosContext...| >> selected: LanguageParserV2PosContext...|
) = { query: .query, pos: .pos, selected: ((.query.lexical.token_count <= 0 || .query.state.unread < 0) ? other(unit) : (.query.choices.0 == 0 ? .query.lexical.tape.tokens.0.candidates.0.pos : (.query.choices.0 == 1 ? .query.lexical.tape.tokens.0.candidates.1.pos : (.query.choices.0 == 2 ? .query.lexical.tape.tokens.0.candidates.2.pos : .query.lexical.tape.tokens.0.candidates.3.pos)))) }
plot language-parser-v2-pos-code-0 (
    context: LanguageParserV2PosContext...| >> resolved: LanguageParserV2PosContext...|
) = { query: .query, selected: .selected, pos: [((.query.lexical.token_count <= 0 || .query.state.unread < 0) ? .pos.0 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16)))))), .pos.1, .pos.2, .pos.3] }
