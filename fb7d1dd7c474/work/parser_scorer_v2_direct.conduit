) = { query: .query, pos: .pos, selected: ((.query.lexical.token_count <= 1 || .query.state.unread < 1) ? other(unit) : (.query.choices.1 == 0 ? .query.lexical.tape.tokens.1.candidates.0.pos : (.query.choices.1 == 1 ? .query.lexical.tape.tokens.1.candidates.1.pos : (.query.choices.1 == 2 ? .query.lexical.tape.tokens.1.candidates.2.pos : .query.lexical.tape.tokens.1.candidates.3.pos)))) }
