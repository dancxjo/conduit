plot language-parser-v2-pos (
    query: LanguageParserV2ChoiceQuery...| >> context: LanguageParserV2PosContext...|
) {
    query >> language-parser-v2-pos-begin() >> language-parser-v2-pos-select-0() >> language-parser-v2-pos-code-0() >> language-parser-v2-pos-select-1() >> language-parser-v2-pos-code-1() >> language-parser-v2-pos-select-2() >> language-parser-v2-pos-code-2() >> language-parser-v2-pos-select-3() >> language-parser-v2-pos-code-3() >> context
