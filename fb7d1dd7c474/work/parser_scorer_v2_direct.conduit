type LanguageParserV2FeaturesContext = {
    input: LanguageParserV2PosContext
    top: U64
    top_pos: U64
    next_pos: U64
}
type LanguageParserV2ModelFeatures = {
    basis: LanguageParserBasis
    indices: collection U64 = 25
}
plot language-parser-v2-features-begin (
    input: LanguageParserV2PosContext...| >> output: LanguageParserV2FeaturesContext...|
) = { input: ., top: sequence/at(.query.state.stack, .query.state.depth - 1), top_pos: 17, next_pos: 17 }
plot language-parser-v2-features-pos (
    input: LanguageParserV2FeaturesContext...| >> output: LanguageParserV2FeaturesContext...|
) = { input: .input, top: .top, top_pos: (.top == 4 ? 17 : sequence/at(.input.pos, .top)), next_pos: (.input.query.state.unread == .input.query.lexical.token_count ? 17 : sequence/at(.input.pos, .input.query.state.unread)) }
