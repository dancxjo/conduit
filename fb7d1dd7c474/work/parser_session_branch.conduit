# Protected head lexical choices strengthen the unchanged pinned v2 branch ABI.
# The protection set is derived from actual committed arcs in the admitted state.
plot language-parser-joint-protected-branch (
    query: LanguageParserJointBranchQuery...| >> result: LanguageParserJointBranchResult...|
) = { proposal: { hypothesis: { parser: { state: { basis: .hypothesis.hypothesis.parser.state.basis, token_count: .hypothesis.hypothesis.parser.state.token_count, unread: .hypothesis.hypothesis.parser.state.unread, depth: .hypothesis.hypothesis.parser.state.depth, stack: .hypothesis.hypothesis.parser.state.stack, heads: .hypothesis.hypothesis.parser.state.heads, relation0: .hypothesis.hypothesis.parser.state.relation0, relation1: .hypothesis.hypothesis.parser.state.relation1, relation2: .hypothesis.hypothesis.parser.state.relation2, relation3: .hypothesis.hypothesis.parser.state.relation3, committed: .hypothesis.hypothesis.parser.state.committed }, active: .hypothesis.hypothesis.parser.active, identity: .hypothesis.hypothesis.parser.identity, score: .hypothesis.hypothesis.parser.score }, choices: [(.hypothesis.selected == 0 && .hypothesis.hypothesis.parser.state.unread == 0 ? .choice : .hypothesis.hypothesis.choices.0), (.hypothesis.selected == 1 && .hypothesis.hypothesis.parser.state.unread == 1 ? .choice : .hypothesis.hypothesis.choices.1), (.hypothesis.selected == 2 && .hypothesis.hypothesis.parser.state.unread == 2 ? .choice : .hypothesis.hypothesis.choices.2), (.hypothesis.selected == 3 && .hypothesis.hypothesis.parser.state.unread == 3 ? .choice : .hypothesis.hypothesis.choices.3)] }, selected: (.hypothesis.selected == .hypothesis.hypothesis.parser.state.unread && .hypothesis.selected < .lexical.token_count ? .hypothesis.selected + 1 : .hypothesis.selected) }, accepted: ((!((.hypothesis.hypothesis.parser.state.committed > 0 && .hypothesis.hypothesis.parser.state.heads.0 == .hypothesis.hypothesis.parser.state.unread) || (.hypothesis.hypothesis.parser.state.committed > 1 && .hypothesis.hypothesis.parser.state.heads.1 == .hypothesis.hypothesis.parser.state.unread) || (.hypothesis.hypothesis.parser.state.committed > 2 && .hypothesis.hypothesis.parser.state.heads.2 == .hypothesis.hypothesis.parser.state.unread) || (.hypothesis.hypothesis.parser.state.committed > 3 && .hypothesis.hypothesis.parser.state.heads.3 == .hypothesis.hypothesis.parser.state.unread)) || .choice == sequence/at(.hypothesis.hypothesis.choices,.hypothesis.hypothesis.parser.state.unread)) && (.hypothesis.selected == .hypothesis.hypothesis.parser.state.unread ? (.hypothesis.hypothesis.parser.state.unread < .lexical.token_count ? (.hypothesis.hypothesis.parser.state.unread == 0 ? .choice < sequence/length(.lexical.tape.tokens.0.candidates) : (.hypothesis.hypothesis.parser.state.unread == 1 ? .choice < sequence/length(.lexical.tape.tokens.1.candidates) : (.hypothesis.hypothesis.parser.state.unread == 2 ? .choice < sequence/length(.lexical.tape.tokens.2.candidates) : (.hypothesis.hypothesis.parser.state.unread == 3 ? .choice < sequence/length(.lexical.tape.tokens.3.candidates) : false)))) : false) : .choice == sequence/at(.hypothesis.hypothesis.choices, .hypothesis.hypothesis.parser.state.unread))) }
