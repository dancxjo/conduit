# Contiguous semantic commitment is separate from independent stable facts.
# The first committed candidate is an actual admitted survivor, and every active
# survivor must share the same previous dependency frontier.
type LanguageParserJointCommitQuery = {
 fact: LanguageParserJointStableFact
 where .fact.query.dependent == .fact.query.beam.candidate0.parser.state.committed
 where !.fact.query.beam.candidate1.parser.active || .fact.query.beam.candidate1.parser.state.committed == .fact.query.beam.candidate0.parser.state.committed
 where !.fact.query.beam.candidate2.parser.active || .fact.query.beam.candidate2.parser.state.committed == .fact.query.beam.candidate0.parser.state.committed
 where !.fact.query.beam.candidate3.parser.active || .fact.query.beam.candidate3.parser.state.committed == .fact.query.beam.candidate0.parser.state.committed
}
type LanguageParserJointCommitProposal = {
 candidate0: LanguageParserRawJointHypothesis
 candidate1: LanguageParserRawJointHypothesis
 candidate2: LanguageParserRawJointHypothesis
 candidate3: LanguageParserRawJointHypothesis
}
plot language-parser-joint-commit (
 input: LanguageParserJointCommitQuery...| >> output: LanguageParserJointCommitProposal...|
) = { candidate0: { parser: { state: { basis: .fact.query.beam.candidate0.parser.state.basis, token_count: .fact.query.beam.candidate0.parser.state.token_count, unread: .fact.query.beam.candidate0.parser.state.unread, depth: .fact.query.beam.candidate0.parser.state.depth, stack: .fact.query.beam.candidate0.parser.state.stack, heads: .fact.query.beam.candidate0.parser.state.heads, relation0: .fact.query.beam.candidate0.parser.state.relation0, relation1: .fact.query.beam.candidate0.parser.state.relation1, relation2: .fact.query.beam.candidate0.parser.state.relation2, relation3: .fact.query.beam.candidate0.parser.state.relation3, committed: (.fact.query.beam.candidate0.parser.active ? .fact.query.beam.candidate0.parser.state.committed + 1 : .fact.query.beam.candidate0.parser.state.committed) }, identity: .fact.query.beam.candidate0.parser.identity, score: .fact.query.beam.candidate0.parser.score, active: .fact.query.beam.candidate0.parser.active }, choices: .fact.query.beam.candidate0.choices }, candidate1: { parser: { state: { basis: .fact.query.beam.candidate1.parser.state.basis, token_count: .fact.query.beam.candidate1.parser.state.token_count, unread: .fact.query.beam.candidate1.parser.state.unread, depth: .fact.query.beam.candidate1.parser.state.depth, stack: .fact.query.beam.candidate1.parser.state.stack, heads: .fact.query.beam.candidate1.parser.state.heads, relation0: .fact.query.beam.candidate1.parser.state.relation0, relation1: .fact.query.beam.candidate1.parser.state.relation1, relation2: .fact.query.beam.candidate1.parser.state.relation2, relation3: .fact.query.beam.candidate1.parser.state.relation3, committed: (.fact.query.beam.candidate1.parser.active ? .fact.query.beam.candidate1.parser.state.committed + 1 : .fact.query.beam.candidate1.parser.state.committed) }, identity: .fact.query.beam.candidate1.parser.identity, score: .fact.query.beam.candidate1.parser.score, active: .fact.query.beam.candidate1.parser.active }, choices: .fact.query.beam.candidate1.choices }, candidate2: { parser: { state: { basis: .fact.query.beam.candidate2.parser.state.basis, token_count: .fact.query.beam.candidate2.parser.state.token_count, unread: .fact.query.beam.candidate2.parser.state.unread, depth: .fact.query.beam.candidate2.parser.state.depth, stack: .fact.query.beam.candidate2.parser.state.stack, heads: .fact.query.beam.candidate2.parser.state.heads, relation0: .fact.query.beam.candidate2.parser.state.relation0, relation1: .fact.query.beam.candidate2.parser.state.relation1, relation2: .fact.query.beam.candidate2.parser.state.relation2, relation3: .fact.query.beam.candidate2.parser.state.relation3, committed: (.fact.query.beam.candidate2.parser.active ? .fact.query.beam.candidate2.parser.state.committed + 1 : .fact.query.beam.candidate2.parser.state.committed) }, identity: .fact.query.beam.candidate2.parser.identity, score: .fact.query.beam.candidate2.parser.score, active: .fact.query.beam.candidate2.parser.active }, choices: .fact.query.beam.candidate2.choices }, candidate3: { parser: { state: { basis: .fact.query.beam.candidate3.parser.state.basis, token_count: .fact.query.beam.candidate3.parser.state.token_count, unread: .fact.query.beam.candidate3.parser.state.unread, depth: .fact.query.beam.candidate3.parser.state.depth, stack: .fact.query.beam.candidate3.parser.state.stack, heads: .fact.query.beam.candidate3.parser.state.heads, relation0: .fact.query.beam.candidate3.parser.state.relation0, relation1: .fact.query.beam.candidate3.parser.state.relation1, relation2: .fact.query.beam.candidate3.parser.state.relation2, relation3: .fact.query.beam.candidate3.parser.state.relation3, committed: (.fact.query.beam.candidate3.parser.active ? .fact.query.beam.candidate3.parser.state.committed + 1 : .fact.query.beam.candidate3.parser.state.committed) }, identity: .fact.query.beam.candidate3.parser.identity, score: .fact.query.beam.candidate3.parser.score, active: .fact.query.beam.candidate3.parser.active }, choices: .fact.query.beam.candidat