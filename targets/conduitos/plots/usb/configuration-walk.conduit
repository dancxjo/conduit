# Complete received configuration geometry. Descriptive records confer no authority.
# The profile admits four interface/alternate records, eight endpoints and
# sixteen complete subordinate descriptors; unknown class records consume steps.
type UsbConfigurationTransfer = {
    wire: sequence U8 <= 256
    actual: U64
}
type UsbConfigurationInterface = {
    number: U8
    alternate: U8
    endpoints: U8
    class: U8
    subclass: U8
    protocol: U8
}
type UsbConfigurationEndpoint = {
    interface_slot: U64
    address: U8
    attributes: U8
    packet_field: U64
    interval: U8
}
type UsbConfigurationTopology = {
    configuration_value: U8
    attributes: U8
    maximum_power_field: U8
    distinct_interfaces: U64
    interface_count: U64
    endpoint_count: U64
    interfaces: collection UsbConfigurationInterface = 4
    endpoints: collection UsbConfigurationEndpoint = 8
}
# Internal words preserve six interface octets in wire order (number, alternate,
# endpoint count, class, subclass, protocol). Endpoint words preserve interface
# slot, address, attributes, two packet-field octets, then interval. Both retain
# the received descriptor offset in octet six. Final U8 fields are selected
# from actual received wire octets, never unchecked narrowing casts. This keeps
# the entire received frame and metadata inside the existing native Fore budget.
type UsbConfigurationWalkMetadata = {
    configuration_value: U8
    attributes: U8
    maximum_power_field: U8
    distinct_interfaces: U64
    interface_count: U64
    endpoint_count: U64
    interfaces: collection U64 = 4
    endpoints: collection U64 = 8
}
# Status: 0 walking, 1 short, 2 malformed, 3 oversized. Only finish exports
# protocol dispositions; intermediate bounded state is not an endpoint offer.
type UsbConfigurationWalkState = {
    wire: sequence U8 <= 256
    total: U64
    cursor: U64
    records: U64
    phase: U8
    status: U8
    declared_interfaces: U8
    current_endpoints: U64
    topology: UsbConfigurationWalkMetadata
}
type UsbConfigurationTopologyResult =
    configuration UsbConfigurationTopology
    | short
    | malformed
    | oversized

plot usb-configuration-walk-start (
    input: UsbConfigurationTransfer...| >> result: UsbConfigurationWalkState...|
) = ({ wire: .wire, total: sequence/length(.wire) < 9 ? 0 : value/u64(sequence/at(.wire, 2)) + value/u64(sequence/at(.wire, 3)) * 256, cursor: 9, records: 0, phase: 0, status: .actual > 256 ? 3 : .actual != sequence/length(.wire) ? 2 : .actual < 9 ? 1 : (sequence/at(.wire, 0) != 9 || (sequence/at(.wire, 1) != 2 || value/u64(sequence/at(.wire, 2)) + value/u64(sequence/at(.wire, 3)) * 256 < 9)) ? 2 : value/u64(sequence/at(.wire, 2)) + value/u64(sequence/at(.wire, 3)) * 256 > 256 ? 3 : value/u64(sequence/at(.wire, 2)) + value/u64(sequence/at(.wire, 3)) * 256 > .actual ? 1 : ((value/u64(sequence/at(.wire, 2)) + value/u64(sequence/at(.wire, 3)) * 256 != .actual || sequence/at(.wire, 4) == 0) || (sequence/at(.wire, 5) == 0 || (sequence/at(.wire, 7) & 128) == 0)) ? 2 : 0, declared_interfaces: sequence/length(.wire) < 9 ? 0 : sequence/at(.wire, 4), current_endpoints: 0, topology: { configuration_value: sequence/length(.wire) < 9 ? 0 : sequence/at(.wire, 5), attributes: sequence/length(.wire) < 9 ? 0 : sequence/at(.wire, 7), maximum_power_field: sequence/length(.wire) < 9 ? 0 : sequence/at(.wire, 8), distinct_interfaces: 0, interface_count: 0, endpoint_count: 0, interfaces: [0, 0, 0, 0], endpoints: [0, 0, 0, 0, 0, 0, 0, 0] } })

