    input: UsbConfigurationWalkState...| >> result: UsbConfigurationWalkState...|
) = (.status != 0 ? . : .cursor > .total || .total != sequence/length(.wire) ? { wire: .wire, total: .total, cursor: .cursor, records: .records, phase: .phase, status: 2, declared_interfaces: .declared_interfaces, current_endpoints: .current_endpoints, topology: .topology } : .cursor == .total ? . : .records >= 16 ? { wire: .wire, total: .total, cursor: .cursor, records: .records, phase: .phase, status: 3, declared_interfaces: .declared_interfaces, current_endpoints: .current_endpoints, topology: .topology } : .total - .cursor < 2 ? { wire: .wire, total: .total, cursor: .cursor, records: .records, phase: .phase, status: 2, declared_interfaces: .declared_interfaces, current_endpoints: .current_endpoints, topology: .topology } : value/u64(sequence/at(.wire, .cursor)) < 2 || value/u64(sequence/at(.wire, .cursor)) > .total - .cursor ? { wire: .wire, total: .total, cursor: .cursor, records: .records, phase: .phase, status: 2, declared_interfaces: .declared_interfaces, current_endpoints: .current_endpoints, topology: .topology } : ((sequence/at(.wire, .cursor + 1) == 4 && value/u64(sequence/at(.wire, .cursor)) < 9) || (sequence/at(.wire, .cursor + 1) == 5 && (value/u64(sequence/at(.wire, .cursor)) < 7 || .topology.interface_count == 0))) ? { wire: .wire, total: .total, cursor: .cursor, records: .records, phase: .phase, status: 2, declared_interfaces: .declared_interfaces, current_endpoints: .current_endpoints, topology: .topology } : sequence/at(.wire, .cursor + 1) == 4 ? { wire: .wire, total: .total, cursor: .cursor, records: .records, phase: 1, status: .status, declared_interfaces: .declared_interfaces, current_endpoints: .current_endpoints, topology: .topology } : sequence/at(.wire, .cursor + 1) == 5 ? { wire: .wire, total: .total, cursor: .cursor, records: .records, phase: 2, status: .status, declared_interfaces: .declared_interfaces, current_endpoints: .current_endpoints, topology: .topology } : sequence/at(.wire, .cursor + 1) == 2 ? { wire: .wire, total: .total, cur