with machine/usb/endpoint-read/request as UsbEndpointReadRequest

# Two exact planned calls share a Root-admitted endpoint capture window.
# Root reuses a member only after its prior ordered observation is delivered.
plot usb-hid-mouse-capture-request (
    read: Unit...| >> request: UsbEndpointReadRequest...| <= 4096B
) = ({ length: 8 })

# One event Fore carries observations and their final outcome in order.
# Concatenation waits for observation EOF before publishing the final outcome.
plot usb-hid-mouse-capture-window (
    >> begin: Unit...|
    >> read0: Unit...|
    >> read1: Unit...|
    event: UsbMousePointerEvent...| >>
) {
    state: usb-hid-mouse-order-lifecycle
    commands: flow/concat/finite
    transfer0: machine/usb/endpoint-read
    transfer1: machine/usb/endpoint-read
    completed: flow/merge/finite
    begin >> state.begin
    begin >> usb-hid-mouse-endpoint-finish() >> usb-hid-mouse-order-command-message() >> commands.right
    read0 >> usb-hid-mouse-capture-request() >> transfer0.request
    transfer0.result >> usb-hid-mouse-endpoint-command-message() >> completed.left
    read1 >> usb-hid-mouse-capture-request() >> transfer1.request
    transfer1.result >> usb-hid-mouse-endpoint-command-message() >> completed.right
    completed.merged >> commands.left
    commands.concatenated >> select(UsbMouseOrderMessage.command, unmatched=drop) >> state.command
    state.event >> event
}
