# The caller authors these eight ordered48-frame PCM payload projections.
# The header owns their original1536-byte extent; transport deadlines are later
# computed by checked Source from an actual controller clock observation.
type PcmSegment = {
    wire: Bytes <= 256B
}
type UsbAudioAuthoredPcm = {
    header: PcmFrameHeader
    cadence: UsbPcmCadence
    segments: sequence PcmSegment <= 8
}
type UsbAudioPlaybackStatus =
    running
    | completed
    | unsupported-pcm
    | setup-rejected
    | stalled
    | unsupported-control
    | unsupported-clock
    | invalid-completion
    | short
    | missed-service
    | underrun
    | provider-lost

# Internal finite Source state/event status codes are decoded to the complete
# typed outward status in usb-audio-play-report; native outcomes stay distinct.
type AudioState = {
    h: PcmFrameHeader
    p: sequence PcmSegment <= 8
    q: U64
    f: U64
    s: U64
    n: U64
    b: U64
    terminal: Boolean
}
type UsbAudioPlaybackRoute =
    control AudioState
    | iso AudioState
    | stopped AudioState

type UsbAudioPlaybackActive =
    running AudioState
    | stopped

# Exactly eight Source event words: kind, phase ack mask, first USB frame,
# status code, completed packet count, actual bytes, acknowledged stop, support.
# Ack bits 1/2/4/8 preserve descriptor/zero/SET/GET observations separately.
type AudioEvent = {
    k: U64
    a: U64
    f: U64
    s: U64
    n: U64
    b: U64
    t: U64
    p: U64
}
type UsbAudioPlaybackReport = {
    header: PcmFrameHeader
    first-frame: U64
    status: UsbAudioPlaybackStatus
    completed-packets: U64
    actual-bytes: U64
}
