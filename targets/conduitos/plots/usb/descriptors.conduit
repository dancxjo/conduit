# USB wire framing only. No controller, attachment selection or authority.
# The cursor consumes header octets extracted from the actual bounded transfer.
# Caller storage and header availability remain explicit; padding is never data.
type UsbDescriptorCursor = {
    offset: U64
    available: U64
    length: U64
    descriptor_type: U64
}
type UsbDescriptorAdvance =
    descriptor {
        next: U64
        length: U64
        descriptor_type: U64
    }
    | end
    | short
    | malformed
    | oversized

plot usb-descriptor-advance (
    cursor: UsbDescriptorCursor >> result: UsbDescriptorAdvance
) = (.available > 256 ? oversized(unit) : (.offset > .available ? malformed(unit) : (.offset == .available ? end(unit) : (.available - .offset < 2 ? short(unit) : (.length < 2 || .length > 255 || .descriptor_type > 255 ? malformed(unit) : (.length > .available - .offset ? short(unit) : descriptor({ next: .offset + .length, length: .length, descriptor_type: .descriptor_type })))))))

# Device descriptor prefix, from a transfer into fixed reusable storage.
# The actual count is independent of the eighteen storage octets.
type UsbDeviceDescriptorFrame = {
    wire: collection U8 = 18
    actual: U64
}
type UsbDeviceDescriptor = {
    usb_version: U64
    device_class: U8
    device_subclass: U8
    device_protocol: U8
    ep0_packet_field: U8
    vendor_id: U64
    product_id: U64
    device_version: U64
    manufacturer_index: U8
    product_index: U8
    serial_index: U8
    configurations: U8
}
type UsbDeviceDescriptorResult =
    device UsbDeviceDescriptor
    | short
    | malformed

# Packet-field interpretation depends on negotiated USB speed. This decoder
# preserves it exactly rather than treating a SuperSpeed exponent as bytes.
plot usb-device-descriptor (
    frame: UsbDeviceDescriptorFrame...| >> result: UsbDeviceDescriptorResult...|
) = (.actual > 18 ? malformed(unit) : (.actual < 2 ? short(unit) : (.wire.0 != 18 || .wire.1 != 1 ? malformed(unit) : (.actual < 18 ? short(unit) : device({ usb_version: value/u64(.wire.2) + value/u64(.wire.3) * 256, device_class: .wire.4, device_subclass: .wire.5, device_protocol: .wire.6, ep0_packet_field: .wire.7, vendor_id: value/u64(.wire.8) + value/u64(.wire.9) * 256, product_id: value/u64(.wire.10) + value/u64(.wire.11) * 256, device_version: value/u64(.wire.12) + value/u64(.wire.13) * 256, manufacturer_index: .wire.14, product_index: .wire.15, serial_index: .wire.16, configurations: .wire.17 })))))
