# Exactly one authored PCM block follows setup once, clock observation, batch,
# and explicit drain. This first mechanic does not promise continuous refill.
with machine/usb/control/request as UsbControlRequest
with machine/usb/control/result as UsbControlResult
with machine/usb/isochronous-out/request as UsbIsochronousOutRequest
with machine/usb/isochronous-out/result as UsbIsochronousOutResult
with flow/zip/feedback/paired as UsbAudioPlaybackPair

plot usb-audio-play-advance (
 pair: UsbAudioPlaybackPair...| >> state: AudioState...|
) = ({ h: .0.h, p: .0.p, q: ((.1.t == 1) ? .0.q : (.0.q < 5 ? (.1.k == 0 && (.0.q == 0 ? (.1.a % 2 == 1) : (.0.q == 1 || .0.q == 2 ? ((.1.a / 2) % 2 == 1) : (.0.q == 3 ? ((.1.a / 4) % 2 == 1) : ((.1.a / 8) % 2 == 1)))) ? .0.q + 1 : 7) : (.0.q == 5 ? ((.1.k == 1 && (.1.p == 1)) ? 6 : 7) : 7))), f: (.0.q == 5 && (.1.k == 1 && (.1.p == 1)) ? .1.f : .0.f), s: ((.1.t == 1) ? .1.s : (.0.q < 5 ? (.1.s == 5 ? 5 : (.1.k == 0 && (.0.q == 0 ? (.1.a % 2 == 1) : (.0.q == 1 || .0.q == 2 ? ((.1.a / 2) % 2 == 1) : (.0.q == 3 ? ((.1.a / 4) % 2 == 1) : ((.1.a / 8) % 2 == 1)))) ? 0 : 3)) : (.0.q == 5 ? ((.1.k == 1 && (.1.p == 1)) ? 0 : 6) : (.0.q == 6 ? ((.1.k == 2 && (.1.p == 1) && .1.f == .0.f) ? 1 : 7) : (.1.k == 3 ? .0.s : 7))))), n: (.0.q == 6 ? .1.n : .0.n), b: (.0.q == 6 ? .1.b : .0.b), terminal: ((.1.t == 1) || .0.q == 7) })
plot usb-audio-play-report (
 state: AudioState...| >> report: UsbAudioPlaybackReport...|
) = ({ header: .h, first-frame: .f, status: (.s == 0 ? running(empty) : (.s == 1 ? completed(empty) : (.s == 2 ? unsupported-pcm(empty) : (.s == 3 ? setup-rejected(empty) : (.s == 4 ? stalled(empty) : (.s == 5 ? unsupported-control(empty) : (.s == 6 ? unsupported-clock(empty) : (.s == 8 ? short(empty) : (.s == 9 ? missed-service(empty) : (.s == 10 ? underrun(empty) : (.s == 11 ? provider-lost(empty) : invalid-completion(empty)))))))))))), completed-packets: .n, actual-bytes: .b })
plot usb-audio-playback (
 >> pcm: UsbAudioAuthoredPcm...|
 report: UsbAudioPlaybackReport...| >>
) {
 state: state/seeded/flow/until
 route: usb-audio-play-route()
 join: flow/zip/feedback
 events: flow/merge/finite
 control: machine/usb/control
 iso: machine/usb/isochronous-out
 pcm >> usb-audio-play-start() >> state.seed
 state.current >> route
 state.current >> usb-audio-play-active() >> select(UsbAudioPlaybackActive.running, unmatched=drop) >> join.left
 route >> select(UsbAudioPlaybackRoute.control, unmatched=drop) >> usb-audio-play-control-request() >> control.request
 route >> select(UsbAudioPlaybackRoute.iso, unmatched=drop) >> usb-audio-play-iso-request() >> iso.request
 control.result >> usb-audio-play-control-event() >> events.left
 iso.result >> usb-audio-play-iso-event() >> events.right
 events.merged >> join.right
 join.paired >> usb-audio-play-advance() >> state.next
 route >> select(UsbAudioPlaybackRoute.stopped, unmatched=drop) >> usb-audio-play-report() >> report
}
