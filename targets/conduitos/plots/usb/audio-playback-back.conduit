# Exactly one authored PCM block follows setup once, clock observation, batch,
# and explicit drain. This first mechanic does not promise continuous refill.
with machine/usb/control/request as UsbControlRequest
with machine/usb/control/result as UsbControlResult
with machine/usb/isochronous-out/request as UsbIsochronousOutRequest
with machine/usb/isochronous-out/result as UsbIsochronousOutResult
with flow/zip/feedback/paired as UsbAudioPlaybackPair

plot usb-audio-play-advance (
 pair: UsbAudioPlaybackPair...| >> state: UsbAudioPlaybackState...|
) = ({ header: .0.header, segments: .0.segments, phase: ((sequence/at(.1.words, 6) == 1) ? .0.phase : (.0.phase < 5 ? (sequence/at(.1.words, 0) == 0 && (.0.phase == 0 ? (sequence/at(.1.words, 1) % 2 == 1) : (.0.phase == 1 || .0.phase == 2 ? ((sequence/at(.1.words, 1) / 2) % 2 == 1) : (.0.phase == 3 ? ((sequence/at(.1.words, 1) / 4) % 2 == 1) : ((sequence/at(.1.words, 1) / 8) % 2 == 1)))) ? .0.phase + 1 : 7) : (.0.phase == 5 ? ((sequence/at(.1.words, 0) == 1 && (sequence/at(.1.words, 7) == 1)) ? 6 : 7) : 7))), first-frame: (.0.phase == 5 && (sequence/at(.1.words, 0) == 1 && (sequence/at(.1.words, 7) == 1)) ? sequence/at(.1.words, 2) : .0.first-frame), status: ((sequence/at(.1.words, 6) == 1) ? sequence/at(.1.words, 3) : (.0.phase < 5 ? (sequence/at(.1.words, 3) == 5 ? 5 : (sequence/at(.1.words, 0) == 0 && (.0.phase == 0 ? (sequence/at(.1.words, 1) % 2 == 1) : (.0.phase == 1 || .0.phase == 2 ? ((sequence/at(.1.words, 1) / 2) % 2 == 1) : (.0.phase == 3 ? ((sequence/at(.1.words, 1) / 4) % 2 == 1) : ((sequence/at(.1.words, 1) / 8) % 2 == 1)))) ? 0 : 3)) : (.0.phase == 5 ? ((sequence/at(.1.words, 0) == 1 && (sequence/at(.1.words, 7) == 1)) ? 0 : 6) : (.0.phase == 6 ? ((sequence/at(.1.words, 0) == 2 && (sequence/at(.1.words, 7) == 1) && sequence/at(.1.words, 2) == .0.first-frame) ? 1 : 7) : (sequence/at(.1.words, 0) == 3 ? .0.status : 7))))), completed-packets: (.0.phase == 6 ? sequence/at(.1.words, 4) : .0.completed-packets), actual-bytes: (.0.phase == 6 ? sequence/at(.1.words, 5) : .0.actual-bytes), terminal: ((sequence/at(.1.words, 6) == 1) || .0.phase == 7) })
plot usb-audio-play-report (
 state: UsbAudioPlaybackState...| >> report: UsbAudioPlaybackReport...|
) = ({ header: .header, first-frame: .first-frame, status: (.status == 0 ? running(empty) : (.status == 1 ? completed(empty) : (.status == 2 ? unsupported-pcm(empty) : (.status == 3 ? setup-rejected(empty) : (.status == 4 ? stalled(empty) : (.status == 5 ? unsupported-control(empty) : (.status == 6 ? unsupported-clock(empty) : (.status == 8 ? short(empty) : (.status == 9 ? missed-service(empty) : (.status == 10 ? underrun(empty) : (.status == 11 ? provider-lost(empty) : invalid-completion(empty)))))))))))), completed-packets: .completed-packets, actual-bytes: .actual-bytes })
plot usb-audio-playback (
 >> pcm: UsbAudioAuthoredPcm...|
 report: UsbAudioPlaybackReport...| >>
) {
 state: state/seeded/flow/until
 route: usb-audio-play-route()
 join: flow/zip/feedback
 events: flow/merge/finite
 control: machine/usb/control
 iso: machine/usb/isochronous-out
 pcm >> usb-audio-play-start() >> state.seed
 state.current >> route
 state.current >> usb-audio-play-active() >> select(UsbAudioPlaybackActive.running, unmatched=drop) >> join.left
 route >> select(UsbAudioPlaybackRoute.control, unmatched=drop) >> usb-audio-play-control-request() >> control.request
 route >> select(UsbAudioPlaybackRoute.iso, unmatched=drop) >> usb-audio-play-iso-request() >> iso.request
 control.result >> usb-audio-play-control-event() >> events.left
 iso.result >> usb-audio-play-iso-event() >> events.right
 events.merged >> join.right
 join.paired >> usb-audio-play-advance() >> state.next
 route >> select(UsbAudioPlaybackRoute.stopped, unmatched=drop) >> usb-audio-play-report() >> report
}
