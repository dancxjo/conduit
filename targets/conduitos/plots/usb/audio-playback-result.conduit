# Preserve the original typed transport observation, including fault tag,
# completed prefix, frame and extents. Retirement remains a bound Root receipt.
# The prepared output bound is 7864B from the finite result schema. The
# expression Back has no output ValueContract; public Fores preserve that
# exact contract while native Host Call and queue storage enforce the bound.
plot usb-audio-playback-result (
    observation: UsbAudioPlaybackObservation...| <= 32768B >> result: UsbIsochronousOutResult...|
) = (.result)
