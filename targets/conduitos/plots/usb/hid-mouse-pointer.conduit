# Advance normalized pointer history only after wire ordering has drained.
# Queue capacity is an explicit semantic pressure fact supplied by admission.
# This derivation contains no endpoint, device, transport or authority facts.
type UsbMousePointerState = {
    position-x: I64
    position-y: I64
    sequence: U64
}
type UsbMousePointerInput = {
    state: UsbMousePointerState
    observation: UsbMouseOrderedObservation
    queue-capacity: U64
}
type UsbMousePointerSample = {
    position-x: I64
    position-y: I64
    delta-x: I64
    delta-y: I64
    primary-pressed: Boolean
    coalesced: U64
    dropped: U64
    queue-capacity: U64
    sequence: U64
}
type UsbMousePointerReady = {
    state: UsbMousePointerState
    ordinal: U64
    sample: UsbMousePointerSample
}
type UsbMousePointerSkipped = {
    state: UsbMousePointerState
    observation: UsbMouseOrderedObservation
}
type UsbMousePointerUpdate =
    ready UsbMousePointerReady
    | skipped UsbMousePointerSkipped
    | invalid-state
    | invalid-motion
    | sequence-exhausted

plot usb-hid-mouse-pointer-initialize (
    begin: Empty...| >> state: UsbMousePointerState...|
) = ({ position-x: 500000, position-y: 500000, sequence: 0 })

plot usb-hid-mouse-pointer-advance (
    input: UsbMousePointerInput...| >> update: UsbMousePointerUpdate...|
) = (((((.state.position-x < 0 || .state.position-x > 1000000) || (.state.position-y < 0 || .state.position-y > 1000000)) || .queue-capacity == 0) || (.observation.observed is mouse ? ((((.observation.observed.mouse.buttons > 7 || .observation.observed.mouse.x < -127) || (.observation.observed.mouse.x > 127 || .observation.observed.mouse.y < -127)) || .observation.observed.mouse.y > 127) || .state.sequence == 18446744073709551615) : false) ? ((((.state.position-x < 0 || .state.position-x > 1000000) || (.state.position-y < 0 || .state.position-y > 1000000)) || .queue-capacity == 0) ? invalid-state(empty) : ((((.observation.observed.mouse.buttons > 7 || .observation.observed.mouse.x < -127) || (.observation.observed.mouse.x > 127 || .observation.observed.mouse.y < -127)) || .observation.observed.mouse.y > 127) ? invalid-motion(empty) : sequence-exhausted(empty))) : (.observation.observed is mouse ? ready({ state: { position-x: (.state.position-x + value/i64(.observation.observed.mouse.x) * 4000 < 0 ? 0 : (.state.position-x + value/i64(.observation.observed.mouse.x) * 4000 > 1000000 ? 1000000 : .state.position-x + value/i64(.observation.observed.mouse.x) * 4000)), position-y: (.state.position-y + value/i64(.observation.observed.mouse.y) * 4000 < 0 ? 0 : (.state.position-y + value/i64(.observation.observed.mouse.y) * 4000 > 1000000 ? 1000000 : .state.position-y + value/i64(.observation.observed.mouse.y) * 4000)), sequence: .state.sequence + 1 }, ordinal: .observation.ordinal, sample: { position-x: (.state.position-x + value/i64(.observation.observed.mouse.x) * 4000 < 0 ? 0 : (.state.position-x + value/i64(.observation.observed.mouse.x) * 4000 > 1000000 ? 1000000 : .state.position-x + value/i64(.observation.observed.mouse.x) * 4000)), position-y: (.state.position-y + value/i64(.observation.observed.mouse.y) * 4000 < 0 ? 0 : (.state.position-y + value/i64(.observation.observed.mouse.y) * 4000 > 1000000 ? 1000000 : .state.position-y + value/i64(.observation.observed.mouse.y) * 4000)), delta-x: value/i64(.observation.observed.mouse.x) * 4000, delta-y: value/i64(.observation.observed.mouse.y) * 4000, primary-pressed: (.observation.observed.mouse.buttons & 1) != 0, coalesced: 0, dropped: 0, queue-capacity: .queue-capacity, sequence: .state.sequence + 1 } }) : skipped({ state: .state, observation: .observation }))))
