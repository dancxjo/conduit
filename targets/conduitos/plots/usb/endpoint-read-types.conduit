# A selected inbound endpoint supplies bytes. No request chooses an endpoint,
# controller, attachment, DMA buffer or authority. Root owns those facts.
type UsbEndpointReadRequest = {
    length: U64
}
type UsbEndpointReadFrame = {
    actual: U64
    short: Boolean
    wire: sequence U8 <= 512
}
type UsbEndpointReadResult =
    completed UsbEndpointReadFrame
    | stalled
    | provider-lost
    | unsupported
    | timeout
