# Reports entering this derivation have passed usb-hid-boot-keyboard and
# its six-slot normalization. This plot grants no endpoint authority.
# Modifier transitions precede sorted releases, then sorted presses.
# Unchanged slots are explicit; this fixed batch does not claim stream emission.
type UsbKeyboardDeltaInput = {
    previous: UsbBootKeyboardReport
    current: UsbBootKeyboardReport
}
type UsbKeyboardTransition = {
    usage: U8
    pressed: Boolean
    modifiers: U8
}
type UsbKeyboardTransitionSlot =
    changed UsbKeyboardTransition
    | unchanged
type UsbKeyboardTransitionBatch = {
    slots: collection UsbKeyboardTransitionSlot = 20
}

plot usb-hid-keyboard-transitions (
    reports: UsbKeyboardDeltaInput...| >> changes: UsbKeyboardTransitionBatch...|
) = ({ slots: [((.previous.modifiers & 1) != (.current.modifiers & 1) ? changed({ usage: 224, pressed: (.current.modifiers & 1) != 0, modifiers: .current.modifiers }) : unchanged(unit)), ((.previous.modifiers & 2) != (.current.modifiers & 2) ? changed({ usage: 225, pressed: (.current.modifiers & 2) != 0, modifiers: .current.modifiers }) : unchanged(unit)), ((.previous.modifiers & 4) != (.current.modifiers & 4) ? changed({ usage: 226, pressed: (.current.modifiers & 4) != 0, modifiers: .current.modifiers }) : unchanged(unit)), ((.previous.modifiers & 8) != (.current.modifiers & 8) ? changed({ usage: 227, pressed: (.current.modifiers & 8) != 0, modifiers: .current.modifiers }) : unchanged(unit)), ((.previous.modifiers & 16) != (.current.modifiers & 16) ? changed({ usage: 228, pressed: (.current.modifiers & 16) != 0, modifiers: .current.modifiers }) : unchanged(unit)), ((.previous.modifiers & 32) != (.current.modifiers & 32) ? changed({ usage: 229, pressed: (.current.modifiers & 32) != 0, modifiers: .current.modifiers }) : unchanged(unit)), ((.previous.modifiers & 64) != (.current.modifiers & 64) ? changed({ usage: 230, pressed: (.current.modifiers & 64) != 0, modifiers: .current.modifiers }) : unchanged(unit)), ((.previous.modifiers & 128) != (.current.modifiers & 128) ? changed({ usage: 231, pressed: (.current.modifiers & 128) != 0, modifiers: .current.modifiers }) : unchanged(unit)), (.previous.keys.0 != 0 && !((.previous.keys.0 == .current.keys.0 || (.previous.keys.0 == .current.keys.1 || .previous.keys.0 == .current.keys.2)) || (.previous.keys.0 == .current.keys.3 || (.previous.keys.0 == .current.keys.4 || .previous.keys.0 == .current.keys.5))) ? changed({ usage: .previous.keys.0, pressed: false, modifiers: .current.modifiers }) : unchanged(unit)), (.previous.keys.1 != 0 && !((.previous.keys.1 == .current.keys.0 || (.previous.keys.1 == .current.keys.1 || .previous.keys.1 == .current.keys.2)) || (.previous.keys.1 == .current.keys.3 || (.previous.keys.1 == .current.keys.4 || .previous.keys.1 == .current.keys.5))) ? changed({ usage: .previous.keys.1, pressed: false, modifiers: .current.modifiers }) : unchanged(unit)), (.previous.keys.2 != 0 && !((.previous.keys.2 == .current.keys.0 || (.previous.keys.2 == .current.keys.1 || .previous.keys.2 == .current.keys.2)) || (.previous.keys.2 == .current.keys.3 || (.previous.keys.2 == .current.keys.4 || .previous.keys.2 == .current.keys.5))) ? changed({ usage: .previous.keys.2, pressed: false, modifiers: .current.modifiers }) : unchanged(unit)), (.previous.keys.3 != 0 && !((.previous.keys.3 == .current.keys.0 || (.previous.keys.3 == .current.keys.1 || .previous.keys.3 == .current.keys.2)) || (.previous.keys.3 == .current.keys.3 || (.previous.keys.3 == .current.keys.4 || .previous.keys.3 == .current.keys.5))) ? changed({ usage: .previous.keys.3, pressed: false, modifiers: .current.modifiers }) : unchanged(unit)), (.previous.keys.4 != 0 && !((.previous.keys.4 == .current.keys.0 || (.previous.keys.4 == .current.keys.1 || .previous.keys.4 == .current.keys.2)) || (.previous.keys.4 == .current.keys.3 || (.previous.keys.4 == .current.keys.4 || .previous.keys.4 == .current.keys.5))) ? changed({ usage: .previous.keys.4, pressed: false, modifiers: .current.modifiers }) : unchanged(unit)), (.previous.keys.5 != 0 && !((.previous.keys.5 == .current.keys.0 || (.previous.keys.5 == .current.keys.1 || .previous.keys.5 == .current.keys.2)) || (.previous.keys.5 == .current.keys.3 || (.previous.keys.5 == .current.keys.4 || .previous.keys.5 == .current.keys.5))) ? changed({ usage: .previous.keys.5, pressed: false, modifiers: .current.modifiers }) : unchanged(unit)), (.current.keys.0 != 0 && !((.current.keys.0 == .previous.keys.0 || (.current.keys.0 == .previous.keys.1 || .current.keys.0 == .previous.keys.2)) || (.current.keys.0 == .previous.keys.3 || (.current.keys.0 == .previous.keys.4 || .current.keys.0 == .previous.keys.5))) ? changed({ usage: .current.keys.0, pressed: true, modifiers: .current.modifiers }) : unchanged(unit)), (.current.keys.1 != 0 && !((.current.keys.1 == .previous.keys.0 || (.current.keys.1 == .previous.keys.1 || .current.keys.1 == .previous.keys.2)) || (.current.keys.1 == .previous.keys.3 || (.current.keys.1 == .previous.keys.4 || .current.keys.1 == .previous.keys.5))) ? changed({ usage: .current.keys.1, pressed: true, modifiers: .current.modifiers }) : unchanged(unit)), (.current.keys.2 != 0 && !((.current.keys.2 == .previous.keys.0 || (.current.keys.2 == .previous.keys.1 || .current.keys.2 == .previous.keys.2)) || (.current.keys.2 == .previous.keys.3 || (.current.keys.2 == .previous.keys.4 || .current.keys.2 == .previous.keys.5))) ? changed({ usage: .current.keys.2, pressed: true, modifiers: .current.modifiers }) : unchanged(unit)), (.current.keys.3 != 0 && !((.current.keys.3 == .previous.keys.0 || (.current.keys.3 == .previous.keys.1 || .current.keys.3 == .previous.keys.2)) || (.current.keys.3 == .previous.keys.3 || (.current.keys.3 == .previous.keys.4 || .current.keys.3 == .previous.keys.5))) ? changed({ usage: .current.keys.3, pressed: true, modifiers: .current.modifiers }) : unchanged(unit)), (.current.keys.4 != 0 && !((.current.keys.4 == .previous.keys.0 || (.current.keys.4 == .previous.keys.1 || .current.keys.4 == .previous.keys.2)) || (.current.keys.4 == .previous.keys.3 || (.current.keys.4 == .previous.keys.4 || .current.keys.4 == .previous.keys.5))) ? changed({ usage: .current.keys.4, pressed: true, modifiers: .current.modifiers }) : unchanged(unit)), (.current.keys.5 != 0 && !((.current.keys.5 == .previous.keys.0 || (.current.keys.5 == .previous.keys.1 || .current.keys.5 == .previous.keys.2)) || (.current.keys.5 == .previous.keys.3 || (.current.keys.5 == .previous.keys.4 || .current.keys.5 == .previous.keys.5))) ? changed({ usage: .current.keys.5, pressed: true, modifiers: .current.modifiers }) : unchanged(unit)) ] })
