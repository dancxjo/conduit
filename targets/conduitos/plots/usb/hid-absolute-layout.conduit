# Status: 0 scanning, 1 ready, 2 short, 3 malformed, 4 unsupported, 5 pressure.
type UsbAbsoluteHidLayoutState = {
    wire: sequence U8 <= 256
    actual: U64
    cursor: U64
    records: U64
    status: U8
    page: U64
    usage: U64
    usage-range: Boolean
    minimum-zero: Boolean
    maximum: U16
    maximum-valid: Boolean
    size: U64
    count: U64
    report: U8
    bits: U64
    depth: U64
    touch-depth: U64
    tip-depth: U64
    have-tip: Boolean
    have-x: Boolean
    have-y: Boolean
    layout-report: U8
    tip-byte: U64
    tip-mask: U8
    x-byte: U64
    y-byte: U64
    x-width: U8
    y-width: U8
    maximum-x: U16
    maximum-y: U16
    terminal: Boolean
}
type UsbAbsoluteHidItem = {
    header: U8
    length: U64
    value: U64
    low: U8
    high: U8
    end: Boolean
    truncated: Boolean
}
type UsbAbsoluteHidStepInput = {
    state: UsbAbsoluteHidLayoutState
    item: UsbAbsoluteHidItem
}
type UsbAbsoluteHidClassified = {
    phase: U8
    state: UsbAbsoluteHidLayoutState
    item: UsbAbsoluteHidItem
    tip: Boolean
    x: Boolean
    y: Boolean
    tip-candidate: Boolean
    x-candidate: Boolean
    y-candidate: Boolean
    malformed: Boolean
    unsupported: Boolean
}
plot usb-hid-absolute-layout-start (
    input: UsbHidDescriptorTransfer...| >> result: UsbAbsoluteHidLayoutState...|
) = ({ wire: .wire, actual: .actual, cursor: 0, records: 0, status: (.actual > 256 || .actual != sequence/length(.wire)) ? 3 : 0, page: 0, usage: 0, usage-range: false, minimum-zero: false, maximum: 0, maximum-valid: false, size: 0, count: 0, report: 0, bits: 0, depth: 0, touch-depth: 0, tip-depth: 0, have-tip: false, have-x: false, have-y: false, layout-report: 0, tip-byte: 0, tip-mask: 0, x-byte: 0, y-byte: 0, x-width: 0, y-width: 0, maximum-x: 0, maximum-y: 0, terminal: (.actual > 256 || .actual != sequence/length(.wire)) })
plot usb-hid-absolute-layout-load (
    input: UsbAbsoluteHidLayoutState...| >> result: UsbAbsoluteHidStepInput...|
) = ({ state: ., item: (.status != 0 || .cursor >= .actual) ? { header: 0, length: 0, value: 0, low: 0, high: 0, end: .cursor >= .actual, truncated: false } : { header: sequence/at(.wire, .cursor), length: value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)), value: (.cursor + 1 + value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) <= .actual) ? ((value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) > 0 ? value/u64(sequence/at(.wire, .cursor + 1)) * 1 : 0) + (value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) > 1 ? value/u64(sequence/at(.wire, .cursor + 2)) * 256 : 0) + (value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) > 2 ? value/u64(sequence/at(.wire, .cursor + 3)) * 65536 : 0) + (value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) > 3 ? value/u64(sequence/at(.wire, .cursor + 4)) * 16777216 : 0)) : 0, low: (.cursor + 1 + value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) <= .actual) && value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) > 0 ? sequence/at(.wire, .cursor + 1) : 0, high: (.cursor + 1 + value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) <= .actual) && value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) > 1 ? sequence/at(.wire, .cursor + 2) : 0, end: false, truncated: .cursor + 1 + value/u64((sequence/at(.wire, .cursor) & 3) == 3 ? (sequence/at(.wire, .cursor) & 0) + 4 : (sequence/at(.wire, .cursor) & 3)) > .actual } })
