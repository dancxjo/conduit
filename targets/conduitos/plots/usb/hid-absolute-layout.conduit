) = ({ phase: .state.status != 0 ? .state.status : .state.records >= 32 ? 5 : .item.end ? 4 : .item.truncated ? 2 : 0, state: .state, item: .item, tip: (((((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) && (.state.touch-depth > 0 && .state.depth >= .state.touch-depth)) && (!.state.have-tip && (.state.page == 13 && .state.usage == 66))) && (((.item.value & 7) == 2 && !.state.usage-range) && (.state.minimum-zero && .state.maximum-valid))) && (.state.size == 1 && (.state.count == 1 && .state.maximum == 1))), x: (((((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) && (((.state.touch-depth > 0 && .state.depth >= .state.touch-depth) && .state.have-tip) && (.state.depth >= .state.tip-depth && .state.report == .state.layout-report))) && (.state.page == 1 && .state.usage == 48)) && (!.state.have-x && (((.item.value & 7) == 2 && !.state.usage-range) && (.state.minimum-zero && .state.maximum-valid)))) && ((.state.size == 8 || .state.size == 16) && (.state.count == 1 && .state.bits % 8 == 0))), y: (((((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) && (((.state.touch-depth > 0 && .state.depth >= .state.touch-depth) && .state.have-tip) && (.state.depth >= .state.tip-depth && .state.report == .state.layout-report))) && (.state.page == 1 && .state.usage == 49)) && (!.state.have-y && (((.item.value & 7) == 2 && !.state.usage-range) && (.state.minimum-zero && .state.maximum-valid)))) && ((.state.size == 8 || .state.size == 16) && (.state.count == 1 && .state.bits % 8 == 0))), tip-candidate: (((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) && (.state.touch-depth > 0 && .state.depth >= .state.touch-depth)) && (!.state.have-tip && (.state.page == 13 && .state.usage == 66))), x-candidate: ((((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) && (((.state.touch-depth > 0 && .state.depth >= .state.touch-depth) && .state.have-tip) && (.state.depth >= .state.tip-depth && .state.report == .state.layout-report))) && (.state.page == 1 && .state.usage == 48)) && !.state.have-x), y-candidate: ((((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) && (((.state.touch-depth > 0 && .state.depth >= .state.touch-depth) && .state.have-tip) && (.state.depth >= .state.tip-depth && .state.report == .state.layout-report))) && (.state.page == 1 && .state.usage == 49)) && !.state.have-y), malformed: (((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 12) && .state.depth == 0) || ((((.item.header / 4) & 3) == 1 && (.item.header / 16) == 8) && (.item.value == 0 || .item.value > 255))), unsupported: ((((((.item.header / 4) & 3) == 1 && (.item.header / 16) == 10) || (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 11)) || ((((.item.header / 4) & 3) == 2 && (.item.header / 16) == 10) || (((((.item.header / 4) & 3) == 2 && (.item.header / 16) == 0) && .item.value > 65535) || ((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) && ((.state.size == 0 || .state.size > 32) || (.state.count == 0 || (.state.count > 512 || .state.bits + .state.size * .state.count + (.state.report == 0 ? 0 : 8) > 512))))))) || ((((((.item.header / 4) & 3) == 1 && (.item.header / 16) == 8) && (.state.have-tip && .item.value != value/u64(.state.report))) || ((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 12) && (.state.have-tip && .state.depth <= .state.tip-depth))) || (((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 10) && .state.depth >= 8) || (((.item.header / 4) & 3) == 3 || .item.header == 254)))) })
plot usb-hid-absolute-layout-step (
    input: UsbAbsoluteHidClassified...| >> result: UsbAbsoluteHidLayoutState...|
) = (.phase != 0 ? { wire: .state.wire, actual: .state.actual, cursor: .state.cursor, records: .state.records, status: .phase, page: .state.page, usage: .state.usage, usage-range: .state.usage-range, minimum-zero: .state.minimum-zero, maximum: .state.maximum, maximum-valid: .state.maximum-valid, size: .state.size, count: .state.count, report: .state.report, bits: .state.bits, depth: .state.depth, touch-depth: .state.touch-depth, tip-depth: .state.tip-depth, have-tip: .state.have-tip, have-x: .state.have-x, have-y: .state.have-y, layout-report: .state.layout-report, tip-byte: .state.tip-byte, tip-mask: .state.tip-mask, x-byte: .state.x-byte, y-byte: .state.y-byte, x-width: .state.x-width, y-width: .state.y-width, maximum-x: .state.maximum-x, maximum-y: .state.maximum-y, terminal: true } : .malformed ? { wire: .state.wire, actual: .state.actual, cursor: .state.cursor, records: .state.records, status: 3, page: .state.page, usage: .state.usage, usage-range: .state.usage-range, minimum-zero: .state.minimum-zero, maximum: .state.maximum, maximum-valid: .state.maximum-valid, size: .state.size, count: .state.count, report: .state.report, bits: .state.bits, depth: .state.depth, touch-depth: .state.touch-depth, tip-depth: .state.tip-depth, have-tip: .state.have-tip, have-x: .state.have-x, have-y: .state.have-y, layout-report: .state.layout-report, tip-byte: .state.tip-byte, tip-mask: .state.tip-mask, x-byte: .state.x-byte, y-byte: .state.y-byte, x-width: .state.x-width, y-width: .state.y-width, maximum-x: .state.maximum-x, maximum-y: .state.maximum-y, terminal: true } : (.unsupported || (.tip-candidate && !.tip) || (.x-candidate && !.x) || (.y-candidate && !.y)) ? { wire: .state.wire, actual: .state.actual, cursor: .state.cursor, records: .state.records, status: 4, page: .state.page, usage: .state.usage, usage-range: .state.usage-range, minimum-zero: .state.minimum-zero, maximum: .state.maximum, maximum-valid: .state.maximum-valid, size: .state.size, count: .state.count, report: .state.report, bits: .state.bits, depth: .state.depth, touch-depth: .state.touch-depth, tip-depth: .state.tip-depth, have-tip: .state.have-tip, have-x: .state.have-x, have-y: .state.have-y, layout-report: .state.layout-report, tip-byte: .state.tip-byte, tip-mask: .state.tip-mask, x-byte: .state.x-byte, y-byte: .state.y-byte, x-width: .state.x-width, y-width: .state.y-width, maximum-x: .state.maximum-x, maximum-y: .state.maximum-y, terminal: true } : { wire: .state.wire, actual: .state.actual, cursor: .state.cursor + 1 + .item.length, records: .state.records + 1, status: ((.state.have-tip || .tip) && (.state.have-x || .x) && (.state.have-y || .y)) ? 1 : 0, page: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 0) ? .item.value : .state.page, usage: (((.item.header / 4) & 3) == 0) ? 0 : (((.item.header / 4) & 3) == 2 && (.item.header / 16) == 0) ? .item.value : .state.usage, usage-range: (((.item.header / 4) & 3) == 0) ? false : ((((.item.header / 4) & 3) == 2 && (.item.header / 16) == 1) || (((.item.header / 4) & 3) == 2 && (.item.header / 16) == 2)) ? true : .state.usage-range, minimum-zero: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 1) ? .item.value == 0 : .state.minimum-zero, maximum: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 2) ? value/u16(.item.low) + value/u16(.item.high) * 256 : .state.maximum, maximum-valid: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 2) ? (.item.value > 0 && .item.value <= 65535) : .state.maximum-valid, size: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 7) ? .item.value : .state.size, count: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 9) ? .item.value : .state.count, report: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 8) ? .item.low : .state.report, bits: (((.item.header / 4) & 3) == 1 && (.item.header / 16) == 8) && .item.value != value/u64(.state.report) ? 0 : (((.item.header / 4) & 3) == 0 && (.item.header / 16) == 8) ? .state.bits + .state.size * .state.count : .state.bits, depth: (((.item.header / 4) & 3) == 0 && (.item.header / 16) == 10) ? .state.depth + 1 : (((.item.header / 4) & 3) == 0 && (.item.header / 16) == 12) ? .state.depth - 1 : .state.depth, touch-depth: ((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 10) && .item.value == 1 && .state.page == 13 && (.state.usage == 4 || .state.usage == 5)) ? .state.depth + 1 : ((((.item.header / 4) & 3) == 0 && (.item.header / 16) == 12) && .state.depth == .state.touch-depth) ? 0 : .state.touch-depth, tip-depth: .tip ? .state.depth : .state.tip-depth, have-tip: .state.have-tip || .tip, have-x: .state.have-x || .x, have-y: .state.have-y || .y, layout-report: .tip ? .state.report : .state.layout-report, tip-byte: .tip ? .state.bits / 8 + (.state.report == 0 ? 0 : 1) : .state.tip-byte, tip-mask: .tip ? ((.state.bits % 8 < 4 ? (.state.bits % 8 < 2 ? (.state.bits % 8 < 1 ? 1 : 2) : (.state.bits % 8 < 3 ? 4 : 8)) : (.state.bits % 8 < 6 ? (.state.bits % 8 < 5 ? 16 : 32) : (.state.bits % 8 < 7 ? 64 : 128)))) : .state.tip-mask, x-byte: .x ? .state.bits / 8 + (.state.report == 0 ? 0 : 1) : .state.x-byte, y-byte: .y ? .state.bits / 8 + (.state.report == 0 ? 0 : 1) : .state.y-byte, x-width: .x ? (.state.size == 8 ? 1 : 2) : .state.x-width, y-width: .y ? (.state.size == 8 ? 1 : 2) : .state.y-width, maximum-x: .x ? .state.maximum : .state.maximum-x, maximum-y: .y ? .state.maximum : .state.maximum-y, terminal: ((.state.have-tip || .tip) && (.state.have-x || .x) && (.state.have-y || .y)) || .state.records + 1 >= 32 })
plot usb-hid-absolute-layout-finish (
    input: UsbAbsoluteHidLayoutState...| >> result: UsbAbsoluteHidLayoutResult...|
) = (.status == 1 ? layout({ report-id: .layout-report, tip-byte: .tip-byte, tip-mask: .tip-mask, x-byte: .x-byte, y-byte: .y-byte, x-width: .x-width, y-width: .y-width, maximum-x: .maximum-x, maximum-y: .maximum-y }) : .status == 2 ? short(empty) : .status == 3 ? malformed(empty) : .status == 4 ? unsupported(empty) : pressure(empty))

type UsbAbsoluteHidScanRoute =
    scanning UsbAbsoluteHidLayoutState
    | finished UsbAbsoluteHidLayoutState
plot usb-hid-absolute-layout-route (
    state: UsbAbsoluteHidLayoutState...| >> route: UsbAbsoluteHidScanRoute...|
) = (.terminal ? finished(.) : scanning(.))

# The existing seeded state operation reuses the bounded stages. It does not
# instantiate a separate set of programs for each descriptor item.
plot usb-hid-absolute-layout (
    input: UsbHidDescriptorTransfer...| >> result: UsbAbsoluteHidLayoutResult...|
) {
    cell: state/seeded/flow/until
    route: usb-hid-absolute-layout-route()
    input >> usb-hid-absolute-layout-start() >> cell.seed
    cell.current >> route
    route >> select(UsbAbsoluteHidScanRoute.scanning, unmatched=drop) >> usb-hid-absolute-layout-load() >> usb-hid-absolute-layout-classify() >> usb-hid-absolute-layout-step() >> cell.next
    route >> select(UsbAbsoluteHidScanRoute.finished, unmatched=drop) >> usb-hid-absolute-layout-finish() >> result
}
