plot usb-audio-play-route (
 state: UsbAudioPlaybackState...| >> route: UsbAudioPlaybackRoute...|
) = (.terminal ? stopped(.) : (.phase < 5 ? control(.) : iso(.)))

plot usb-audio-play-control-request (
 state: UsbAudioPlaybackState...| >> request: UsbControlRequest...|
) = (.phase == 0 ? { setup: 0x0064000002000680, output: [] } : (.phase == 1 ? { setup: 0x0000000000010900, output: [] } : (.phase == 2 ? { setup: 0x0000000100010b01, output: [] } : (.phase == 3 ? { setup: 0x0003000101000122, output: [128, 187, 0] } : { setup: 0x00030001010081a2, output: [] }))))

