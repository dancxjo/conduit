# Completion is accepted only for the original eight exact scheduled packets.
# Variant and length guards precede every payload or indexed field access.
type UsbAudioCompletionInput = {
    request: UsbIsochronousOutRequest
    result: UsbIsochronousOutResult
}
plot usb-audio-completion-supported (
    input: UsbAudioCompletionInput...| >> supported: Boolean...|
) = (!(.request is batch) ? false : (!(.result is completed) ? false : (sequence/length(.request.batch.packets) != 8 || sequence/length(.result.completed.packets) != 8 ? false : ((((sequence/at(.result.completed.packets, 0).frame == sequence/at(.request.batch.packets, 0).frame && ((sequence/at(.result.completed.packets, 0).requested == 192 && sequence/at(.result.completed.packets, 0).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 0).wire) == 192)) && (sequence/at(.result.completed.packets, 1).frame == sequence/at(.request.batch.packets, 1).frame && ((sequence/at(.result.completed.packets, 1).requested == 192 && sequence/at(.result.completed.packets, 1).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 1).wire) == 192))) && ((sequence/at(.result.completed.packets, 2).frame == sequence/at(.request.batch.packets, 2).frame && ((sequence/at(.result.completed.packets, 2).requested == 192 && sequence/at(.result.completed.packets, 2).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 2).wire) == 192)) && (sequence/at(.result.completed.packets, 3).frame == sequence/at(.request.batch.packets, 3).frame && ((sequence/at(.result.completed.packets, 3).requested == 192 && sequence/at(.result.completed.packets, 3).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 3).wire) == 192)))) && (((sequence/at(.result.completed.packets, 4).frame == sequence/at(.request.batch.packets, 4).frame && ((sequence/at(.result.completed.packets, 4).requested == 192 && sequence/at(.result.completed.packets, 4).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 4).wire) == 192)) && (sequence/at(.result.completed.packets, 5).frame == sequence/at(.request.batch.packets, 5).frame && ((sequence/at(.result.completed.packets, 5).requested == 192 && sequence/at(.result.completed.packets, 5).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 5).wire) == 192))) && ((sequence/at(.result.completed.packets, 6).frame == sequence/at(.request.batch.packets, 6).frame && ((sequence/at(.result.completed.packets, 6).requested == 192 && sequence/at(.result.completed.packets, 6).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 6).wire) == 192)) && (sequence/at(.result.completed.packets, 7).frame == sequence/at(.request.batch.packets, 7).frame && ((sequence/at(.result.completed.packets, 7).requested == 192 && sequence/at(.result.completed.packets, 7).actual == 192) && bytes/length(sequence/at(.request.batch.packets, 7).wire) == 192))))))))
