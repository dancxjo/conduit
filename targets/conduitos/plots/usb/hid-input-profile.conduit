# This bounded input profile selects the first HID alternate-zero interface
# and one full-speed/low-speed interrupt IN endpoint from an already checked
# configuration topology. No vendor, endpoint, interface or panel constants.
# The high-speed polling profile is explicitly unsupported here.
type UsbHidInputProfileInput = {
    topology: UsbConfigurationTopology
    low-speed: Boolean
    high-speed: Boolean
}
type UsbHidInputInterface = {
    valid: Boolean
    found: Boolean
    low-speed: Boolean
    high-speed: Boolean
    configuration-value: U8
    interface-slot: U64
    interface-number: U8
    endpoint-count: U64
    endpoints: collection UsbConfigurationEndpoint = 8
}
type UsbHidInputCandidates = {
    context: UsbHidInputInterface
    candidate-0: Boolean
    candidate-1: Boolean
    candidate-2: Boolean
    candidate-3: Boolean
    candidate-4: Boolean
    candidate-5: Boolean
    candidate-6: Boolean
    candidate-7: Boolean
}
type UsbHidInputSelection = {
    configuration-value: U8
    interface-number: U8
    endpoint: U8
    maximum-packet: U64
    interval-ms: U64
}
type UsbHidInputProfileResult =
    selected UsbHidInputSelection
    | no-hid-interface
    | unsupported-link
    | unsupported-endpoint
    | malformed

plot usb-hid-input-interface (
    input: UsbHidInputProfileInput...| >> result: UsbHidInputInterface...|
) = ({ valid: ((.topology.interface_count <= 4 && .topology.endpoint_count <= 8) && (.topology.configuration_value != 0 && !(.low-speed && .high-speed))), found: (((.topology.interface_count > 0 && (.topology.interfaces.0.class == 3 && .topology.interfaces.0.alternate == 0)) || (.topology.interface_count > 1 && (.topology.interfaces.1.class == 3 && .topology.interfaces.1.alternate == 0))) || ((.topology.interface_count > 2 && (.topology.interfaces.2.class == 3 && .topology.interfaces.2.alternate == 0)) || (.topology.interface_count > 3 && (.topology.interfaces.3.class == 3 && .topology.interfaces.3.alternate == 0)))), low-speed: .low-speed, high-speed: .high-speed, configuration-value: .topology.configuration_value, interface-slot: (.topology.interface_count > 0 && (.topology.interfaces.0.class == 3 && .topology.interfaces.0.alternate == 0)) ? 0 : (.topology.interface_count > 1 && (.topology.interfaces.1.class == 3 && .topology.interfaces.1.alternate == 0)) ? 1 : (.topology.interface_count > 2 && (.topology.interfaces.2.class == 3 && .topology.interfaces.2.alternate == 0)) ? 2 : 3, interface-number: (.topology.interface_count > 0 && (.topology.interfaces.0.class == 3 && .topology.interfaces.0.alternate == 0)) ? .topology.interfaces.0.number : (.topology.interface_count > 1 && (.topology.interfaces.1.class == 3 && .topology.interfaces.1.alternate == 0)) ? .topology.interfaces.1.number : (.topology.interface_count > 2 && (.topology.interfaces.2.class == 3 && .topology.interfaces.2.alternate == 0)) ? .topology.interfaces.2.number : .topology.interfaces.3.number, endpoint-count: .topology.endpoint_count, endpoints: .topology.endpoints })

plot usb-hid-input-candidates (
    input: UsbHidInputInterface...| >> result: UsbHidInputCandidates...|
) = ({ context: ., candidate-0: (((.endpoint-count > 0 && .endpoints.0.interface_slot == .interface-slot) && ((.endpoints.0.address & 128) != 0 && (.endpoints.0.address & 15) != 0)) && (((.endpoints.0.attributes & 3) == 3 && .endpoints.0.packet_field > 0) && (.endpoints.0.packet_field <= 64 && ((.low-speed ? .endpoints.0.packet_field <= 8 : true) && .endpoints.0.interval != 0)))), candidate-1: (((.endpoint-count > 1 && .endpoints.1.interface_slot == .interface-slot) && ((.endpoints.1.address & 128) != 0 && (.endpoints.1.address & 15) != 0)) && (((.endpoints.1.attributes & 3) == 3 && .endpoints.1.packet_field > 0) && (.endpoints.1.packet_field <= 64 && ((.low-speed ? .endpoints.1.packet_field <= 8 : true) && .endpoints.1.interval != 0)))), candidate-2: (((.endpoint-count > 2 && .endpoints.2.interface_slot == .interface-slot) && ((.endpoints.2.address & 128) != 0 && (.endpoints.2.address & 15) != 0)) && (((.endpoints.2.attributes & 3) == 3 && .endpoints.2.packet_field > 0) && (.endpoints.2.packet_field <= 64 && ((.low-speed ? .endpoints.2.packet_field <= 8 : true) && .endpoints.2.interval != 0)))), candidate-3: (((.endpoint-count > 3 && .endpoints.3.interface_slot == .interface-slot) && ((.endpoints.3.address & 128) != 0 && (.endpoints.3.address & 15) != 0)) && (((.endpoints.3.attributes & 3) == 3 && .endpoints.3.packet_field > 0) && (.endpoints.3.packet_field <= 64 && ((.low-speed ? .endpoints.3.packet_field <= 8 : true) && .endpoints.3.interval != 0)))), candidate-4: (((.endpoint-count > 4 && .endpoints.4.interface_slot == .interface-slot) && ((.endpoints.4.address & 128) != 0 && (.endpoints.4.address & 15) != 0)) && (((.endpoints.4.attributes & 3) == 3 && .endpoints.4.packet_field > 0) && (.endpoints.4.packet_field <= 64 && ((.low-speed ? .endpoints.4.packet_field <= 8 : true) && .endpoints.4.interval != 0)))), candidate-5: (((.endpoint-count > 5 && .endpoints.5.interface_slot == .interface-slot) && ((.endpoints.5.address & 128) != 0 && (.endpoints.5.address & 15) != 0)) && (((.endpoints.5.attributes & 3) == 3 && .endpoints.5.packet_field > 0) && (.endpoints.5.packet_field <= 64 && ((.low-speed ? .endpoints.5.packet_field <= 8 : true) && .endpoints.5.interval != 0)))), candidate-6: (((.endpoint-count > 6 && .endpoints.6.interface_slot == .interface-slot) && ((.endpoints.6.address & 128) != 0 && (.endpoints.6.address & 15) != 0)) && (((.endpoints.6.attributes & 3) == 3 && .endpoints.6.packet_field > 0) && (.endpoints.6.packet_field <= 64 && ((.low-speed ? .endpoints.6.packet_field <= 8 : true) && .endpoints.6.interval != 0)))), candidate-7: (((.endpoint-count > 7 && .endpoints.7.interface_slot == .interface-slot) && ((.endpoints.7.address & 128) != 0 && (.endpoints.7.address & 15) != 0)) && (((.endpoints.7.attributes & 3) == 3 && .endpoints.7.packet_field > 0) && (.endpoints.7.packet_field <= 64 && ((.low-speed ? .endpoints.7.packet_field <= 8 : true) && .endpoints.7.interval != 0)))) })

plot usb-hid-input-select (
    input: UsbHidInputCandidates...| >> result: UsbHidInputProfileResult...|
) = (!.context.valid ? malformed(empty) : .context.high-speed ? unsupported-link(empty) : !.context.found ? no-hid-interface(empty) : !(((.candidate-0 || .candidate-1) || (.candidate-2 || .candidate-3)) || ((.candidate-4 || .candidate-5) || (.candidate-6 || .candidate-7))) ? unsupported-endpoint(empty) : (((.candidate-0 || .candidate-1) || (.candidate-2 || .candidate-3)) ? ((.candidate-0 || .candidate-1) ? (.candidate-0 ? selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.0.address & 15, maximum-packet: .context.endpoints.0.packet_field, interval-ms: value/u64(.context.endpoints.0.interval) }) : selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.1.address & 15, maximum-packet: .context.endpoints.1.packet_field, interval-ms: value/u64(.context.endpoints.1.interval) })) : (.candidate-2 ? selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.2.address & 15, maximum-packet: .context.endpoints.2.packet_field, interval-ms: value/u64(.context.endpoints.2.interval) }) : selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.3.address & 15, maximum-packet: .context.endpoints.3.packet_field, interval-ms: value/u64(.context.endpoints.3.interval) }))) : ((.candidate-4 || .candidate-5) ? (.candidate-4 ? selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.4.address & 15, maximum-packet: .context.endpoints.4.packet_field, interval-ms: value/u64(.context.endpoints.4.interval) }) : selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.5.address & 15, maximum-packet: .context.endpoints.5.packet_field, interval-ms: value/u64(.context.endpoints.5.interval) })) : (.candidate-6 ? selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.6.address & 15, maximum-packet: .context.endpoints.6.packet_field, interval-ms: value/u64(.context.endpoints.6.interval) }) : selected({ configuration-value: .context.configuration-value, interface-number: .context.interface-number, endpoint: .context.endpoints.7.address & 15, maximum-packet: .context.endpoints.7.packet_field, interval-ms: value/u64(.context.endpoints.7.interval) })))))

plot usb-hid-input-profile (
    input: UsbHidInputProfileInput...| >> result: UsbHidInputProfileResult...|
) {
    input >> usb-hid-input-interface() >> usb-hid-input-candidates() >> usb-hid-input-select() >> result
}
