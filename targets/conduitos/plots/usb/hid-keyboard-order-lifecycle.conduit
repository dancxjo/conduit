with flow/zip/feedback/paired as UsbKeyboardOrderCommandPair

# This lifecycle drains the next wire ordinal before consuming another command.
# EOF with a missing ordinal is a gap, never a synthetic report or clean drain.
type UsbKeyboardOrderSession = {
    terminal: Boolean
    order: UsbKeyboardOrderState
}
type UsbKeyboardOrderCommand =
    observation UsbKeyboardOrderedObservation
    | finish
type UsbKeyboardOrderRoute =
    waiting UsbKeyboardOrderSession
    | emitting UsbKeyboardOrderReady
    | stopped
type UsbKeyboardOrderEnd =
    closed
    | gap
    | stale
    | duplicate
    | outside-window
    | pressure
type UsbKeyboardOrderDecision =
    continued UsbKeyboardOrderState
    | ended UsbKeyboardOrderEnd
type UsbKeyboardOrderWork =
    inserting UsbKeyboardOrderInsertion
    | ending UsbKeyboardOrderEnd

plot usb-hid-keyboard-order-session-initialize (
    order: UsbKeyboardOrderState...| >> session: UsbKeyboardOrderSession...|
) = ({ terminal: false, order: . })

plot usb-hid-keyboard-order-session-ready (
    ready: UsbKeyboardOrderReady...| >> session: UsbKeyboardOrderSession...|
) = ({ terminal: false, order: .state })

plot usb-hid-keyboard-order-session-observation (
    ready: UsbKeyboardOrderReady...| >> observation: UsbKeyboardOrderedObservation...|
) = (.observation)

plot usb-hid-keyboard-order-session-accepted (
    order: UsbKeyboardOrderState...| >> session: UsbKeyboardOrderSession...|
) = ({ terminal: false, order: . })

plot usb-hid-keyboard-order-session-end (
    end: UsbKeyboardOrderEnd...| >> session: UsbKeyboardOrderSession...|
) = ({ terminal: true, order: { expected: 0, slot0: vacant(unit), slot1: vacant(unit), slot2: vacant(unit), slot3: vacant(unit), slot4: vacant(unit), slot5: vacant(unit), slot6: vacant(unit), slot7: vacant(unit) } })

plot usb-hid-keyboard-order-decision (
    admission: UsbKeyboardOrderAdmission...| >> decision: UsbKeyboardOrderDecision...|
) = (. is accepted ? continued(.accepted) : ended(. is stale ? stale(unit) : (. is duplicate ? duplicate(unit) : (. is outside-window ? outside-window(unit) : pressure(unit)))))

plot usb-hid-keyboard-order-session-route (
    session: UsbKeyboardOrderSession...| >> route: UsbKeyboardOrderRoute...|
) = (.terminal ? stopped(unit) : ((.order.slot0 is held ? (.order.slot0.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: vacant(unit), slot1: .order.slot1, slot2: .order.slot2, slot3: .order.slot3, slot4: .order.slot4, slot5: .order.slot5, slot6: .order.slot6, slot7: .order.slot7 }, observation: .order.slot0.held }) : ((.order.slot1 is held ? (.order.slot1.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: .order.slot0, slot1: vacant(unit), slot2: .order.slot2, slot3: .order.slot3, slot4: .order.slot4, slot5: .order.slot5, slot6: .order.slot6, slot7: .order.slot7 }, observation: .order.slot1.held }) : ((.order.slot2 is held ? (.order.slot2.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: .order.slot0, slot1: .order.slot1, slot2: vacant(unit), slot3: .order.slot3, slot4: .order.slot4, slot5: .order.slot5, slot6: .order.slot6, slot7: .order.slot7 }, observation: .order.slot2.held }) : ((.order.slot3 is held ? (.order.slot3.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: .order.slot0, slot1: .order.slot1, slot2: .order.slot2, slot3: vacant(unit), slot4: .order.slot4, slot5: .order.slot5, slot6: .order.slot6, slot7: .order.slot7 }, observation: .order.slot3.held }) : ((.order.slot4 is held ? (.order.slot4.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: .order.slot0, slot1: .order.slot1, slot2: .order.slot2, slot3: .order.slot3, slot4: vacant(unit), slot5: .order.slot5, slot6: .order.slot6, slot7: .order.slot7 }, observation: .order.slot4.held }) : ((.order.slot5 is held ? (.order.slot5.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: .order.slot0, slot1: .order.slot1, slot2: .order.slot2, slot3: .order.slot3, slot4: .order.slot4, slot5: vacant(unit), slot6: .order.slot6, slot7: .order.slot7 }, observation: .order.slot5.held }) : ((.order.slot6 is held ? (.order.slot6.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: .order.slot0, slot1: .order.slot1, slot2: .order.slot2, slot3: .order.slot3, slot4: .order.slot4, slot5: .order.slot5, slot6: vacant(unit), slot7: .order.slot7 }, observation: .order.slot6.held }) : ((.order.slot7 is held ? (.order.slot7.held.ordinal == .order.expected) : false) ? emitting({ state: { expected: .order.expected + 1, slot0: .order.slot0, slot1: .order.slot1, slot2: .order.slot2, slot3: .order.slot3, slot4: .order.slot4, slot5: .order.slot5, slot6: .order.slot6, slot7: vacant(unit) }, observation: .order.slot7.held }) : (waiting(.)))))))))))

plot usb-hid-keyboard-order-session-command (
    pair: UsbKeyboardOrderCommandPair...| >> work: UsbKeyboardOrderWork...|
) = (.1 is observation ? inserting({ state: .0.order, observation: .1.observation }) : ending(.0.order.slot0 is vacant && .0.order.slot1 is vacant && .0.order.slot2 is vacant && .0.order.slot3 is vacant && .0.order.slot4 is vacant && .0.order.slot5 is vacant && .0.order.slot6 is vacant && .0.order.slot7 is vacant ? closed(unit) : gap(unit)))

plot usb-hid-keyboard-order-lifecycle (
    >> begin: Unit...|
    >> command: UsbKeyboardOrderCommand...| <= 4096B
    observation: UsbKeyboardOrderedObservation...| >>
    ended: UsbKeyboardOrderEnd...| >>
) {
    cell: state/seeded/flow/until
    join: flow/zip/feedback
    route: usb-hid-keyboard-order-session-route()
    work: usb-hid-keyboard-order-session-command()
    insert: usb-hid-keyboard-order-insert()
    decide: usb-hid-keyboard-order-decision()
    updates: flow/merge/finite
    ends: flow/merge/finite
    replacements: flow/merge/finite
    begin >> usb-hid-keyboard-order-initialize() >> usb-hid-keyboard-order-session-initialize() >> cell.seed
    cell.current >> route
    route >> select(UsbKeyboardOrderRoute.waiting, unmatched=drop) >> join.left
    command >> join.right
    join.paired >> work
    work >> select(UsbKeyboardOrderWork.inserting, unmatched=drop) >> insert >> decide
    decide >> select(UsbKeyboardOrderDecision.continued, unmatched=drop) >> usb-hid-keyboard-order-session-accepted() >> updates.left
    decide >> select(UsbKeyboardOrderDecision.ended, unmatched=drop) >> ends.left
    work >> select(UsbKeyboardOrderWork.ending, unmatched=drop) >> ends.right
    ends.merged >> ended
    ends.merged >> usb-hid-keyboard-order-session-end() >> updates.right
    route >> select(UsbKeyboardOrderRoute.emitting, unmatched=drop) >> usb-hid-keyboard-order-session-observation() >> observation
    route >> select(UsbKeyboardOrderRoute.emitting, unmatched=drop) >> usb-hid-keyboard-order-session-ready() >> replacements.right
    updates.merged >> replacements.left
    replacements.merged >> cell.next
}
