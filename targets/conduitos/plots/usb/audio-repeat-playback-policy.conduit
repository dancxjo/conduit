) = ({ observation: .observation, accepted: !.accepted ? false : (sequence/length(.observation.result.completed.packets) != 72 ? false : ((((sequence/at(.observation.result.completed.packets, 56).frame == (.observation.previous.first-frame + 56) % 2048 && sequence/at(.observation.result.completed.packets, 56).requested == 192 && sequence/at(.observation.result.completed.packets, 56).actual == 192) && (sequence/at(.observation.result.completed.packets, 57).frame == (.observation.previous.first-frame + 57) % 2048 && sequence/at(.observation.result.completed.packets, 57).requested == 192 && sequence/at(.observation.result.completed.packets, 57).actual == 192)) && ((sequence/at(.observation.result.completed.packets, 58).frame == (.observation.previous.first-frame + 58) % 2048 && sequence/at(.observation.result.completed.packets, 58).requested == 192 && sequence/at(.observation.result.completed.packets, 58).actual == 192) && (sequence/at(.observation.result.completed.packets, 59).frame == (.observation.previous.first-frame + 59) % 2048 && sequence/at(.observation.result.completed.packets, 59).requested == 192 && sequence/at(.observation.result.completed.packets, 59).actual == 192))) && (((sequence/at(.observation.result.completed.packets, 60).frame == (.observation.previous.first-frame + 60) % 2048 && sequence/at(.observation.result.completed.packets, 60).requested == 192 && sequence/at(.observation.result.completed.packets, 60).actual == 192) && (sequence/at(.observation.result.completed.packets, 61).frame == (.observation.previous.first-frame + 61) % 2048 && sequence/at(.observation.result.completed.packets, 61).requested == 192 && sequence/at(.observation.result.completed.packets, 61).actual == 192)) && ((sequence/at(.observation.result.completed.packets, 62).frame == (.observation.previous.first-frame + 62) % 2048 && sequence/at(.observation.result.completed.packets, 62).requested == 192 && sequence/at(.observation.result.completed.packets, 62).actual == 192) && (sequence/at(.observation.result.completed.packets, 63).frame == (.observation.previous.first-frame + 63) % 2048 && sequence/at(.observation.result.completed.packets, 63).requested == 192 && sequence/at(.observation.result.completed.packets, 63).actual == 192))))) })
