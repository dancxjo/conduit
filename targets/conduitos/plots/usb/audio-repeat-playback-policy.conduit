# Finite explicit playback intent: repeat the admitted eight-packet PCM clip nine times.
# Checked playback retains the original PCM block throughout observe, batch,
# and drain. The controller coordinate is admitted only from a real snapshot.
type UsbAudioPlaybackState = {
    pcm: UsbAudioPcmBlock
    first-frame: U64
    phase: U64
    terminal: Boolean
}
type UsbAudioPlaybackRoute =
    awaiting UsbAudioPlaybackState
    | validating UsbAudioPlaybackState
    | active UsbAudioPlaybackState
    | stopped UsbAudioPlaybackState
plot usb-audio-playback-seed (
    pcm: UsbAudioPcmBlock...| <= 4096B >> state: UsbAudioPlaybackState...| <= 4096B
) = ({ pcm: ., first-frame: 0, phase: 4, terminal: false })
plot usb-audio-playback-route (
    state: UsbAudioPlaybackState...| <= 4096B >> route: UsbAudioPlaybackRoute...|
) = (.terminal ? stopped(.) : (.phase == 4 ? awaiting(.) : (.phase == 5 ? validating(.) : active(.))))
# Explicit finite intent: repeat this admitted PCM clip nine times.
plot usb-audio-playback-request (
    state: UsbAudioPlaybackState...| <= 4096B >> request: UsbIsochronousOutRequest...| <= 32768B
) = (.phase == 0 ? observe(empty) : (.phase == 1 ? batch({ packets: [{ frame: (.first-frame + 0) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 1) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 2) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 3) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 4) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 5) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 6) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 7) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 8) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 9) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 10) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 11) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 12) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 13) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 14) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 15) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 16) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 17) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 18) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 19) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 20) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 21) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 22) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 23) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 24) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 25) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 26) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 27) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 28) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 29) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 30) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 31) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 32) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 33) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 34) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 35) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 36) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 37) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 38) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 39) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 40) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 41) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 42) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 43) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 44) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 45) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 46) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 47) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 48) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 49) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 50) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 51) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 52) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 53) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 54) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 55) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 56) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 57) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 58) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 59) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 60) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 61) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 62) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 63) % 2048, wire: sequence/at(.pcm.packets, 7).wire }, { frame: (.first-frame + 64) % 2048, wire: sequence/at(.pcm.packets, 0).wire }, { frame: (.first-frame + 65) % 2048, wire: sequence/at(.pcm.packets, 1).wire }, { frame: (.first-frame + 66) % 2048, wire: sequence/at(.pcm.packets, 2).wire }, { frame: (.first-frame + 67) % 2048, wire: sequence/at(.pcm.packets, 3).wire }, { frame: (.first-frame + 68) % 2048, wire: sequence/at(.pcm.packets, 4).wire }, { frame: (.first-frame + 69) % 2048, wire: sequence/at(.pcm.packets, 5).wire }, { frame: (.first-frame + 70) % 2048, wire: sequence/at(.pcm.packets, 6).wire }, { frame: (.first-frame + 71) % 2048, wire: sequence/at(.pcm.packets, 7).wire }] }) : drain(empty)))

type UsbAudioPlaybackObservation = {
    previous: UsbAudioPlaybackState
    result: UsbIsochronousOutResult
}
plot usb-audio-playback-clock-advance (
    observation: UsbAudioPlaybackObservation...| <= 32768B >> state: UsbAudioPlaybackState...| <= 4096B
) = (.previous.terminal || .previous.phase != 0 ? { pcm: .previous.pcm, first-frame: .previous.first-frame, phase: .previous.phase, terminal: true } : (!(.result is snapshot) ? { pcm: .previous.pcm, first-frame: .previous.first-frame, phase: 0, terminal: true } : (.result.snapshot.current-microframe < 16384 && .result.snapshot.scheduling-threshold <= 248 && .result.snapshot.service-interval-microframes == 8 && .result.snapshot.maximum-packet-bytes == 192 && .result.snapshot.pending-packets == 0 && .result.snapshot.maximum-pending-packets == 8 && .result.snapshot.dma-resource-bytes == 3072 ? { pcm: .previous.pcm, first-frame: ((.result.snapshot.current-microframe / 8) + 256) % 2048, phase: 1, terminal: false } : { pcm: .previous.pcm, first-frame: .previous.first-frame, phase: 0, terminal: true })))

type UsbAudioCompletionValidation = {
    observation: UsbAudioPlaybackObservation
    accepted: Boolean
}
plot usb-audio-completion-validation-seed (
    observation: UsbAudioPlaybackObservation...| <= 32768B >> validation: UsbAudioCompletionValidation...| <= 32768B
) = ({ observation: ., accepted: !.previous.terminal && .previous.phase == 1 && .result is completed })
plot usb-audio-completion-validation-0 (
    validation: UsbAudioCompletionValidation...| <= 32768B >> checked: UsbAudioCompletionValidation...|
