plot usb-audio-completion-validation-finish (
    validation: UsbAudioCompletionValidation...| <= 32768B >> state: UsbAudioPlaybackState...| <= 4096B
) = ({ pcm: .observation.previous.pcm, first-frame: .observation.previous.first-frame, phase: .accepted ? 2 : .observation.previous.phase, terminal: !.accepted })
plot usb-audio-playback-batch-advance (
    observation: UsbAudioPlaybackObservation...| <= 32768B >> state: UsbAudioPlaybackState...| <= 4096B
) {
    observation >> usb-audio-completion-validation-seed() >> usb-audio-completion-validation-0() >> usb-audio-completion-validation-1() >> usb-audio-completion-validation-2() >> usb-audio-completion-validation-3() >> usb-audio-completion-validation-4() >> usb-audio-completion-validation-5() >> usb-audio-completion-validation-6() >> usb-audio-completion-validation-7() >> usb-audio-completion-validation-8() >> usb-audio-completion-validation-finish() >> state
}

plot usb-audio-playback-drain-advance (
    observation: UsbAudioPlaybackObservation...| <= 32768B >> state: UsbAudioPlaybackState...| <= 4096B
) = (!.previous.terminal && .previous.phase == 2 && .result is drained ? { pcm: .previous.pcm, first-frame: .previous.first-frame, phase: 3, terminal: true } : { pcm: .previous.pcm, first-frame: .previous.first-frame, phase: .previous.phase, terminal: true })

type UsbAudioPlaybackObservationRoute =
    clock UsbAudioPlaybackObservation
    | batch UsbAudioPlaybackObservation
    | drain UsbAudioPlaybackObservation
plot usb-audio-playback-observation-route (
    observation: UsbAudioPlaybackObservation...| <= 32768B >> route: UsbAudioPlaybackObservationRoute...|
) = (.previous.phase == 0 ? clock(.) : (.previous.phase == 1 ? batch(.) : drain(.)))

type UsbAudioAdmission = {
    accepted: Boolean
}

plot usb-audio-playback-pcm (
    state: UsbAudioPlaybackState...| <= 4096B >> pcm: UsbAudioPcmBlock...| <= 4096B
) = (.pcm)
plot usb-audio-admission-evidence (
    accepted: Boolean...| >> evidence: UsbAudioAdmission...|
) = ({ accepted: . })
