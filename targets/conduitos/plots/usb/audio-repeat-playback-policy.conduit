) = ({ observation: .observation, accepted: !.accepted ? false : (sequence/length(.observation.result.completed.packets) != 72 ? false : ((((sequence/at(.observation.result.completed.packets, 64).frame == (.observation.previous.first-frame + 64) % 2048 && sequence/at(.observation.result.completed.packets, 64).requested == 192 && sequence/at(.observation.result.completed.packets, 64).actual == 192) && (sequence/at(.observation.result.completed.packets, 65).frame == (.observation.previous.first-frame + 65) % 2048 && sequence/at(.observation.result.completed.packets, 65).requested == 192 && sequence/at(.observation.result.completed.packets, 65).actual == 192)) && ((sequence/at(.observation.result.completed.packets, 66).frame == (.observation.previous.first-frame + 66) % 2048 && sequence/at(.observation.result.completed.packets, 66).requested == 192 && sequence/at(.observation.result.completed.packets, 66).actual == 192) && (sequence/at(.observation.result.completed.packets, 67).frame == (.observation.previous.first-frame + 67) % 2048 && sequence/at(.observation.result.completed.packets, 67).requested == 192 && sequence/at(.observation.result.completed.packets, 67).actual == 192))) && (((sequence/at(.observation.result.completed.packets, 68).frame == (.observation.previous.first-frame + 68) % 2048 && sequence/at(.observation.result.completed.packets, 68).requested == 192 && sequence/at(.observation.result.completed.packets, 68).actual == 192) && (sequence/at(.observation.result.completed.packets, 69).frame == (.observation.previous.first-frame + 69) % 2048 && sequence/at(.observation.result.completed.packets, 69).requested == 192 && sequence/at(.observation.result.completed.packets, 69).actual == 192)) && ((sequence/at(.observation.result.completed.packets, 70).frame == (.observation.previous.first-frame + 70) % 2048 && sequence/at(.observation.result.completed.packets, 70).requested == 192 && sequence/at(.observation.result.completed.packets, 70).actual == 192) && (seq