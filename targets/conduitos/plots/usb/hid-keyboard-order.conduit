# Eight admitted physical reads may finish their Source processing out of order.
# Retain compact decoded observations, including malformed reports, before
# changing keyboard history. This Source state grants no endpoint authority.
type UsbKeyboardOrderedObservation = {
    ordinal: U64
    observed: UsbBootKeyboardResult
}
type UsbKeyboardOrderSlot =
    vacant
    | held UsbKeyboardOrderedObservation
type UsbKeyboardOrderState = {
    expected: U64
    slot0: UsbKeyboardOrderSlot
    slot1: UsbKeyboardOrderSlot
    slot2: UsbKeyboardOrderSlot
    slot3: UsbKeyboardOrderSlot
    slot4: UsbKeyboardOrderSlot
    slot5: UsbKeyboardOrderSlot
    slot6: UsbKeyboardOrderSlot
    slot7: UsbKeyboardOrderSlot
}
type UsbKeyboardOrderInsertion = {
    state: UsbKeyboardOrderState
    observation: UsbKeyboardOrderedObservation
}
type UsbKeyboardOrderAdmission =
    accepted UsbKeyboardOrderState
    | stale
    | duplicate
    | outside-window
    | pressure
type UsbKeyboardOrderReady = {
    state: UsbKeyboardOrderState
    observation: UsbKeyboardOrderedObservation
}
type UsbKeyboardOrderDrain =
    ready UsbKeyboardOrderReady
    | waiting UsbKeyboardOrderState

plot usb-hid-keyboard-order-initialize (
    begin: Unit...| >> state: UsbKeyboardOrderState...|
) = ({ expected: 0, slot0: vacant(unit), slot1: vacant(unit), slot2: vacant(unit), slot3: vacant(unit), slot4: vacant(unit), slot5: vacant(unit), slot6: vacant(unit), slot7: vacant(unit) })

plot usb-hid-keyboard-order-insert (
    input: UsbKeyboardOrderInsertion...| >> admitted: UsbKeyboardOrderAdmission...|
) = (.observation.ordinal < .state.expected ? stale(unit) : (.observation.ordinal == 18446744073709551615 || .observation.ordinal - .state.expected >= 8 ? outside-window(unit) : ((.state.slot0 is held ? (.state.slot0.held.ordinal == .observation.ordinal) : false) || (.state.slot1 is held ? (.state.slot1.held.ordinal == .observation.ordinal) : false) || (.state.slot2 is held ? (.state.slot2.held.ordinal == .observation.ordinal) : false) || (.state.slot3 is held ? (.state.slot3.held.ordinal == .observation.ordinal) : false) || (.state.slot4 is held ? (.state.slot4.held.ordinal == .observation.ordinal) : false) || (.state.slot5 is held ? (.state.slot5.held.ordinal == .observation.ordinal) : false) || (.state.slot6 is held ? (.state.slot6.held.ordinal == .observation.ordinal) : false) || (.state.slot7 is held ? (.state.slot7.held.ordinal == .observation.ordinal) : false) ? duplicate(unit) : (.state.slot0 is vacant ? accepted({ expected: .state.expected, slot0: held(.observation), slot1: .state.slot1, slot2: .state.slot2, slot3: .state.slot3, slot4: .state.slot4, slot5: .state.slot5, slot6: .state.slot6, slot7: .state.slot7 }) : (.state.slot1 is vacant ? accepted({ expected: .state.expected, slot0: .state.slot0, slot1: held(.observation), slot2: .state.slot2, slot3: .state.slot3, slot4: .state.slot4, slot5: .state.slot5, slot6: .state.slot6, slot7: .state.slot7 }) : (.state.slot2 is vacant ? accepted({ expected: .state.expected, slot0: .state.slot0, slot1: .state.slot1, slot2: held(.observation), slot3: .state.slot3, slot4: .state.slot4, slot5: .state.slot5, slot6: .state.slot6, slot7: .state.slot7 }) : (.state.slot3 is vacant ? accepted({ expected: .state.expected, slot0: .state.slot0, slot1: .state.slot1, slot2: .state.slot2, slot3: held(.observation), slot4: .state.slot4, slot5: .state.slot5, slot6: .state.slot6, slot7: .state.slot7 }) : (.state.slot4 is vacant ? accepted({ expected: .state.expected, slot0: .state.slot0, slot1: .state.slot1, slot2: .state.slot2, slot3: .state.slot3, slot4: held(.observation), slot5: .state.slot5, slot6: .state.slot6, slot7: .state.slot7 }) : (.state.slot5 is vacant ? accepted({ expected: .state.expected, slot0: .state.slot0, slot1: .state.slot1, slot2: .state.slot2, slot3: .state.slot3, slot4: .state.slot4, slot5: held(.observation), slot6: .state.slot6, slot7: .state.slot7 }) : (.state.slot6 is vacant ? accepted({ expected: .state.expected, slot0: .state.slot0, slot1: .state.slot1, slot2: .state.slot2, slot3: .state.slot3, slot4: .state.slot4, slot5: .state.slot5, slot6: held(.observation), slot7: .state.slot7 }) : (.state.slot7 is vacant ? accepted({ expected: .state.expected, slot0: .state.slot0, slot1: .state.slot1, slot2: .state.slot2, slot3: .state.slot3, slot4: .state.slot4, slot5: .state.slot5, slot6: .state.slot6, slot7: held(.observation) }) : (pressure(unit)))))))))))))

plot usb-hid-keyboard-order-drain (
    state: UsbKeyboardOrderState...| >> drained: UsbKeyboardOrderDrain...|
) = ((.slot0 is held ? (.slot0.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: vacant(unit), slot1: .slot1, slot2: .slot2, slot3: .slot3, slot4: .slot4, slot5: .slot5, slot6: .slot6, slot7: .slot7 }, observation: .slot0.held }) : ((.slot1 is held ? (.slot1.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: .slot0, slot1: vacant(unit), slot2: .slot2, slot3: .slot3, slot4: .slot4, slot5: .slot5, slot6: .slot6, slot7: .slot7 }, observation: .slot1.held }) : ((.slot2 is held ? (.slot2.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: .slot0, slot1: .slot1, slot2: vacant(unit), slot3: .slot3, slot4: .slot4, slot5: .slot5, slot6: .slot6, slot7: .slot7 }, observation: .slot2.held }) : ((.slot3 is held ? (.slot3.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: .slot0, slot1: .slot1, slot2: .slot2, slot3: vacant(unit), slot4: .slot4, slot5: .slot5, slot6: .slot6, slot7: .slot7 }, observation: .slot3.held }) : ((.slot4 is held ? (.slot4.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: .slot0, slot1: .slot1, slot2: .slot2, slot3: .slot3, slot4: vacant(unit), slot5: .slot5, slot6: .slot6, slot7: .slot7 }, observation: .slot4.held }) : ((.slot5 is held ? (.slot5.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: .slot0, slot1: .slot1, slot2: .slot2, slot3: .slot3, slot4: .slot4, slot5: vacant(unit), slot6: .slot6, slot7: .slot7 }, observation: .slot5.held }) : ((.slot6 is held ? (.slot6.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: .slot0, slot1: .slot1, slot2: .slot2, slot3: .slot3, slot4: .slot4, slot5: .slot5, slot6: vacant(unit), slot7: .slot7 }, observation: .slot6.held }) : ((.slot7 is held ? (.slot7.held.ordinal == .expected) : false) ? ready({ state: { expected: .expected + 1, slot0: .slot0, slot1: .slot1, slot2: .slot2, slot3: .slot3, slot4: .slot4, slot5: .slot5, slot6: .slot6, slot7: vacant(unit) }, observation: .slot7.held }) : (waiting(.))))))))))
