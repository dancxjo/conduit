with machine/usb/control/request as UsbControlRequest
with machine/usb/control/result as UsbControlResult
with machine/usb/endpoint-read/request as UsbEndpointReadRequest
with machine/usb/endpoint-read/result as UsbEndpointReadResult
with machine/usb/endpoint-write/request as UsbEndpointWriteRequest
with machine/usb/endpoint-write/result as UsbEndpointWriteResult
with network/ethernet-frame/request as EthernetFrameRequest
with network/ethernet-frame/result as EthernetFrameResult
with flow/zip/feedback/paired as CdcEcmPair

plot cdc-ecm-start (
    value: CdcEcmStart...| <= 4096B >> result: CdcEcmState...| <= 4096B
) = ({ terminator: .terminator, phase: 1, cycles: 0, transmit: pressure(empty), receive: take-transmit(empty), terminal: bytes/length(.terminator.wire) != 0, outcome: bytes/length(.terminator.wire) != 0 ? malformed(empty) : completed(empty) })

plot cdc-ecm-route (
    value: CdcEcmState...| <= 4096B >> result: CdcEcmRoute...| <= 4096B
) = (.terminal || .cycles >= 16 || .phase < 1 || .phase > 11 ? stopped(.) : (.phase <= 5 ? control(.) : (.phase == 6 || .phase == 9 || .phase == 11 ? frame(.) : (.phase == 7 || .phase == 8 ? write(.) : read(.)))))

plot cdc-ecm-pending (
    value: CdcEcmRoute...| <= 4096B >> result: CdcEcmPending...| <= 4096B
) = (. is stopped ? stopped(empty) : (. is control ? running(.control) : (. is frame ? running(.frame) : (. is write ? running(.write) : running(.read)))))

plot cdc-ecm-control-request (
    value: CdcEcmState...| <= 4096B >> result: UsbControlRequest...| <= 4096B
) = (.phase == 1 ? { setup: 0x0050000002000680, output: [] } : (.phase == 2 ? { setup: 0x0000000000010900, output: [] } : (.phase == 3 ? { setup: 0x001a040903040680, output: [] } : (.phase == 4 ? { setup: 0x00000000000f4321, output: [] } : ({ setup: 0x0000000100010b01, output: [] })))))

plot cdc-ecm-queue-request (
    value: CdcEcmState...| <= 4096B >> result: EthernetFrameRequest...| <= 4096B
) = (.phase == 6 ? take-transmit(empty) : (.phase == 9 ? acknowledge-transmit({ ordinal: .transmit.transmit.ordinal, actual: bytes/length(.transmit.transmit.wire) }) : .receive))

plot cdc-ecm-write-request (
    value: CdcEcmState...| <= 4096B >> result: UsbEndpointWriteRequest...| <= 4096B
) = (.phase == 8 ? .terminator : (bytes/length(.transmit.transmit.wire) <= 2048 ? { wire: .transmit.transmit.wire } : .terminator))

plot cdc-ecm-read-request (
    value: CdcEcmState...| <= 4096B >> result: UsbEndpointReadRequest...| <= 4096B
) = ({ length: 1514 })

plot cdc-ecm-control-event (
    value: UsbControlResult...| <= 4096B >> result: CdcEcmEvent...| <= 4096B
) = (control({ result: ., topology: !(. is completed) ? false : (.completed.transferred != 80 || .completed.short || sequence/length(.completed.input) != 80 ? false : ((((((sequence/at(.completed.input, 0) == 9 && sequence/at(.completed.input, 1) == 2) && (sequence/at(.completed.input, 2) == 80 && (sequence/at(.completed.input, 3) == 0 && sequence/at(.completed.input, 4) == 2))) && ((sequence/at(.completed.input, 5) == 1 && sequence/at(.completed.input, 6) == 0) && (sequence/at(.completed.input, 7) == 128 && (sequence/at(.completed.input, 8) == 50 && sequence/at(.completed.input, 9) == 9)))) && (((sequence/at(.completed.input, 10) == 4 && sequence/at(.completed.input, 11) == 0) && (sequence/at(.completed.input, 12) == 0 && (sequence/at(.completed.input, 13) == 1 && sequence/at(.completed.input, 14) == 2))) && ((sequence/at(.completed.input, 15) == 6 && sequence/at(.completed.input, 16) == 0) && (sequence/at(.completed.input, 17) == 0 && (sequence/at(.completed.input, 18) == 5 && sequence/at(.completed.input, 19) == 36))))) && ((((sequence/at(.completed.input, 20) == 0 && sequence/at(.completed.input, 21) == 16) && (sequence/at(.completed.input, 22) == 1 && (sequence/at(.completed.input, 23) == 5 && sequence/at(.completed.input, 24) == 36))) && ((sequence/at(.completed.input, 25) == 6 && sequence/at(.completed.input, 26) == 0) && (sequence/at(.completed.input, 27) == 1 && (sequence/at(.completed.input, 28) == 13 && sequence/at(.completed.input, 29) == 36)))) && (((sequence/at(.completed.input, 30) == 15 && sequence/at(.completed.input, 31) == 4) && (sequence/at(.completed.input, 32) == 0 && (sequence/at(.completed.input, 33) == 0 && sequence/at(.completed.input, 34) == 0))) && ((sequence/at(.completed.input, 35) == 0 && sequence/at(.completed.input, 36) == 234) && (sequence/at(.completed.input, 37) == 5 && (sequence/at(.completed.input, 38) == 0 && sequence/at(.completed.input, 39) == 0)))))) && (((((sequence/at(.completed.input, 40) == 0 && sequence/at(.completed.input, 41) == 7) && (sequence/at(.completed.input, 42) == 5 && (sequence/at(.completed.input, 43) == 131 && sequence/at(.completed.input, 44) == 3))) && ((sequence/at(.completed.input, 45) == 16 && sequence/at(.completed.input, 46) == 0) && (sequence/at(.completed.input, 47) == 16 && (sequence/at(.completed.input, 48) == 9 && sequence/at(.completed.input, 49) == 4)))) && (((sequence/at(.completed.input, 50) == 1 && sequence/at(.completed.input, 51) == 0) && (sequence/at(.completed.input, 52) == 0 && (sequence/at(.completed.input, 53) == 10 && sequence/at(.completed.input, 54) == 0))) && ((sequence/at(.completed.input, 55) == 0 && sequence/at(.completed.input, 56) == 0) && (sequence/at(.completed.input, 57) == 9 && (sequence/at(.completed.input, 58) == 4 && sequence/at(.completed.input, 59) == 1))))) && ((((sequence/at(.completed.input, 60) == 1 && sequence/at(.completed.input, 61) == 2) && (sequence/at(.completed.input, 62) == 10 && (sequence/at(.completed.input, 63) == 0 && sequence/at(.completed.input, 64) == 0))) && ((sequence/at(.completed.input, 65) == 0 && sequence/at(.completed.input, 66) == 7) && (sequence/at(.completed.input, 67) == 5 && (sequence/at(.completed.input, 68) == 129 && sequence/at(.completed.input, 69) == 2)))) && (((sequence/at(.completed.input, 70) == 64 && sequence/at(.completed.input, 71) == 0) && (sequence/at(.completed.input, 72) == 0 && (sequence/at(.completed.input, 73) == 7 && sequence/at(.completed.input, 74) == 5))) && ((sequence/at(.completed.input, 75) == 2 && sequence/at(.completed.input, 76) == 2) && (sequence/at(.completed.input, 77) == 64 && (sequence/at(.completed.input, 78) == 0 && sequence/at(.completed.input, 79) == 0)))))))), mac: !(. is completed) ? false : (.completed.transferred != 26 || .completed.short || sequence/length(.completed.input) != 26 ? false : ((((sequence/at(.completed.input, 0) == 26 && (sequence/at(.completed.input, 1) == 3 && sequence/at(.completed.input, 2) == 48)) && (sequence/at(.completed.input, 3) == 0 && (sequence/at(.completed.input, 4) == 50 && sequence/at(.completed.input, 5) == 0))) && ((sequence/at(.completed.input, 6) == 48 && (sequence/at(.completed.input, 7) == 0 && sequence/at(.completed.input, 8) == 48)) && ((sequence/at(.completed.input, 9) == 0 && sequence/at(.completed.input, 10) == 48) && (sequence/at(.completed.input, 11) == 0 && sequence/at(.completed.input, 12) == 48)))) && (((sequence/at(.completed.input, 13) == 0 && (sequence/at(.completed.input, 14) == 48 && sequence/at(.completed.input, 15) == 0)) && (sequence/at(.completed.input, 16) == 48 && (sequence/at(.completed.input, 17) == 0 && sequence/at(.completed.input, 18) == 48))) && ((sequence/at(.completed.input, 19) == 0 && (sequence/at(.completed.input, 20) == 48 && sequence/at(.completed.input, 21) == 0)) && ((sequence/at(.completed.input, 22) == 48 && sequence/at(.completed.input, 23) == 0) && (sequence/at(.completed.input, 24) == 49 && sequence/at(.completed.input, 25) == 0)))))), ack: !(. is completed) ? false : (.completed.transferred == 0 && !.completed.short && sequence/length(.completed.input) == 0) }))

plot cdc-ecm-frame-event (
    value: EthernetFrameResult...| <= 4096B >> result: CdcEcmEvent...| <= 4096B
) = (frame(.))

plot cdc-ecm-write-event (
    value: UsbEndpointWriteResult...| <= 4096B >> result: CdcEcmEvent...| <= 4096B
) = (write(.))

plot cdc-ecm-read-event (
    value: UsbEndpointReadResult...| <= 4096B >> result: CdcEcmEvent...| <= 4096B
) = (read({ result: ., gate: . is completed ? (.completed.actual != bytes/length(.completed.wire) || bytes/length(.completed.wire) > 1514 || .completed.actual < 14 || (.completed.actual < 1514) != .completed.short ? malformed(empty) : ((bytes/at(.completed.wire, 6) & 1) != 0 || (bytes/at(.completed.wire, 6) == 0 && bytes/at(.completed.wire, 7) == 0 && bytes/at(.completed.wire, 8) == 0 && bytes/at(.completed.wire, 9) == 0 && bytes/at(.completed.wire, 10) == 0 && bytes/at(.completed.wire, 11) == 0) ? malformed(empty) : (value/u64(bytes/at(.completed.wire, 12)) * 256 + value/u64(bytes/at(.completed.wire, 13)) < 1536 || (bytes/at(.completed.wire, 12) == 129 && bytes/at(.completed.wire, 13) == 0) || (bytes/at(.completed.wire, 12) == 136 && bytes/at(.completed.wire, 13) == 168) ? malformed(empty) : ready(deliver-receive({ wire: .completed.wire }))))) : (. is stalled ? stalled(empty) : (. is provider-lost ? provider-lost(empty) : (. is timeout ? timeout(empty) : unsupported(empty)))) }))

plot cdc-ecm-accept (
    value: CdcEcmPair...| <= 4096B >> result: CdcEcmTransition...| <= 4096B
) = ({ previous: .0, event: .1, accepted: .0.terminal || .0.cycles >= 16 || .0.phase < 1 || .0.phase > 11 ? false : (.0.phase <= 5 ? (.1 is control ? (.0.phase == 1 ? .1.control.topology : (.0.phase == 3 ? .1.control.mac : .1.control.ack)) : false) : (.0.phase == 6 ? (.1 is frame ? (.1.frame is transmit ? (.1.frame.transmit.ordinal == .0.cycles && bytes/length(.1.frame.transmit.wire) >= 14 && bytes/length(.1.frame.transmit.wire) <= 1514) : false) : false) : (.0.phase == 7 || .0.phase == 8 ? (.1 is write ? (.1.write is completed ? .1.write.completed.actual == (.0.phase == 8 ? 0 : bytes/length(.0.transmit.transmit.wire)) : false) : false) : (.0.phase == 9 ? (.1 is frame && .1.frame is acknowledged) : (.0.phase == 10 ? (.1 is read ? (.1.read.gate is ready && .1.read.result is completed ? .1.read.result.completed.ordinal == .0.cycles : false) : false) : (.1 is frame && .1.frame is accepted)))))) })

plot cdc-ecm-advance (
    value: CdcEcmTransition...| <= 4096B >> result: CdcEcmState...| <= 4096B
) = ({ terminator: .previous.terminator, phase: !.accepted ? 12 : (.previous.phase == 11 ? 6 : (.previous.phase == 7 ? (bytes/length(.previous.transmit.transmit.wire) % 64 == 0 ? 8 : 9) : .previous.phase + 1)), cycles: .accepted && .previous.phase == 11 && .previous.cycles < 16 ? .previous.cycles + 1 : .previous.cycles, transmit: .accepted && .previous.phase == 6 ? .event.frame : .previous.transmit, receive: .accepted && .previous.phase == 10 ? .event.read.gate.ready : .previous.receive, terminal: !.accepted || (.previous.phase == 11 && .previous.cycles == 15), outcome: .accepted ? completed(empty) : (.event is control ? (.event.control.result is stalled ? stalled(empty) : (.event.control.result is provider-lost ? provider-lost(empty) : (.event.control.result is completed ? malformed(empty) : unsupported(empty)))) : (.event is frame ? (.event.frame is pressure ? pressure(empty) : (.event.frame is stale ? stale(empty) : (.event.frame is cancelled ? cancelled(empty) : (.event.frame is sequence-exhausted ? sequence-exhausted(empty) : (.event.frame is provider-lost ? provider-lost(empty) : malformed(empty)))))) : (.event is write ? (.event.write is stalled ? stalled(empty) : (.event.write is provider-lost ? provider-lost(empty) : (.event.write is completed ? malformed(empty) : unsupported(empty)))) : (.event.read.gate is stalled ? stalled(empty) : (.event.read.gate is provider-lost ? provider-lost(empty) : (.event.read.gate is timeout ? timeout(empty) : (.event.read.gate is unsupported ? unsupported(empty) : malformed(empty)))))))) })

plot cdc-ecm-outcome (
    value: CdcEcmState...| <= 4096B >> result: CdcEcmOutcome...| <= 4096B
) = (.outcome)

# One physical placement per Kind. Sixteen genuine queue frames are consumed,
# acknowledged only after full USB OUT (and a terminating ZLP when max64 divides
# the frame), followed by one checked RX and one independently admitted enqueue.
# Pressure/fault ends this finite profile; no private polling/retry or fake ack.
plot cdc-ecm-frame-service (
    >> start: CdcEcmStart...| <= 4096B
    observed: CdcEcmEvent...| <= 4096B >>
    ended: CdcEcmOutcome...| <= 256B >>
) {
    cell: state/seeded/flow/until
    route: cdc-ecm-route()
    join: flow/zip/feedback
    controls: machine/usb/control
    frames: network/ethernet-frame
    writes: machine/usb/endpoint-write
    reads: machine/usb/endpoint-read
    first: flow/merge/finite
    second: flow/merge/finite
    events: flow/merge/finite
    start >> cdc-ecm-start() >> cell.seed
    cell.current >> route
    route >> cdc-ecm-pending() >> select(CdcEcmPending.running, unmatched=drop) >> join.left
    route >> select(CdcEcmRoute.control, unmatched=drop) >> cdc-ecm-control-request() >> controls.request
    route >> select(CdcEcmRoute.frame, unmatched=drop) >> cdc-ecm-queue-request() >> frames.request
    route >> select(CdcEcmRoute.write, unmatched=drop) >> cdc-ecm-write-request() >> writes.request
    route >> select(CdcEcmRoute.read, unmatched=drop) >> cdc-ecm-read-request() >> reads.request
    route >> select(CdcEcmRoute.stopped, unmatched=drop) >> cdc-ecm-outcome() >> ended
    controls.result >> cdc-ecm-control-event() >> first.left
    frames.result >> cdc-ecm-frame-event() >> first.right
    writes.result >> cdc-ecm-write-event() >> second.left
    reads.result >> cdc-ecm-read-event() >> second.right
    first.merged >> events.left
    second.merged >> events.right
    events.merged >> join.right
    events.merged >> observed
    join.paired >> cdc-ecm-accept() >> cdc-ecm-advance() >> cell.next
}
