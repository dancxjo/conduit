plot usb-audio-descriptor-request (
    start: Boolean...| >> request: UsbControlRequest...|
) = ({ setup: 0x0064000002000680, output: [] })

# Explicit Source clock-domain projection:32ms initial margin,1ms service,
# all eight frames retained in the generic request. Native rechecks deadlines.
plot usb-audio-schedule-packet (
    input: UsbAudioSchedulingInput...| >> request: UsbIsochronousOutRequest...|
) = (batch({ packets: [{ frame: ((.clock.current-microframe / 8) + 32) % 2048, wire: .packet.wire }] }))
