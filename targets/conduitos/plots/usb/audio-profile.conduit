plot usb-audio-adjacent-0-supported (
    pcm: UsbAudioPcmBatch...| >> supported: Boolean...|
) = (sequence/at(.packets, 0).header.start-frame > 18446744073709551567 ? false : (sequence/at(.packets, 1).header.clock-id == sequence/at(.packets, 0).header.clock-id && sequence/at(.packets, 1).header.start-frame == sequence/at(.packets, 0).header.start-frame + 48 && sequence/at(.packets, 1).frame == (sequence/at(.packets, 0).frame + 1) % 2048))
