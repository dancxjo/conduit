    pcm: UsbAudioPcmBatch...| >> supported: Boolean...|
) = (sequence/at(.packets, 1).header.start-frame > 18446744073709551567 ? false : (sequence/at(.packets, 2).header.clock-id == sequence/at(.packets, 1).header.clock-id && sequence/at(.packets, 2).header.start-frame == sequence/at(.packets, 1).header.start-frame + 48 && sequence/at(.packets, 2).frame == (sequence/at(.packets, 1).frame + 1) % 2048))
