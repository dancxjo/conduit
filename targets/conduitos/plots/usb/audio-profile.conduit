plot usb-audio-empty-ack (
    completion: UsbControlResult...| >> supported: Boolean...|
) = (!(. is completed) ? false : (.completed.transferred == 0 && !.completed.short && sequence/length(.completed.input) == 0))

plot usb-audio-set-rate-ack (
    completion: UsbControlResult...| >> supported: Boolean...|
) = (!(. is completed) ? false : (.completed.transferred == 3 && !.completed.short && sequence/length(.completed.input) == 0))

plot usb-audio-get-rate-ack (
    completion: UsbControlResult...| >> supported: Boolean...|
) = (!(. is completed) ? false : (.completed.transferred != 3 || .completed.short || sequence/length(.completed.input) != 3 ? false : (sequence/at(.completed.input, 0) == 128 && sequence/at(.completed.input, 1) == 187 && sequence/at(.completed.input, 2) == 0)))

plot usb-audio-configuration-request (
    start: Boolean...| >> request: UsbControlRequest...|
) = ({ setup: 67840, output: [] })

plot usb-audio-alternate-request (
    start: Boolean...| >> request: UsbControlRequest...|
) = ({ setup: 4295035649, output: [] })

plot usb-audio-set-rate-request (
    start: Boolean...| >> request: UsbControlRequest...|
) = ({ setup: 844429241876770, output: [128, 187, 0] })

plot usb-audio-get-rate-request (
    start: Boolean...| >> request: UsbControlRequest...|
) = ({ setup: 844429241909666, output: [] })

plot usb-audio-pcm-cadence (
    packet: UsbAudioPcmPacket...| >> cadence: UsbPcmCadence...|
) = (.cadence)

plot usb-audio-pcm-supported (
    observation: UsbAudioPacketObservation...| >> supported: Boolean...|
) = (.packet.header.representation is signed16-little-endian && .packet.header.sample-rate-hz == 48000 && .packet.header.layout is stereo-left-right && .packet.header.frame-count == 48 && .packet.header.payload-bytes == 192 && bytes/length(.packet.wire) == 192 && .cadence-bytes == 192 && !.packet.header.discontinuity)

plot usb-audio-pcm-packet (
    packet: UsbAudioPcmPacket...| >> request: UsbIsochronousPacket...|
) = ({ frame: .frame, wire: .wire })

plot usb-audio-terminal (
    result: UsbIsochronousOutResult...| >> terminal: UsbAudioTerminal...|
) = (. is completed ? completed(empty) : (. is short ? short(empty) : (. is missed-service ? missed-service(empty) : (. is underrun ? underrun(empty) : (. is provider-lost ? provider-lost(empty) : (. is drained ? drained(empty) : unsupported(empty)))))))

