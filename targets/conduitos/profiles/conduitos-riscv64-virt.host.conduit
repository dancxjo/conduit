host conduitos-riscv64-headless {
  schema = 1
  target = {architecture: "riscv64", machine: "virt"}
  base = {kind: "conduitos/riscv64-sbi-console-text", implementation: "conduitos/riscv64-sbi-console@1"}
  limits = {static_memory_bytes: 1048576, heap_arena_bytes: 0, queue_items: 64, buffered_bytes: 16384, active_instances: 16, operation_slots: 8, timer_slots: 4, line_sessions: 1, evidence_items: 64}
}
