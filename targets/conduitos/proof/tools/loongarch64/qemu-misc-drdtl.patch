@@ -20,0 +21,11 @@
+/* Diagnostic profile implements only the architected PLV1..3 counter-disable
+ * bits. Other currently unimplemented MISC fields retain their existing value.
+ */
+target_ulong helper_csrwr_misc_drdtl(CPULoongArchState *env, target_ulong val)
+{
+    target_ulong old = env->CSR_MISC;
+    const target_ulong mask = (1ULL << 5) | (1ULL << 6) | (1ULL << 7);
+    env->CSR_MISC = (old & ~mask) | (val & mask);
+    return old;
+}
