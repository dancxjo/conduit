# Checked construction request for the HW-463 ESP-WROOM-32.
# Only kernel/signal is registered in this Make package. Peripheral needs below
# do not assert installed Backs or select the climate diagnostic firmware.
host hw463-environment {
  schema = 1
  target = {architecture: "xtensa-lx6", machine: "hw-463-esp-wroom-32", board: "hw-463-esp-wroom-32", make_descriptor: "sha256:1a95795ecb4dc88e30a66f70abafcbbf9c9b30787f01e93858b404c47a39b5ab"}
  base = {kind: "kernel/signal", implementation: "esp32/kernel-signal@1"}
  need = {id: "environment/sensor-data-gpio27", class: "gpio/open-drain", slots: 1, bytes: 64}
  need = {id: "environment/sampling-clock", class: "clock/monotonic", slots: 1, bytes: 64}
  need = {id: "environment/recent-observations", class: "storage/bounded-ram", slots: 1024, bytes: 32768}
  need = {id: "environment/browser-line", class: "network/access-point", slots: 1, bytes: 16384}
  need = {id: "environment/display", class: "face/seven-segment", slots: 1, bytes: 64}
  limits = {static_memory_bytes: 131072, heap_arena_bytes: 114688, queue_items: 128, buffered_bytes: 65536, active_instances: 32, operation_slots: 32, timer_slots: 16, line_sessions: 4, evidence_items: 128}
}
