# Development child candidate for the existing bounded scan coordinator.
# The oscillator and resonator algorithms remain ordinary imported Source plots.
# Development proofs cover Source/Plan/Play for the finite four-frame profile.
with data/pair/paired as AcousticStagePair

type AcousticFrameStatus =
    waiting
    | sample
    | cancelled
    | exhausted
    | invalid
    | overflow
    | stale_epoch
    | late_control
    | future_control
type AcousticFrameCursor = {
    oscillator: AudioPeriodicCursorCandidate
    resonator: ResonatorCursor
    sample: I128
    clipped: Boolean
    status: AcousticFrameStatus
    history_count: U64
    history_a: I128
    history_b: I128
    history_c: I128
    history_d: I128
}
type AcousticControlStatus =
    ready
    | cancelled
    | stale_epoch
    | late_control
    | future_control
    | invalid
type AcousticFrameControl = {
    cursor: AcousticFrameCursor
    cancelled: Boolean
    oscillator_ready: Boolean
    drive: I128
    control_status: AcousticControlStatus
}
type AcousticTimedTick = {
    anchor: AudioTrajectoryAnchor
    time: AudioExactTimeOffset
    cancelled: Boolean
}
type AcousticStage =
    context AcousticFrameControl
    | oscillator AudioPeriodicOutcome
    | resonator ResonatorOutcome
    | tick Boolean
    | timed AcousticTimedTick
    | control AcousticControlStatus

plot acoustic-frame-control (
    >> pair: AcousticStagePair
    result: AcousticStage >>
) = (AcousticStage.context({cursor: .0.context.cursor, cancelled: .1.control is cancelled, oscillator_ready: false, drive: 0, control_status: .1.control}))

plot acoustic-frame-context (
    >> value: AcousticFrameControl
    result: AcousticStage >>
) = (AcousticStage.context(.))

plot acoustic-oscillator-input (
    >> value: AcousticStage
    result: AudioPeriodicStepInput >>
) = ({cursor: .context.cursor.oscillator, cancelled: .context.cancelled})

plot acoustic-oscillator-result (
    >> value: AudioPeriodicOutcome
    result: AcousticStage >>
) = (AcousticStage.oscillator(.))

# Invalid/cancelled/exhausted oscillator results never become sample frames.
plot acoustic-after-oscillator (
    >> pair: AcousticStagePair
    result: AcousticStage >>
) = (AcousticStage.context({cursor: {oscillator: (.0.context.control_status is ready ? (.1.oscillator is advanced ? .1.oscillator.advanced.cursor : .1.oscillator is cancelled ? .1.oscillator.cancelled : .1.oscillator is exhausted ? .1.oscillator.exhausted : .0.context.cursor.oscillator) : .0.context.cursor.oscillator), resonator: .0.context.cursor.resonator, sample: (.0.context.control_status is ready ? 0 : .0.context.cursor.sample), clipped: (.0.context.control_status is ready ? false : .0.context.cursor.clipped), status: (.0.context.control_status is ready ? (.1.oscillator is advanced ? AcousticFrameStatus.waiting : .1.oscillator is cancelled ? AcousticFrameStatus.cancelled : .1.oscillator is exhausted ? AcousticFrameStatus.exhausted : AcousticFrameStatus.invalid) : (.0.context.control_status is cancelled ? AcousticFrameStatus.cancelled : .0.context.control_status is stale_epoch ? AcousticFrameStatus.stale_epoch : .0.context.control_status is late_control ? AcousticFrameStatus.late_control : .0.context.control_status is future_control ? AcousticFrameStatus.future_control : AcousticFrameStatus.invalid)), history_count: .0.context.cursor.history_count, history_a: .0.context.cursor.history_a, history_b: .0.context.cursor.history_b, history_c: .0.context.cursor.history_c, history_d: .0.context.cursor.history_d}, cancelled: .0.context.cancelled, oscillator_ready: .0.context.control_status is ready && .1.oscillator is advanced, drive: (.0.context.control_status is ready && .1.oscillator is advanced ? .1.oscillator.advanced.sample : 0), control_status: .0.context.control_status}))

plot acoustic-resonator-input (
    >> value: AcousticStage
    result: ResonatorStepInput >>
) = ({cursor: .context.cursor.resonator, sample: .context.drive, cancelled: .context.cancelled || !.context.oscillator_ready})

plot acoustic-resonator-result (
    >> value: ResonatorOutcome
    result: AcousticStage >>
) = (AcousticStage.resonator(.))

# Saturation into the PCM16 range is explicit; the wide carrier still needs
# the ordinary PCM packing boundary to admit/narrow it. The clipping fact stays in the
# same frame cursor. The original Q14 resonator history remains unmodified.
plot acoustic-after-resonator (
    >> pair: AcousticStagePair
    result: AcousticStage >>
) = (AcousticStage.context({cursor: (!.0.context.oscillator_ready ? .0.context.cursor : {oscillator: .0.context.cursor.oscillator, resonator: (.1.resonator is advanced ? .1.resonator.advanced.cursor : .1.resonator is cancelled ? .1.resonator.cancelled : .1.resonator is exhausted ? .1.resonator.exhausted : .0.context.cursor.resonator), sample: (.1.resonator is advanced ? (.1.resonator.advanced.sample < -32768 ? -32768 : .1.resonator.advanced.sample > 32767 ? 32767 : .1.resonator.advanced.sample) : 0), clipped: (.1.resonator is advanced ? .1.resonator.advanced.sample < -32768 || .1.resonator.advanced.sample > 32767 : false), status: (.1.resonator is advanced ? AcousticFrameStatus.sample : .1.resonator is cancelled ? AcousticFrameStatus.cancelled : .1.resonator is exhausted ? AcousticFrameStatus.exhausted : .1.resonator is overflow ? AcousticFrameStatus.overflow : AcousticFrameStatus.invalid), history_count: (.1.resonator is advanced && .0.context.cursor.history_count < 4 ? .0.context.cursor.history_count + 1 : .0.context.cursor.history_count), history_a: (.1.resonator is advanced && .0.context.cursor.history_count == 0 ? (.1.resonator is advanced ? (.1.resonator.advanced.sample < -32768 ? -32768 : .1.resonator.advanced.sample > 32767 ? 32767 : .1.resonator.advanced.sample) : 0) : .0.context.cursor.history_a), history_b: (.1.resonator is advanced && .0.context.cursor.history_count == 1 ? (.1.resonator is advanced ? (.1.resonator.advanced.sample < -32768 ? -32768 : .1.resonator.advanced.sample > 32767 ? 32767 : .1.resonator.advanced.sample) : 0) : .0.context.cursor.history_b), history_c: (.1.resonator is advanced && .0.context.cursor.history_count == 2 ? (.1.resonator is advanced ? (.1.resonator.advanced.sample < -32768 ? -32768 : .1.resonator.advanced.sample > 32767 ? 32767 : .1.resonator.advanced.sample) : 0) : .0.context.cursor.history_c), history_d: (.1.resonator is advanced && .0.context.cursor.history_count == 3 ? (.1.resonator is advanced ? (.1.resonator.advanced.sample < -32768 ? -32768 : .1.resonator.advanced.sample > 32767 ? 32767 : .1.resonator.advanced.sample) : 0) : .0.context.cursor.history_d)}), cancelled: false, oscillator_ready: false, drive: 0, control_status: AcousticControlStatus.ready}))

plot acoustic-retain-frame (
    >> value: AcousticStage <= 32768B
    result: AcousticStage <= 32768B >>
) = (.)

plot acoustic-control-input (
    >> pair: AcousticStagePair
    result: AcousticStage >>
) = (AcousticStage.control(.1 is timed ? (.1.timed.anchor == .0.context.cursor.oscillator.profile.projection.request.basis.anchor ? ((.1.timed.time.numerator_seconds * .0.context.cursor.oscillator.profile.projection.request.basis.sample_rate_hz) == (value/u64(.0.context.cursor.oscillator.emitted) * .1.timed.time.denominator) ? (.1.timed.cancelled ? AcousticControlStatus.cancelled : AcousticControlStatus.ready) : (.1.timed.time.numerator_seconds * .0.context.cursor.oscillator.profile.projection.request.basis.sample_rate_hz) < (value/u64(.0.context.cursor.oscillator.emitted) * .1.timed.time.denominator) ? AcousticControlStatus.late_control : AcousticControlStatus.future_control) : AcousticControlStatus.stale_epoch) : .1 is tick ? (.1.tick ? AcousticControlStatus.cancelled : AcousticControlStatus.ready) : AcousticControlStatus.invalid))

plot acoustic-value-frame (
    >> accumulator: AcousticStage <= 32768B
    >> item: AcousticStage <= 32768B
    result: AcousticStage <= 32768B >>
) {
    paired: data/pair
    admitted: acoustic-retain-frame()
    checked-control: acoustic-control-input()
    accepted-context: data/pair
    control: acoustic-frame-control()
    oscillator_context: data/pair
    oscillator: dsp/oscillator-step()
    oscillated: acoustic-after-oscillator()
    resonator_context: data/pair
    resonator: dsp/resonator-step()
    filtered: acoustic-after-resonator()
    oscillator_input: acoustic-oscillator-input()
    oscillator_tag: acoustic-oscillator-result()
    resonator_input: acoustic-resonator-input()
    resonator_tag: acoustic-resonator-result()
    retained: acoustic-retain-frame()
    accumulator >> admitted.value
    admitted.result >> paired.left
    item >> paired.right
    paired.paired >> checked-control.pair
    admitted.result >> accepted-context.left
    checked-control.result >> accepted-context.right
    accepted-context.paired >> control.pair
    control.result >> oscillator_context.left
    control.result >> oscillator_input.value
    oscillator_input.result >> oscillator.value
    oscillator.result >> oscillator_tag.value
    oscillator_tag.result >> oscillator_context.right
    oscillator_context.paired >> oscillated.pair
    oscillated.result >> resonator_context.left
    oscillated.result >> resonator_input.value
    resonator_input.result >> resonator.value
    resonator.result >> resonator_tag.value
    resonator_tag.result >> resonator_context.right
    resonator_context.paired >> filtered.pair
    filtered.result >> retained.value
    retained.result >> result
}
