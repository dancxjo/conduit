# Semantic names order matrix columns and rows; delivery bundle order is independent.
plot linear-model (
    >> inputs: NamedTensorBundle <= 262144B
    outputs: NamedTensorBundle <= 262144B >>
) {
    model: model/infer(signature = { identity: "test/multi-linear@1", compatibility_version: 1, operations: [infer(empty)], inputs: [{ identity: "left", semantic_kind: "data/tensor@1", presence: required(empty), value: tensor({ constraint: { elements: [f32(empty)], axes: [{ role: feature(empty), dimension: fixed({ value: 1 }) }], maximum_bytes: 4 } }) }, { identity: "right", semantic_kind: "data/tensor@1", presence: required(empty), value: tensor({ constraint: { elements: [f32(empty)], axes: [{ role: feature(empty), dimension: fixed({ value: 1 }) }], maximum_bytes: 4 } }) }], outputs: [{ identity: "upper", semantic_kind: "data/tensor@1", presence: required(empty), value: tensor({ constraint: { elements: [f32(empty)], axes: [{ role: feature(empty), dimension: fixed({ value: 1 }) }], maximum_bytes: 4 } }) }, { identity: "lower", semantic_kind: "data/tensor@1", presence: required(empty), value: tensor({ constraint: { elements: [f32(empty)], axes: [{ role: feature(empty), dimension: fixed({ value: 1 }) }], maximum_bytes: 4 } }) }] })
    inputs >> model.inputs
    model.outputs >> outputs
}.
