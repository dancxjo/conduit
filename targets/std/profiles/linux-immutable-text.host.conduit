host linux-immutable-text {
  schema = 1
  target = {architecture: "aarch64", machine: "raspberry-pi-3-model-b-plus-rev-1.3", board: "raspberry-pi-3-model-b-plus-rev-1.3", os: "linux"}
  base = {kind: "timer/monotonic", implementation: "hosted/monotonic-clock@1"}
  base = {kind: "storage/immutable-text", implementation: "std/file-data-save-text@1", initialization: {directory: "/var/lib/conduit/immutable-text", identity: "1111111111111111111111111111111111111111111111111111111111111111", version: "2222222222222222222222222222222222222222222222222222222222222222", content_profile: "value/text", access: "write-candidate-publish", content_bytes: 256, disk_capacity_bytes: 8192}}
  capability = {kind: "time/tick", pinned_implementation: "std/kernel-time-tick@2"}
  capability = {kind: "data/save/text", pinned_implementation: "std/file-data-save-text@1"}
  need = {id: "timer/main", class: "conduit.resource/timer-slot@1", slots: 8, bytes: 512}
  need = {id: "text/generation", class: "data/immutable-generation@1", slots: 1, bytes: 8192}
  limits = {static_memory_bytes: 16777216, heap_arena_bytes: 67108864, queue_items: 4096, buffered_bytes: 16777216, active_instances: 512, operation_slots: 256, timer_slots: 128, line_sessions: 64, evidence_items: 4096}
}
