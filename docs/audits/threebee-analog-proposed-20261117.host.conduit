host threebee-native-display {
  schema = 1
  target = {architecture: "aarch64", machine: "raspberry-pi-3-model-b-plus-rev-1.3", board: "raspberry-pi-3-model-b-plus-rev-1.3", os: "linux"}
  base = {kind: "display/scanout", implementation: "display/linear-framebuffer@1", initialization: {backend: "KMSDRM", height: 600, width: 1024}}
  base = {kind: "serial/text", implementation: "raspberry-pi-os/serial@1"}
  base = {kind: "storage/protected-file", implementation: "hosted/protected-file@1"}
  base = {kind: "timer/monotonic", implementation: "hosted/monotonic-clock@1"}
  capability = {kind: "time/tick", pinned_implementation: "std/kernel-time-tick@2"}
  need = {id: "display/main", class: "face/surface", slots: 1, bytes: 2457600}
  need = {id: "display/memory", class: "conduit.resource/runtime-memory@1", slots: 33554432, bytes: 33554432}
  need = {id: "display/show", class: "face.resource/show@1", slots: 1, bytes: 1}
  need = {id: "input/main", class: "conduit.resource/conduitos-human-input@1", slots: 1, bytes: 1}
  need = {id: "timer/main", class: "conduit.resource/timer-slot@1", slots: 8, bytes: 512}
  base = {kind: "audio/speaker", implementation: "std/kernel-audio-play-alsa-hw@1", initialization: {executable_sha256: "f6794fe7af0d7e1bb67fc56fe6e146babb099b953bfb5886852205c883e4e022", card_id: "Headphones", device: 0, base_identity: "bcm2835-audio"}}
  limits = {static_memory_bytes: 16777216, heap_arena_bytes: 67108864, queue_items: 4096, buffered_bytes: 16777216, active_instances: 512, operation_slots: 256, timer_slots: 128, line_sessions: 64, evidence_items: 4096}
}
