 input: BmeProtocolTransition...| >> output: BmeProtocolStep...|
) = { state: { address: .state.address, phase: (.event is clock-failed ? 15 : (.state.phase >= 14 ? .state.phase : (.state.address == 118 || .state.address == 119 ? ((variant/is(.event, "tick") ? .event.tick : .event.bus.now) < .state.clock ? 15 : (variant/is(.event, "tick") ? ((.state.phase == 2 || .state.phase == 11) ? (.event.tick >= .state.deadline ? (.state.phase == 2 ? 3 : 12) : .state.phase) : .state.phase) : ((.state.phase == 2 || .state.phase == 11) ? 15 : (variant/is(.event.bus.result, "completed") ? .state.phase : 15)))) : 15))), index: .state.index, polls: .state.polls, deadline: (.event is clock-failed ? .state.deadline : (.state.phase >= 14 ? .state.deadline : (.state.address == 118 || .state.address == 119 ? ((variant/is(.event, "tick") ? .event.tick : .event.bus.now) < .state.clock ? .state.deadline : (variant/is(.event, "tick") ? ((.state.phase == 2 || .state.phase == 11) ? (.event.tick >= .state.deadline ? 0 : .state.deadline) : .state.deadline) : .state.deadline)) : .state.deadline))), clock: (.event is clock-failed ? .state.clock : (.state.phase >= 14 ? (variant/is(.event, "tick") ? .event.tick : .event.bus.now) : (.state.address == 118 || .state.address == 119 ? ((variant/is(.event, "tick") ? .event.tick : .event.bus.now) < .state.clock ? (variant/is(.event, "tick") ? .event.tick : .event.bus.now) : (variant/is(.event, "tick") ? ((.state.phase == 2 || .state.phase == 11) ? (.event.tick >= .state.deadline ? (variant/is(.event, "tick") ? .event.tick : .event.bus.now) : .event.tick) : (variant/is(.event, "tick") ? .event.tick : .event.bus.now)) : ((.state.phase == 2 || .state.phase == 11) ? (variant/is(.event, "tick") ? .event.tick : .event.bus.now) : (variant/is(.event.bus.result, "completed") ? .state.clock : (variant/is(.event, "tick") ? .event.tick : .event.bus.now))))) : (variant/is(.event, "tick") ? .event.tick : .event.bus.now)))), ready: (.event is clock-failed ? true : (.state.phase >= 14 ? false : (.state.address == 118 || .state.address == 119 ? ((variant/is(.event, "tick") ? .event.tick : .event.bus.now) < .state.clock ? true : (variant/is(.event, "tick") ? ((.state.phase == 2 || .state.phase == 11) ? (.event.tick >= .state.deadline ? true : .state.ready) : false) : ((.state.phase == 2 || .state.phase == 11) ? true : (variant/is(.event.bus.result, "completed") ? .state.ready : true)))) : true))), first: .state.first, humidity_first: .state.humidity_first, humidity: .state.humidity, sample: .state.sample, failure: (.event is clock-failed ? clock(.event.clock-failed) : (.state.phase >= 14 ? .state.failure : (.state.address == 118 || .state.address == 119 ? ((variant/is(.event, "tick") ? .event.tick : .event.bus.now) < .state.clock ? malformed(empty) : (variant/is(.event, "tick") ? .state.failure : ((.state.phase == 2 || .state.phase == 11) ? unexpected(empty) : (variant/is(.event.bus.result, "completed") ? .state.failure : bus(.event.bus.result))))) : unsupported-address(.state.address)))) }, event: .event, handled: (.event is clock-failed ? true : (.state.phase >= 14 ? true : (.state.address == 118 || .state.address == 119 ? ((variant/is(.event, "tick") ? .event.tick : .event.bus.now) < .state.clock ? true : (variant/is(.event, "tick") ? true : ((.state.phase == 2 || .state.phase == 11) ? true : (variant/is(.event.bus.result, "completed") ? false : true)))) : true))) }

# Handled routes select original fields without evaluating phase conditions.
# Unhandled routes preserve the original phase order and finish fallback.
