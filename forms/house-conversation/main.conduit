form house-conversation (
    > detection: AddressDetection
    > context: HouseContext
    response: llm/generated-result@1 >
) {
    request: house/context-to-prompt
    model: llm/generate(maximum-input-bytes = 131072, maximum-context-items = 128, maximum-output-bytes = 2048, maximum-work-units = 1000000, maximum-history-items = 64)

    detection > request.detection
    context > request.context
    request.request > model.request
    model.result > response
}
