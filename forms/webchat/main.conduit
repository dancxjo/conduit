# Explicit external-WebSocket transport faces for the bounded local webchat.
form chat/client (
    url: Url
    > send: WebSocketMessage...|
    recv: WebSocketMessage...| >
    live: $Boolean >
) {
    socket: net/websocket(url)
    send > socket.send
    socket.recv > recv
    socket.live > live
}

form chat/server (
    bind: NetAddress
    live: $Boolean >
) {
    listen: net/websocket/listen(bind)
    listen.recv > listen.send
    listen.live > live
}

form webchat-transport-demo {
    client: chat/client("ws://127.0.0.1:4178")
    server: chat/server("127.0.0.1:4178")
}

form webchat-server-demo {
    server: chat/server("127.0.0.1:4178")
}

form chat/browser-client (
    url: Url
) {
    state: chat/state(title = "Conduit Webchat", history-label = "Chat history", input-label = "Message", submit-label = "Send", status-label = "Connection", maximum-history-items = 16, maximum-message-bytes = 256)
    spread: presentation/tee
    render: presentation/renderer
    human: presentation/interaction
    submit: chat/submit(action = "chat/send", maximum-message-bytes = 256)
    socket: net/websocket(url)

    socket.recv > state.message
    socket.live > state.live
    state.presentation > spread.presentation
    spread.presentation > render.presentation
    spread.presentation > human.presentation
    render.manifestation > human.manifestation
    human.interaction > submit.interaction
    submit.message > socket.send
}

form webchat-browser-demo {
    client: chat/browser-client("ws://127.0.0.1:4178")
}

form chat/browser-client-label-oracle (
    url: Url
) {
    state: chat/state(title = "Conduit Webchat", history-label = "Chat history", input-label = "Say something", submit-label = "Transmit", status-label = "Connection", maximum-history-items = 16, maximum-message-bytes = 256)
    spread: presentation/tee
    render: presentation/renderer
    human: presentation/interaction
    submit: chat/submit(action = "chat/send", maximum-message-bytes = 256)
    socket: net/websocket(url)

    socket.recv > state.message
    socket.live > state.live
    state.presentation > spread.presentation
    spread.presentation > render.presentation
    spread.presentation > human.presentation
    render.manifestation > human.manifestation
    human.interaction > submit.interaction
    submit.message > socket.send
}

form webchat-browser-label-oracle {
    client: chat/browser-client-label-oracle("ws://127.0.0.1:4178")
}
