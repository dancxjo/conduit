form bounded-typed-history (
    value-profile: Text = "value/text@1"
    maximum-entries: Count = 16
    maximum-referenced-bytes: Count = 1048576
    overflow-policy: Text = "refuse"
    > command: HistoricalTimelineCommand...|
    timeline: HistoricalTypedTimeline >
) {
    history: history/bounded-typed(value-profile, maximum-entries, maximum-referenced-bytes, overflow-policy)
    command > history.command
    history.timeline > timeline
}
