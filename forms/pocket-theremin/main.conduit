# A finite portable controller-to-pitch Form. Pointer acquisition and visible
# quantity manifestation are selected Host realizations, not authored APIs.
form pocket-theremin {
    controller: input/pointer-source
    normalize: math/normalized-quantity-scalar
    pitch: quantity-range-map
    inspect: structured-info/wrap-quantity
    manifest: presentation/quantity

    controller.pointer > project(PointerEvent.position) > project(Point2.x) > normalize.in
    normalize.out > pitch.control
    pitch.quantity > inspect.in
    inspect.out > manifest.input
}

# Reusable typed pitch mapping; other controllers can supply the same normalized
# scalar without importing pointer or presentation meaning.
form quantity-range-map (
    control: Scalar > quantity: Quantity
) {
    map: math/map-quantity(source-minimum = 0, source-maximum = 1000000, target-minimum = 20, target-maximum = 20000, target-granularity = 1, unit = "Hz", range-policy = "clamp", quantization = "nearest")
    control > map.in
    map.out > quantity
}
