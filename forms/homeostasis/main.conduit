# Ordinary factual self-state reduction. Sources remain optional and typed;
# the reducer owns no acquisition, effects, safety enforcement, or prose.
form homeostasis (
    > power: HomeostaticPowerInput...|
    > thermal: HomeostaticThermalInput...|
    > compute-pressure: HomeostaticComputePressureInput...|
    > storage-pressure: HomeostaticStoragePressureInput...|
    > motion-safety: HomeostaticSafetyInput...|
    > important-capability: HomeostaticCapabilityInput...|
    state: $ExperienceBodyInput >
) {
    reduce: experience/reduce-homeostasis
    power > reduce.power
    thermal > reduce.thermal
    compute-pressure > reduce.compute_pressure
    storage-pressure > reduce.storage_pressure
    motion-safety > reduce.motion_safety
    important-capability > reduce.important_capability
    reduce.state > state
}
