form bounded-replay-control (
    mode: Text = "original-timing"
    rate-numerator: Count = 1
    rate-denominator: Count = 1
    > timeline: ReplayTimeline
    > control: ReplayControl...|
    > clock: PlaybackTick...|
    event: ReplayEvent...| >
    state: ReplayState...| >
) {
    replay: time/replay-control(mode, rate-numerator, rate-denominator)
    timeline > replay.timeline
    control > replay.control
    clock > replay.clock
    replay.event > event
    replay.state > state
}
