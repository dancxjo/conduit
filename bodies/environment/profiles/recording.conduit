# A recorder's status projection, not a replacement for the producer's full
# capture evidence. Available entries retain first-class observation quantities.
type RecordingDisposition =
    available
    | capture-timeout
    | provider-failed
    | geometry-refused
    | short-frame
    | malformed-length
    | checksum
    | invalid-payload
form environment/recording-disposition = RecordingDisposition as u8

# Event meaning in the producer's Boot clock; neither alternative is UTC or
# receiver receipt time. Observing a publication does not date its acquisition.
type RecordingTimestampBasis =
    acquisition
    | producer-observation
