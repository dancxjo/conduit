# Separate symbolic commitment. Unknown origin and policy remain inspectable.
# This does not establish linguistic truth or change legacy stable fact laws.
type LanguageParserWindow8QualifiedLexicalQuery = {
    proposed: LanguageLexicalProposedTape
    fact: LanguageParserWindow8FactQuery
    where .proposed.tape == .fact.snapshot.lexical.tape
    where !variant/is(sequence/at(.proposed.origins,.fact.dependent),"incomplete")
}
type LanguageParserWindow8QualifiedLexicalProposal = {
    query: LanguageParserWindow8QualifiedLexicalQuery
}
type LanguageParserWindow8QualifiedLexicalAnalysis = {
    proposal: LanguageParserWindow8QualifiedLexicalProposal
    where variant/is(sequence/at(.proposal.query.proposed.origins,.proposal.query.fact.dependent),"unknown") ? !variant/is(.proposal.query.proposed.definition.unknown.commitment,"refuse") : true
    where (variant/is(sequence/at(.proposal.query.proposed.origins,.proposal.query.fact.dependent),"unknown") && variant/is(.proposal.query.proposed.definition.unknown.commitment,"final_input_consensus")) ? variant/is(.proposal.query.fact.snapshot.lexical.tape.source.finality,"final") : (variant/is(.proposal.query.fact.snapshot.lexical.tape.source.stable_prefix,"some") ? (sequence/at(.proposal.query.fact.snapshot.lexical.tape.tokens,.proposal.query.fact.dependent).span.end <= value/u64(.proposal.query.fact.snapshot.lexical.tape.source.stable_prefix.some)) : false)
    where .proposal.query.fact.dependent < .proposal.query.fact.snapshot.candidate0.hypothesis.selected
    where !.proposal.query.fact.snapshot.candidate1.hypothesis.active || .proposal.query.fact.dependent < .proposal.query.fact.snapshot.candidate1.hypothesis.selected
    where !.proposal.query.fact.snapshot.candidate1.hypothesis.active || sequence/at(.proposal.query.fact.snapshot.candidate1.hypothesis.choices,.proposal.query.fact.dependent) == sequence/at(.proposal.query.fact.snapshot.candidate0.hypothesis.choices,.proposal.query.fact.dependent)
    where !.proposal.query.fact.snapshot.candidate2.hypothesis.active || .proposal.query.fact.dependent < .proposal.query.fact.snapshot.candidate2.hypothesis.selected
    where !.proposal.query.fact.snapshot.candidate2.hypothesis.active || sequence/at(.proposal.query.fact.snapshot.candidate2.hypothesis.choices,.proposal.query.fact.dependent) == sequence/at(.proposal.query.fact.snapshot.candidate0.hypothesis.choices,.proposal.query.fact.dependent)
    where !.proposal.query.fact.snapshot.candidate3.hypothesis.active || .proposal.query.fact.dependent < .proposal.query.fact.snapshot.candidate3.hypothesis.selected
    where !.proposal.query.fact.snapshot.candidate3.hypothesis.active || sequence/at(.proposal.query.fact.snapshot.candidate3.hypothesis.choices,.proposal.query.fact.dependent) == sequence/at(.proposal.query.fact.snapshot.candidate0.hypothesis.choices,.proposal.query.fact.dependent)
}
plot language-window8-qualified-lexical-proposal (
    input: LanguageParserWindow8QualifiedLexicalQuery...| >> output: LanguageParserWindow8QualifiedLexicalProposal...|
) = { query: . }
