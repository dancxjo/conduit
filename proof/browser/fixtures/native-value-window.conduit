type Vector<T, N: U16> = collection T = N
type Window<H: U16, D: U16> = {
    window: Vector<U8, (H + 1) * D>
    history: Vector<Vector<U8, D>, H>
}
type Window2x3 = Window<2, 3>
plot make (
    >> input: Text
    result: Window2x3 >>
) = ({window: [1,2,3,4,5,6,7,8,9], history: [[1,2,3],[4,5,6]]})
plot verify (
    >> input: Window2x3
    result: Boolean >>
) = (sequence/length(.window) == 9 && sequence/length(.history) == 2)
plot native-value-window {
    seed: text/literal("type admission")
    created: make
    checked: verify
    show: presentation/bool-value
    seed >> created.input
    created.result >> checked.input
    checked.result >> show.value
}.
