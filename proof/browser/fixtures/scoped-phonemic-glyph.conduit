with speech/ipa/notation as ph using {provenance: chosen-provenance, inventory: chosen-inventory, basis: chosen-basis, phone-bindings: chosen-phone-bindings, phoneme-bindings: chosen-phoneme-bindings}
plot glyph-ipa {
 chosen-provenance = {method: "quoted phonemic fixture", source: manual(""), version: none("")}
 chosen-inventory = {identity: "inventory/test", language: "language/test", phones: [], phonemes: [ {identity: "phoneme/ch", notation: "t͡ʃ", features: [], aliases: [], default_phone: none(""), possible_phones: [], allophones: [], status: core("")}, {identity: "phoneme/long-a", notation: "aː", features: [], aliases: [], default_phone: none(""), possible_phones: [], allophones: [], status: core("")} ]}
 chosen-basis = {inventory_id: "inventory/test", language: "language/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, profile: { identity: "notation/test", inventory_id: "inventory/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, aliases: [], provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}, units: [ {identity: "unit/ch", spelling: "t͡ʃ", kind: segment(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/a", spelling: "a", kind: segment(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/length", spelling: "ː", kind: length(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/stress", spelling: "ˈ", kind: primary_stress(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}} ] }}
 chosen-phone-bindings = {values: []}
 chosen-phoneme-bindings = {values: [ {phoneme: "phoneme/ch", units: ["unit/ch"], provenance: {method: "declared contrast", source: manual(""), version: none("")}}, {phoneme: "phoneme/long-a", units: ["unit/a", "unit/length"], provenance: {method: "declared contrast", source: manual(""), version: none("")}} ]}
 value = ph/ˈt͡ʃaː/
 seed: text/literal("checked IPA equality")
 show: presentation/bool-value
 seed >> (value == value) >> show.value
}.
