+#[test]
+fn bounded_selected_factory_admits_box_and_refuses_capacity_foreign_before_allocation() {
+    let ty = StructuredInfoType::leaf(kind_id("value/count")).unwrap();
+    let c = CheckedValueContract::new(kind_id("value/count"), 8, vec![]).unwrap();
+    for feedback in [false, true] {
+        let mut factory = FlowZipOperationFactory::frame16k();
+        let offer = if feedback {
+            factory.install_feedback_specialized(&c, &ty, &c, &ty)
+        } else {
+            factory.install_specialized(&c, &ty, &c, &ty)
+        }
+        .unwrap();
+        let g = gear(&offer);
+        let mut reservation = None;
+        assert_eq!(
+            crate::test_allocations::allocations(
+                || reservation = Some(factory.back_storage_reservation(&g).unwrap())
+            ),
+            0
+        );
+        let r = reservation.unwrap();
+        let (mut back, receipt) = factory
+            .prepare_with_storage_limits(
+                &g,
+                r.preparation_requested_bytes_bound,
+                r.retained_heap_bytes_bound,
+            )
+            .unwrap();
+        assert_eq!(receipt, r);
+        for (prep, retained) in [
+            (
+                r.preparation_requested_bytes_bound - 1,
+                r.retained_heap_bytes_bound,
+            ),
+            (
+                r.preparation_requested_bytes_bound,
+                r.retained_heap_bytes_bound - 1,
+            ),
+        ] {
+            assert_eq!(
+                crate::test_allocations::allocations(|| assert!(matches!(
+                    factory.prepare_with_storage_limits(&g, prep, retained),
+                    Err(FlowZipPreparationRefusal::Storage(
+                        PreparedStructuredCompositionStorageRefusal::Capacity
+                    ))
+                ))),
+                0
+            );
+        }
+        let mut foreign = g.clone();
+        foreign.artifact_id = ArtifactId::from("foreign/artifact");
+        assert_eq!(
+            crate::test_allocations::allocations(|| assert!(matches!(
+                factory.prepare_with_storage_limits(
+                    &foreign,
+                    r.preparation_requested_bytes_bound,
+                    r.retained_heap_bytes_bound
+                ),
+                Err(FlowZipPreparationRefusal::Selection(_))
+            ))),
+            0
+        );
+        use conduit_kernel::{
+            PortId, ValueRef,
+            scheduler::{StepInputBytes, StepIo, StepOutcome},
+        };
+        let left = encode_count(3);
+        let right = encode_count(5);
+        let mut expected =
+            PreparedTypedTuplePairEncoder::new(ty.clone(), 8, ty.clone(), 8).unwrap();
+        let expected = expected.encode(&left, &right).unwrap().to_vec();
+        assert_eq!(
+            crate::test_allocations::allocations(|| {
+                for (side, bytes) in [(0, left.as_slice()), (1, right.as_slice())] {
+                    let mut refs = [None; 16];
+                    let mut inputs = [None; 16];
+                    refs[side] = Some(ValueRef {
+                        slot: side as u16,
+                        generation: 1,
+                        byte_len: bytes.len() as u32,
+                    });
+                    inputs[side] = Some(bytes);
+                    let mut io = StepIo::test_frame(refs, [false; 16], [None; 16], None, 16);
+                    assert_eq!(
+                        back.step(&mut io, &StepInputBytes::test_frame(inputs, None)),
+                        StepOutcome::Progress
+                    );
+                    back.step_committed();
+                }
+                let mut io = StepIo::test_frame([None; 16], [false; 16], [None; 16], None, 16);
+                assert_eq!(
+                    back.step(&mut io, &StepInputBytes::test_frame([None; 16], None)),
+                    StepOutcome::Await
+                );
+                let mut outputs = [None; 16];
+                outputs[0] = Some(4096);
+                let mut io = StepIo::test_frame([None; 16], [false; 16], outputs, None, 16);
+                assert_eq!(
+                    back.step(&mut io, &StepInputBytes::test_frame([None; 16], None)),
+                    StepOutcome::Progress
+                );
+                assert_eq!(back.prepared_output(PortId(0)), Some(expected.as_slice()));
+                back.step_committed();
+            }),
+            0
+        );
+    }
+}
