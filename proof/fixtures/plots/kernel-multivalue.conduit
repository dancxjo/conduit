plot kernel-multivalue {
    clock: time/tick(count = 4, period-ms = 0)
    split: flow/tee
    even: flow/filter-even
    latest: state/latest
    show-even: face/show("Signal")
    show-latest: face/show("Signal")

    clock.tick >> split.in
    split.left >> even.in
    even.out >> show-even.in
    split.right >> latest.in
    latest.out >> show-latest.in
}
