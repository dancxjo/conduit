{
  "suite": "conduit.conduct-output",
  "finite_result_cases": [
    {
      "id": "check-result",
      "mode": "check",
      "format": "json",
      "expected": {"schema": "conduit.result", "schema_version": 0, "operation": "check"}
    },
    {
      "id": "explain-result",
      "mode": "explain",
      "format": "json",
      "expected": {"schema": "conduit.result", "schema_version": 0, "operation": "explain"}
    }
  ],
  "run_record_cases": [
    {
      "id": "value-record",
      "sequence": 0,
      "expected": {"schema": "conduit.run", "schema_version": 0, "record": "value", "channel": "stdout", "encoding": "hex"}
    },
    {
      "id": "summary-record",
      "sequence": 1,
      "expected": {"schema": "conduit.run", "schema_version": 0, "record": "summary"}
    },
    {
      "id": "ordered-records",
      "expected": {"first_sequence": 0, "contiguous": true, "summary_final": true}
    }
  ],
  "format_cases": [
    {
      "id": "check-human",
      "mode": "check",
      "format": "human",
      "expected": {"accepted": true, "stdout_kind": "human"}
    },
    {
      "id": "check-json",
      "mode": "check",
      "format": "json",
      "expected": {"accepted": true, "stdout_kind": "finite-json"}
    },
    {
      "id": "check-ndjson-rejected",
      "mode": "check",
      "format": "ndjson",
      "expected": {"accepted": false, "diagnostic_code": "CND-CLI-003"}
    },
    {
      "id": "explain-human",
      "mode": "explain",
      "format": "human",
      "expected": {"accepted": true, "stdout_kind": "human"}
    },
    {
      "id": "explain-json",
      "mode": "explain",
      "format": "json",
      "expected": {"accepted": true, "stdout_kind": "finite-json"}
    },
    {
      "id": "explain-ndjson-rejected",
      "mode": "explain",
      "format": "ndjson",
      "expected": {"accepted": false, "diagnostic_code": "CND-CLI-003"}
    },
    {
      "id": "run-human",
      "mode": "run",
      "format": "human",
      "expected": {"accepted": true, "stdout_kind": "human"}
    },
    {
      "id": "run-json-rejected",
      "mode": "run",
      "format": "json",
      "expected": {"accepted": false, "diagnostic_code": "CND-CLI-003"}
    },
    {
      "id": "run-ndjson",
      "mode": "run",
      "format": "ndjson",
      "expected": {"accepted": true, "stdout_kind": "streaming-ndjson"}
    }
  ],
  "stream_policy_cases": [
    {
      "id": "diagnostic-human-independent",
      "expected": {"diagnostic_stream": "stderr", "result_stream": "stdout"}
    },
    {
      "id": "diagnostic-json-independent",
      "expected": {"diagnostic_stream": "stderr", "diagnostic_schema": "conduit.diagnostic", "result_stream": "stdout"}
    },
    {
      "id": "machine-stdout-clean",
      "expected": {"ansi": false, "cursor_control": false, "progress": false, "diagnostic_prose": false}
    },
    {
      "id": "quiet-preserves-primary",
      "expected": {"primary": true, "diagnostics": true, "status": false, "progress": false}
    },
    {
      "id": "verbose-distinct-from-diagnostic-verbosity",
      "expected": {"general_verbosity": "status-detail", "diagnostic_verbosity": "related-structure"}
    },
    {
      "id": "non-tty-status-suppressed",
      "expected": {"status": false, "cursor_control": false}
    },
    {
      "id": "ci-redirection-status-suppressed",
      "environment": {"CI": "true"},
      "terminal": false,
      "expected": {"status": false, "cursor_control": false}
    },
    {
      "id": "broken-pipe-success",
      "expected": {"exit": 0, "diagnostic": false}
    },
    {
      "id": "non-broken-output-failure",
      "expected": {"exit": 2, "diagnostic_code": "CND-IO-002"}
    }
  ],
  "progress_cases": [
    {
      "id": "known-positive-total",
      "total": 3,
      "updates": [0, 2, 3],
      "expected": {"accepted": true}
    },
    {
      "id": "zero-total-rejected",
      "total": 0,
      "expected": {"accepted": false, "reason": "zero-total"}
    },
    {
      "id": "reverse-rejected",
      "total": 3,
      "updates": [2, 1],
      "expected": {"accepted": false, "reason": "out-of-bounds"}
    },
    {
      "id": "overflow-rejected",
      "total": 3,
      "updates": [4],
      "expected": {"accepted": false, "reason": "out-of-bounds"}
    }
  ],
  "generated_asset_cases": [
    {"id": "bash", "path": "generated/completions/conduct.bash", "expected": {"generated": true}},
    {"id": "zsh", "path": "generated/completions/_conduct", "expected": {"generated": true}},
    {"id": "fish", "path": "generated/completions/conduct.fish", "expected": {"generated": true}},
    {"id": "powershell", "path": "generated/completions/conduct.ps1", "expected": {"generated": true}},
    {"id": "elvish", "path": "generated/completions/conduct.elv", "expected": {"generated": true}},
    {"id": "man", "path": "generated/man/conduct.1", "expected": {"generated": true}}
  ]
}
