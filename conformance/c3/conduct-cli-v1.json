{
  "suite": "conduit.conduct-cli/v1",
  "command_cases": [
    {
      "id": "default-run-file",
      "runner": "process",
      "args": ["$EXAMPLE"],
      "expected": {"exit": 0, "stdout": "HELLO FROM CONDUIT.\n", "stderr": "empty"}
    },
    {
      "id": "explicit-run-file",
      "runner": "process",
      "args": ["--run", "$EXAMPLE"],
      "expected": {"exit": 0, "stdout": "HELLO FROM CONDUIT.\n", "stderr": "empty"}
    },
    {
      "id": "check-file",
      "runner": "process",
      "args": ["--check", "$EXAMPLE"],
      "expected": {"exit": 0, "stdout": "ok: panel v3; 0 definitions; 3 root nodes; 2 root cords\n", "stderr": "empty"}
    },
    {
      "id": "explain-file",
      "runner": "process",
      "args": ["--explain", "$EXAMPLE"],
      "expected": {"exit": 0, "stdout_starts": "logical panel v3:", "stderr": "empty"}
    },
    {
      "id": "default-run-stdin",
      "runner": "process",
      "args": [],
      "stdin": "$HELLO_SOURCE",
      "expected": {"exit": 0, "stdout": "HELLO FROM CONDUIT.\n", "stderr": "empty"}
    },
    {
      "id": "dash-run-stdin",
      "runner": "process",
      "args": ["-"],
      "stdin": "$HELLO_SOURCE",
      "expected": {"exit": 0, "stdout": "HELLO FROM CONDUIT.\n", "stderr": "empty"}
    },
    {
      "id": "mutually-exclusive-modes-human",
      "runner": "process",
      "args": ["--check", "--run"],
      "expected": {"exit": 2, "stdout": "empty", "stderr_snapshot": "argument-conflict.txt"}
    },
    {
      "id": "mutually-exclusive-modes-json",
      "runner": "process",
      "args": ["--diagnostic-format=json", "--check", "--run"],
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-CLI-001"}
    },
    {
      "id": "unknown-option-json",
      "runner": "process",
      "args": ["--diagnostic-format=json", "--unknown"],
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-CLI-001"}
    },
    {
      "id": "two-panels-json",
      "runner": "process",
      "args": ["--diagnostic-format=json", "one.panel", "two.panel"],
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-CLI-001"}
    },
    {
      "id": "canonical-diagnostic-flags",
      "runner": "process",
      "args": ["--check", "--diagnostic-format=json", "--color=never", "--verbose-diagnostics", "-"],
      "stdin": "panel 3\ncord a.value b.text\n",
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-SRC-001", "ansi": false}
    },
    {
      "id": "concise-human-diagnostic",
      "runner": "process",
      "args": ["--check", "--color=never", "-"],
      "stdin": "panel 3\ncord a.value b.text\n",
      "expected": {"exit": 2, "stdout": "empty", "stderr_contains": "error[CND-SRC-001]", "ansi": false}
    },
    {
      "id": "verbose-human-diagnostic",
      "runner": "process",
      "args": ["--check", "--color=never", "--verbose-diagnostics", "-"],
      "stdin": "panel 3\ncord a.value b.text\n",
      "expected": {"exit": 2, "stdout": "empty", "stderr_contains": "bytes 21..22", "ansi": false}
    },
    {
      "id": "diagnostic-json-clean-stdout",
      "runner": "process",
      "args": ["--check", "--diagnostic-format=json", "-"],
      "stdin": "panel 3\ncord a.value b.text\n",
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-SRC-001"}
    },
    {
      "id": "missing-file",
      "runner": "process",
      "args": ["--check", "--diagnostic-format=json", "fixture/definitely-missing.panel"],
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-IO-001"}
    },
    {
      "id": "invalid-utf8-stdin",
      "runner": "process",
      "args": ["--check", "--diagnostic-format=json", "-"],
      "stdin_hex": "fffe",
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-IO-001"}
    },
    {
      "id": "ordinary-run-path-not-subcommand",
      "runner": "process",
      "args": ["--diagnostic-format=json", "run"],
      "expected": {"exit": 2, "stdout": "empty", "stderr_code": "CND-IO-001"}
    },
    {
      "id": "help-width-40",
      "runner": "process",
      "args": ["--help"],
      "environment": {"COLUMNS": "40"},
      "expected": {"exit": 0, "stdout_snapshot": "help.txt", "stderr": "empty"}
    },
    {
      "id": "help-width-120",
      "runner": "process",
      "args": ["--help"],
      "environment": {"COLUMNS": "120"},
      "expected": {"exit": 0, "stdout_snapshot": "help.txt", "stderr": "empty"}
    },
    {
      "id": "version",
      "runner": "process",
      "args": ["--version"],
      "expected": {"exit": 0, "stdout_starts": "conduct ", "stderr": "empty"}
    },
    {
      "id": "broken-stdout-pipe",
      "runner": "broken-pipe",
      "args": ["--explain", "$EXAMPLE"],
      "expected": {"exit": 0}
    },
    {
      "id": "closed-stderr",
      "runner": "closed-stderr",
      "args": ["--check", "--run"],
      "expected": {"exit": 2}
    },
    {
      "id": "stdout-write-failure",
      "runner": "output-failure",
      "args": ["--check", "$EXAMPLE"],
      "expected": {"exit": 2, "stderr_contains": "CND-IO-002"}
    },
    {
      "id": "warning-presentation",
      "runner": "diagnostic-fixture-link",
      "fixture": "diagnostics-v1#stable-json",
      "expected": {"severity": "warning", "renderer": "conduit-diagnostics"}
    }
  ],
