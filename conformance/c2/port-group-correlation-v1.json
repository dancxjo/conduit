{
  "suite": "conduit.port-group-correlation/v1",
  "port_group_cases": [
    {
      "id": "keyed-exact-identities-and-spans",
      "assertion": "lower",
      "source": "panel 1\nport-group routes input : fixture/request-port keyed max 3 { member home member assets }\n",
      "expected": {
        "outcome": "accepted",
        "maximum": 3,
        "members": [
          {"key": "home", "ordinal": 0, "line": 2, "column": 69, "end_column": 73},
          {"key": "assets", "ordinal": 1, "line": 2, "column": 81, "end_column": 87}
        ]
      }
    },
    {
      "id": "indexed-exact-range",
      "assertion": "lower",
      "source": "panel 1\nport-group workers output : fixture/reply-port indexed max 3\n",
      "expected": {
        "outcome": "accepted",
        "maximum": 3,
        "members": [
          {"key": "0", "ordinal": 0, "authored_span": false},
          {"key": "1", "ordinal": 1, "authored_span": false},
          {"key": "2", "ordinal": 2, "authored_span": false}
        ]
      }
    },
    {
      "id": "complete-contract-direction-mismatch",
      "assertion": "diagnostic",
      "source": "panel 1\nport-group routes input : fixture/reply-port indexed max 1\n",
      "expected": {"outcome": "rejected", "code": "CND-LWR-010"}
    },
    {
      "id": "maximum-changes-identity",
      "assertion": "compare",
      "source": "panel 1\nport-group routes input : fixture/request-port keyed max 2 { member home member assets }\n",
      "comparison_source": "panel 1\nport-group routes input : fixture/request-port keyed max 3 { member home member assets }\n",
      "expected": {"outcome": "accepted", "relation": "different"}
    },
    {
      "id": "trivia-preserves-identity",
      "assertion": "compare",
      "source": "panel 1\nport-group routes input : fixture/request-port keyed max 2 { member home member assets }\n",
      "comparison_source": "# presentation only\npanel 1 port-group routes input:fixture/request-port keyed max 2{member home member assets}\n",
      "expected": {"outcome": "accepted", "relation": "equal"}
    },
    {
      "id": "catalog-order-independent",
      "assertion": "catalog-order",
      "source": "panel 1\nport-group routes input : fixture/request-port indexed max 2\n",
      "catalog_orders": [
        ["fixture/request-port", "fixture/reply-port"],
        ["fixture/reply-port", "fixture/request-port"]
      ],
      "expected": {"outcome": "accepted", "relation": "equal"}
    },
    {
      "id": "nested-member-export-source",
      "assertion": "parse",
      "source": "panel 1\nnode inner() { port-group routes output : fixture/reply-port keyed max 2 { member home member assets } }\nnode middle() { node child : inner export output child.routes[home] as home }\nnode outer() { node child : middle export output child.home as home }\nroot outer\n",
      "expected": {"outcome": "accepted", "target": "routes[home]"}
    },
    {
      "id": "unknown-local-member",
      "assertion": "parse-diagnostic",
      "source": "panel 1\nnode inner() { port-group routes output : fixture/reply-port keyed max 1 { member home } }\nnode outer() { node child : inner export output child.routes[missing] as missing }\nroot outer\n",
      "expected": {"outcome": "rejected", "code": "CND-SRC-009"}
    },
    {
      "id": "duplicate-key",
      "assertion": "parse-diagnostic",
      "source": "panel 1\nport-group routes input : fixture/request-port keyed max 2 { member home member home }\n",
      "expected": {"outcome": "rejected", "code": "CND-SRC-002"}
    },
    {
      "id": "zero-maximum",
      "assertion": "parse-diagnostic",
      "source": "panel 1\nport-group routes input : fixture/request-port indexed max 0\n",
      "expected": {"outcome": "rejected", "code": "CND-SRC-008"}
    },
    {
      "id": "overflowed-maximum",
      "assertion": "parse-diagnostic",
      "source": "panel 1\nport-group routes input : fixture/request-port indexed max 65536\n",
      "expected": {"outcome": "rejected", "code": "CND-SRC-008"}
    },
    {
      "id": "membership-exceeds-maximum",
      "assertion": "parse-diagnostic",
      "source": "panel 1\nport-group routes input : fixture/request-port keyed max 1 { member home member assets }\n",
      "expected": {"outcome": "rejected", "code": "CND-SRC-008"}
    },
    {
      "id": "boundary-bypass",
      "assertion": "parse-diagnostic",
      "source": "panel 1\nnode inner() { port-group routes output : fixture/reply-port keyed max 1 { member home } }\nnode outer() { node child : inner export output missing.routes[home] as home }\nroot outer\n",
      "expected": {"outcome": "rejected", "code": "CND-SRC-009"}
    }
  ],
  "plan_cases": [
    {
      "id": "plan-v1-preserved",
      "schema": 1,
      "mutation": "maximum-and-direction",
      "expected": {"identity": "equal", "validation": "accepted"}
    },
    {
      "id": "plan-v2-maximum",
      "schema": 2,
      "mutation": "maximum",
      "expected": {"identity": "different", "validation": "accepted"}
    },
    {
      "id": "plan-v2-direction",
      "schema": 2,
      "mutation": "direction",
      "expected": {"identity": "different", "validation": "accepted"}
    },
    {
      "id": "plan-v2-membership-over-maximum",
      "schema": 2,
      "maximum": 1,
      "member_count": 2,
      "expected": {"validation": "rejected", "code": "CND-PLN-003"}
    },
    {
      "id": "plan-v1-to-v2-migration",
      "from_schema": 1,
      "to_schema": 2,
      "migration_inputs": ["exact_lowered_maximum", "exact_lowered_direction"],
      "forbidden_inference": "member_count_as_maximum",
      "expected": {"identity": "different", "meaning": "preserved"}
    }
  ],
  "identity_families": [
    {"id": "request", "allocator": "request-origin", "scope": "request", "lifetime": "terminal-reply-or-failure", "uniqueness": "origin-namespace", "serialization": "id", "sensitivity": "policy-classified-metadata", "propagation": "end-to-end", "expected": {"outcome": "defined"}},
    {"id": "exchange", "allocator": "protocol-owner", "scope": "request-reply-exchange", "lifetime": "exchange-terminal", "uniqueness": "request-and-protocol", "serialization": "id", "sensitivity": "policy-classified-metadata", "propagation": "request-and-reply", "expected": {"outcome": "defined"}},
    {"id": "session", "allocator": "session-owner", "scope": "session", "lifetime": "session-terminal-or-replacement", "uniqueness": "session-owner", "serialization": "id", "sensitivity": "policy-classified-metadata", "propagation": "session-work", "expected": {"outcome": "defined"}},
    {"id": "session-epoch", "allocator": "session-owner", "scope": "session", "lifetime": "one-session-epoch", "uniqueness": "session-and-epoch", "serialization": "u32", "sensitivity": "metadata", "propagation": "with-session", "expected": {"outcome": "defined"}},
    {"id": "work-unit", "allocator": "work-submitter", "scope": "logical-job", "lifetime": "job-terminal", "uniqueness": "submitter-namespace", "serialization": "id", "sensitivity": "policy-classified-metadata", "propagation": "attempts-and-checkpoints", "expected": {"outcome": "defined"}},
    {"id": "attempt", "allocator": "supervisor", "scope": "work-unit", "lifetime": "attempt-terminal", "uniqueness": "work-and-supervisor", "serialization": "id", "sensitivity": "metadata", "propagation": "one-attempt", "expected": {"outcome": "defined"}},
    {"id": "causation", "allocator": "run-recorder-or-observer", "scope": "run-evidence", "lifetime": "evidence-retention", "uniqueness": "run-stream", "serialization": "event-id", "sensitivity": "evidence-metadata", "propagation": "explicit-event-relation", "expected": {"outcome": "defined"}},
    {"id": "correlation", "allocator": "initiating-boundary", "scope": "declared-related-activity", "lifetime": "declared-scope", "uniqueness": "allocator-namespace", "serialization": "id", "sensitivity": "policy-classified-metadata", "propagation": "declared-only", "expected": {"outcome": "defined"}},
    {"id": "idempotency", "allocator": "caller", "scope": "target-operation", "lifetime": "duplicate-suppression-window", "uniqueness": "caller-and-target", "serialization": "id", "sensitivity": "protected-when-policy-requires", "propagation": "enforcing-boundaries", "expected": {"outcome": "defined"}},
    {"id": "checkpoint", "allocator": "checkpoint-writer", "scope": "work-unit", "lifetime": "durable-progress-retention", "uniqueness": "work-and-checkpoint-store", "serialization": "id", "sensitivity": "policy-classified-metadata", "propagation": "resume", "expected": {"outcome": "defined"}},
    {"id": "transport", "allocator": "transport-boundary", "scope": "transport-hop", "lifetime": "transport-terminal", "uniqueness": "transport-endpoint", "serialization": "id", "sensitivity": "hop-metadata", "propagation": "one-explicit-hop", "expected": {"outcome": "defined"}},
    {"id": "logical-template", "allocator": "planner", "scope": "semantic-template", "lifetime": "template-identity", "uniqueness": "lowered-closure", "serialization": "instance-path", "sensitivity": "semantic-metadata", "propagation": "instances", "expected": {"outcome": "defined"}},
    {"id": "concrete-instance", "allocator": "pool-controller", "scope": "template-generation", "lifetime": "instance-terminal", "uniqueness": "template-and-generation", "serialization": "instance-path", "sensitivity": "metadata", "propagation": "one-instance", "expected": {"outcome": "defined"}},
    {"id": "generation", "allocator": "replication-or-transition-controller", "scope": "logical-template", "lifetime": "population-generation", "uniqueness": "template", "serialization": "path-component", "sensitivity": "metadata", "propagation": "generation-instances", "expected": {"outcome": "defined"}},
    {"id": "plan-epoch", "allocator": "resolver-or-transition-controller", "scope": "run-lineage", "lifetime": "immutable-plan", "uniqueness": "semantic-hash", "serialization": "semantic-hash", "sensitivity": "exact-plan-metadata", "propagation": "every-event", "expected": {"outcome": "defined"}}
  ],
  "propagation_cases": [
    {
      "id": "local-request-reply",
      "boundary": "local-cord",
      "preserve": ["request", "exchange", "session", "session-epoch", "work-unit", "attempt", "correlation", "idempotency"],
      "allocate": [],
      "expected": {"outcome": "accepted"}
    },
    {
      "id": "remote-request-reply",
      "boundary": "remote-cord",
      "preserve": ["request", "exchange", "session", "session-epoch", "work-unit", "attempt", "correlation", "idempotency"],
      "allocate": ["transport"],
      "expected": {"outcome": "accepted"}
    },
    {
      "id": "retry",
      "boundary": "supervisor-retry",
      "preserve": ["request", "exchange", "session", "session-epoch", "work-unit", "correlation", "idempotency"],
      "replace": ["attempt"],
      "expected": {"outcome": "accepted"}
    },
    {
      "id": "restart",
      "boundary": "supervisor-restart",
      "preserve": ["session", "session-epoch", "work-unit", "correlation", "idempotency"],
      "replace": ["attempt"],
      "expected": {"outcome": "accepted"}
    },
    {
      "id": "checkpoint-resume",
      "boundary": "resume",
      "preserve": ["session", "session-epoch", "work-unit", "correlation", "idempotency", "checkpoint"],
      "replace": ["attempt"],
      "expected": {"outcome": "accepted"}
    },
    {
      "id": "replicated-generation",
      "boundary": "generation-transition",
      "preserve": ["logical-template", "work-unit", "correlation"],
      "replace": ["generation", "concrete-instance", "attempt"],
      "expected": {"outcome": "accepted"}
    },
    {
      "id": "plan-epoch-transition",
      "boundary": "plan-transition",
      "preserve": ["logical-template", "session", "work-unit", "correlation"],
      "replace": ["plan-epoch", "generation", "concrete-instance", "attempt"],
      "expected": {"outcome": "accepted"}
    }
  ],
  "negative_allocator_cases": [
    {"id": "wall-clock-request", "family": "request", "allocator": "wall-clock", "expected": {"outcome": "rejected"}},
    {"id": "scheduler-order-attempt", "family": "attempt", "allocator": "scheduler-order", "expected": {"outcome": "rejected"}},
    {"id": "registry-order-member", "family": "group-member", "allocator": "registry-order", "expected": {"outcome": "rejected"}},
    {"id": "map-order-generation", "family": "generation", "allocator": "map-order", "expected": {"outcome": "rejected"}},
    {"id": "transport-order-request", "family": "request", "allocator": "transport-discovery-order", "expected": {"outcome": "rejected"}},
    {"id": "work-as-attempt", "family": "attempt", "allocator": "reuse-work-unit", "expected": {"outcome": "rejected"}},
    {"id": "timestamp-as-causation", "family": "causation", "allocator": "timestamp-order", "expected": {"outcome": "rejected"}}
  ]
}
