# Canonical Recovery R3 proof: one finite value through installed pure nodes.
panel 0

source: std/literal {
    value = "Conduit exact slice.\n"
}
transform: text/uppercase
encoder: std/data/encode-utf8 {
    codec = ref("conduit.codec/utf-8")
    codec_schema_version = 0
    codec_hash = bytes("f219297cb276bc91eccddb346a8b21e7edd4414b8844014108513747ae11bf53")
    maximum_input_bytes = 4096
    maximum_output_bytes = 4096
}
sink: io/stdout

source.value > transform.text {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}

transform.text > encoder.text {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}

encoder.bytes > sink.bytes {
    capacity = 1
    max_value_bytes = 64
    max_queued_bytes = 64
    low_watermark = 0
    high_watermark = 1
    pressure = block
}
