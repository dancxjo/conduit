# Generic finite f32 numeric value and immutable tensor-view profiles.
# Resource authority and ModelArtifact compatibility are separately admitted.
type NumericFiniteF32 = F32 finite
type NumericVector<N: U16> = collection NumericFiniteF32 = N
type NumericF32Vector2 = NumericVector<2>
type NumericF32Vector3 = NumericVector<3>
type NumericF32Vector12 = NumericVector<12>
type NumericF32Vector20 = NumericVector<20>
type NumericF32Vector32 = NumericVector<32>
type NumericF32Vector64 = NumericVector<64>
type NumericF32Vector128 = NumericVector<128>
type NumericF32Vector192 = NumericVector<192>
type NumericF32Vector320 = NumericVector<320>
type NumericTensorDigest = collection U8 = 32
type NumericTensorElement =
    f32

type NumericMatrixRef<C: U16, R: U16> = {
    resource: ResourceRef
    content_digest: NumericTensorDigest
    element: NumericTensorElement
    columns: U16 in C..=C
    rows: U16 in R..=R
    where .columns == C && .rows == R
}
type NumericEmbedding224x12 = NumericMatrixRef<224, 12>
type NumericF32MatrixRef32x64 = NumericMatrixRef<32, 64>
type NumericF32MatrixRef192x128 = NumericMatrixRef<192, 128>
type NumericF32MatrixRef128x320 = NumericMatrixRef<128, 320>
type NumericF32MatrixRef3x2 = NumericMatrixRef<3, 2>

type NumericBiasRef<N: U16> = {
    resource: ResourceRef
    content_digest: NumericTensorDigest
    element: NumericTensorElement
    length: U16 in N..=N
    where .length == N
}
type NumericF32BiasRef64 = NumericBiasRef<64>
type NumericF32BiasRef128 = NumericBiasRef<128>
type NumericF32BiasRef320 = NumericBiasRef<320>
type NumericF32BiasRef2 = NumericBiasRef<2>

type NumericHistory<H: U16, D: U16> = collection NumericVector<D> = H
type NumericHistory2x64 = NumericHistory<2, 64>

type NumericWindow<H: U16, D: U16> = {
    window: NumericVector<(H + 1) * D>
    next_history: NumericHistory<H, D>
}
type NumericWindow2x64 = NumericWindow<2, 64>
