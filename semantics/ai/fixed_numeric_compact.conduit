# Generic signed I8 resource tensors with explicit input4/output8 tiled packing.
# Exact scales and optional biases are separately retained immutable resources.
type NumericCompactTensorElement =
    i8
type NumericI8TiledMatrixRef4x40 = {
    resource: ResourceRef
    content_digest: NumericTensorDigest
    element: NumericCompactTensorElement
    columns: U16 in 4..=4
    rows: U16 in 40..=40
}
