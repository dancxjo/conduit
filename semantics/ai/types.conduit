# Authoritative portable AI meaning. Rust consumes generated bindings.

type GeneratedTextFlowTerminal =
    completed
    | output_bound_exhausted
    | backpressured
    | cancelled
    | provider_lost
    | non_monotonic

type ModelOperation =
    infer
    | encode
    | decode
    | sample
    | log_probability
    | evaluate
    | train

type ModelPortPresence =
    required
    | optional

type SimilarityMetric =
    cosine_similarity
    | dot_product_similarity
    | squared_euclidean_distance

type EmbeddingNormalization =
    none
    | unit_length
