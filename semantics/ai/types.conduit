# Authoritative portable AI meaning. Rust consumes generated bindings.

type GeneratedTextFlowTerminal =
    completed
    | output_bound_exhausted
    | backpressured
    | cancelled
    | provider_lost
    | non_monotonic

type ModelOperation =
    infer
    | encode
    | decode
    | sample
    | log_probability
    | evaluate
    | train

type ModelPortPresence =
    required
    | optional

type SimilarityMetric =
    cosine_similarity
    | dot_product_similarity
    | squared_euclidean_distance

type EmbeddingNormalization =
    none
    | unit_length

type TemporalSource =
    event
    | valid_from
    | valid_until
    | observed
    | recorded
    | ingested
    | retrieved

type EntityBoundary =
    created
    | first_observed
    | first_user_mention
    | born
    | started
    | current_phase_started
    | last_changed

type TransitionDirection =
    into_state
    | out_of_state

type TemporalValidity =
    current
    | historical
    | superseded
    | unknown_whether_current

type TemporalWindowRelation =
    before
    | within
    | after
    | overlaps
    | unknown
