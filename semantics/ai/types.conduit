type BaseProofClass =
    deterministic_conformance_fixture

type DataHandling =
    local_only
    | remote_egress

type Metering =
    unmetered_fixture
    | metered_fixture

type CandidateLifecycle =
    awaiting_explicit_validation_plan_and_play

type TrainingLifecyclePhase =
    unloaded
    | loading
    | ready
    | active_step {
        step: U64
    }
    | evaluating
    | checkpointing
    | cancelled
    | provider_lost
    | failed

type ModelOperation =
    infer
    | encode
    | decode
    | sample
    | log_probability
    | evaluate
    | train

code ai/model-operation = ModelOperation as u8

type ModelPortPresence =
    required
    | optional

code ai/model-port-presence = ModelPortPresence as u8

type SimilarityMetric =
    cosine_similarity
    | dot_product_similarity
    | squared_euclidean_distance

type EmbeddingNormalization =
    none
    | unit_length

type TemporalSource =
