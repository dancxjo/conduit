    cancelled
    | resource_exhausted
    | provider_lost
    | failed

type TrainStepFailure =
    cancelled
    | resource_exhausted
    | provider_lost
    | failed

type IntegrationTerminal =
    work_limit_exhausted
    | cancelled
    | discontinuity
    | provider_lost
    | failed

type IntegrationAccuracy = {
    absolute-tolerance-millionths: U64
    relative-tolerance-millionths: U64
    maximum-estimated-error-millionths: U64
    where .absolute-tolerance-millionths > 0 || .relative-tolerance-millionths > 0
    where .maximum-estimated-error-millionths > 0
}

type IntegrationResourceEnvelope = {
    maximum_state_bytes: U64
    maximum_context_bytes: U64
    maximum_output_samples: U32
    maximum_output_bytes: U64
    maximum_internal_steps: U64
    maximum_function_evaluations: U64
    maximum_work_units: U64
    memory_ceiling_bytes: U64
    where .maximum_state_bytes > 0
    where .maximum_context_bytes > 0
    where .maximum_output_samples >= 2
    where .maximum_output_samples <= 65536
    where .maximum_output_bytes > 0
    where .maximum_internal_steps > 0
    where .maximum_function_evaluations > 0
    where .maximum_work_units > 0
    where .memory_ceiling_bytes > 0
}

type ShadowResourceEnvelope = {
    maximum_runs: U32
    maximum_input_bytes: U64
    maximum_output_bytes: U64
    maximum_work_units: U64
    where .maximum_runs > 0
    where .maximum_input_bytes > 0
    where .maximum_output_bytes > 0
    where .maximum_work_units > 0
}

type TrainingResourceEnvelope = {
    model_bytes: U64
    working_memory_bytes: U64
    compute_lanes: U32
    maximum_batch_items: U32
    maximum_batch_bytes: U64
    maximum_steps: U64
    maximum_work_units: U64
    maximum_checkpoint_bytes: U64
    maximum_in_flight_steps: U16
    where .model_bytes > 0
    where .working_memory_bytes > 0
    where .compute_lanes > 0
    where .maximum_batch_items > 0
    where .maximum_batch_items <= 4096
    where .maximum_batch_bytes > 0
    where .maximum_steps > 0
    where .maximum_work_units > 0
    where .maximum_checkpoint_bytes > 0
    where .maximum_in_flight_steps == 1
}

type TrainingObjectiveIdentity = Text <= 128B not in [""]

type TrainingObjective = {
    role: TrainingObjectiveIdentity
    weight_millionths: U64
    configuration_identity: TrainingObjectiveIdentity
    output_identity: TrainingObjectiveIdentity
    participation: ObjectiveParticipation
    where .participation is observe_only || .weight_millionths > 0
}

type TrainingMetric = {
    output_identity: TrainingObjectiveIdentity
    value_millionths: I64
}

type TrainingExampleIdentityPage = Bytes <= 32768B
type TrainingExampleIdentityPages = sequence TrainingExampleIdentityPage in 1..=4
type TrainingModality = Text <= 128B not in [""]
type TrainingModalities = sequence TrainingModality in 1..=32
type TrainingObjectives = sequence TrainingObjective in 1..=32
type TrainingCheckpointIdentity = collection U8 = 32

type TrainingBatch = {
    identity: collection U8 = 32
    dataset_identity: collection U8 = 32
    split_identity: Text <= 128B not in [""]
    example_identities: TrainingExampleIdentityPages
    present_modalities: TrainingModalities
    encoded_bytes: U64 in 1..=18446744073709551615
    order: BatchOrder
    stochastic_seed: U64?
}

type TrainingSession = {
    identity: collection U8 = 32
    base_artifact_identity: collection U8 = 32
    base_checkpoint_identity: TrainingCheckpointIdentity?
    dataset_manifest_identity: collection U8 = 32
    split_membership_identity: collection U8 = 32
    objective_profile: Text <= 128B not in [""]
    objectives: TrainingObjectives
    randomness: RandomnessProfile
    precision_profile: Text <= 128B not in [""]
    model_modalities: TrainingModalities
    missing_modality_policy: MissingModalityPolicy
    resources: TrainingResourceEnvelope
    checkpoint_policy: CheckpointPolicy
    evaluation_policy: EvaluationPolicy
}

type TrainStepRequest = {
    step: U64 in 1..=18446744073709551615
    expected_generation: U64
    batch: TrainingBatch
    admitted_work_units: U64 in 1..=18446744073709551615
}

type EmbodimentStage =
    perception_only
    | expressive
    | authorized_effect

type RerankScore =
    hybrid_fusion U64
    | model_derived I64

type RerankObservation = {
    chunk_identity: ChunkIdentity
    score_micros: I64
    work_units: U32 in 1..=1048576
}

type MechanismScore =
    similarity_micros I64
    | lexical_score U32
    | metadata_match
    | temporal_boundary
    | exact_match

type CheckpointPolicy =
    none
    | every_steps U64
    | at_completion

type EvaluationPolicy =
    none
    | every_steps U64
    | at_completion
