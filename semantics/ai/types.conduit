# Authoritative portable AI meaning. Rust consumes generated bindings.

type ShadowTerminal =
    compared
    | cancelled
    | pressured
    | candidate_provider_lost
    | baseline_failed
    | candidate_failed

type HumanAssessmentDisposition =
    supports_candidate
    | supports_baseline
    | disagrees
    | inconclusive

type EvaluationDisposition =
    sufficient
    | insufficient
    | disagreement

type PromotionDecision =
    approved
    | denied

type PromotionTerminal =
    promoted
    | preparation_failed
    | commit_unknown

type RollbackTerminal =
    rolled_back
    | unavailable
    | refused
    | failed
    | commit_unknown

type LearnedLifecycleRefusal =
    invalid_identity
    | same_realization
    | unbounded_resources
    | effectful_shadow_route
    | wrong_contract
    | wrong_input
    | wrong_realization
    | resource_bound_exceeded
    | invalid_evidence
    | invalid_evaluation
    | evidence_insufficient
    | approval_denied
    | grant_not_yet_valid
    | grant_expired
    | stale_candidate
    | incompatible_signature
    | invalid_plan_transition
    | rollback_target_mismatch
    | attempt_limit_exceeded

type GeneratedTextFlowTerminal =
    completed
    | output_bound_exhausted
    | backpressured
    | cancelled
    | provider_lost
    | non_monotonic

type LlmDeterminismProfile =
    deterministic_validation_fixture
    | seeded_implementation_best_effort
    | stochastic_inference
    | provider_nondeterministic

type LlmTerminalOutcome =
    produced
    | truncated
    | refused
    | failed
    | cancelled
    | provider_lost

type LlmImplementationControl =
    temperature
    | seed
    | sampler
    | quantization
    | prompt_template
    | chat_role_encoding
    | provider_function_json

type LlmInterruptionReason =
    model_provider_lost
    | part_or_line_lost

type LlmPlanningRefusal =
    missing_llm_realization

type BaseProofClass =
    deterministic_conformance_fixture

type DataHandling =
    local_only
    | remote_egress

type Metering =
    unmetered_fixture
    | metered_fixture

type CandidateLifecycle =
    awaiting_explicit_validation_plan_and_play

type TrainingLifecyclePhase =
    unloaded
    | loading
    | ready
    | active_step {
        step: U64
    }
    | evaluating
    | checkpointing
    | cancelled
    | provider_lost
    | failed

type ModelOperation =
    infer
    | encode
    | decode
    | sample
    | log_probability
    | evaluate
    | train

form ai/model-operation = ModelOperation as u8

type ModelPortPresence =
    required
    | optional

form ai/model-port-presence = ModelPortPresence as u8

type ModelDimensionConstraint =
    fixed {
        value: U64 in 1..=18446744073709551615
    }
    | bounded {
        minimum: U64 in 1..=18446744073709551615
        maximum: U64 in 1..=18446744073709551615
    }

type ModelAxisConstraint = {
    role: TensorAxisRole
    dimension: ModelDimensionConstraint
}

type ModelTensorElements = sequence TensorElement in 1..=8
type ModelTensorAxes = sequence ModelAxisConstraint in 1..=8

type ModelTensorConstraint = {
    elements: ModelTensorElements
    axes: ModelTensorAxes
    maximum_bytes: U64 in 1..=18446744073709551615
}

type ModelValueConstraint =
    tensor {
        constraint: ModelTensorConstraint
    }
    | sampled_signal {
        constraint: ModelTensorConstraint
    }
    | probabilistic_tensor {
        constraint: ModelTensorConstraint
    }
    | probabilistic_signal {
        constraint: ModelTensorConstraint
    }

type ModelPortIdentity = Text <= 128B not in [""]
type ModelSemanticKind = Text <= 128B not in [""]

type ModelPortConstraint = {
    identity: ModelPortIdentity
    semantic_kind: ModelSemanticKind
    presence: ModelPortPresence
    value: ModelValueConstraint
}

type ModelOperations = sequence ModelOperation in 1..=8
type ModelPorts = sequence ModelPortConstraint in 0..=32

type ModelSignature = {
    identity: Text <= 128B not in [""]
    compatibility_version: U32 in 1..=4294967295
    operations: ModelOperations
    inputs: ModelPorts
    outputs: ModelPorts
}

type SimilarityMetric =
    cosine_similarity
    | dot_product_similarity
    | squared_euclidean_distance

type FiniteF32 = F32 finite

type NonnegativeFiniteF32 = F32 finite in 0.0..

type SimilarityScore =
    similarity FiniteF32
    | squared_distance FiniteF32

type SimilarityThreshold =
    minimum_similarity FiniteF32
    | maximum_squared_distance NonnegativeFiniteF32

type EmbeddingNormalization =
    none
    | unit_length

type CompatibleMetrics = {
    cosine_similarity: Boolean
    dot_product_similarity: Boolean
    squared_euclidean_distance: Boolean
}

type ClassificationLabel = Text <= 64B not in [""]
type ClassificationLabels = sequence ClassificationLabel in 1..=32

type FiniteClassification = {
    label: ClassificationLabel
    allowed_labels: ClassificationLabels
}

type EmbeddingProfileIdentity = Text <= 128B not in [""]
type FiniteEmbeddingValuePage = sequence FiniteF32 in 1..=1024
type FiniteEmbeddingValuePages = sequence FiniteEmbeddingValuePage in 1..=4

type FiniteEmbedding = {
    profile_identity: EmbeddingProfileIdentity
    dimensions: U32 in 1..=4096
    values: FiniteEmbeddingValuePages
}

type EmbeddingProfile = {
    identity: Text <= 256B not in [""]
    semantic_space_identity: Text <= 256B not in [""]
    model_identity: Text <= 256B not in [""]
    provider_identity: Text <= 256B not in [""]
    dimensions: U32 in 1..=4096
    normalization: EmbeddingNormalization
    compatible_metrics: CompatibleMetrics
}

type Embedding = {
    profile: EmbeddingProfile
    values: FiniteEmbedding
}

type VectorMetadata = {
    key: Text <= 64B not in [""]
    value: Text <= 1024B not in [""]
}

type VectorMetadataEntries = sequence VectorMetadata in 0..=32

type MetadataFilter =
    equal {
        key: Text <= 64B not in [""]
        value: Text <= 1024B not in [""]
    }
    | present {
        key: Text <= 64B not in [""]
    }

type MetadataFilters = sequence MetadataFilter in 0..=32

type VectorRecord<T> = {
    value: T
    embedding: Embedding
    source_identity: Text <= 256B not in [""]
    resource_identity: Text <= 256B not in [""]
    metadata: VectorMetadataEntries
    temporal_provenance: TemporalProvenance?
}

type SimilarityQuery = {
    embedding: Embedding
    metric: SimilarityMetric
    top_k: U32 in 1..=1024
    threshold: SimilarityThreshold?
    filters: MetadataFilters
    temporal_intent: TemporalRetrievalIntent?
}

type SimilarityHit<T> = {
    value: T
    score: SimilarityScore
    rank: U32 in 1..=1024
    index_generation: U64
    source_identity: Text <= 256B not in [""]
    resource_identity: Text <= 256B not in [""]
    temporal_provenance: TemporalProvenance?
}

type Chunk<T> = {
    identity: ChunkIdentity
    lineage: ExtractionLineage
    value: T
}

type Candidate<T> = {
    chunk: Chunk<T>
    rank: U16 in 1..=1024
    score: RetrievalScore?
    retrieval_basis: Text <= 2048B not in [""]
}

type ContextItem<T> = {
    candidate: Candidate<T>
    rationale: ContextSelectionRationale
    budget: ContextBudgetCost
}

type ContextSelection<T> = {
    items: sequence ContextItem<T> in 0..=64
    outcome: ContextSelectionOutcome
}

type StageCandidate<T> = {
    chunk: Chunk<T>
    rank: U16 in 1..=1024
    score: MechanismScore?
    temporal_evidence_identity: TemporalEvidenceIdentity?
}

type RetrievalStage<T> = {
    retriever: RetrieverIdentity
    candidates: sequence StageCandidate<T> in 1..=1024
    work_units: U32 in 1..=1048576
}

type RetrievalContribution = {
    retriever: RetrieverIdentity
    stage_rank: U16 in 1..=1024
    score: MechanismScore?
    temporal_evidence_identity: Text <= 256B not in [""]?
}

type HybridCandidate<T> = {
    chunk: Chunk<T>
    rank: U16 in 1..=1024
    fusion_score_micros: U64
    contributions: sequence RetrievalContribution in 1..=8
}

type HybridRetrievalOutcome<T> =
    candidates sequence HybridCandidate<T> in 1..=1024
    | need_earlier_history
    | boundary_unavailable

type ExactVectorSearchCandidate<T> = {
    record: VectorRecord<T>
    temporal_source: TemporalSource
    boundary: EntityBoundary?
    transition: TransitionDirection?
    validity: TemporalValidity
}

type ExactVectorSearchResult<T> = {
    proof_class: VectorSearchProofClass
    index_generation: U64
    admitted_work_units: U32 in 1..=1048576
    candidate_count: U32 in 0..=65536
    hits: sequence SimilarityHit<T> in 0..=1024
}

type VectorSearchValue<T> = {
    proof_class: VectorSearchExecutionProofClass
    index_generation: U64
    admitted_work_units: U32 in 1..=1048576
    candidate_count: U32 in 0..=65536
    hits: sequence SimilarityHit<T> in 0..=1024
}

type RerankedCandidate<T> = {
    candidate: HybridCandidate<T>
    original_rank: U16 in 1..=1024
    reranked_rank: U16 in 1..=1024
    score: RerankScore
}

type RerankingReceipt<T> = {
    policy_identity: Text <= 256B not in [""]
    proof_class: RerankingProofClass
    candidates: sequence RerankedCandidate<T> in 1..=1024
    work_units: U32 in 1..=1048576
}

type ContextTemporalEvidence<TContext> = {
    evidence_identity: Text <= 256B not in [""]
    provenance: TemporalProvenance
    source: TemporalSource
    boundary: EntityBoundary?
    context: TContext
}

type ContextCandidate<T, TContext> = {
    reranked: RerankedCandidate<T>
    reranking_policy_identity: Text <= 256B not in [""]
    reranking_proof_class: RerankingProofClass
    temporal: ContextTemporalEvidence<TContext>?
    redundancy_group: Text <= 256B not in [""]?
    token_count: U32 in 1..=262144
}

type SelectedContextItem<T, TContext> = {
    reranked: RerankedCandidate<T>
    reranking_policy_identity: Text <= 256B not in [""]
    reranking_proof_class: RerankingProofClass
    temporal: ContextTemporalEvidence<TContext>?
    redundancy_group: Text <= 256B not in [""]?
    rationale: SelectedContextRationale
    budget: SelectedContextCost
}

type StructuredContext<T, TContext> = {
    policy_identity: Text <= 256B not in [""]
    token_accounting_profile: Text <= 256B not in [""]
    redundancy: ContextRedundancyPolicy
    ordering: ContextOrderingPolicy
    items: sequence SelectedContextItem<T, TContext> in 1..=64
    disposition: ContextSelectionDisposition
    used: SelectedContextCost
}

type GroundedAnswerRequest<T, TContext> = {
    identity: Text <= 256B not in [""]
    retrieval_intent: RetrievalIntent
    context: StructuredContext<T, TContext>
}

type ProposedClaimSupport<TCitation> =
    supported {
        citations: sequence TCitation in 1..=128
    }
    | unsupported {
        rationale: Text <= 2048B not in [""]
    }

type ProposedGroundedClaim<TCitation> = {
    answer_span: AnswerSpan
    support: ProposedClaimSupport<TCitation>
}

type GroundedAnswer<TAnswer, TCitation> = {
    provenance: ModelResultProvenance
    policy_identity: Text <= 256B not in [""]
    request_identity: Text <= 256B not in [""]
    context_policy_identity: Text <= 256B not in [""]
    model_implementation_identity: Text <= 256B not in [""]
    model_run_identity: Text <= 256B not in [""]
    answer_kind: Text <= 256B not in [""]
    answer: TAnswer
    disposition: GroundedAnswerDisposition
    claims: sequence AnswerClaimSupport in 0..=64
    citations: sequence TCitation in 0..=128
    limitations: sequence GroundingLimitation in 0..=32
}

type PortableProposedClaimSupport = ProposedClaimSupport<Citation>
type PortableProposedGroundedClaim = ProposedGroundedClaim<Citation>
type GroundedAnswerBytePage = Bytes <= 65536B
type GroundedAnswerBytePages = sequence GroundedAnswerBytePage in 0..=4
type PortableGroundedAnswer = GroundedAnswer<GroundedAnswerBytePages, Citation>

type ModelDerivedResult<TPayload> = {
    provenance: ModelResultProvenance
    payload_kind: Text <= 256B not in [""]
    payload: TPayload
    implementation_identity: Text <= 256B not in [""]
    request_identity: Text <= 256B not in [""]
    run_identity: Text <= 256B not in [""]
    confidence: ConfidencePermille?
    disposition: ModelResultDisposition
    determinism: LlmDeterminismProfile
    accounting: ModelWorkAccounting
}

type ModelResultPayload = Bytes <= 65536B
type PortableModelDerivedResult = ModelDerivedResult<ModelResultPayload>

type ExtractionKey = Text <= 64B not in [""]
type ExtractionValue = Text <= 1024B not in [""]

type ExtractedField = {
    key: ExtractionKey
    value: ExtractionValue
}

type ExtractionFields = sequence ExtractedField in 1..=32

type ValidatedExtraction = {
    schema_identity: Text not in [""]
    fields: ExtractionFields
}

type ConfidencePermille = U16 in 0..=1000

type ModelWorkAccounting = {
    input_bytes: U64
    context_items: U64
    output_bytes: U64
    work_units: U64
    history_items: U64
}

type GeneratedTextChunk = {
    sequence: U64 in 0..=4095
    text: Text <= 4096B not in [""]
}

type GeneratedTextFlowEvidence = {
    chunks: U64 in 0..=4096
    generated_bytes: U64 in 0..=65536
    terminal: GeneratedTextFlowTerminal
    retained_private_text: Boolean
    where (.chunks == 0) == (.generated_bytes == 0)
}

type TemporalSource =
    event
    | valid_from
    | valid_until
    | observed
    | recorded
    | ingested
    | retrieved

type EntityBoundary =
    created
    | first_observed
    | first_user_mention
    | born
    | started
    | current_phase_started
    | last_changed

type TransitionDirection =
    into_state
    | out_of_state

type TemporalRetrievalWindow = {
    start: U64
    end: U64
    where .start <= .end
}

type TemporalRetrievalIntent =
    earliest_evidence
    | latest_evidence
    | state_valid_at {
        instant: U64
    }
    | transition {
        direction: TransitionDirection
    }
    | duration_since {
        boundary: EntityBoundary
    }
    | event_ordering
    | evidence_within {
        window: TemporalRetrievalWindow
    }

type RetrievalMode =
    semantic
    | exact
    | metadata
    | temporal {
        intent: TemporalRetrievalIntent
    }
    | boundary {
        intent: TemporalRetrievalIntent
    }

type RetrievalModes = sequence RetrievalMode in 1..=8
type RetrievalIntentIdentity = Text <= 256B not in [""]

type RetrievalIntent = {
    identity: RetrievalIntentIdentity
    modes: RetrievalModes
    maximum_candidates: U16 in 1..=1024
}

type TemporalValidity =
    current
    | historical
    | superseded
    | unknown_whether_current

type TemporalWindowRelation =
    before
    | within
    | after
    | overlaps
    | unknown

type ClockIdentity = Text <= 128B not in [""]

type ClockBasis =
    unix_epoch_milliseconds
    | monotonic_milliseconds {
        identity: ClockIdentity
    }

type TemporalProvenance = {
    event_at: U64?
    valid_from: U64?
    valid_until: U64?
    observed_at: U64?
    recorded_at: U64?
    ingested_at: U64?
    retrieved_at: U64
    reference_at: U64
    clock_basis: ClockBasis
    uncertainty_millis: U64?
}

type TemporalEvidenceIdentity = Text <= 256B not in [""]
type TemporalEvidenceIdentities = sequence TemporalEvidenceIdentity in 1..=128

type TemporalEvidenceCandidate = {
    identity: TemporalEvidenceIdentity
    provenance: TemporalProvenance
    source: TemporalSource
    boundary: EntityBoundary?
    transition: TransitionDirection?
    validity: TemporalValidity
}

type TemporalEvidenceCandidates = sequence TemporalEvidenceCandidate in 1..=128

type TemporalEvidenceBatch = {
    reference: TemporalReference
    candidates: TemporalEvidenceCandidates
    earliest_history_complete: Boolean
}

type TemporalEvidenceSelection =
    selected {
        identities: TemporalEvidenceIdentities
    }
    | need_earlier_history
    | boundary_unavailable

type TemporalReference = {
    reference_at: U64
    clock_basis: ClockBasis
}

type ContextRedundancyPolicy =
    keep_all
    | one_per_reviewed_group

type ContextOrderingPolicy =
    reranked
    | chronological_oldest_first

type ContextSelectionPolicy = {
    identity: Text <= 256B not in [""]
    token_accounting_profile: Text <= 256B not in [""]
    redundancy: ContextRedundancyPolicy
    ordering: ContextOrderingPolicy
    maximum_items: U16 in 1..=64
    maximum_bytes: U32 in 1..=1048576
    maximum_tokens: U32 in 1..=262144
    maximum_work_units: U32 in 1..=1048576
}

type SelectedContextRationale =
    reranked
    | temporal_chronology

type ContextOmissionReason =
    reviewed_redundancy
    | item_budget
    | byte_budget
    | token_budget
    | work_budget

type SelectedContextCost = {
    bytes: U32
    tokens: U32
    work_units: U32
}

type ContextOmission = {
    chunk_identity: ChunkIdentity
    reason: ContextOmissionReason
}

type ContextOmissions = sequence ContextOmission in 1..=1024

type ContextSelectionDisposition =
    complete
    | omitted {
        candidates: ContextOmissions
    }

type SourceSpanUnit =
    bytes
    | items

type SourceSpan = {
    unit: SourceSpanUnit
    start: U64
    end: U64
    where .start < .end
}

type AnswerSpan = {
    start: U32
    end: U32
    where .start < .end
}

type CitationIndices = sequence U16 in 1..=128

type GroundedClaim = {
    answer_span: AnswerSpan
    citation_indices: CitationIndices
}

type GroundingLimitation = Text <= 2048B not in [""]

type GroundingInputAssessment =
    sufficient
    | insufficient_evidence {
        limitation: GroundingLimitation
    }
    | conflicting_evidence {
        limitation: GroundingLimitation
    }

type GroundedClaimSupport =
    supported {
        citation_indices: CitationIndices
    }
    | unsupported {
        rationale: GroundingLimitation
    }

type AnswerClaimSupport = {
    answer_span: AnswerSpan
    support: GroundedClaimSupport
}

type RetrievalScore = {
    value_micros: I64
}

type ContextBudgetCost = {
    bytes: U32
    tokens: U32
    where .bytes > 0 || .tokens > 0
}

type ContextSelectionOutcome =
    complete
    | truncated {
        omitted_candidates: U16 in 1..=1024
        reason: ContextTruncationReason
    }

type SourceExtractionProfile =
    text_utf8 {
        overlap_bytes: U32
    }
    | structured_items {
        overlap_items: U32
    }
    | resource_metadata {
        overlap_items: U32
    }

type SourceExtractionLimits = {
    maximum_source_bytes: U32 in 1..=4294967295
    maximum_source_items: U32 in 1..=4294967295
    maximum_chunk_bytes: U32 in 1..=4294967295
    maximum_chunks: U32 in 1..=4294967295
    maximum_output_bytes: U32 in 1..=4294967295
    maximum_work_units: U32 in 1..=4294967295
}

type FusionStrategy =
    reciprocal_rank {
        rank_constant: U16 in 1..=65535
    }

type HybridRequiredMechanisms = sequence RetrievalMechanism in 0..=8

type HybridFusionPolicy = {
    identity: Text <= 256B not in [""]
    strategy: FusionStrategy
    required_mechanisms: HybridRequiredMechanisms
    temporal_hard_filter: TemporalRetrievalIntent?
    maximum_candidates_per_stage: U16 in 1..=1024
    maximum_output_candidates: U16 in 1..=1024
    maximum_total_work_units: U32 in 1..=1048576
}

type RelationResultProfile =
    deterministic
    | probabilistic {
        maximum_samples: U32 in 1..=4294967295
    }

type RelationVariableIdentity = Text <= 128B not in [""]
type RelationVariableIdentities = sequence RelationVariableIdentity in 1..=32

type SupportedRelationQuery = {
    evidence_variables: RelationVariableIdentities
    target_variables: RelationVariableIdentities
    mode: RelationQueryMode
    result_profile: RelationResultProfile
    maximum_work_units: U64
    maximum_output_bytes: U64
    where .maximum_work_units > 0
    where .maximum_output_bytes > 0
}

type RelationCandidateOutput = {
    target_variable: RelationVariableIdentity
    value_identity: ProbabilityDigest
    disposition: ProbabilisticDisposition
    sample_count: U32
}

type RelationDigest = collection U8 = 32
type RelationQueryIdentity = collection U8 = 32
type RelationIdentity = Text <= 128B not in [""]
type RelationSemanticRole = Text <= 128B not in [""]

type RelationVariable = {
    identity: RelationIdentity
    semantic_role: RelationSemanticRole
    value: ModelValueConstraint
}

type RelationVariables = sequence RelationVariable in 1..=32
type SupportedRelationQueries = sequence SupportedRelationQuery in 1..=64

type ModelRelationSignature = {
    identity: Text <= 128B not in [""]
    compatibility_version: U32 in 1..=4294967295
    callable_signature_identity: RelationDigest
    variables: RelationVariables
    supported_queries: SupportedRelationQueries
}

type RelationValue =
    tensor {
        value: TensorValue
    }
    | sampled_signal {
        value: SampledSignal
    }

type RelationEvidence = {
    variable: RelationVariableIdentity
    value: RelationValue
}

type RelationEvidenceValues = sequence RelationEvidence in 1..=32

type RelationQuery = {
    identity: RelationQueryIdentity
    artifact_identity: RelationDigest
    checkpoint_identity: RelationDigest?
    relation_signature_identity: RelationDigest
    evidence: RelationEvidenceValues
    targets: RelationVariableIdentities
    mode: RelationQueryMode
    requested_result: RelationResultProfile
    randomness: RandomnessProfile
    admitted_work_units: U64 in 1..=18446744073709551615
    maximum_output_bytes: U64 in 1..=18446744073709551615
}


type ModelCachePolicy =
    no_cache
    | bounded {
        maximum_loaded_models: U16 in 1..=65535
        maximum_loaded_bytes: U64 in 1..=18446744073709551615
    }

type MissingModality = Text <= 128B not in [""]

type MissingModalityPolicy =
    reject
    | permit_declared {
        optional_modalities: sequence MissingModality <= 32
    }

type ContextSelectionRationale =
    exact_match
    | semantic_candidate
    | metadata_match
    | temporal_match
    | boundary_evidence
    | conflict_preserved

type ContextTruncationReason =
    byte_budget
    | token_budget
    | item_budget

type GroundingDisposition =
    supported
    | insufficient_evidence
    | conflicting_evidence

type GroundedAnswerDisposition =
    supported
    | partially_supported
    | insufficient_evidence
    | conflicting_evidence

type GroundedAnswerPolicy = {
    identity: Text <= 256B not in [""]
    answer_kind: Text <= 256B not in [""]
    maximum_output_bytes: U32 in 1..=262144
    maximum_claims: U16 in 1..=64
    maximum_citations: U16 in 1..=128
    maximum_work_units: U64 in 1..=1000000
}

type InterpretationProvenance =
    model_derived

type InterpretationDisposition =
    interpreted
    | insufficient_evidence
    | contradictory_evidence

type ModelResultProvenance =
    model_derived

type ModelRefusal =
    unsupported_request
    | policy_denied
    | context_unavailable
    | capacity_unavailable

type ModelFailure =
    malformed_result
    | implementation_failure
    | resource_exhausted
    | output_bound_exceeded

type LlmWorkBounds = {
    maximum_input_bytes: U64 in 1..=262144
    maximum_context_items: U64 in 0..=128
    maximum_output_bytes: U64 in 1..=65536
    maximum_work_units: U64 in 1..=1000000
    maximum_history_items: U64 in 0..=64
}

type HouseContextProvenanceClass =
    observed_sign
    | declared_configuration
    | model_derived_history

type WiredHouseContextItem = {
    item_identity: Text <= 256B not in [""]
    value_kind: Text <= 256B not in [""]
    canonical_value: Bytes <= 16384B
    provenance: HouseContextProvenanceClass
    source_identity: Text <= 256B not in [""]
}

type HouseModelRequest = {
    request_identity: Text <= 84B not in [""]
    addressed_utterance: Text <= 4096B not in [""]
    context: sequence WiredHouseContextItem <= 16
    maximum_output_bytes: U64 in 1..=65536
}

type RetrievalMechanism =
    vector_similarity
    | lexical
    | metadata
    | temporal
    | domain_exact

type RetrieverIdentity = {
    identity: Text <= 256B not in [""]
    mechanism: RetrievalMechanism
}

form ai/retrieval-mechanism = RetrievalMechanism as u8

type RerankingProofClass =
    deterministic_conformance
    | model_derived

type RerankingStrategy =
    preserve_hybrid_fusion
    | observed_scores {
        proof_class: RerankingProofClass
        scoring_run_identity: Text <= 256B not in [""]
    }

type RerankingPolicy = {
    identity: Text <= 256B not in [""]
    strategy: RerankingStrategy
    maximum_candidates: U16 in 1..=1024
    maximum_work_units: U32 in 1..=1048576
}

type RandomnessProfile =
    deterministic
    | explicit_seed {
        seed: U64
    }
    | provider_chosen {
        seed: U64
        nonce: Text <= 128B not in [""]
    }

type DrawRelationship =
    independent
    | correlated {
        profile: Text <= 128B not in [""]
    }

type ProbabilityDigest = collection U8 = 32
type ChunkIdentity = collection U8 = 32

type SourceRef = {
    resource: ResourceRef
}

type RagIdentity = Text <= 256B not in [""]
type TransformProfiles = sequence RagIdentity <= 16

type ExtractionLineage = {
    source: SourceRef
    span: SourceSpan
    extraction_profile: RagIdentity
    transform_profiles: TransformProfiles
    parent_chunk: ChunkIdentity?
}

type Citation = {
    source: SourceRef
    span: SourceSpan
    chunk_identity: ChunkIdentity
}

type StochasticProvenance = {
    model_artifact_identity: ProbabilityDigest
    checkpoint_identity: ProbabilityDigest?
    query_identity: ProbabilityDigest
    randomness: RandomnessProfile
    draws: DrawRelationship
}

type ProbabilityClaimProfile =
    samples
    | weighted_samples
    | trajectory_alternatives

type ProbabilitySummary = {
    claim_profile: ProbabilityClaimProfile
    result_count: U32
    model_artifact_identity: ProbabilityDigest
    query_identity: ProbabilityDigest
    randomness: RandomnessProfile
    disposition: ProbabilisticDisposition
}

type ProbabilisticDisposition =
    exact
    | approximate {
        method_profile: Text <= 128B not in [""]
    }
    | truncated {
        retained_samples: U32
        requested_samples: U32
    }

type LogScoreKind =
    probability_mass
    | density
    | unnormalized_score

type LogProbability = {
    natural_log_millionths: I64
    score_kind: LogScoreKind
    support_identity: ProbabilityDigest
    provenance: StochasticProvenance
    disposition: ProbabilisticDisposition
}

type ProbabilitySample = {
    value: TensorValue
    provenance: StochasticProvenance
    disposition: ProbabilisticDisposition
}

type ProbabilitySampleSet = {
    alternatives: sequence TensorValue in 1..=64
    provenance: StochasticProvenance
    disposition: ProbabilisticDisposition
}

type WeightedSamples = {
    alternatives: sequence TensorValue in 1..=64
    weights: sequence U64 in 1..=64
    provenance: StochasticProvenance
    disposition: ProbabilisticDisposition
}

type MeanVariance = {
    mean: TensorValue
    variance: TensorValue
    provenance: StochasticProvenance
    disposition: ProbabilisticDisposition
}

type MeanCovariance = {
    mean: TensorValue
    covariance: TensorValue
    provenance: StochasticProvenance
    disposition: ProbabilisticDisposition
}

type TrajectoryAlternatives = {
    observation_identity: ProbabilityDigest
    plausible_alternatives: sequence SampledSignal in 1..=32
    provenance: StochasticProvenance
    disposition: ProbabilisticDisposition
}

type ProbabilityRefusal =
    missing_identity
    | invalid_disposition
    | empty_samples
    | sample_count_overflow
    | invalid_sample
    | shape_mismatch
    | weight_count_mismatch
    | invalid_weight_sum
    | invalid_variance
    | invalid_covariance
    | covariance_dimension_overflow
    | invalid_log_probability

type ModelResultInvalidity =
    missing_exact_identity
    | unsupported_payload_kind
    | invalid_confidence
    | input_bound_exceeded
    | context_bound_exceeded
    | output_bound_exceeded
    | work_bound_exceeded
    | history_bound_exceeded
    | payload_length_mismatch
    | terminal_payload_present
    | produced_payload_missing

type ModelResultDisposition =
    produced
    | truncated
    | refused ModelRefusal
    | failed ModelFailure
    | cancelled
    | provider_lost

type GroundedAnswerRefusal =
    empty_identity
    | identity_too_large
    | invalid_bound
    | invalid_retrieval_intent
    | invalid_context
    | duplicate_context_item
    | context_accounting_mismatch
    | invalid_model_result ModelResultInvalidity
    | model_request_mismatch
    | model_did_not_produce ModelResultDisposition
    | output_bound_exceeded
    | work_bound_exceeded
    | empty_claims
    | claim_limit_exceeded
    | citation_limit_exceeded
    | invalid_answer_span
    | citation_not_in_context
    | duplicate_citation
    | empty_citation_set
    | empty_limitation
    | limitation_too_large
    | arithmetic_overflow

type StructuredResultInvalidity =
    empty
    | too_many_members
    | member_too_large
    | duplicate_member
    | label_not_allowed
    | dimension_mismatch
    | non_finite_value

type RagAnswerOfferInvalidity =
    empty_process_identity
    | process_identity_too_large

type R3OfferInvalidity =
    empty_process_identity
    | process_identity_too_large

type VectorSearchOfferInvalidity =
    empty_process_identity
    | process_identity_too_large

type SourceExtractionOfferInvalidity =
    empty_process_identity
    | process_identity_too_large

type HybridRetrievalOfferInvalidity =
    empty_process_identity
    | process_identity_too_large

type TemporalContextRefusal =
    reversed_validity_interval
    | retrieval_after_reference
    | clock_basis_mismatch
    | source_unavailable
    | source_after_reference
    | reversed_query_window
    | arithmetic_overflow
    | uncertain_age

type VectorSearchExecutionProofClass =
    deterministic_exact
    | approximate

type VectorSearchProofClass =
    deterministic_exact_oracle

type ObjectiveParticipation =
    optimize
    | observe_only

type BatchOrder =
    stable
    | shuffled

type ModelComputeOperation =
    inference
    | encode
    | decode
    | sample
    | score
    | train_step
    | evaluate
    | checkpoint
    | integrate_dynamics
    | relation_query

type ModelComputeLifecycle =
    discovered
    | loading
    | warming
    | ready
    | active ModelComputeOperation
    | unloading
    | lost
    | failed
    | shutdown

type PortableComputeClass =
    general_cpu
    | vector_compute
    | accelerator

type VectorIndexHealth =
    ready
    | unavailable

type VectorIndexMaintenanceKind =
    rebuild
    | compaction

type ModelComputeRefusal =
    invalid_offer
    | missing_identity
    | unsupported_operation
    | unsupported_format
    | unsupported_element
    | unsupported_shape
    | unsupported_compute_class
    | unsupported_solver
    | unsupported_determinism
    | unsupported_checkpoint
    | resource_bound_exceeded
    | queue_full
    | cancellation_unsupported
    | invalid_lifecycle_transition
    | provider_unavailable

type ModelSignatureRefusal =
    invalid_identity
    | invalid_compatibility_version
    | missing_operation
    | too_many_operations
    | duplicate_operation
    | missing_port
    | too_many_ports
    | duplicate_port
    | invalid_tensor_constraint
    | invalid_signal_constraint

