    | current_phase_started
    | last_changed

type TransitionDirection =
    into_state
    | out_of_state

type TemporalValidity =
    current
    | historical
    | superseded
    | unknown_whether_current

type TemporalWindowRelation =
    before
    | within
    | after
    | overlaps
    | unknown

type ContextRedundancyPolicy =
    keep_all
