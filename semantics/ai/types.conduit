# Authoritative portable AI meaning. Rust consumes generated bindings.

type GeneratedTextFlowTerminal =
    completed
    | output_bound_exhausted
    | backpressured
    | cancelled
    | provider_lost
    | non_monotonic

type ModelOperation =
    infer
    | encode
    | decode
    | sample
    | log_probability
    | evaluate
    | train

type ModelPortPresence =
    required
    | optional
