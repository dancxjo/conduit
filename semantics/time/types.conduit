# Authoritative portable temporal meaning. Rust consumes generated bindings.

type SuspendBehavior =
    clock_includes_suspend
    | clock_excludes_suspend
    | refuse_after_suspend

type ClockChangeBehavior =
    reevaluate_window
    | refuse_after_change

type CivilGapPolicy =
    skip
    | use_before
    | use_after
    | refuse

type CivilFoldPolicy =
    earlier
    | later
    | both
    | refuse

type CivilResolutionChoice =
    unique
    | gap_before
    | gap_after
    | fold_earlier
    | fold_later

type ParticipantRole =
    organizer
    | required
    | optional

type InvitationState =
    needs_action
    | accepted
    | declined
    | tentative

type AvailabilityState =
    free
    | tentative
    | busy
    | unavailable

type HistoricalEntryOrigin =
    machine_observation
    | operator_authored

type HistoricalOverflowPolicy =
    refuse
    | evict_oldest_with_gap

type TemporalBoundary =
    inclusive
    | exclusive

type TemporalWindowPosition =
    before
    | within
    | after
    | indeterminate
