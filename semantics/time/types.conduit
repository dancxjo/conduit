# Authoritative portable temporal meaning. Rust consumes generated bindings.

type SuspendBehavior =
    clock_includes_suspend
    | clock_excludes_suspend
    | refuse_after_suspend

type ClockChangeBehavior =
    reevaluate_window
    | refuse_after_change

type CivilGapPolicy =
    skip
    | use_before
    | use_after
    | refuse

type CivilFoldPolicy =
    earlier
    | later
    | both
    | refuse

type CivilResolutionChoice =
    unique
    | gap_before
    | gap_after
    | fold_earlier
    | fold_later

type CivilResolutionPolicy = {
    gap: CivilGapPolicy
    fold: CivilFoldPolicy
}

type ParticipantRole =
    organizer
    | required
    | optional

type InvitationState =
    needs_action
    | accepted
    | declined
    | tentative

type AvailabilityState =
    free
    | tentative
    | busy
    | unavailable

type TemporalScale =
    seconds
    | milliseconds
    | microseconds
    | nanoseconds

type TemporalInstant = {
    ticks: U64
    scale: TemporalScale
    clock_basis: Text <= 256B not in [""]
    resolution_ticks: U64 in 1..=18446744073709551615
    uncertainty_ticks: U64
}

# Portable civil and monotonic time. Calendar meaning depends on these Types;
# Rust clock objects are adapters/runtime evidence, never their semantic owner.

type LocalDate = {
    year: I32
    month: U8 in 1..=12
    day: U8 in 1..=31
}

type LocalTime = {
    hour: U8 in 0..=23
    minute: U8 in 0..=59
    second: U8 in 0..=59
    nanosecond: U32 in 0..=999999999
}

type LocalDateTime = {
    date: LocalDate
    time: LocalTime
}

type NamedTimeZone = {
    identity: Text <= 256B not in [""]
    rule_set: Text <= 256B not in [""]
}

type MonotonicClockIdentity = {
    host_identity: Text <= 256B not in [""]
    boot_identity: Text <= 256B not in [""]
    basis_identity: Text <= 256B not in [""]
    scale: TemporalScale
    resolution_ticks: U64 in 1..=18446744073709551615
    uncertainty_ticks: U64
}

type MonotonicInstant = {
    ticks: U64
    clock: MonotonicClockIdentity
}

type MonotonicDuration = {
    ticks: U64
    scale: TemporalScale
}

type TemporalWindow = {
    start: TemporalInstant
    start_boundary: TemporalBoundary
    end: TemporalInstant
    end_boundary: TemporalBoundary
}

type WeekdaySet = U8 in 1..=127

type RecurrenceUntil =
    wall {
        value: TemporalInstant
    }
    | monotonic {
        value: MonotonicInstant
    }
    | civil_date {
        value: LocalDate
    }

type RecurrenceRule =
    one_shot {
        at: TemporalInstant
    }
    | fixed_elapsed {
        first: MonotonicInstant
        every: MonotonicDuration
    }
    | civil_weekdays {
        first_date: LocalDate
        local_time: LocalTime
        zone: NamedTimeZone
        weekdays: WeekdaySet
        excluded_dates: sequence LocalDate <= 256
    }

type RecurrenceDefinition = {
    identity: Text <= 256B not in [""]
    rule: RecurrenceRule
    maximum_occurrences: U32 in 1..=4096
    until: RecurrenceUntil?
    excluded_ordinals: sequence U32 <= 256
}

type RecurrenceWindow =
    wall {
        start: TemporalInstant
        end: TemporalInstant
    }
    | monotonic {
        start: MonotonicInstant
        end: MonotonicInstant
    }

type RecurrenceExpansion = {
    maximum_results: U32 in 1..=4096
    window: RecurrenceWindow
}

type OccurrenceInstant =
    wall {
        value: TemporalInstant
    }
    | monotonic {
        value: MonotonicInstant
    }
    | civil {
        local: LocalDateTime
        zone: NamedTimeZone
        instant: TemporalInstant
        resolution: CivilResolutionChoice
    }

type RecurrenceOccurrence = {
    identity: Text <= 256B not in [""]
    recurrence_identity: Text <= 256B not in [""]
    ordinal: U32
    at: OccurrenceInstant
}

type InvitationEvidence =
    unknown
    | observed {
        state: InvitationState
        observed_at: TemporalInstant
        source_identity: Text <= 256B not in [""]
    }

type Participant = {
    identity: Text <= 256B not in [""]
    contact_reference: Text <= 256B not in [""] ?
    role: ParticipantRole
    invitation: InvitationEvidence
}

type TimedCalendarSpan = {
    local_start: LocalDateTime
    local_end: LocalDateTime
    zone: NamedTimeZone
    instant: TemporalWindow
}

type CalendarEventTime =
    timed {
        value: TimedCalendarSpan
    }
    | all_day {
        start: LocalDate
        end_exclusive: LocalDate
    }

type ReminderSpecification = {
    identity: Text <= 256B not in [""]
    before_start_ticks: U64 in 1..=18446744073709551615
    scale: TemporalScale
    delivery_kind: Text <= 256B not in [""]
}

type CalendarEvent = {
    identity: Text <= 256B not in [""]
    title: Text <= 1024B
    description: Text <= 1024B
    location: Text <= 1024B
    time: CalendarEventTime
    participants: sequence Participant <= 64
    recurrence: RecurrenceDefinition?
    reminders: sequence ReminderSpecification <= 16
}

type AvailabilityInterval = {
    participant_identity: Text <= 256B not in [""]
    interval: TemporalWindow
    state: AvailabilityState
}

type AvailabilityBasis = {
    identity: Text <= 256B not in [""]
    observed_at: TemporalInstant
    usable_until: TemporalInstant
}

type ParticipantAvailability = {
    participant_identity: Text <= 256B not in [""]
    zone: NamedTimeZone
    basis: AvailabilityBasis
    intervals: sequence AvailabilityInterval <= 256
}

type MeetingCandidate = {
    identity: Text <= 256B not in [""]
    interval: TemporalWindow
    rationale: Text <= 1024B
}

type MeetingProposalRequest = {
    identity: Text <= 256B not in [""]
    reference_at: TemporalInstant
    participant_identities: sequence Text <= 64
    candidates: sequence MeetingCandidate <= 64
    maximum_results: U16 in 1..=64
}

type ProposedMeetingSlot = {
    candidate_identity: Text <= 256B not in [""]
    interval: TemporalWindow
    rationale: Text <= 1024B
    tentative_participants: sequence Text <= 64
}

type RejectedMeetingSlot = {
    candidate_identity: Text <= 256B not in [""]
    conflicts: sequence CandidateConflict <= 64
}

type MeetingProposal = {
    identity: Text <= 256B not in [""]
    reference_at: TemporalInstant
    availability_basis_identities: sequence Text <= 64
    candidates: sequence ProposedMeetingSlot <= 64
    rejected: sequence RejectedMeetingSlot <= 64
}

type ElapsedTrigger = {
    opens_at: MonotonicInstant
    expires_at: MonotonicInstant
    suspend: SuspendBehavior
}

type CivilTrigger = {
    window: TemporalWindow
    zone: NamedTimeZone
    clock_change: ClockChangeBehavior
}

type TriggerProfile =
    elapsed {
        value: ElapsedTrigger
    }
    | civil {
        value: CivilTrigger
    }

type MissedOccurrencePolicy =
    expire
    | skip
    | fire_late {
        maximum_lateness_ticks: U64 in 1..=18446744073709551615
    }

type ScheduledIntent<T> = {
    identity: Text <= 256B not in [""]
    occurrence: RecurrenceOccurrence
    trigger: TriggerProfile
    missed: MissedOccurrencePolicy
    payload: T
}

type TriggerObservation =
    elapsed {
        now: MonotonicInstant
        suspend_observed: Boolean
    }
    | civil {
        now: TemporalInstant
        clock_change_observed: Boolean
    }

type ScheduledOccurrenceDecision =
    awaiting
    | ready {
        lateness_ticks: U64
    }
    | missed
    | expired
    | cancelled
    | rebooted
    | suspended
    | clock_changed
    | clock_uncertain

type CandidateConflict = {
    participant-identity: Text <= 128B not in [""]
    state: AvailabilityState
}

type HistoricalEntryOrigin =
    machine_observation
    | operator_authored

code time/historical-entry-origin = HistoricalEntryOrigin as u8

type HistoricalOverflowPolicy =
    refuse
    | evict_oldest_with_gap

code time/historical-overflow-policy = HistoricalOverflowPolicy as u8

type ReplayPolicy =
    step
    | original-timing
    | rate {
        numerator: U32 in 1..=1000
        denominator: U32 in 1..=1000
    }

type ReplayCommand =
    start
    | stop
    | pause
    | resume
    | restart
    | step
    | fail {
        code: U16
    }

type ReplayState =
    stopped
    | running
    | paused
    | completed
    | failed {
        code: U16
    }

type HistoricalReplayEntry = {
    sequence: U64
    identity: Text <= 128B not in [""]
    event-time: TemporalInstant
    origin: HistoricalEntryOrigin
    value: ResourceRef
}

type OwnedReplayEvent = {
    ordinal: U16 in 0..=63
    historical-sequence: U64
    historical-identity: Text <= 128B not in [""]
    historical-event-time: TemporalInstant
    historical-origin: HistoricalEntryOrigin
    value: ResourceRef
    playback-ticks: U64
}

type TemporalBoundary =
    inclusive
    | exclusive

type TemporalWindowPosition =
    before
    | within
    | after
    | indeterminate

type PulseObservation = {
    sequence: U32
    period_ms: U16
}

type RhythmState = {
    sequence: U32
    next-pulse-at-ms: U32
    period-ms: U16
    expected-peer-sequence: U32
}

type SynchronizationOutcome =
    adjusted {
        phase-ms: I16
        period-ms: I16
    }
    | outside-window
    | stale
    | missing
    | pressure

type CalendarRefusal =
    invalid_identity
    | invalid_text
    | invalid_time
    | invalid_participants
    | invalid_invitation_evidence
    | invalid_reminder
    | invalid_recurrence
    | invalid_availability
    | stale_availability
    | incomparable_time

type MeetingProposalRefusal =
    invalid_request
    | invalid_availability
    | stale_availability
    | missing_participant
    | no_common_availability
    | incomparable_time

type RecurrenceRefusal =
    invalid_identity
    | invalid_rule
    | invalid_limit
    | invalid_exceptions
    | invalid_window
    | incomparable_window
    | wrong_window_kind
    | work_limit_exceeded
    | arithmetic_overflow
    | civil_resolution_required
    | invalid_civil_resolution
    | civil_resolution_mismatch

type ScheduledIntentRefusal =
    invalid_identity
    | invalid_occurrence
    | trigger_occurrence_mismatch
    | invalid_window
    | incomparable_observation
    | wrong_observation_profile
    | invalid_late_policy

type TemporalWindowRefusal =
    invalid_instant
    | incomparable
    | interval_overflow
    | reversed
    | indeterminate_boundary_order
    | empty

type SequenceNormalizationRefusal =
    malformed
    | empty
    | too-many-values
    | zero-duration

type PatternComparisonRefusal =
    malformed
    | unsupported-metric
    | tolerance-out-of-range
    | algorithm-mismatch
    | length-mismatch

type PatternComparison = {
    matched: Boolean
    metric: Text
    score_millionths: Count
    tolerance_millionths: Count
}

type NormalizedDurationSequence = {
    algorithm: Text
    values: Text
}

type TimedEventSequence = {
    clock_basis: Text
    event_times: Text
}

type IntervalSequence = {
    clock_basis: Text
    intervals: Text
}

type NamedPatternTemplateSlot = {
    active: Boolean
    name: Text
    pattern: NormalizedDurationSequence
}

type NamedPatternTemplateSlots = collection NamedPatternTemplateSlot = 8

type NamedPatternTemplate = {
    name: Text
    pattern: NormalizedDurationSequence
}

type NamedPatternTemplateCommand =
    delete Text
    | get Text
    | put NamedPatternTemplate
    | put-and-get NamedPatternTemplate

type NamedPatternTemplateResult =
    deleted Text
    | found NamedPatternTemplate
    | missing Text
    | stored Text

type TimedPatternRefusal =
    malformed
    | too-few-events
    | too-many-events
    | reordered-or-duplicate-event
    | interval-overflow

type WorkflowLifecycle =
    pending
    | running
    | completed
    | failed
    | cancelled
    | expired

type ScheduleRefusal =
    non-temporal-quantity
    | negative-quantity
    | inconsistent-lifecycle

type WorkflowTimingOutcome =
    awaiting
    | on-time
    | late {
        lateness: Duration
    }
    | missed-window
    | clock-uncertain {
        uncertainty: Duration
    }
    | failed
    | cancelled
    | expired

type ScheduleEffectIntent =
    observation Text
    | proposed_effect Text

type ScheduleWorkflowLifecycle =
    cancelled
    | completed
    | expired
    | failed Text
    | pending
    | running

type ScheduleAssessment = {
    intent_identity: Text
    outcome: WorkflowTimingOutcome
}

type TemplateCollectionRefusal =
    malformed
    | name-empty
    | name-too-long
    | duplicate-name
    | collection-full
    | not-found
    | corrupt-template

type ReminderOccurrence = {
    delivery_kind: Text
    event_identity: Text
    identity: Text
    reminder_identity: Text
}
