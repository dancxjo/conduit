# Reviewed finite early eligibility: det/case/vocative; other dependencies
# remain provisional until Final. Beam agreement alone is not future invariance.
# Primitive endpoints are mechanical observations checked against full material.
type LanguageParserWindow8DependencyFactContext = {
    query: LanguageParserWindow8FactQuery
    head: U64 in 0..=8
    relation: LanguageParserRelation
    dependent_end: U64
    head_end: U64
    where .head == sequence/at(.query.snapshot.candidate0.hypothesis.state.heads,.query.dependent)
    where .head == 8 || .head < .query.snapshot.lexical.token_count
    where .dependent_end == sequence/at(.query.snapshot.lexical.tape.tokens,.query.dependent).span.end
    where .head_end == (.head == 8 ? 0 : sequence/at(.query.snapshot.lexical.tape.tokens,.head).span.end)
    where .query.dependent != 0 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation0.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation0.subtype)
    where .query.dependent != 1 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation1.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation1.subtype)
    where .query.dependent != 2 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation2.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation2.subtype)
    where .query.dependent != 3 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation3.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation3.subtype)
    where .query.dependent != 4 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation4.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation4.subtype)
    where .query.dependent != 5 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation5.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation5.subtype)
    where .query.dependent != 6 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation6.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation6.subtype)
    where .query.dependent != 7 || (variant/tag(.relation.base) == variant/tag(.query.snapshot.candidate0.hypothesis.state.relation7.base) && .relation.subtype == .query.snapshot.candidate0.hypothesis.state.relation7.subtype)
}
type LanguageParserWindow8StableDependencyFact = {
    context: LanguageParserWindow8DependencyFactContext
    where (variant/is(.context.query.snapshot.lexical.tape.source.stable_prefix,"some") ? (.context.dependent_end <= value/u64(.context.query.snapshot.lexical.tape.source.stable_prefix.some) && .context.head_end <= value/u64(.context.query.snapshot.lexical.tape.source.stable_prefix.some)) : false)
    where .context.head == 8 ? variant/is(.context.query.snapshot.lexical.tape.source.finality,"final") : (variant/is(.context.query.snapshot.lexical.tape.source.finality,"final") || variant/tag(.context.relation.base) == "det" || variant/tag(.context.relation.base) == "case" || variant/tag(.context.relation.base) == "vocative")
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent < .context.query.snapshot.candidate0.hypothesis.state.unread && .context.query.dependent < .context.query.snapshot.candidate0.hypothesis.selected)
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.head == 8 || (.context.head < .context.query.snapshot.candidate0.hypothesis.state.unread && .context.head < .context.query.snapshot.candidate0.hypothesis.selected))
    where !.context.query.snapshot.candidate0.hypothesis.active || sequence/at(.context.query.snapshot.candidate0.hypothesis.state.heads,.context.query.dependent) == .context.head
    where !.context.query.snapshot.candidate0.hypothesis.active || sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.query.dependent) == sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.query.dependent)
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.head == 8 ? true : sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.head) == sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.head))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 0 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation0.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation0.subtype))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 1 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation1.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation1.subtype))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 2 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation2.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation2.subtype))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 3 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation3.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation3.subtype))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 4 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation4.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation4.subtype))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 5 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation5.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation5.subtype))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 6 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation6.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation6.subtype))
    where !.context.query.snapshot.candidate0.hypothesis.active || (.context.query.dependent != 7 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate0.hypothesis.state.relation7.base) && .context.relation.subtype == .context.query.snapshot.candidate0.hypothesis.state.relation7.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent < .context.query.snapshot.candidate1.hypothesis.state.unread && .context.query.dependent < .context.query.snapshot.candidate1.hypothesis.selected)
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.head == 8 || (.context.head < .context.query.snapshot.candidate1.hypothesis.state.unread && .context.head < .context.query.snapshot.candidate1.hypothesis.selected))
    where !.context.query.snapshot.candidate1.hypothesis.active || sequence/at(.context.query.snapshot.candidate1.hypothesis.state.heads,.context.query.dependent) == .context.head
    where !.context.query.snapshot.candidate1.hypothesis.active || sequence/at(.context.query.snapshot.candidate1.hypothesis.choices,.context.query.dependent) == sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.query.dependent)
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.head == 8 ? true : sequence/at(.context.query.snapshot.candidate1.hypothesis.choices,.context.head) == sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.head))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 0 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation0.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation0.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 1 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation1.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation1.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 2 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation2.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation2.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 3 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation3.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation3.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 4 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation4.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation4.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 5 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation5.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation5.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 6 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation6.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation6.subtype))
    where !.context.query.snapshot.candidate1.hypothesis.active || (.context.query.dependent != 7 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate1.hypothesis.state.relation7.base) && .context.relation.subtype == .context.query.snapshot.candidate1.hypothesis.state.relation7.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent < .context.query.snapshot.candidate2.hypothesis.state.unread && .context.query.dependent < .context.query.snapshot.candidate2.hypothesis.selected)
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.head == 8 || (.context.head < .context.query.snapshot.candidate2.hypothesis.state.unread && .context.head < .context.query.snapshot.candidate2.hypothesis.selected))
    where !.context.query.snapshot.candidate2.hypothesis.active || sequence/at(.context.query.snapshot.candidate2.hypothesis.state.heads,.context.query.dependent) == .context.head
    where !.context.query.snapshot.candidate2.hypothesis.active || sequence/at(.context.query.snapshot.candidate2.hypothesis.choices,.context.query.dependent) == sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.query.dependent)
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.head == 8 ? true : sequence/at(.context.query.snapshot.candidate2.hypothesis.choices,.context.head) == sequence/at(.context.query.snapshot.candidate0.hypothesis.choices,.context.head))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 0 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation0.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation0.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 1 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation1.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation1.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 2 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation2.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation2.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 3 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation3.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation3.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 4 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation4.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation4.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 5 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation5.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation5.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 6 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation6.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation6.subtype))
    where !.context.query.snapshot.candidate2.hypothesis.active || (.context.query.dependent != 7 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate2.hypothesis.state.relation7.base) && .context.relation.subtype == .context.query.snapshot.candidate2.hypothesis.state.relation7.subtype))
    where !.context.query.snapshot.candidate3.hypothesis.active || (.context.query.dependent < .context.query.snapshot.candidate3.hypothesis.state.unread && .context.query.dependent < .context.query.snapshot.candidate3.hypothesis.selected)
