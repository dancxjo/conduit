    where !.context.query.snapshot.candidate3.hypothesis.active || (.context.query.dependent != 0 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate3.hypothesis.state.relation0.base) && .context.relation.subtype == .context.query.snapshot.candidate3.hypothesis.state.relation0.subtype))
    where !.context.query.snapshot.candidate3.hypothesis.active || (.context.query.dependent != 1 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate3.hypothesis.state.relation1.base) && .context.relation.subtype == .context.query.snapshot.candidate3.hypothesis.state.relation1.subtype))
    where !.context.query.snapshot.candidate3.hypothesis.active || (.context.query.dependent != 2 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate3.hypothesis.state.relation2.base) && .context.relation.subtype == .context.query.snapshot.candidate3.hypothesis.state.relation2.subtype))
    where !.context.query.snapshot.candidate3.hypothesis.active || (.context.query.dependent != 3 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate3.hypothesis.state.relation3.base) && .context.relation.subtype == .context.query.snapshot.candidate3.hypothesis.state.relation3.subtype))
    where !.context.query.snapshot.candidate3.hypothesis.active || (.context.query.dependent != 4 || (variant/tag(.context.relation.base) == variant/tag(.context.query.snapshot.candidate3.hypothesis.state.relation4.base) && .context.relation.subtype == .context.query.snapshot.candidate3.hypothesis.state.relation4.subtype))
