type LanguageParserWindow8StableDependencyFactProposal = {
    context: LanguageParserWindow8DependencyFactContext
}
plot language-window8-stable-dependency-fact (
    input: LanguageParserWindow8DependencyFactContext...| >> output: LanguageParserWindow8StableDependencyFactProposal...|
) = { context: . }
