# Private Source-derived protections refine, never replace, the existing mask.
# Final recursive Native state/protection admission remains required.
type LanguageParserIndependentMaskQuery = {
 request: LanguageParserMaskQuery
 mask: LanguageParserLegalMask
 retained: LanguageParserProtectedSetProposal
 default_relation: LanguageParserRelation
 where .mask.basis == .request.basis
 where .mask.state == .request.state
 where .retained.basis == .request.basis
 where .retained.basis == .request.state.basis
 where .retained.active.0 ? (.retained.edge0.dependent == 0 && .retained.edge0.current_basis == .retained.basis && .retained.edge0.dependent < .request.state.token_count && .retained.edge0.head <= 4) : true
 where .retained.active.1 ? (.retained.edge1.dependent == 1 && .retained.edge1.current_basis == .retained.basis && .retained.edge1.dependent < .request.state.token_count && .retained.edge1.head <= 4) : true
 where .retained.active.2 ? (.retained.edge2.dependent == 2 && .retained.edge2.current_basis == .retained.basis && .retained.edge2.dependent < .request.state.token_count && .retained.edge2.head <= 4) : true
 where .retained.active.3 ? (.retained.edge3.dependent == 3 && .retained.edge3.current_basis == .retained.basis && .retained.edge3.dependent < .request.state.token_count && .retained.edge3.head <= 4) : true
}
type LanguageParserIndependentMaskContext = {
