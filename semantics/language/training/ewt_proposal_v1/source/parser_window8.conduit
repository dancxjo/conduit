) = { accepted: .eligible, refusal: (!(.basis.text == .state.basis.text && (.basis.source_revision == .state.basis.source_revision && .basis.analysis_revision == .state.basis.analysis_revision)) ? stale_basis(unit) : (.eligible ? none(unit) : (.cycle ? cycle(unit) : illegal_action(unit)))), state: (.eligible ? { basis: .state.basis, token_count: .state.token_count, unread: (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) ? .state.unread + 1 : .state.unread), depth: (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) ? .state.depth + 1 : .state.depth - 1), stack: [(((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 0 ? .state.unread : .state.stack.0), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 1 ? .state.unread : .state.stack.1), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 2 ? .state.unread : .state.stack.2), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 3 ? .state.unread : .state.stack.3), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 4 ? .state.unread : .state.stack.4), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 5 ? .state.unread : .state.stack.5), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 6 ? .state.unread : .state.stack.6), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 7 ? .state.unread : .state.stack.7), (((variant/is(.action,"shift")) || (variant/is(.action,"right_arc"))) && .state.depth == 8 ? .state.unread : .state.stack.8)], heads: [((variant/is(.action,"left_arc")) && .top == 0 ? .state.unread : ((variant/is(.action,"right_arc")) && .state.unread == 0 ? .top : .state.heads.0)), ((variant/is(.action,"left_arc")) && .top == 1 ? .state.unread : ((variant/is(.action,"right_arc"))