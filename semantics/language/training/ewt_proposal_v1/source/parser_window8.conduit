== 6) ? .relation : .state.relation6), relation7: (((variant/is(.action,"left_arc")) && .top == 7) || ((variant/is(.action,"right_arc")) && .state.unread == 7) ? .relation : .state.relation7), committed: .state.committed } : .state) }
plot language-window8-transition (
    request: LanguageParserWindow8RawRequest...| >> result: LanguageParserWindow8RawResult...|
) {
    request >> language-window8-move-context() >> language-window8-move-legal() >> language-window8-move-apply() >> result
}
type LanguageParserWindow8Completion = {
    complete: Boolean
}
plot language-window8-complete (
    state: LanguageParserWindow8RawState...| >> result: LanguageParserWindow8Completion...|
) = { complete: (.unread == .token_count && (.depth == 1 && ((0 >= .token_count || .heads.0 < 9) && (1 >= .token_count || .heads.1 < 9) && (2 >= .token_count || .heads.2 < 9) && (3 >= .token_count || .heads.3 < 9) && (4 >= .token_count || .heads.4 < 9) && (5 >= .token_count || .heads.5 < 9) && (6 >= .token_count || .heads.6 < 9) && (7 >= .token_count || .heads.7 < 9)))) }

# Available prefixes and lexical alternatives remain distinct from analysis.
# The full exact tape stays private; only Source-produced codes enter scoring.
type LanguageParserWindow8Available = {
    count: U64
}
plot language-window8-available (
    tape: LanguageLexicalTape...| >> result: LanguageParserWindow8Available...|
) = { count: (sequence/length(.tokens) == 0 ? 0 : ((sequence/at(.tokens, sequence/length(.tokens) - 1).completeness is trailing_partial) ? sequence/length(.tokens) - 1 : sequence/length(.tokens))) }
type LanguageParserWindow8Lexical = {
    tape: LanguageLexicalTape
    token_count: U64 in 0..=8
    where .tape.profile.language == .tape.source.material.language
    where .token_count == (sequence/length(.tape.tokens) == 0 ? 0 : ((sequence/at(.tape.tokens, sequence/length(.tape.tokens) - 1).completeness is trailing_partial) ? sequence/length(.tape.tokens) - 1 : sequence/length(.tape.tokens)))
    where .token_count <= 0 ? true : (sequence/at(.tape.tokens, 0).identity.ordinal == 0 && sequence/at(.tape.tokens, 0).identity.text_identity == .tape.source.material.identity && sequence/at(.tape.tokens, 0).identity.text_revision == .tape.source.material.revision && sequence/at(.tape.tokens, 0).span.text_identity == .tape.source.material.identity && sequence/at(.tape.tokens, 0).span.text_revision == .tape.source.material.revision && (sequence/at(.tape.tokens, 0).span.basis is unicode_scalar) && (sequence/at(.tape.tokens, 0).completeness is complete) && sequence/length(sequence/at(.tape.tokens, 0).candidates) >= 1)
    where .token_count <= 1 ? true : (sequence/at(.tape.tokens, 1).identity.ordinal == 1 && sequence/at(.tape.tokens, 1).identity.text_identity == .tape.source.material.identity && sequence/at(.tape.tokens, 1).identity.text_revision == .tape.source.material.revision && sequence/at(.tape.tokens, 1).span.text_identity == .tape.source.material.identity && sequence/at(.tape.tokens, 1).span.text_revision == .tape.source.material.revision && (sequence/at(.tape.tokens, 1).span.basis is unicode_scalar) && (sequence/at(.tape.tokens, 1).completeness is complete) && sequence/length(sequence/at(.tape.tokens, 1).candidates) >= 1)
