) = { basis: .query.state.basis, indices: [.top_pos, 18 + .next_pos, 36 + .top_pos * 18 + .next_pos, 360 + .query.state.depth, 370 + .query.state.unread, 379 + (sequence/at(.query.state.stack, .query.state.depth - 1) != 8 && sequence/at(.query.state.heads, sequence/at(.query.state.stack, .query.state.depth - 1)) != 9 ? 1 : 0), 381, 382 + .query.projection.token_count, 391 + ((.future.count > 0 && .future.codes.0 == 0) || (.future.count > 1 && .future.codes.1 == 0) || (.future.count > 2 && .future.codes.2 == 0) || (.future.count > 3 && .future.codes.3 == 0) ? 1 : 0), 393 + ((.future.count > 0 && .future.codes.0 == 1) || (.future.count > 1 && .future.codes.1 == 1) || (.future.count > 2 && .future.codes.2 == 1) || (.future.count > 3 && .future.codes.3 == 1) ? 1 : 0), 395 + ((.future.count > 0 && .future.codes.0 == 2) || (.future.count > 1 && .future.codes.1 == 2) || (.future.count > 2 && .future.codes.2 == 2) || (.future.count > 3 && .future.codes.3 == 2) ? 1 : 0), 397 + ((.future.count > 0 && .future.codes.0 == 3) || (.future.count > 1 && .future.codes.1 == 3) || (.future.count > 2 && .future.codes.2 == 3) || (.future.count > 3 && .future.codes.3 == 3) ? 1 : 0), 399 + ((.future.count > 0 && .future.codes.0 == 4) || (.future.count > 1 && .future.codes.1 == 4) || (.future.count > 2 && .future.codes.2 == 4) || (.future.count > 3 && .future.codes.3 == 4) ? 1 : 0), 401 + ((.future.count > 0 && .future.codes.0 == 5) || (.future.count > 1 && .future.codes.1 == 5) || (.future.count > 2 && .future.codes.2 == 5) || (.future.count > 3 && .future.codes.3 == 5) ? 1 : 0), 403 + ((.future.count > 0 && .future.codes.0 == 6) || (.future.count > 1 && .future.codes.1 == 6) || (.future.count > 2 && .future.codes.2 == 6) || (.future.count > 3 && .future.codes.3 == 6) ? 1 : 0), 405 + ((.future.count > 0 && .future.codes.0 == 7) || (.future.count > 1 && .future.codes.1 == 7) || (.future.count > 2 && .future.codes.2 == 7) || (.future.count > 3 && .future.codes.3 == 7) ? 1 : 0), 407 + ((.future.count > 0 && .future.codes.0 == 8) || (.future.count > 1 && .future.codes.1 == 8) || (.future.count > 2 && .future.codes.2 == 8) || (.future.count > 3 && .future.codes.3 == 8) ? 1 : 0), 409 + ((.future.count > 0 && .future.codes.0 == 9) || (.future.count > 1 && .future.codes.1 == 9) || (.future.count > 2 && .future.codes.2 == 9) || (.future.count > 3 && .future.codes.3 == 9) ? 1 : 0), 411 + ((.future.count > 0 && .future.codes.0 == 10) || (.future.count > 1 && .future.codes.1 == 10) || (.future.count > 2 && .future.codes.2 == 10) || (.future.count > 3 && .future.codes.3 == 10) ? 1 : 0), 413 + ((.future.count > 0 && .future.codes.0 == 11) || (.future.count > 1 && .future.codes.1 == 11) || (.future.count > 2 && .future.codes.2 == 11) || (.future.count > 3 && .future.codes.3 == 11) ? 1 : 0), 415 + ((.future.count > 0 && .future.codes.0 == 12) || (.future.count > 1 && .future.codes.1 == 12) || (.future.count > 2 && .future.codes.2 == 12) || (.future.count > 3 && .future.codes.3 == 12) ? 1 : 0), 417 + ((.future.count > 0 && .future.codes.0 == 13) || (.future.count > 1 && .future.codes.1 == 13) || (.future.count > 2 && .future.codes.2 == 13) || (.future.count > 3 && .future.codes.3 == 13) ? 1 : 0), 419 + ((.future.count > 0 && .future.codes.0 == 14) || (.future.count > 1 && .future.codes.1 == 14) || (.future.count > 2 && .future.codes.2 == 14) || (.future.count > 3 && .future.codes.3 == 14) ? 1 : 0), 421 + ((.future.count > 0 && .future.codes.0 == 15) || (.future.count > 1 && .future.codes.1 == 15) || (.future.count > 2 && .future.codes.2 == 15) || (.future.count > 3 && .future.codes.3 == 15) ? 1 : 0), 423 + ((.future.count > 0 && .future.codes.0 == 16) || (.future.count > 1 && .future.codes.1 == 16) || (.future.count > 2 && .future.codes.2 == 16) || (.future.count > 3 && .future.codes.3 == 16) ? 1 : 0)] }
plot language-window8-model-features (
    query: LanguageParserWindow8RawFeatureQuery...| >> features: LanguageParserWindow8RawModelFeatures...|
) {
    query >> language-window8-feature-context() >> language-window8-feature-values() >> features
}

# Version3 model class encoding: Shift0, Reduce1, Left2..38, Right39..75.
# All labels predict canonical UD bases only; this finite model has no subtype output.
type LanguageParserWindow8ClassQuery = {
    code: U64 in 0..=75
    default_relation: LanguageParserRelation
    where text/material(.default_relation.subtype) == ""
}
type LanguageParserWindow8RawClassIndex = {
    action: LanguageParserAction
    index: U64
    default_relation: LanguageParserRelation
}
type LanguageParserWindow8RawClass = {
    action: LanguageParserAction
    relation: LanguageParserRelation
}
plot language-window8-class-index (
    query: LanguageParserWindow8ClassQuery...| >> index: LanguageParserWindow8RawClassIndex...|
) = { action: (.code == 0 ? shift(unit) : (.code == 1 ? reduce(unit) : (.code < 39 ? left_arc(unit) : right_arc(unit)))), index: (.code < 2 ? 14 : (.code < 39 ? .code - 2 : .code - 39)), default_relation: .default_relation }
type LanguageParserWindow8RawClassRelations = {
    index: LanguageParserWindow8RawClassIndex
    relations: collection LanguageUniversalDependencyRelation = 37
}
plot language-window8-class-relations (
    index: LanguageParserWindow8RawClassIndex...| >> relations: LanguageParserWindow8RawClassRelations...|
) = { index: ., relations: [acl(unit), advcl(unit), advmod(unit), amod(unit), appos(unit), aux(unit), case(unit), cc(unit), ccomp(unit), clf(unit), compound(unit), conj(unit), cop(unit), csubj(unit), dep(unit), det(unit), discourse(unit), dislocated(unit), expl(unit), fixed(unit), flat(unit), goeswith(unit), iobj(unit), list(unit), mark(unit), nmod(unit), nsubj(unit), nummod(unit), obj(unit), obl(unit), orphan(unit), parataxis(unit), punct(unit), reparandum(unit), root(unit), vocative(unit), xcomp(unit)] }
plot language-window8-class-relation (
    relations: LanguageParserWindow8RawClassRelations...| >> decoded: LanguageParserWindow8RawClass...|
) = { action: .index.action, relation: { base: sequence/at(.relations,.index.index), subtype: .index.default_relation.subtype } }
