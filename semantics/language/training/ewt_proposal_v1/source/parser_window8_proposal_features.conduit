# Additive draft; never changes legacy425/25 Source or artifact pins.
# Origins come from the original proposed tape through the retained Source chain.
type LanguageParserProposalWindow8OriginQuery = {
 proposed: LanguageLexicalProposedTape
 lexical: LanguageParserWindow8Lexical
 where .proposed.tape == .lexical.tape
}
type LanguageParserProposalWindow8RawOrigins = {
 text: LanguageTextId
 source_revision: LanguageTextRevisionId
 sequence: U64
 profile_identity: Text <= 64B not in [""]
 token_count: U64 in 0..=8
 origins: collection U64 = 8
}
type LanguageParserProposalWindow8Origins = {
 raw: LanguageParserProposalWindow8RawOrigins
 where 0 < .raw.token_count ? .raw.origins.0 < 2 : .raw.origins.0 == 2
 where 1 < .raw.token_count ? .raw.origins.1 < 2 : .raw.origins.1 == 2
 where 2 < .raw.token_count ? .raw.origins.2 < 2 : .raw.origins.2 == 2
 where 3 < .raw.token_count ? .raw.origins.3 < 2 : .raw.origins.3 == 2
 where 4 < .raw.token_count ? .raw.origins.4 < 2 : .raw.origins.4 == 2
 where 5 < .raw.token_count ? .raw.origins.5 < 2 : .raw.origins.5 == 2
 where 6 < .raw.token_count ? .raw.origins.6 < 2 : .raw.origins.6 == 2
 where 7 < .raw.token_count ? .raw.origins.7 < 2 : .raw.origins.7 == 2
}
