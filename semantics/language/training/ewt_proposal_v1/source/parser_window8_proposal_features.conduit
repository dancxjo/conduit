) = { text: .proposed.tape.source.material.identity, source_revision: .proposed.tape.source.material.revision, sequence: .proposed.tape.source.sequence, profile_identity: .proposed.definition.identity, token_count: .lexical.token_count, origins: [(0 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,0),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,0),"unknown") ? 1 : 2)) : 2),(1 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,1),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,1),"unknown") ? 1 : 2)) : 2),(2 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,2),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,2),"unknown") ? 1 : 2)) : 2),(3 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,3),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,3),"unknown") ? 1 : 2)) : 2),(4 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,4),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,4),"unknown") ? 1 : 2)) : 2),(5 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,5),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,5),"unknown") ? 1 : 2)) : 2),(6 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,6),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,6),"unknown") ? 1 : 2)) : 2),(7 < .lexical.token_count ? (variant/is(sequence/at(.proposed.origins,7),"reviewed") ? 0 : (variant/is(sequence/at(.proposed.origins,7),"unknown") ? 1 : 2)) : 2)] }
type LanguageParserProposalWindow8FeatureQuery = {
 raw: LanguageParserWindow8RawFeatureQuery
 origins: LanguageParserProposalWindow8Origins
 where .raw.projection.text == .origins.raw.text && .raw.projection.source_revision == .origins.raw.source_revision
 where .raw.projection.sequence == .origins.raw.sequence && .raw.projection.profile_identity == .origins.raw.profile_identity
 where .raw.projection.token_count == .origins.raw.token_count
}
type LanguageParserProposalWindow8FeatureContext = {
