# Bounded joint alternatives retain exact lexical occurrences and source choices.
# Scores propose rank; recursive native admission precedes agreement/publication.
type LanguageParserJointLexical = {
    tape: LanguageLexicalTape
    token_count: U64 in 1..=4
    where sequence/length(.tape.tokens) == .token_count
    where .tape.profile.language == .tape.source.material.language
    where .token_count <= 0 ? true : (sequence/at(.tape.tokens, 0).identity.ordinal == 0)
    where .token_count <= 0 ? true : (sequence/at(.tape.tokens, 0).span.text_identity == .tape.source.material.identity)
    where .token_count <= 0 ? true : (sequence/at(.tape.tokens, 0).span.text_revision == .tape.source.material.revision)
    where .token_count <= 0 ? true : (variant/is(sequence/at(.tape.tokens, 0).span.basis,"unicode_scalar"))
    where .token_count <= 0 ? true : (variant/is(sequence/at(.tape.tokens, 0).completeness,"complete"))
    where .token_count <= 0 ? true : (sequence/at(.tape.tokens, 0).identity.text_identity == .tape.source.material.identity)
    where .token_count <= 0 ? true : (sequence/at(.tape.tokens, 0).identity.text_revision == .tape.source.material.revision)
    where .token_count <= 0 ? true : (sequence/length(sequence/at(.tape.tokens, 0).candidates) >= 1)
    where .token_count <= 1 ? true : (sequence/at(.tape.tokens, 1).identity.ordinal == 1)
    where .token_count <= 1 ? true : (sequence/at(.tape.tokens, 1).span.text_identity == .tape.source.material.identity)
    where .token_count <= 1 ? true : (sequence/at(.tape.tokens, 1).span.text_revision == .tape.source.material.revision)
    where .token_count <= 1 ? true : (variant/is(sequence/at(.tape.tokens, 1).span.basis,"unicode_scalar"))
    where .token_count <= 1 ? true : (variant/is(sequence/at(.tape.tokens, 1).completeness,"complete"))
    where .token_count <= 1 ? true : (sequence/at(.tape.tokens, 1).identity.text_identity == .tape.source.material.identity)
    where .token_count <= 1 ? true : (sequence/at(.tape.tokens, 1).identity.text_revision == .tape.source.material.revision)
    where .token_count <= 1 ? true : (sequence/length(sequence/at(.tape.tokens, 1).candidates) >= 1)
    where .token_count <= 2 ? true : (sequence/at(.tape.tokens, 2).identity.ordinal == 2)
    where .token_count <= 2 ? true : (sequence/at(.tape.tokens, 2).span.text_identity == .tape.source.material.identity)
    where .token_count <= 2 ? true : (sequence/at(.tape.tokens, 2).span.text_revision == .tape.source.material.revision)
    where .token_count <= 2 ? true : (variant/is(sequence/at(.tape.tokens, 2).span.basis,"unicode_scalar"))
    where .token_count <= 2 ? true : (variant/is(sequence/at(.tape.tokens, 2).completeness,"complete"))
    where .token_count <= 2 ? true : (sequence/at(.tape.tokens, 2).identity.text_identity == .tape.source.material.identity)
    where .token_count <= 2 ? true : (sequence/at(.tape.tokens, 2).identity.text_revision == .tape.source.material.revision)
    where .token_count <= 2 ? true : (sequence/length(sequence/at(.tape.tokens, 2).candidates) >= 1)
    where .token_count <= 3 ? true : (sequence/at(.tape.tokens, 3).identity.ordinal == 3)
    where .token_count <= 3 ? true : (sequence/at(.tape.tokens, 3).span.text_identity == .tape.source.material.identity)
    where .token_count <= 3 ? true : (sequence/at(.tape.tokens, 3).span.text_revision == .tape.source.material.revision)
    where .token_count <= 3 ? true : (variant/is(sequence/at(.tape.tokens, 3).span.basis,"unicode_scalar"))
    where .token_count <= 3 ? true : (variant/is(sequence/at(.tape.tokens, 3).completeness,"complete"))
    where .token_count <= 3 ? true : (sequence/at(.tape.tokens, 3).identity.text_identity == .tape.source.material.identity)
    where .token_count <= 3 ? true : (sequence/at(.tape.tokens, 3).identity.text_revision == .tape.source.material.revision)
    where .token_count <= 3 ? true : (sequence/length(sequence/at(.tape.tokens, 3).candidates) >= 1)
}
type LanguageParserJointHypothesis = {
    parser: LanguageParserHypothesis
    choices: collection U64 = 4
    where .choices.0 < 4 && .choices.1 < 4 && .choices.2 < 4 && .choices.3 < 4
}
type LanguageParserJointBeam = {
    lexical: LanguageParserJointLexical
    basis: LanguageParserBasis
    epoch: U64
    invocation: U64
    candidate0: LanguageParserJointHypothesis
    candidate1: LanguageParserJointHypothesis
    candidate2: LanguageParserJointHypothesis
    candidate3: LanguageParserJointHypothesis
    where .basis.text == .lexical.tape.source.material.identity
    where .basis.source_revision == .lexical.tape.source.material.revision
    where .epoch == .lexical.tape.source.sequence
    where !.candidate0.parser.active || (.candidate0.parser.state.token_count == .lexical.token_count)
    where !.candidate0.parser.active || (.candidate0.parser.state.basis.text == .basis.text)
    where !.candidate0.parser.active || (.candidate0.parser.state.basis.source_revision == .basis.source_revision)
    where !.candidate0.parser.active || (.candidate0.parser.state.basis.analysis_revision == .basis.analysis_revision)
    where !.candidate0.parser.active || (.lexical.token_count <= 0 ? true : (.candidate0.choices.0 < sequence/length(sequence/at(.lexical.tape.tokens, 0).candidates)))
    where !.candidate0.parser.active || (.lexical.token_count <= 1 ? true : (.candidate0.choices.1 < sequence/length(sequence/at(.lexical.tape.tokens, 1).candidates)))
    where !.candidate0.parser.active || (.lexical.token_count <= 2 ? true : (.candidate0.choices.2 < sequence/length(sequence/at(.lexical.tape.tokens, 2).candidates)))
    where !.candidate0.parser.active || (.lexical.token_count <= 3 ? true : (.candidate0.choices.3 < sequence/length(sequence/at(.lexical.tape.tokens, 3).candidates)))
    where !.candidate1.parser.active || (.candidate1.parser.state.token_count == .lexical.token_count)
    where !.candidate1.parser.active || (.candidate1.parser.state.basis.text == .basis.text)
    where !.candidate1.parser.active || (.candidate1.parser.state.basis.source_revision == .basis.source_revision)
    where !.candidate1.parser.active || (.candidate1.parser.state.basis.analysis_revision == .basis.analysis_revision)
    where !.candidate1.parser.active || (.lexical.token_count <= 0 ? true : (.candidate1.choices.0 < sequence/length(sequence/at(.lexical.tape.tokens, 0).candidates)))
    where !.candidate1.parser.active || (.lexical.token_count <= 1 ? true : (.candidate1.choices.1 < sequence/length(sequence/at(.lexical.tape.tokens, 1).candidates)))
    where !.candidate1.parser.active || (.lexical.token_count <= 2 ? true : (.candidate1.choices.2 < sequence/length(sequence/at(.lexical.tape.tokens, 2).candidates)))
    where !.candidate1.parser.active || (.lexical.token_count <= 3 ? true : (.candidate1.choices.3 < sequence/length(sequence/at(.lexical.tape.tokens, 3).candidates)))
    where !.candidate2.parser.active || (.candidate2.parser.state.token_count == .lexical.token_count)
    where !.candidate2.parser.active || (.candidate2.parser.state.basis.text == .basis.text)
    where !.candidate2.parser.active || (.candidate2.parser.state.basis.source_revision == .basis.source_revision)
    where !.candidate2.parser.active || (.candidate2.parser.state.basis.analysis_revision == .basis.analysis_revision)
    where !.candidate2.parser.active || (.lexical.token_count <= 0 ? true : (.candidate2.choices.0 < sequence/length(sequence/at(.lexical.tape.tokens, 0).candidates)))
    where !.candidate2.parser.active || (.lexical.token_count <= 1 ? true : (.candidate2.choices.1 < sequence/length(sequence/at(.lexical.tape.tokens, 1).candidates)))
    where !.candidate2.parser.active || (.lexical.token_count <= 2 ? true : (.candidate2.choices.2 < sequence/length(sequence/at(.lexical.tape.tokens, 2).candidates)))
    where !.candidate2.parser.active || (.lexical.token_count <= 3 ? true : (.candidate2.choices.3 < sequence/length(sequence/at(.lexical.tape.tokens, 3).candidates)))
    where !.candidate3.parser.active || (.candidate3.parser.state.token_count == .lexical.token_count)
    where !.candidate3.parser.active || (.candidate3.parser.state.basis.text == .basis.text)
    where !.candidate3.parser.active || (.candidate3.parser.state.basis.source_revision == .basis.source_revision)
    where !.candidate3.parser.active || (.candidate3.parser.state.basis.analysis_revision == .basis.analysis_revision)
    where !.candidate3.parser.active || (.lexical.token_count <= 0 ? true : (.candidate3.choices.0 < sequence/length(sequence/at(.lexical.tape.tokens, 0).candidates)))
    where !.candidate3.parser.active || (.lexical.token_count <= 1 ? true : (.candidate3.choices.1 < sequence/length(sequence/at(.lexical.tape.tokens, 1).candidates)))
    where !.candidate3.parser.active || (.lexical.token_count <= 2 ? true : (.candidate3.choices.2 < sequence/length(sequence/at(.lexical.tape.tokens, 2).candidates)))
    where !.candidate3.parser.active || (.lexical.token_count <= 3 ? true : (.candidate3.choices.3 < sequence/length(sequence/at(.lexical.tape.tokens, 3).candidates)))
}
type LanguageParserJointChoiceQuery = {
    lexical: LanguageParserJointLexical
    state: LanguageParserState
    choices: collection U64 = 4
    epoch: U64
    invocation: U64
    where .epoch == .lexical.tape.source.sequence
    where .state.token_count == .lexical.token_count
    where .state.basis.text == .lexical.tape.source.material.identity
    where .state.basis.source_revision == .lexical.tape.source.material.revision
    where .lexical.token_count <= 0 ? true : (.choices.0 < sequence/length(sequence/at(.lexical.tape.tokens, 0).candidates))
    where .lexical.token_count <= 1 ? true : (.choices.1 < sequence/length(sequence/at(.lexical.tape.tokens, 1).candidates))
    where .lexical.token_count <= 2 ? true : (.choices.2 < sequence/length(sequence/at(.lexical.tape.tokens, 2).candidates))
    where .lexical.token_count <= 3 ? true : (.choices.3 < sequence/length(sequence/at(.lexical.tape.tokens, 3).candidates))
}
# Raw POS projection must be admitted as PosEvidence and joined to this State.
type LanguageParserJointPosContext = {
    query: LanguageParserJointChoiceQuery
    pos: collection U64 = 4
    selected: LanguageLexicalPos
}
plot language-parser-joint-pos-begin (
    query: LanguageParserJointChoiceQuery...| >> context: LanguageParserJointPosContext...|
) = { query: ., pos: [16,16,16,16], selected: other(unit) }
plot language-parser-joint-pos-select-0 (
    context: LanguageParserJointPosContext...| >> selected: LanguageParserJointPosContext...|
) = { query: .query, pos: .pos, selected: (.query.lexical.token_count <= 0 ? other(unit) : (.query.choices.0 == 0 ? .query.lexical.tape.tokens.0.candidates.0.pos : (.query.choices.0 == 1 ? .query.lexical.tape.tokens.0.candidates.1.pos : (.query.choices.0 == 2 ? .query.lexical.tape.tokens.0.candidates.2.pos : .query.lexical.tape.tokens.0.candidates.3.pos)))) }
plot language-parser-joint-pos-code-0 (
    context: LanguageParserJointPosContext...| >> resolved: LanguageParserJointPosContext...|
) = { query: .query, selected: .selected, pos: [(.query.lexical.token_count <= 0 ? .pos.0 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16)))))), .pos.1, .pos.2, .pos.3] }
plot language-parser-joint-pos-select-1 (
    context: LanguageParserJointPosContext...| >> selected: LanguageParserJointPosContext...|
) = { query: .query, pos: .pos, selected: (.query.lexical.token_count <= 1 ? other(unit) : (.query.choices.1 == 0 ? .query.lexical.tape.tokens.1.candidates.0.pos : (.query.choices.1 == 1 ? .query.lexical.tape.tokens.1.candidates.1.pos : (.query.choices.1 == 2 ? .query.lexical.tape.tokens.1.candidates.2.pos : .query.lexical.tape.tokens.1.candidates.3.pos)))) }
plot language-parser-joint-pos-code-1 (
    context: LanguageParserJointPosContext...| >> resolved: LanguageParserJointPosContext...|
) = { query: .query, selected: .selected, pos: [.pos.0, (.query.lexical.token_count <= 1 ? .pos.1 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16)))))), .pos.2, .pos.3] }
plot language-parser-joint-pos-select-2 (
    context: LanguageParserJointPosContext...| >> selected: LanguageParserJointPosContext...|
) = { query: .query, pos: .pos, selected: (.query.lexical.token_count <= 2 ? other(unit) : (.query.choices.2 == 0 ? .query.lexical.tape.tokens.2.candidates.0.pos : (.query.choices.2 == 1 ? .query.lexical.tape.tokens.2.candidates.1.pos : (.query.choices.2 == 2 ? .query.lexical.tape.tokens.2.candidates.2.pos : .query.lexical.tape.tokens.2.candidates.3.pos)))) }
plot language-parser-joint-pos-code-2 (
    context: LanguageParserJointPosContext...| >> resolved: LanguageParserJointPosContext...|
) = { query: .query, selected: .selected, pos: [.pos.0, .pos.1, (.query.lexical.token_count <= 2 ? .pos.2 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16)))))), .pos.3] }
plot language-parser-joint-pos-select-3 (
    context: LanguageParserJointPosContext...| >> selected: LanguageParserJointPosContext...|
) = { query: .query, pos: .pos, selected: (.query.lexical.token_count <= 3 ? other(unit) : (.query.choices.3 == 0 ? .query.lexical.tape.tokens.3.candidates.0.pos : (.query.choices.3 == 1 ? .query.lexical.tape.tokens.3.candidates.1.pos : (.query.choices.3 == 2 ? .query.lexical.tape.tokens.3.candidates.2.pos : .query.lexical.tape.tokens.3.candidates.3.pos)))) }
plot language-parser-joint-pos-code-3 (
    context: LanguageParserJointPosContext...| >> resolved: LanguageParserJointPosContext...|
) = { query: .query, selected: .selected, pos: [.pos.0, .pos.1, .pos.2, (.query.lexical.token_count <= 3 ? .pos.3 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16))))))] }
plot language-parser-joint-pos (
    query: LanguageParserJointChoiceQuery...| >> context: LanguageParserJointPosContext...|
) {
    query >> language-parser-joint-pos-begin() >> language-parser-joint-pos-select-0() >> language-parser-joint-pos-code-0() >> language-parser-joint-pos-select-1() >> language-parser-joint-pos-code-1() >> language-parser-joint-pos-select-2() >> language-parser-joint-pos-code-2() >> language-parser-joint-pos-select-3() >> language-parser-joint-pos-code-3() >> context
}
# Raw merge proposals retain lexical choices together with parser state.
# The containing JointBeam must be recursively admitted after each expansion.
type LanguageParserJointRawBeam = {
    candidate0: LanguageParserJointHypothesis
    candidate1: LanguageParserJointHypothesis
    candidate2: LanguageParserJointHypothesis
    candidate3: LanguageParserJointHypothesis
}
type LanguageParserJointMerge = {
    beam: LanguageParserJointRawBeam
    proposal: LanguageParserJointHypothesis
}
plot language-parser-joint-insert (
    merge: LanguageParserJointMerge...| >> beam: LanguageParserJointRawBeam...|
) = { candidate0: .beam.candidate0, candidate1: .beam.candidate1, candidate2: .beam.candidate2, candidate3: (((.proposal.parser.active && !.beam.candidate3.parser.active) || (.proposal.parser.active == .beam.candidate3.parser.active && (.proposal.parser.score > .beam.candidate3.parser.score || (.proposal.parser.score == .beam.candidate3.parser.score && .proposal.parser.identity <= .beam.candidate3.parser.identity)))) ? .proposal : .beam.candidate3) }
plot language-parser-joint-rank-0-1 (
    input: LanguageParserJointRawBeam...| >> output: LanguageParserJointRawBeam...|
) = { candidate0: (((.candidate0.parser.active && !.candidate1.parser.active) || (.candidate0.parser.active == .candidate1.parser.active && (.candidate0.parser.score > .candidate1.parser.score || (.candidate0.parser.score == .candidate1.parser.score && .candidate0.parser.identity <= .candidate1.parser.identity)))) ? .candidate0 : .candidate1), candidate1: (((.candidate0.parser.active && !.candidate1.parser.active) || (.candidate0.parser.active == .candidate1.parser.active && (.candidate0.parser.score > .candidate1.parser.score || (.candidate0.parser.score == .candidate1.parser.score && .candidate0.parser.identity <= .candidate1.parser.identity)))) ? .candidate1 : .candidate0), candidate2: .candidate2, candidate3: .candidate3 }
plot language-parser-joint-rank-2-3 (
    input: LanguageParserJointRawBeam...| >> output: LanguageParserJointRawBeam...|
) = { candidate0: .candidate0, candidate1: .candidate1, candidate2: (((.candidate2.parser.active && !.candidate3.parser.active) || (.candidate2.parser.active == .candidate3.parser.active && (.candidate2.parser.score > .candidate3.parser.score || (.candidate2.parser.score == .candidate3.parser.score && .candidate2.parser.identity <= .candidate3.parser.identity)))) ? .candidate2 : .candidate3), candidate3: (((.candidate2.parser.active && !.candidate3.parser.active) || (.candidate2.parser.active == .candidate3.parser.active && (.candidate2.parser.score > .candidate3.parser.score || (.candidate2.parser.score == .candidate3.parser.score && .candidate2.parser.identity <= .candidate3.parser.identity)))) ? .candidate3 : .candidate2) }
plot language-parser-joint-rank-0-2 (
    input: LanguageParserJointRawBeam...| >> output: LanguageParserJointRawBeam...|
) = { candidate0: (((.candidate0.parser.active && !.candidate2.parser.active) || (.candidate0.parser.active == .candidate2.parser.active && (.candidate0.parser.score > .candidate2.parser.score || (.candidate0.parser.score == .candidate2.parser.score && .candidate0.parser.identity <= .candidate2.parser.identity)))) ? .candidate0 : .candidate2), candidate1: .candidate1, candidate2: (((.candidate0.parser.active && !.candidate2.parser.active) || (.candidate0.parser.active == .candidate2.parser.active && (.candidate0.parser.score > .candidate2.parser.score || (.candidate0.parser.score == .candidate2.parser.score && .candidate0.parser.identity <= .candidate2.parser.identity)))) ? .candidate2 : .candidate0), candidate3: .candidate3 }
plot language-parser-joint-rank-1-3 (
    input: LanguageParserJointRawBeam...| >> output: LanguageParserJointRawBeam...|
) = { candidate0: .candidate0, candidate1: (((.candidate1.parser.active && !.candidate3.parser.active) || (.candidate1.parser.active == .candidate3.parser.active && (.candidate1.parser.score > .candidate3.parser.score || (.candidate1.parser.score == .candidate3.parser.score && .candidate1.parser.identity <= .candidate3.parser.identity)))) ? .candidate1 : .candidate3), candidate2: .candidate2, candidate3: (((.candidate1.parser.active && !.candidate3.parser.active) || (.candidate1.parser.active == .candidate3.parser.active && (.candidate1.parser.score > .candidate3.parser.score || (.candidate1.parser.score == .candidate3.parser.score && .candidate1.parser.identity <= .candidate3.parser.identity)))) ? .candidate3 : .candidate1) }
plot language-parser-joint-rank-1-2 (
    input: LanguageParserJointRawBeam...| >> output: LanguageParserJointRawBeam...|
) = { candidate0: .candidate0, candidate1: (((.candidate1.parser.active && !.candidate2.parser.active) || (.candidate1.parser.active == .candidate2.parser.active && (.candidate1.parser.score > .candidate2.parser.score || (.candidate1.parser.score == .candidate2.parser.score && .candidate1.parser.identity <= .candidate2.parser.identity)))) ? .candidate1 : .candidate2), candidate2: (((.candidate1.parser.active && !.candidate2.parser.active) || (.candidate1.parser.active == .candidate2.parser.active && (.candidate1.parser.score > .candidate2.parser.score || (.candidate1.parser.score == .candidate2.parser.score && .candidate1.parser.identity <= .candidate2.parser.identity)))) ? .candidate2 : .candidate1), candidate3: .candidate3 }
