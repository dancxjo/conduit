# Independent stable dependency fact. Its exact admitted candidate set, source,
# dependent/head lexical choices and relation are retained in the full query.
# Stable scalar spans alone do not authorize syntax; all survivors must agree.
# Root closure additionally requires final input, without gating non-root facts.
type LanguageParserJointStableFact = {
 query: LanguageParserJointConsensusQuery
 where .query.beam.candidate0.parser.active
 where (!.query.beam.candidate0.parser.active || (.query.dependent < .query.beam.candidate0.parser.state.unread && sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) < 5))
 where (!.query.beam.candidate1.parser.active || (.query.dependent < .query.beam.candidate1.parser.state.unread && sequence/at(.query.beam.candidate1.parser.state.heads,.query.dependent) < 5))
 where (!.query.beam.candidate2.parser.active || (.query.dependent < .query.beam.candidate2.parser.state.unread && sequence/at(.query.beam.candidate2.parser.state.heads,.query.dependent) < 5))
 where (!.query.beam.candidate3.parser.active || (.query.dependent < .query.beam.candidate3.parser.state.unread && sequence/at(.query.beam.candidate3.parser.state.heads,.query.dependent) < 5))
 where (!.query.beam.candidate1.parser.active || (sequence/at(.query.beam.candidate0.choices,.query.dependent) == sequence/at(.query.beam.candidate1.choices,.query.dependent) && sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) == sequence/at(.query.beam.candidate1.parser.state.heads,.query.dependent) && (sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) < 4 ? sequence/at(.query.beam.candidate0.choices,sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent)) : 0) == (sequence/at(.query.beam.candidate1.parser.state.heads,.query.dependent) < 4 ? sequence/at(.query.beam.candidate1.choices,sequence/at(.query.beam.candidate1.parser.state.heads,.query.dependent)) : 0) && (.query.dependent == 0 ? (variant/tag(.query.beam.candidate0.parser.state.relation0.base) == variant/tag(.query.beam.candidate1.parser.state.relation0.base) && .query.beam.candidate0.parser.state.relation0.subtype == .query.beam.candidate1.parser.state.relation0.subtype) : (.query.dependent == 1 ? (variant/tag(.query.beam.candidate0.parser.state.relation1.base) == variant/tag(.query.beam.candidate1.parser.state.relation1.base) && .query.beam.candidate0.parser.state.relation1.subtype == .query.beam.candidate1.parser.state.relation1.subtype) : (.query.dependent == 2 ? (variant/tag(.query.beam.candidate0.parser.state.relation2.base) == variant/tag(.query.beam.candidate1.parser.state.relation2.base) && .query.beam.candidate0.parser.state.relation2.subtype == .query.beam.candidate1.parser.state.relation2.subtype) : (variant/tag(.query.beam.candidate0.parser.state.relation3.base) == variant/tag(.query.beam.candidate1.parser.state.relation3.base) && .query.beam.candidate0.parser.state.relation3.subtype == .query.beam.candidate1.parser.state.relation3.subtype))))))
 where (!.query.beam.candidate2.parser.active || (sequence/at(.query.beam.candidate0.choices,.query.dependent) == sequence/at(.query.beam.candidate2.choices,.query.dependent) && sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) == sequence/at(.query.beam.candidate2.parser.state.heads,.query.dependent) && (sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) < 4 ? sequence/at(.query.beam.candidate0.choices,sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent)) : 0) == (sequence/at(.query.beam.candidate2.parser.state.heads,.query.dependent) < 4 ? sequence/at(.query.beam.candidate2.choices,sequence/at(.query.beam.candidate2.parser.state.heads,.query.dependent)) : 0) && (.query.dependent == 0 ? (variant/tag(.query.beam.candidate0.parser.state.relation0.base) == variant/tag(.query.beam.candidate2.parser.state.relation0.base) && .query.beam.candidate0.parser.state.relation0.subtype == .query.beam.candidate2.parser.state.relation0.subtype) : (.query.dependent == 1 ? (variant/tag(.query.beam.candidate0.parser.state.relation1.base) == variant/tag(.query.beam.candidate2.parser.state.relation1.base) && .query.beam.candidate0.parser.state.relation1.subtype == .query.beam.candidate2.parser.state.relation1.subtype) : (.query.dependent == 2 ? (variant/tag(.query.beam.candidate0.parser.state.relation2.base) == variant/tag(.query.beam.candidate2.parser.state.relation2.base) && .query.beam.candidate0.parser.state.relation2.subtype == .query.beam.candidate2.parser.state.relation2.subtype) : (variant/tag(.query.beam.candidate0.parser.state.relation3.base) == variant/tag(.query.beam.candidate2.parser.state.relation3.base) && .query.beam.candidate0.parser.state.relation3.subtype == .query.beam.candidate2.parser.state.relation3.subtype))))))
 where (!.query.beam.candidate3.parser.active || (sequence/at(.query.beam.candidate0.choices,.query.dependent) == sequence/at(.query.beam.candidate3.choices,.query.dependent) && sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) == sequence/at(.query.beam.candidate3.parser.state.heads,.query.dependent) && (sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) < 4 ? sequence/at(.query.beam.candidate0.choices,sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent)) : 0) == (sequence/at(.query.beam.candidate3.parser.state.heads,.query.dependent) < 4 ? sequence/at(.query.beam.candidate3.choices,sequence/at(.query.beam.candidate3.parser.state.heads,.query.dependent)) : 0) && (.query.dependent == 0 ? (variant/tag(.query.beam.candidate0.parser.state.relation0.base) == variant/tag(.query.beam.candidate3.parser.state.relation0.base) && .query.beam.candidate0.parser.state.relation0.subtype == .query.beam.candidate3.parser.state.relation0.subtype) : (.query.dependent == 1 ? (variant/tag(.query.beam.candidate0.parser.state.relation1.base) == variant/tag(.query.beam.candidate3.parser.state.relation1.base) && .query.beam.candidate0.parser.state.relation1.subtype == .query.beam.candidate3.parser.state.relation1.subtype) : (.query.dependent == 2 ? (variant/tag(.query.beam.candidate0.parser.state.relation2.base) == variant/tag(.query.beam.candidate3.parser.state.relation2.base) && .query.beam.candidate0.parser.state.relation2.subtype == .query.beam.candidate3.parser.state.relation2.subtype) : (variant/tag(.query.beam.candidate0.parser.state.relation3.base) == variant/tag(.query.beam.candidate3.parser.state.relation3.base) && .query.beam.candidate0.parser.state.relation3.subtype == .query.beam.candidate3.parser.state.relation3.subtype))))))
 where (!.query.beam.candidate0.parser.active || (sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) < .query.beam.candidate0.parser.state.unread || sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) == 4))
 where (!.query.beam.candidate1.parser.active || (sequence/at(.query.beam.candidate1.parser.state.heads,.query.dependent) < .query.beam.candidate1.parser.state.unread || sequence/at(.query.beam.candidate1.parser.state.heads,.query.dependent) == 4))
 where (!.query.beam.candidate2.parser.active || (sequence/at(.query.beam.candidate2.parser.state.heads,.query.dependent) < .query.beam.candidate2.parser.state.unread || sequence/at(.query.beam.candidate2.parser.state.heads,.query.dependent) == 4))
 where (!.query.beam.candidate3.parser.active || (sequence/at(.query.beam.candidate3.parser.state.heads,.query.dependent) < .query.beam.candidate3.parser.state.unread || sequence/at(.query.beam.candidate3.parser.state.heads,.query.dependent) == 4))
 where (variant/is(.query.beam.lexical.tape.source.stable_prefix,"some") ? (sequence/at(.query.beam.lexical.tape.tokens,.query.dependent).span.end <= value/u64(.query.beam.lexical.tape.source.stable_prefix.some)) : false)
 where (variant/is(.query.beam.lexical.tape.source.stable_prefix,"some") ? (sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) < .query.beam.lexical.token_count ? (sequence/at(.query.beam.lexical.tape.tokens,sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent)).span.end <= value/u64(.query.beam.lexical.tape.source.stable_prefix.some)) : (sequence/at(.query.beam.candidate0.parser.state.heads,.query.dependent) == 4 && variant/is(.query.beam.lexical.tape.source.finality,"final"))) : false)
}
# This ordinary graph proposes exact retained custody. Admission is the generic
# Native validator executing the full Source-authored StableFact laws above;
# a raw proposal never publishes stable truth on its own.
type LanguageParserJointStableFactProposal = {
 query: LanguageParserJointConsensusQuery
}
plot language-parser-joint-stable-fact (
 input: LanguageParserJointConsensusQuery...| >> output: LanguageParserJointStableFactProposal...|
) = { query: . }
