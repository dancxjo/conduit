# Source8 open-frontier continuation. Private producers retain exact model and
# full prepared lexical history; these receipts do not establish played/protected
# authority. Closed provisional trees require a separate explicit reanalysis.
type LanguageParserWindow8Continuation = {
    state: LanguageParserWindow8StateProof
    lexical: LanguageParserWindow8Lexical
    basis: LanguageParserBasis
    where .state.state.basis.text == .basis.text && .state.state.basis.source_revision == .basis.source_revision && .state.state.basis.analysis_revision == .basis.analysis_revision
    where .basis.text == .lexical.tape.source.material.identity && .basis.source_revision == .lexical.tape.source.material.revision
    where .state.state.token_count == .lexical.token_count
}
type LanguageParserWindow8Wait = {
    context: LanguageParserWindow8Continuation
    where variant/is(.context.lexical.tape.source.finality,"partial")
    where .context.state.state.unread == .context.lexical.token_count
}
type LanguageParserWindow8WaitProposal = {
    context: LanguageParserWindow8Continuation
}
plot language-window8-wait (
    input: LanguageParserWindow8Continuation...| >> output: LanguageParserWindow8WaitProposal...|
) = { context: . }
type LanguageParserWindow8GrowContext = {
    previous: LanguageParserWindow8Wait
    next: LanguageParserWindow8Lexical
    lineage: LanguageTextRevisionLineage
    basis: LanguageParserBasis
    choices: collection U64 = 8
    selected: U64 in 0..=8
    where .lineage.previous == .previous.context.lexical.tape.source && .lineage.next == .next.tape.source
    where .previous.context.lexical.tape.profile == .next.tape.profile
    where .next.token_count > .previous.context.lexical.token_count
    where .basis.text == .next.tape.source.material.identity && .basis.source_revision == .next.tape.source.material.revision
    where .basis.analysis_revision != .previous.context.basis.analysis_revision
    where .previous.context.state.state.committed == 0
    where .previous.context.state.state.depth > 1
    where sequence/at(.previous.context.state.state.heads,sequence/at(.previous.context.state.state.stack,.previous.context.state.state.depth - 1)) == 9
    where .selected == .previous.context.lexical.token_count
    where .selected > 0 ? .choices.0 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,0).candidates) : .choices.0 == 0
    where .previous.context.lexical.token_count <= 0 ? true : (sequence/at(.previous.context.lexical.tape.tokens,0).identity.ordinal == 0 && sequence/at(.next.tape.tokens,0).identity.ordinal == 0 && sequence/at(.previous.context.lexical.tape.tokens,0).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,0).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,0).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,0).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 0 ? true : (sequence/at(.previous.context.lexical.tape.tokens,0).span.start == sequence/at(.next.tape.tokens,0).span.start && sequence/at(.previous.context.lexical.tape.tokens,0).span.end == sequence/at(.next.tape.tokens,0).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,0).span.basis) == variant/tag(sequence/at(.next.tape.tokens,0).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,0).surface == sequence/at(.next.tape.tokens,0).surface && sequence/at(.previous.context.lexical.tape.tokens,0).candidates == sequence/at(.next.tape.tokens,0).candidates)
    where .previous.context.lexical.token_count <= 0 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,0).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,0).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,0).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,0).identity : false) : true) : true)
    where .selected > 1 ? .choices.1 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,1).candidates) : .choices.1 == 0
    where .previous.context.lexical.token_count <= 1 ? true : (sequence/at(.previous.context.lexical.tape.tokens,1).identity.ordinal == 1 && sequence/at(.next.tape.tokens,1).identity.ordinal == 1 && sequence/at(.previous.context.lexical.tape.tokens,1).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,1).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,1).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,1).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 1 ? true : (sequence/at(.previous.context.lexical.tape.tokens,1).span.start == sequence/at(.next.tape.tokens,1).span.start && sequence/at(.previous.context.lexical.tape.tokens,1).span.end == sequence/at(.next.tape.tokens,1).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,1).span.basis) == variant/tag(sequence/at(.next.tape.tokens,1).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,1).surface == sequence/at(.next.tape.tokens,1).surface && sequence/at(.previous.context.lexical.tape.tokens,1).candidates == sequence/at(.next.tape.tokens,1).candidates)
    where .previous.context.lexical.token_count <= 1 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,1).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,1).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,1).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,1).identity : false) : true) : true)
    where .selected > 2 ? .choices.2 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,2).candidates) : .choices.2 == 0
    where .previous.context.lexical.token_count <= 2 ? true : (sequence/at(.previous.context.lexical.tape.tokens,2).identity.ordinal == 2 && sequence/at(.next.tape.tokens,2).identity.ordinal == 2 && sequence/at(.previous.context.lexical.tape.tokens,2).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,2).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,2).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,2).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 2 ? true : (sequence/at(.previous.context.lexical.tape.tokens,2).span.start == sequence/at(.next.tape.tokens,2).span.start && sequence/at(.previous.context.lexical.tape.tokens,2).span.end == sequence/at(.next.tape.tokens,2).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,2).span.basis) == variant/tag(sequence/at(.next.tape.tokens,2).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,2).surface == sequence/at(.next.tape.tokens,2).surface && sequence/at(.previous.context.lexical.tape.tokens,2).candidates == sequence/at(.next.tape.tokens,2).candidates)
    where .previous.context.lexical.token_count <= 2 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,2).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,2).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,2).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,2).identity : false) : true) : true)
    where .selected > 3 ? .choices.3 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,3).candidates) : .choices.3 == 0
    where .previous.context.lexical.token_count <= 3 ? true : (sequence/at(.previous.context.lexical.tape.tokens,3).identity.ordinal == 3 && sequence/at(.next.tape.tokens,3).identity.ordinal == 3 && sequence/at(.previous.context.lexical.tape.tokens,3).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,3).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,3).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,3).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 3 ? true : (sequence/at(.previous.context.lexical.tape.tokens,3).span.start == sequence/at(.next.tape.tokens,3).span.start && sequence/at(.previous.context.lexical.tape.tokens,3).span.end == sequence/at(.next.tape.tokens,3).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,3).span.basis) == variant/tag(sequence/at(.next.tape.tokens,3).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,3).surface == sequence/at(.next.tape.tokens,3).surface && sequence/at(.previous.context.lexical.tape.tokens,3).candidates == sequence/at(.next.tape.tokens,3).candidates)
    where .previous.context.lexical.token_count <= 3 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,3).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,3).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,3).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,3).identity : false) : true) : true)
    where .selected > 4 ? .choices.4 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,4).candidates) : .choices.4 == 0
    where .previous.context.lexical.token_count <= 4 ? true : (sequence/at(.previous.context.lexical.tape.tokens,4).identity.ordinal == 4 && sequence/at(.next.tape.tokens,4).identity.ordinal == 4 && sequence/at(.previous.context.lexical.tape.tokens,4).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,4).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,4).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,4).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 4 ? true : (sequence/at(.previous.context.lexical.tape.tokens,4).span.start == sequence/at(.next.tape.tokens,4).span.start && sequence/at(.previous.context.lexical.tape.tokens,4).span.end == sequence/at(.next.tape.tokens,4).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,4).span.basis) == variant/tag(sequence/at(.next.tape.tokens,4).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,4).surface == sequence/at(.next.tape.tokens,4).surface && sequence/at(.previous.context.lexical.tape.tokens,4).candidates == sequence/at(.next.tape.tokens,4).candidates)
    where .previous.context.lexical.token_count <= 4 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,4).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,4).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,4).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,4).identity : false) : true) : true)
    where .selected > 5 ? .choices.5 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,5).candidates) : .choices.5 == 0
    where .previous.context.lexical.token_count <= 5 ? true : (sequence/at(.previous.context.lexical.tape.tokens,5).identity.ordinal == 5 && sequence/at(.next.tape.tokens,5).identity.ordinal == 5 && sequence/at(.previous.context.lexical.tape.tokens,5).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,5).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,5).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,5).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 5 ? true : (sequence/at(.previous.context.lexical.tape.tokens,5).span.start == sequence/at(.next.tape.tokens,5).span.start && sequence/at(.previous.context.lexical.tape.tokens,5).span.end == sequence/at(.next.tape.tokens,5).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,5).span.basis) == variant/tag(sequence/at(.next.tape.tokens,5).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,5).surface == sequence/at(.next.tape.tokens,5).surface && sequence/at(.previous.context.lexical.tape.tokens,5).candidates == sequence/at(.next.tape.tokens,5).candidates)
    where .previous.context.lexical.token_count <= 5 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,5).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,5).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,5).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,5).identity : false) : true) : true)
    where .selected > 6 ? .choices.6 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,6).candidates) : .choices.6 == 0
    where .previous.context.lexical.token_count <= 6 ? true : (sequence/at(.previous.context.lexical.tape.tokens,6).identity.ordinal == 6 && sequence/at(.next.tape.tokens,6).identity.ordinal == 6 && sequence/at(.previous.context.lexical.tape.tokens,6).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,6).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,6).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,6).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 6 ? true : (sequence/at(.previous.context.lexical.tape.tokens,6).span.start == sequence/at(.next.tape.tokens,6).span.start && sequence/at(.previous.context.lexical.tape.tokens,6).span.end == sequence/at(.next.tape.tokens,6).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,6).span.basis) == variant/tag(sequence/at(.next.tape.tokens,6).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,6).surface == sequence/at(.next.tape.tokens,6).surface && sequence/at(.previous.context.lexical.tape.tokens,6).candidates == sequence/at(.next.tape.tokens,6).candidates)
    where .previous.context.lexical.token_count <= 6 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,6).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,6).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,6).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,6).identity : false) : true) : true)
    where .selected > 7 ? .choices.7 < sequence/length(sequence/at(.previous.context.lexical.tape.tokens,7).candidates) : .choices.7 == 0
    where .previous.context.lexical.token_count <= 7 ? true : (sequence/at(.previous.context.lexical.tape.tokens,7).identity.ordinal == 7 && sequence/at(.next.tape.tokens,7).identity.ordinal == 7 && sequence/at(.previous.context.lexical.tape.tokens,7).identity.text_identity == .lineage.previous.material.identity && sequence/at(.previous.context.lexical.tape.tokens,7).identity.text_revision == .lineage.previous.material.revision && sequence/at(.next.tape.tokens,7).identity.text_identity == .lineage.next.material.identity && sequence/at(.next.tape.tokens,7).identity.text_revision == .lineage.next.material.revision)
    where .previous.context.lexical.token_count <= 7 ? true : (sequence/at(.previous.context.lexical.tape.tokens,7).span.start == sequence/at(.next.tape.tokens,7).span.start && sequence/at(.previous.context.lexical.tape.tokens,7).span.end == sequence/at(.next.tape.tokens,7).span.end && variant/tag(sequence/at(.previous.context.lexical.tape.tokens,7).span.basis) == variant/tag(sequence/at(.next.tape.tokens,7).span.basis) && sequence/at(.previous.context.lexical.tape.tokens,7).surface == sequence/at(.next.tape.tokens,7).surface && sequence/at(.previous.context.lexical.tape.tokens,7).candidates == sequence/at(.next.tape.tokens,7).candidates)
    where .previous.context.lexical.token_count <= 7 ? true : (variant/is(.lineage.previous.stable_prefix,"some") ? (sequence/at(.previous.context.lexical.tape.tokens,7).span.end <= value/u64(.lineage.previous.stable_prefix.some) ? (variant/is(sequence/at(.next.tape.tokens,7).prior_occurrence,"some") ? sequence/at(.next.tape.tokens,7).prior_occurrence.some == sequence/at(.previous.context.lexical.tape.tokens,7).identity : false) : true) : true)
}
type LanguageParserWindow8GrowProposal = {
    state: LanguageParserWindow8RawState
    choices: collection U64 = 8
    selected: U64
}
plot language-window8-grow (
    input: LanguageParserWindow8GrowContext...| >> output: LanguageParserWindow8GrowProposal...|
) = { state: { basis: .basis, token_count: .next.token_count, unread: .previous.context.state.state.unread, depth: .previous.context.state.state.depth, stack: .previous.context.state.state.stack, heads: .previous.context.state.state.heads, committed: .previous.context.state.state.committed, relation0: .previous.context.state.state.relation0, relation1: .previous.context.state.state.relation1, relation2: .previous.context.state.state.relation2, relation3: .previous.context.state.state.relation3, relation4: .previous.context.state.state.relation4, relation5: .previous.context.state.state.relation5, relation6: .previous.context.state.state.relation6, relation7: .previous.context.state.state.relation7 }, choices: .choices, selected: .selected }
