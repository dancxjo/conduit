# Explicit uncalibrated retention profile: integer score band 1000.
# Candidate0 must be an admitted active maximum, never a caller ranking claim.
# Source mutation preserves every state/choice/score/identity; native admission
# remains mandatory for the raw output before agreement or truth publication.
type LanguageParserJointScoreBandQuery = {
 runtime: LanguageParserJointRuntimeBeam
 where .runtime.beam.candidate0.parser.active
 where !.runtime.beam.candidate1.parser.active || .runtime.beam.candidate0.parser.score >= .runtime.beam.candidate1.parser.score
 where !.runtime.beam.candidate2.parser.active || .runtime.beam.candidate0.parser.score >= .runtime.beam.candidate2.parser.score
 where !.runtime.beam.candidate3.parser.active || .runtime.beam.candidate0.parser.score >= .runtime.beam.candidate3.parser.score
}
type LanguageParserJointScoreBandProposal = {
 candidate0: LanguageParserJointRuntimeRawHypothesis
 candidate1: LanguageParserJointRuntimeRawHypothesis
 candidate2: LanguageParserJointRuntimeRawHypothesis
 candidate3: LanguageParserJointRuntimeRawHypothesis
}
