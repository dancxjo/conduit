# Four-token symbolic revision profile. Retain committed dependent and head
# occurrences exactly; discard only uncommitted graph choices. Mechanical text
# and lexical lineage admission remains with the existing lexical owner.
# Derived from retained 798b3e5d6 parser_session_rebase, without learned choices.
type LanguageResourceParserRebaseRequest = {
 lineage: LanguageTextRevisionLineage
 previous: LanguageParserState
 previous_lexical: LanguageParserAvailableLexical
 next: LanguageParserAvailableLexical
 resource: ResourceRef
 previous_resource: ResourceRef
 basis: LanguageParserBasis
 default_relation: LanguageParserRelation
 where .default_relation.base is dep
 where .previous.token_count == .previous_lexical.token_count
 where .previous.basis.text == .previous_lexical.tape.source.material.identity
 where .previous.basis.source_revision == .previous_lexical.tape.source.material.revision
 where .lineage.previous == .previous_lexical.tape.source
 where .lineage.next == .next.tape.source
 where .resource == .previous_resource
 where .basis.text == .next.tape.source.material.identity
 where .basis.source_revision == .next.tape.source.material.revision
 where .basis.analysis_revision != .previous.basis.analysis_revision
 where .next.token_count > 0
 where .previous.committed <= .next.token_count
 where .previous.committed <= 0 ? true : (0 < .next.token_count ? (sequence/at(.next.tape.tokens,0).prior_occurrence is some ? (sequence/at(.next.tape.tokens,0).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,0).identity && sequence/at(.next.tape.tokens,0).span.start == sequence/at(.previous_lexical.tape.tokens,0).span.start && sequence/at(.next.tape.tokens,0).span.end == sequence/at(.previous_lexical.tape.tokens,0).span.end && sequence/at(.next.tape.tokens,0).surface == sequence/at(.previous_lexical.tape.tokens,0).surface && sequence/at(.next.tape.tokens,0).candidates == sequence/at(.previous_lexical.tape.tokens,0).candidates) : false) : false)
 where .previous.committed <= 0 || sequence/at(.previous.heads,0) == 4 ? true : (sequence/at(.previous.heads,0) < .next.token_count ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,0)).prior_occurrence is some ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,0)).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,0)).identity && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,0)).span.start == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,0)).span.start && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,0)).span.end == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,0)).span.end && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,0)).surface == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,0)).surface && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,0)).candidates == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,0)).candidates) : false) : false)
 where .previous.committed <= 1 ? true : (1 < .next.token_count ? (sequence/at(.next.tape.tokens,1).prior_occurrence is some ? (sequence/at(.next.tape.tokens,1).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,1).identity && sequence/at(.next.tape.tokens,1).span.start == sequence/at(.previous_lexical.tape.tokens,1).span.start && sequence/at(.next.tape.tokens,1).span.end == sequence/at(.previous_lexical.tape.tokens,1).span.end && sequence/at(.next.tape.tokens,1).surface == sequence/at(.previous_lexical.tape.tokens,1).surface && sequence/at(.next.tape.tokens,1).candidates == sequence/at(.previous_lexical.tape.tokens,1).candidates) : false) : false)
 where .previous.committed <= 1 || sequence/at(.previous.heads,1) == 4 ? true : (sequence/at(.previous.heads,1) < .next.token_count ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,1)).prior_occurrence is some ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,1)).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,1)).identity && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,1)).span.start == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,1)).span.start && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,1)).span.end == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,1)).span.end && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,1)).surface == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,1)).surface && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,1)).candidates == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,1)).candidates) : false) : false)
 where .previous.committed <= 2 ? true : (2 < .next.token_count ? (sequence/at(.next.tape.tokens,2).prior_occurrence is some ? (sequence/at(.next.tape.tokens,2).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,2).identity && sequence/at(.next.tape.tokens,2).span.start == sequence/at(.previous_lexical.tape.tokens,2).span.start && sequence/at(.next.tape.tokens,2).span.end == sequence/at(.previous_lexical.tape.tokens,2).span.end && sequence/at(.next.tape.tokens,2).surface == sequence/at(.previous_lexical.tape.tokens,2).surface && sequence/at(.next.tape.tokens,2).candidates == sequence/at(.previous_lexical.tape.tokens,2).candidates) : false) : false)
 where .previous.committed <= 2 || sequence/at(.previous.heads,2) == 4 ? true : (sequence/at(.previous.heads,2) < .next.token_count ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,2)).prior_occurrence is some ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,2)).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,2)).identity && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,2)).span.start == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,2)).span.start && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,2)).span.end == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,2)).span.end && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,2)).surface == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,2)).surface && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,2)).candidates == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,2)).candidates) : false) : false)
 where .previous.committed <= 3 ? true : (3 < .next.token_count ? (sequence/at(.next.tape.tokens,3).prior_occurrence is some ? (sequence/at(.next.tape.tokens,3).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,3).identity && sequence/at(.next.tape.tokens,3).span.start == sequence/at(.previous_lexical.tape.tokens,3).span.start && sequence/at(.next.tape.tokens,3).span.end == sequence/at(.previous_lexical.tape.tokens,3).span.end && sequence/at(.next.tape.tokens,3).surface == sequence/at(.previous_lexical.tape.tokens,3).surface && sequence/at(.next.tape.tokens,3).candidates == sequence/at(.previous_lexical.tape.tokens,3).candidates) : false) : false)
 where .previous.committed <= 3 || sequence/at(.previous.heads,3) == 4 ? true : (sequence/at(.previous.heads,3) < .next.token_count ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,3)).prior_occurrence is some ? (sequence/at(.next.tape.tokens,sequence/at(.previous.heads,3)).prior_occurrence.some == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,3)).identity && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,3)).span.start == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,3)).span.start && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,3)).span.end == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,3)).span.end && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,3)).surface == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,3)).surface && sequence/at(.next.tape.tokens,sequence/at(.previous.heads,3)).candidates == sequence/at(.previous_lexical.tape.tokens,sequence/at(.previous.heads,3)).candidates) : false) : false)
}
plot language-resource-parser-rebase-adapter (
 input: LanguageResourceParserRebaseRequest...| <= 65536B >> output: LanguageParserRebaseInput...|
) = { basis: .basis, previous: .previous, next_count: .next.token_count, default_relation: .default_relation }
plot language-resource-parser-rebase (input: LanguageResourceParserRebaseRequest...| <= 65536B >> output: LanguageParserNumericState...|) {
 input >> language-resource-parser-rebase-adapter() >> language-parser-rebase-numeric() >> output
}
