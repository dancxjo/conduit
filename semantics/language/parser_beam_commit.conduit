 input: LanguageParserBeamCommitDecision...| >> output: LanguageParserBeamCommitResult...|
) = {  candidate0: { state: { basis: .beam.candidate0.state.basis, token_count: .beam.candidate0.state.token_count, unread: .beam.candidate0.state.unread, depth: .beam.candidate0.state.depth, stack: .beam.candidate0.state.stack, heads: .beam.candidate0.state.heads, relation0: .beam.candidate0.state.relation0, relation1: .beam.candidate0.state.relation1, relation2: .beam.candidate0.state.relation2, relation3: .beam.candidate0.state.relation3, committed: (.accepted && .beam.candidate0.active ? .through : .beam.candidate0.state.committed) }, identity: .beam.candidate0.identity, score: .beam.candidate0.score, active: .beam.candidate0.active },  candidate1: { state: { basis: .beam.candidate1.state.basis, token_count: .beam.candidate1.state.token_count, unread: .beam.candidate1.state.unread, depth: .beam.candidate1.state.depth, stack: .beam.candidate1.state.stack, heads: .beam.candidate1.state.heads, relation0: .beam.candidate1.state.relation0, relation1: .beam.candidate1.state.relation1, relation2: .beam.candidate1.state.relation2, relation3: .beam.candidate1.state.relation3, committed: (.accepted && .beam.candidate1.active ? .through : .beam.candidate1.state.committed) }, identity: .beam.candidate1.identity, score: .beam.candidate1.score, active: .beam.candidate1.active },  candidate2: { state: { basis: .beam.candidate2.state.basis, token_count: .beam.candidate2.state.token_count, unread: .beam.candidate2.state.unread, depth: .beam.candidate2.state.depth, stack: .beam.candidate2.state.stack, heads: .beam.candidate2.state.heads, relation0: .beam.candidate2.state.relation0, relation1: .beam.candidate2.state.relation1, relation2: .beam.candidate2.state.relation2, relation3: .beam.candidate2.state.relation3, committed: (.accepted && .beam.candidate2.active ? .through : .beam.candidate2.state.committed) }, identity: .beam.candidate2.identity, score: .beam.candidate2.score, active: .beam.candidate2.active },  candidate3: { state: { basis: .beam.candidate3.state.basis, token_count: .beam.candidate3.state.token_count, unread: .beam.candidate3.state.unread, depth: .beam.candidate3.state.depth, stack: .beam.candidate3.state.stack, heads: .beam.candidate3.state.heads, relation0: .beam.candidate3.state.relation0, relation1: .beam.candidate3.state.relation1, relation2: .beam.candidate3.state.relation2, relation3: .beam.candidate3.state.relation3, committed: (.accepted && .beam.candidate3.active ? .through : .beam.candidate3.state.committed) }, identity: .beam.candidate3.identity, score: .beam.candidate3.score, active: .beam.candidate3.active },  frontier: { basis: .frontier.basis, stable: .frontier.stable, committed: (.accepted ? .through : .frontier.committed) },  accepted: .accepted,  refusal: .refusal }
plot language-parser-beam-commit (
 input: LanguageParserBeamCommitRequest...| <= 65536B >> output: LanguageParserBeamCommitResult...|
) {
 input >> language-parser-beam-commit-proposal() >> language-parser-beam-commit-start() >> language-parser-beam-commit-check-0() >> language-parser-beam-commit-check-1() >> language-parser-beam-commit-check-2() >> language-parser-beam-commit-check-3() >> language-parser-beam-commit-decision() >> language-parser-beam-commit-apply() >> output
}
