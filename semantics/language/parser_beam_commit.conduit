) = { request: .request, agrees: (.agrees && (.request.through <= 2 || ((.request.beam.candidate0.state.heads.2 < 5 && (!.request.beam.candidate1.active || (.request.beam.candidate1.state.heads.2 == .request.beam.candidate0.state.heads.2 && .request.beam.candidate1.state.relation2 == .request.beam.candidate0.state.relation2))) && ((!.request.beam.candidate2.active || (.request.beam.candidate2.state.heads.2 == .request.beam.candidate0.state.heads.2 && .request.beam.candidate2.state.relation2 == .request.beam.candidate0.state.relation2)) && (!.request.beam.candidate3.active || (.request.beam.candidate3.state.heads.2 == .request.beam.candidate0.state.heads.2 && .request.beam.candidate3.state.relation2 == .request.beam.candidate0.state.relation2)))))) }
