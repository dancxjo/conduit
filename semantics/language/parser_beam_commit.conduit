# Four admitted hypotheses, with scores supplied as bounded proposals.
# Source consensus and the stable frontier gate semantic commitment. Neither
# cancellation nor pressure mutates any candidate or frontier.
type LanguageParserBeamCommitRequest = {
 beam: LanguageParserAdmittedBeam
 frontier: LanguageParserRawFrontier
 through: U64 in 0..=4
 cancelled: Boolean
 pressure: Boolean
}
type LanguageParserBeamCommitDecision = {
 basis: LanguageParserBasis
 beam: LanguageParserBeam
 frontier: LanguageParserRawFrontier
 through: U64
 accepted: Boolean
 refusal: LanguageParserFrontierRefusal
}
type LanguageParserBeamCommitResult = {
 candidate0: LanguageParserRawHypothesis
 candidate1: LanguageParserRawHypothesis
 candidate2: LanguageParserRawHypothesis
 candidate3: LanguageParserRawHypothesis
 frontier: LanguageParserRawFrontier
 accepted: Boolean
 refusal: LanguageParserFrontierRefusal
}
# Representation adapter only: admitted inputs become raw proposals for the
# unchanged checked policy. Raw intermediate values are not admitted facts.
type LanguageParserRawBeamCommitRequest = {
 basis: LanguageParserBasis
 beam: LanguageParserBeam
 frontier: LanguageParserRawFrontier
 through: U64
 cancelled: Boolean
 pressure: Boolean
}
plot language-parser-beam-commit-proposal (
 input: LanguageParserBeamCommitRequest...| <= 65536B >> output: LanguageParserRawBeamCommitRequest...|
) = { basis: .beam.basis, beam: { candidate0: { state: { basis: .beam.candidate0.state.basis, token_count: .beam.candidate0.state.token_count, unread: .beam.candidate0.state.unread, depth: .beam.candidate0.state.depth, stack: .beam.candidate0.state.stack, heads: .beam.candidate0.state.heads, relation0: .beam.candidate0.state.relation0, relation1: .beam.candidate0.state.relation1, relation2: .beam.candidate0.state.relation2, relation3: .beam.candidate0.state.relation3, committed: .beam.candidate0.state.committed }, identity: .beam.candidate0.identity, score: .beam.candidate0.score, active: .beam.candidate0.active }, candidate1: { state: { basis: .beam.candidate1.state.basis, token_count: .beam.candidate1.state.token_count, unread: .beam.candidate1.state.unread, depth: .beam.candidate1.state.depth, stack: .beam.candidate1.state.stack, heads: .beam.candidate1.state.heads, relation0: .beam.candidate1.state.relation0, relation1: .beam.candidate1.state.relation1, relation2: .beam.candidate1.state.relation2, relation3: .beam.candidate1.state.relation3, committed: .beam.candidate1.state.committed }, identity: .beam.candidate1.identity, score: .beam.candidate1.score, active: .beam.candidate1.active }, candidate2: { state: { basis: .beam.candidate2.state.basis, token_count: .beam.candidate2.state.token_count, unread: .beam.candidate2.state.unread, depth: .beam.candidate2.state.depth, stack: .beam.candidate2.state.stack, heads: .beam.candidate2.state.heads, relation0: .beam.candidate2.state.relation0, relation1: .beam.candidate2.state.relation1, relation2: .beam.candidate2.state.relation2, relation3: .beam.candidate2.state.relation3, committed: .beam.candidate2.state.committed }, identity: .beam.candidate2.identity, score: .beam.candidate2.score, active: .beam.candidate2.active }, candidate3: { state: { basis: .beam.candidate3.state.basis, token_count: .beam.candidate3.state.token_count, unread: .beam.candidate3.state.unread, depth: .beam.candidate3.state.depth, stack: .beam.candidate3.state.stack, heads: .beam.candidate3.state.heads, relation0: .beam.candidate3.state.relation0, relation1: .beam.candidate3.state.relation1, relation2: .beam.candidate3.state.relation2, relation3: .beam.candidate3.state.relation3, committed: .beam.candidate3.state.committed }, identity: .beam.candidate3.identity, score: .beam.candidate3.score, active: .beam.candidate3.active } }, frontier: .frontier, through: .through, cancelled: .cancelled, pressure: .pressure }
type LanguageParserBeamCommitCheck = {
 request: LanguageParserRawBeamCommitRequest
 agrees: Boolean
}
plot language-parser-beam-commit-start (
 input: LanguageParserRawBeamCommitRequest...| >> output: LanguageParserBeamCommitCheck...|
) = { request: ., agrees: .beam.candidate0.active }
