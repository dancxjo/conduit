 input: LanguageParserBeamCommitCheck...| >> output: LanguageParserBeamCommitCheck...|
) = { request: .request, agrees: (.agrees && (.request.through <= 0 || ((.request.beam.candidate0.state.heads.0 < 5 && (!.request.beam.candidate1.active || (.request.beam.candidate1.state.heads.0 == .request.beam.candidate0.state.heads.0 && .request.beam.candidate1.state.relation0 == .request.beam.candidate0.state.relation0))) && ((!.request.beam.candidate2.active || (.request.beam.candidate2.state.heads.0 == .request.beam.candidate0.state.heads.0 && .request.beam.candidate2.state.relation0 == .request.beam.candidate0.state.relation0)) && (!.request.beam.candidate3.active || (.request.beam.candidate3.state.heads.0 == .request.beam.candidate0.state.heads.0 && .request.beam.candidate3.state.relation0 == .request.beam.candidate0.state.relation0)))))) }
