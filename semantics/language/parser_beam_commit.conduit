plot language-parser-beam-commit-decision (
 input: LanguageParserBeamCommitCheck...| >> output: LanguageParserBeamCommitDecision...|
) = { basis: .request.basis, beam: .request.beam, frontier: .request.frontier, through: .request.through, accepted: ((!.request.cancelled && (!.request.pressure && (.request.frontier.stable <= 4 && .request.frontier.committed <= .request.frontier.stable))) && (((.request.frontier.basis == .request.basis) && (((!.request.beam.candidate0.active || .request.beam.candidate0.state.committed == .request.frontier.committed) && (!.request.beam.candidate1.active || .request.beam.candidate1.state.committed == .request.frontier.committed)) && ((!.request.beam.candidate2.active || .request.beam.candidate2.state.committed == .request.frontier.committed) && (!.request.beam.candidate3.active || .request.beam.candidate3.state.committed == .request.frontier.committed)))) && ((.request.through >= .request.frontier.committed && .request.through <= .request.frontier.stable) && .agrees))), refusal: (.request.cancelled ? cancelled(empty) : (.request.pressure ? pressure(empty) : (!(.request.frontier.stable <= 4 && .request.frontier.committed <= .request.frontier.stable) ? invalid_frontier(empty) : (!(.request.frontier.basis == .request.basis) ? wrong_basis(empty) : (!(((!.request.beam.candidate0.active || .request.beam.candidate0.state.committed == .request.frontier.committed) && (!.request.beam.candidate1.active || .request.beam.candidate1.state.committed == .request.frontier.committed)) && ((!.request.beam.candidate2.active || .request.beam.candidate2.state.committed == .request.frontier.committed) && (!.request.beam.candidate3.active || .request.beam.candidate3.state.committed == .request.frontier.committed))) ? invalid_frontier(empty) : (!(.request.through >= .request.frontier.committed && .request.through <= .request.frontier.stable) ? beyond_stable(empty) : (!.agrees ? not_agreed(empty) : none(empty)))))))) }
