# Explicit consumer support inventory does not infer locale from spelling.
type LanguageLexicalConsumerInventory = {
    identity: Text <= 64B not in [""]
    language: LanguageId
    varieties: sequence LanguageVariety in 1..=32
    features: sequence LinguisticTokenFeature <= 32
    provenance: LinguisticDerivationProvenance
}
type LanguageLexicalConsumerVarietyMatch = {
    inventory: LanguageLexicalConsumerInventory
    variety: LanguageVariety
    index: U64 in 0..=31
    where .variety.language == .inventory.language
    where .index < sequence/length(.inventory.varieties)
    where .index < sequence/length(.inventory.varieties) ? .variety == sequence/at(.inventory.varieties,.index) : false
}
type LanguageLexicalConsumerFeatureMatch = {
    inventory: LanguageLexicalConsumerInventory
    feature: LinguisticTokenFeature
    index: U64 in 0..=31
    where .index < sequence/length(.inventory.features)
    where .index < sequence/length(.inventory.features) ? .feature == sequence/at(.inventory.features,.index) : false
}
type LanguageLexicalConsumerBasis = {
    source: LanguageTextRevision
    inventory: LanguageLexicalConsumerInventory
    where .source.material.language == .inventory.language
}
