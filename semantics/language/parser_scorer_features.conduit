# Finite feature encoding for the accepted #5722 artifact. Recovered narrowly
# from #5196; the exact 25 indices follow training/ewt_joint_v2/schema.json.
# Future candidate membership is evidence, never a chosen future POS.
type LanguageParserScorerChoiceQuery = {
    lexical: LanguageParserAvailableLexical
    state: LanguageParserState
    choices: collection U64 = 4
    epoch: U64
    invocation: U64
    where .epoch == .lexical.tape.source.sequence
    where .state.token_count == .lexical.token_count
    where .state.basis.text == .lexical.tape.source.material.identity
    where .state.basis.source_revision == .lexical.tape.source.material.revision
    where .lexical.token_count <= 0 ? true : (.choices.0 < sequence/length(sequence/at(.lexical.tape.tokens, 0).candidates))
    where .lexical.token_count <= 1 ? true : (.choices.1 < sequence/length(sequence/at(.lexical.tape.tokens, 1).candidates))
    where .lexical.token_count <= 2 ? true : (.choices.2 < sequence/length(sequence/at(.lexical.tape.tokens, 2).candidates))
    where .lexical.token_count <= 3 ? true : (.choices.3 < sequence/length(sequence/at(.lexical.tape.tokens, 3).candidates))
}
# POS alternatives come only from the admitted profile; selection is not a fact.
type LanguageParserScorerPosContext = {
    query: LanguageParserScorerChoiceQuery
    pos: collection U64 = 4
    selected: LanguageLexicalPos
}
plot language-parser-scorer-pos-begin (
    query: LanguageParserScorerChoiceQuery...| <= 65536B >> context: LanguageParserScorerPosContext...|
) = { query: ., pos: [16,16,16,16], selected: other(empty) }
plot language-parser-scorer-pos-select-0 (
    context: LanguageParserScorerPosContext...| >> selected: LanguageParserScorerPosContext...|
) = { query: .query, pos: .pos, selected: ((.query.lexical.token_count <= 0 || .query.state.unread < 0) ? other(empty) : (.query.choices.0 == 0 ? .query.lexical.tape.tokens.0.candidates.0.pos : (.query.choices.0 == 1 ? .query.lexical.tape.tokens.0.candidates.1.pos : (.query.choices.0 == 2 ? .query.lexical.tape.tokens.0.candidates.2.pos : .query.lexical.tape.tokens.0.candidates.3.pos)))) }
plot language-parser-scorer-pos-code-0 (
    context: LanguageParserScorerPosContext...| >> resolved: LanguageParserScorerPosContext...|
) = { query: .query, selected: .selected, pos: [((.query.lexical.token_count <= 0 || .query.state.unread < 0) ? .pos.0 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16)))))), .pos.1, .pos.2, .pos.3] }
plot language-parser-scorer-pos-select-1 (
    context: LanguageParserScorerPosContext...| >> selected: LanguageParserScorerPosContext...|
) = { query: .query, pos: .pos, selected: ((.query.lexical.token_count <= 1 || .query.state.unread < 1) ? other(empty) : (.query.choices.1 == 0 ? .query.lexical.tape.tokens.1.candidates.0.pos : (.query.choices.1 == 1 ? .query.lexical.tape.tokens.1.candidates.1.pos : (.query.choices.1 == 2 ? .query.lexical.tape.tokens.1.candidates.2.pos : .query.lexical.tape.tokens.1.candidates.3.pos)))) }
plot language-parser-scorer-pos-code-1 (
    context: LanguageParserScorerPosContext...| >> resolved: LanguageParserScorerPosContext...|
) = { query: .query, selected: .selected, pos: [.pos.0, ((.query.lexical.token_count <= 1 || .query.state.unread < 1) ? .pos.1 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16)))))), .pos.2, .pos.3] }
plot language-parser-scorer-pos-select-2 (
    context: LanguageParserScorerPosContext...| >> selected: LanguageParserScorerPosContext...|
) = { query: .query, pos: .pos, selected: ((.query.lexical.token_count <= 2 || .query.state.unread < 2) ? other(empty) : (.query.choices.2 == 0 ? .query.lexical.tape.tokens.2.candidates.0.pos : (.query.choices.2 == 1 ? .query.lexical.tape.tokens.2.candidates.1.pos : (.query.choices.2 == 2 ? .query.lexical.tape.tokens.2.candidates.2.pos : .query.lexical.tape.tokens.2.candidates.3.pos)))) }
plot language-parser-scorer-pos-code-2 (
    context: LanguageParserScorerPosContext...| >> resolved: LanguageParserScorerPosContext...|
) = { query: .query, selected: .selected, pos: [.pos.0, .pos.1, ((.query.lexical.token_count <= 2 || .query.state.unread < 2) ? .pos.2 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16)))))), .pos.3] }
plot language-parser-scorer-pos-select-3 (
    context: LanguageParserScorerPosContext...| >> selected: LanguageParserScorerPosContext...|
) = { query: .query, pos: .pos, selected: ((.query.lexical.token_count <= 3 || .query.state.unread < 3) ? other(empty) : (.query.choices.3 == 0 ? .query.lexical.tape.tokens.3.candidates.0.pos : (.query.choices.3 == 1 ? .query.lexical.tape.tokens.3.candidates.1.pos : (.query.choices.3 == 2 ? .query.lexical.tape.tokens.3.candidates.2.pos : .query.lexical.tape.tokens.3.candidates.3.pos)))) }
plot language-parser-scorer-pos-code-3 (
    context: LanguageParserScorerPosContext...| >> resolved: LanguageParserScorerPosContext...|
) = { query: .query, selected: .selected, pos: [.pos.0, .pos.1, .pos.2, ((.query.lexical.token_count <= 3 || .query.state.unread < 3) ? .pos.3 : ((((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) || ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) || (variant/is(.selected,"interjection") || variant/is(.selected,"noun")))) ? (((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) || (variant/is(.selected,"adverb") || variant/is(.selected,"auxiliary"))) ? ((variant/is(.selected,"adjective") || variant/is(.selected,"adposition")) ? (variant/is(.selected,"adjective") ? 0 : 1) : (variant/is(.selected,"adverb") ? 2 : 3)) : ((variant/is(.selected,"coordinating_conjunction") || variant/is(.selected,"determiner")) ? (variant/is(.selected,"coordinating_conjunction") ? 4 : 5) : (variant/is(.selected,"interjection") ? 6 : 7))) : (((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) || (variant/is(.selected,"pronoun") || variant/is(.selected,"proper_noun"))) ? ((variant/is(.selected,"numeral") || variant/is(.selected,"particle")) ? (variant/is(.selected,"numeral") ? 8 : 9) : (variant/is(.selected,"pronoun") ? 10 : 11)) : ((variant/is(.selected,"punctuation") || variant/is(.selected,"subordinating_conjunction")) ? (variant/is(.selected,"punctuation") ? 12 : 13) : (variant/is(.selected,"symbol") ? 14 : (variant/is(.selected,"verb") ? 15 : 16))))))] }
plot language-parser-scorer-pos (
    query: LanguageParserScorerChoiceQuery...| <= 65536B >> context: LanguageParserScorerPosContext...|
) {
    query >> language-parser-scorer-pos-begin() >> language-parser-scorer-pos-select-0() >> language-parser-scorer-pos-code-0() >> language-parser-scorer-pos-select-1() >> language-parser-scorer-pos-code-1() >> language-parser-scorer-pos-select-2() >> language-parser-scorer-pos-code-2() >> language-parser-scorer-pos-select-3() >> language-parser-scorer-pos-code-3() >> context
}
type LanguageParserScorerFeaturesContext = {
    query: LanguageParserScorerChoiceQuery
    pos: collection U64 = 4
    top: U64
    top_pos: U64
    next_pos: U64
    candidate_count: U64
    lookahead: collection LanguageLexicalPos = 4
}
type LanguageParserScorerFeatures = {
    basis: LanguageParserBasis
    epoch: U64
    invocation: U64
    indices: collection U64 = 25
}
plot language-parser-scorer-features-begin (
    input: LanguageParserScorerPosContext...| >> output: LanguageParserScorerFeaturesContext...|
) = { query: .query, pos: .pos, top: sequence/at(.query.state.stack, .query.state.depth - 1), top_pos: 17, next_pos: 17, candidate_count: 0, lookahead: [other(empty),other(empty),other(empty),other(empty)] }
plot language-parser-scorer-features-pos (
    input: LanguageParserScorerFeaturesContext...| >> output: LanguageParserScorerFeaturesContext...|
) = { query: .query, pos: .pos, top: .top, top_pos: (.top == 4 ? 17 : sequence/at(.pos, .top)), next_pos: (.query.state.unread == .query.lexical.token_count ? 17 : sequence/at(.pos, .query.state.unread)), candidate_count: .candidate_count, lookahead: .lookahead }
plot language-parser-scorer-lookahead-count (
    input: LanguageParserScorerFeaturesContext...| >> output: LanguageParserScorerFeaturesContext...|
) = { query: .query, pos: .pos, top: .top, top_pos: .top_pos, next_pos: .next_pos, candidate_count: (.query.state.unread + 1 < .query.lexical.token_count ? (.query.state.unread == 0 ? sequence/length(.query.lexical.tape.tokens.1.candidates) : (.query.state.unread == 1 ? sequence/length(.query.lexical.tape.tokens.2.candidates) : sequence/length(.query.lexical.tape.tokens.3.candidates))) : 0), lookahead: .lookahead }
plot language-parser-scorer-lookahead-0 (
    input: LanguageParserScorerFeaturesContext...| >> output: LanguageParserScorerFeaturesContext...|
) = { query: .query, pos: .pos, top: .top, top_pos: .top_pos, next_pos: .next_pos, candidate_count: .candidate_count, lookahead: [(.candidate_count <= 0 ? other(empty) : (.query.state.unread == 0 ? .query.lexical.tape.tokens.1.candidates.0.pos : (.query.state.unread == 1 ? .query.lexical.tape.tokens.2.candidates.0.pos : .query.lexical.tape.tokens.3.candidates.0.pos))), .lookahead.1, .lookahead.2, .lookahead.3] }
plot language-parser-scorer-lookahead-1 (
    input: LanguageParserScorerFeaturesContext...| >> output: LanguageParserScorerFeaturesContext...|
) = { query: .query, pos: .pos, top: .top, top_pos: .top_pos, next_pos: .next_pos, candidate_count: .candidate_count, lookahead: [.lookahead.0, (.candidate_count <= 1 ? other(empty) : (.query.state.unread == 0 ? .query.lexical.tape.tokens.1.candidates.1.pos : (.query.state.unread == 1 ? .query.lexical.tape.tokens.2.candidates.1.pos : .query.lexical.tape.tokens.3.candidates.1.pos))), .lookahead.2, .lookahead.3] }
plot language-parser-scorer-lookahead-2 (
    input: LanguageParserScorerFeaturesContext...| >> output: LanguageParserScorerFeaturesContext...|
) = { query: .query, pos: .pos, top: .top, top_pos: .top_pos, next_pos: .next_pos, candidate_count: .candidate_count, lookahead: [.lookahead.0, .lookahead.1, (.candidate_count <= 2 ? other(empty) : (.query.state.unread == 0 ? .query.lexical.tape.tokens.1.candidates.2.pos : (.query.state.unread == 1 ? .query.lexical.tape.tokens.2.candidates.2.pos : .query.lexical.tape.tokens.3.candidates.2.pos))), .lookahead.3] }
plot language-parser-scorer-lookahead-3 (
    input: LanguageParserScorerFeaturesContext...| >> output: LanguageParserScorerFeaturesContext...|
) = { query: .query, pos: .pos, top: .top, top_pos: .top_pos, next_pos: .next_pos, candidate_count: .candidate_count, lookahead: [.lookahead.0, .lookahead.1, .lookahead.2, (.candidate_count <= 3 ? other(empty) : (.query.state.unread == 0 ? .query.lexical.tape.tokens.1.candidates.3.pos : (.query.state.unread == 1 ? .query.lexical.tape.tokens.2.candidates.3.pos : .query.lexical.tape.tokens.3.candidates.3.pos)))] }
plot language-parser-scorer-features-output (
    input: LanguageParserScorerFeaturesContext...| >> output: LanguageParserScorerFeatures...|
) = { basis: .query.state.basis, epoch: .query.epoch, invocation: .query.invocation, indices: [.top_pos, 18 + .next_pos, 36 + .top_pos * 18 + .next_pos, 360 + .query.state.depth, 366 + .query.state.unread, 371 + (.top != 4 && sequence/at(.query.state.heads, .top) != 5 ? 1 : 0), 373, 374 + .query.lexical.token_count, 379 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"adjective") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"adjective") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"adjective") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"adjective") : false))) ? 1 : 0), 381 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"adposition") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"adposition") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"adposition") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"adposition") : false))) ? 1 : 0), 383 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"adverb") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"adverb") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"adverb") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"adverb") : false))) ? 1 : 0), 385 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"auxiliary") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"auxiliary") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"auxiliary") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"auxiliary") : false))) ? 1 : 0), 387 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"coordinating_conjunction") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"coordinating_conjunction") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"coordinating_conjunction") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"coordinating_conjunction") : false))) ? 1 : 0), 389 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"determiner") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"determiner") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"determiner") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"determiner") : false))) ? 1 : 0), 391 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"interjection") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"interjection") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"interjection") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"interjection") : false))) ? 1 : 0), 393 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"noun") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"noun") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"noun") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"noun") : false))) ? 1 : 0), 395 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"numeral") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"numeral") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"numeral") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"numeral") : false))) ? 1 : 0), 397 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"particle") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"particle") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"particle") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"particle") : false))) ? 1 : 0), 399 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"pronoun") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"pronoun") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"pronoun") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"pronoun") : false))) ? 1 : 0), 401 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"proper_noun") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"proper_noun") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"proper_noun") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"proper_noun") : false))) ? 1 : 0), 403 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"punctuation") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"punctuation") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"punctuation") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"punctuation") : false))) ? 1 : 0), 405 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"subordinating_conjunction") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"subordinating_conjunction") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"subordinating_conjunction") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"subordinating_conjunction") : false))) ? 1 : 0), 407 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"symbol") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"symbol") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"symbol") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"symbol") : false))) ? 1 : 0), 409 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"verb") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"verb") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"verb") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"verb") : false))) ? 1 : 0), 411 + ((((.candidate_count > 0 ? variant/is(.lookahead.0,"other") : false) || (.candidate_count > 1 ? variant/is(.lookahead.1,"other") : false)) || ((.candidate_count > 2 ? variant/is(.lookahead.2,"other") : false) || (.candidate_count > 3 ? variant/is(.lookahead.3,"other") : false))) ? 1 : 0)] }
plot language-parser-scorer-model-features (
    query: LanguageParserScorerChoiceQuery...| <= 65536B >> features: LanguageParserScorerFeatures...|
) {
    query >> language-parser-scorer-pos() >> language-parser-scorer-features-begin() >> language-parser-scorer-features-pos() >> language-parser-scorer-lookahead-count() >> language-parser-scorer-lookahead-0() >> language-parser-scorer-lookahead-1() >> language-parser-scorer-lookahead-2() >> language-parser-scorer-lookahead-3() >> language-parser-scorer-features-output() >> features
}
