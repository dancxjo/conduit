    where !.query.context.query.snapshot.candidate0.hypothesis.active || (.query.context.query.dependent != 6 || (variant/tag(.query.context.relation.base) == variant/tag(.query.context.query.snapshot.candidate0.hypothesis.state.relation6.base) && .query.context.relation.subtype == .query.context.query.snapshot.candidate0.hypothesis.state.relation6.subtype))
    where !.query.context.query.snapshot.candidate0.hypothesis.active || (.query.context.query.dependent != 7 || (variant/tag(.query.context.relation.base) == variant/tag(.query.context.query.snapshot.candidate0.hypothesis.state.relation7.base) && .query.context.relation.subtype == .query.context.query.snapshot.candidate0.hypothesis.state.relation7.subtype))
    where !.query.context.query.snapshot.candidate1.hypothesis.active || (.query.context.query.dependent < .query.context.query.snapshot.candidate1.hypothesis.state.unread && .query.context.query.dependent < .query.context.query.snapshot.candidate1.hypothesis.selected)
    where !.query.context.query.snapshot.candidate1.hypothesis.active || (.query.context.head == 8 || (.query.context.head < .query.context.query.snapshot.candidate1.hypothesis.state.unread && .query.context.head < .query.context.query.snapshot.candidate1.hypothesis.selected))
