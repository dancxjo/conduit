    where !.query.context.query.snapshot.candidate1.hypothesis.active || sequence/at(.query.context.query.snapshot.candidate1.hypothesis.choices,.query.context.query.dependent) == sequence/at(.query.context.query.snapshot.candidate0.hypothesis.choices,.query.context.query.dependent)
