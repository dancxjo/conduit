    where !.query.context.query.snapshot.candidate2.hypothesis.active || sequence/at(.query.context.query.snapshot.candidate2.hypothesis.choices,.query.context.query.dependent) == sequence/at(.query.context.query.snapshot.candidate0.hypothesis.choices,.query.context.query.dependent)
