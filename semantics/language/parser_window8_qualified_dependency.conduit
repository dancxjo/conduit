# Exact original Source proposal precedes fresh guarded Analysis admission.
# Semantic refusal retains this complete Source execution/output; resource,
# custody, target and other late refusals cancel the entire unpublished revision.
plot language-window8-qualified-dependency-analysis (
 input: LanguageParserWindow8QualifiedDependencyQuery...| >> output: LanguageParserWindow8QualifiedDependencyProposal...|
) = { query: . }
