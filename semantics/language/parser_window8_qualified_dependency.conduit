    where !.query.context.query.snapshot.candidate1.hypothesis.active || (.query.context.query.dependent != 0 || (variant/tag(.query.context.relation.base) == variant/tag(.query.context.query.snapshot.candidate1.hypothesis.state.relation0.base) && .query.context.relation.subtype == .query.context.query.snapshot.candidate1.hypothesis.state.relation0.subtype))
