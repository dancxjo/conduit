    where !.query.context.query.snapshot.candidate2.hypothesis.active || (.query.context.query.dependent < .query.context.query.snapshot.candidate2.hypothesis.state.unread && .query.context.query.dependent < .query.context.query.snapshot.candidate2.hypothesis.selected)
    where !.query.context.query.snapshot.candidate2.hypothesis.active || (.query.context.head == 8 || (.query.context.head < .query.context.query.snapshot.candidate2.hypothesis.state.unread && .query.context.head < .query.context.query.snapshot.candidate2.hypothesis.selected))
