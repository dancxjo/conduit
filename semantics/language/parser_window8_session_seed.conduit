# WORK-only Window8 Session seed; no arbitrary admitted snapshot is initialization.
# Positive initial state must come from retained original language-window8-initialize.
# Closed Session checks exact whole state equality against that execution before this port.
type LanguageParserWindow8SessionSeedContext = {
 initial: LanguageParserWindow8RawState
 lexical: LanguageParserWindow8Lexical
 identity: U64
 where .initial.basis.text == .lexical.tape.source.material.identity
 where .initial.basis.source_revision == .lexical.tape.source.material.revision
 where .initial.token_count == .lexical.token_count && .lexical.token_count > 0
 where .initial.unread == 0 && .initial.depth == 1 && .initial.committed == 0
 where .initial.stack.0 == 8 && .initial.heads.0 == 9
 where .initial.stack.1 == 8 && .initial.heads.1 == 9
 where .initial.stack.2 == 8 && .initial.heads.2 == 9
 where .initial.stack.3 == 8 && .initial.heads.3 == 9
 where .initial.stack.4 == 8 && .initial.heads.4 == 9
 where .initial.stack.5 == 8 && .initial.heads.5 == 9
 where .initial.stack.6 == 8 && .initial.heads.6 == 9
 where .initial.stack.7 == 8 && .initial.heads.7 == 9
 where .initial.stack.8 == 8 && .initial.heads.8 == 8
 where !variant/is(.initial.relation0.base,"root")
 where !variant/is(.initial.relation1.base,"root")
 where !variant/is(.initial.relation2.base,"root")
 where !variant/is(.initial.relation3.base,"root")
 where !variant/is(.initial.relation4.base,"root")
 where !variant/is(.initial.relation5.base,"root")
 where !variant/is(.initial.relation6.base,"root")
 where !variant/is(.initial.relation7.base,"root")
}
plot language-window8-session-seed (
 input: LanguageParserWindow8SessionSeedContext...| >> output: LanguageParserWindow8RawBeam...|
) = { candidate0: { identity: .identity, active: true, score: 0, state: .initial, choices: [0,0,0,0,0,0,0,0], selected: 0 }, candidate1: { identity: 0, active: false, score: 0, state: .initial, choices: [0,0,0,0,0,0,0,0], selected: 0 }, candidate2: { identity: 0, active: false, score: 0, state: .initial, choices: [0,0,0,0,0,0,0,0], selected: 0 }, candidate3: { identity: 0, active: false, score: 0, state: .initial, choices: [0,0,0,0,0,0,0,0], selected: 0 } }
# Existing positive initializer cannot accept zero tokens. This exact additive
# Source initializer owns the partial-empty case and is freshly readmitted as
# original EmptyPrefix; it neither parses nor authorizes facts at zero tokens.
type LanguageParserWindow8EmptySeedRequest = {
 basis: LanguageParserBasis
 lexical: LanguageParserWindow8Lexical
 default_relation: LanguageParserRelation
 where .lexical.token_count == 0
 where variant/is(.lexical.tape.source.finality,"partial")
 where .basis.text == .lexical.tape.source.material.identity
 where .basis.source_revision == .lexical.tape.source.material.revision
 where !variant/is(.default_relation.base,"root")
}
type LanguageParserWindow8EmptySeedProposal = {
 state: LanguageParserWindow8RawState
 lexical: LanguageParserWindow8Lexical
 basis: LanguageParserBasis
}
plot language-window8-session-empty-seed (
 input: LanguageParserWindow8EmptySeedRequest...| >> output: LanguageParserWindow8EmptySeedProposal...|
) = { state: { basis: .basis, token_count: 0, unread: 0, depth: 1, stack: [8,8,8,8,8,8,8,8,8], heads: [9,9,9,9,9,9,9,9,8], relation0: .default_relation, relation1: .default_relation, relation2: .default_relation, relation3: .default_relation, relation4: .default_relation, relation5: .default_relation, relation6: .default_relation, relation7: .default_relation, committed: 0 }, lexical: .lexical, basis: .basis }
