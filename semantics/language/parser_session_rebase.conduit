 next: LanguageParserAvailableLexical
 basis: LanguageParserBasis
 default_relation: LanguageParserRelation
 where .default_relation.base is dep
 where .lineage.previous == .previous.lexical.tape.source
 where .lineage.next == .next.tape.source
 where .previous.lexical.tape.profile == .next.tape.profile
 where .basis.text == .next.tape.source.material.identity
 where .basis.source_revision == .next.tape.source.material.revision
 where .basis.analysis_revision != .previous.state.basis.analysis_revision
 where .next.token_count > 0
 where .previous.state.committed <= .next.token_count
 where .previous.lexical.token_count <= 0 ? true : (.choices.0 < sequence/length(.previous.lexical.tape.tokens.0.candidates))
 where .previous.state.committed <= 0 ? true : (0 < .next.token_count ? (sequence/at(.next.tape.tokens,0).prior_occurrence is some ? (sequence/at(.next.tape.tokens,0).prior_occurrence.some == sequence/at(.previous.lexical.tape.tokens,0).identity && sequence/at(.next.tape.tokens,0).span.start == sequence/at(.previous.lexical.tape.tokens,0).span.start && sequence/at(.next.tape.tokens,0).span.end == sequence/at(.previous.lexical.tape.tokens,0).span.end && sequence/at(.next.tape.tokens,0).surface == sequence/at(.previous.lexical.tape.tokens,0).surface && sequence/at(.next.tape.tokens,0).candidates == sequence/at(.previous.lexical.tape.tokens,0).candidates) : false) : false)
