 where .previous.lexical.token_count <= 1 ? true : (.choices.1 < sequence/length(.previous.lexical.tape.tokens.1.candidates))
 where .previous.state.committed <= 1 ? true : (1 < .next.token_count ? (sequence/at(.next.tape.tokens,1).prior_occurrence is some ? (sequence/at(.next.tape.tokens,1).prior_occurrence.some == sequence/at(.previous.lexical.tape.tokens,1).identity && sequence/at(.next.tape.tokens,1).span.start == sequence/at(.previous.lexical.tape.tokens,1).span.start && sequence/at(.next.tape.tokens,1).span.end == sequence/at(.previous.lexical.tape.tokens,1).span.end && sequence/at(.next.tape.tokens,1).surface == sequence/at(.previous.lexical.tape.tokens,1).surface && sequence/at(.next.tape.tokens,1).candidates == sequence/at(.previous.lexical.tape.tokens,1).candidates) : false) : false)
 where .previous.state.committed <= 1 || sequence/at(.previous.state.heads,1) == 4 ? true : (sequence/at(.previous.state.heads,1) < .next.token_count ? (sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,1)).prior_occurrence is some ? (sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,1)).prior_occurrence.some == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,1)).identity && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,1)).span.start == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,1)).span.start && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,1)).span.end == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,1)).span.end && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,1)).surface == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,1)).surface && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,1)).candidates == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,1)).candidates) : false) : false)
 where .previous.lexical.token_count <= 2 ? true : (.choices.2 < sequence/length(.previous.lexical.tape.tokens.2.candidates))
 where .previous.state.committed <= 2 ? true : (2 < .next.token_count ? (sequence/at(.next.tape.tokens,2).prior_occurrence is some ? (sequence/at(.next.tape.tokens,2).prior_occurrence.some == sequence/at(.previous.lexical.tape.tokens,2).identity && sequence/at(.next.tape.tokens,2).span.start == sequence/at(.previous.lexical.tape.tokens,2).span.start && sequence/at(.next.tape.tokens,2).span.end == sequence/at(.previous.lexical.tape.tokens,2).span.end && sequence/at(.next.tape.tokens,2).surface == sequence/at(.previous.lexical.tape.tokens,2).surface && sequence/at(.next.tape.tokens,2).candidates == sequence/at(.previous.lexical.tape.tokens,2).candidates) : false) : false)
 where .previous.state.committed <= 2 || sequence/at(.previous.state.heads,2) == 4 ? true : (sequence/at(.previous.state.heads,2) < .next.token_count ? (sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,2)).prior_occurrence is some ? (sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,2)).prior_occurrence.some == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,2)).identity && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,2)).span.start == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,2)).span.start && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,2)).span.end == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,2)).span.end && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,2)).surface == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,2)).surface && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,2)).candidates == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,2)).candidates) : false) : false)
 where .previous.lexical.token_count <= 3 ? true : (.choices.3 < sequence/length(.previous.lexical.tape.tokens.3.candidates))
 where .previous.state.committed <= 3 ? true : (3 < .next.token_count ? (sequence/at(.next.tape.tokens,3).prior_occurrence is some ? (sequence/at(.next.tape.tokens,3).prior_occurrence.some == sequence/at(.previous.lexical.tape.tokens,3).identity && sequence/at(.next.tape.tokens,3).span.start == sequence/at(.previous.lexical.tape.tokens,3).span.start && sequence/at(.next.tape.tokens,3).span.end == sequence/at(.previous.lexical.tape.tokens,3).span.end && sequence/at(.next.tape.tokens,3).surface == sequence/at(.previous.lexical.tape.tokens,3).surface && sequence/at(.next.tape.tokens,3).candidates == sequence/at(.previous.lexical.tape.tokens,3).candidates) : false) : false)
 where .previous.state.committed <= 3 || sequence/at(.previous.state.heads,3) == 4 ? true : (sequence/at(.previous.state.heads,3) < .next.token_count ? (sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,3)).prior_occurrence is some ? (sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,3)).prior_occurrence.some == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,3)).identity && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,3)).span.start == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,3)).span.start && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,3)).span.end == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,3)).span.end && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,3)).surface == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,3)).surface && sequence/at(.next.tape.tokens,sequence/at(.previous.state.heads,3)).candidates == sequence/at(.previous.lexical.tape.tokens,sequence/at(.previous.state.heads,3)).candidates) : false) : false)
}
type LanguageParserJointRebaseProposal = {
 state: LanguageParserNumericState
 choices: collection U64 = 4
 selected: U64
}
plot language-parser-joint-rebase (
 input: LanguageParserJointRebaseContext...| >> output: LanguageParserJointRebaseProposal...|
) = { state: { basis: .basis, token_count: .next.token_count, unread: .previous.state.committed, depth: ((.previous.state.committed > 0 && .previous.state.heads.0 == 4) || (.previous.state.committed > 1 && .previous.state.heads.1 == 4) || (.previous.state.committed > 2 && .previous.state.heads.2 == 4) || (.previous.state.committed > 3 && .previous.state.heads.3 == 4) ? 2 : 1), stack: [4,(.previous.state.committed > 0 && .previous.state.heads.0 == 4 ? 0 : (.previous.state.committed > 1 && .previous.state.heads.1 == 4 ? 1 : (.previous.state.committed > 2 && .previous.state.heads.2 == 4 ? 2 : (.previous.state.committed > 3 && .previous.state.heads.3 == 4 ? 3 : 4)))),4,4,4], heads: [(.previous.state.committed > 0 ? .previous.state.heads.0 : 5),(.previous.state.committed > 1 ? .previous.state.heads.1 : 5),(.previous.state.committed > 2 ? .previous.state.heads.2 : 5),(.previous.state.committed > 3 ? .previous.state.heads.3 : 5),4], relation0: (.previous.state.committed > 0 ? .previous.state.relation0 : .default_relation), relation1: (.previous.state.committed > 1 ? .previous.state.relation1 : .default_relation), relation2: (.previous.state.committed > 2 ? .previous.state.relation2 : .default_relation), relation3: (.previous.state.committed > 3 ? .previous.state.relation3 : .default_relation), committed: .previous.state.committed }, choices: [((.previous.state.committed > 0 || (.previous.state.committed > 0 && .previous.state.heads.0 == 0) || (.previous.state.committed > 1 && .previous.state.heads.1 == 0) || (.previous.state.committed > 2 && .previous.state.heads.2 == 0) || (.previous.state.committed > 3 && .previous.state.heads.3 == 0)) ? .choices.0 : 0),((.previous.state.committed > 1 || (.previous.state.committed > 0 && .previous.state.heads.0 == 1) || (.previous.state.committed > 1 && .previous.state.heads.1 == 1) || (.previous.state.committed > 2 && .previous.state.heads.2 == 1) || (.previous.state.committed > 3 && .previous.state.heads.3 == 1)) ? .choices.1 : 0),((.p