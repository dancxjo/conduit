# The preset menu and its source linkage are authored data, not runtime identities.
type KeymapPresetDescriptor = {
    identity: Text <= 32B
    label: Text <= 64B
    definition: Text <= 64B
}
type KeymapPresetDescriptors = sequence KeymapPresetDescriptor <= 8
type KeymapChoice = {
    identity: Text <= 32B
    label: Text <= 64B
    layout: KeymapLayout
}
type KeymapChoices = sequence KeymapChoice <= 8

plot input/keymap-presets (
    descriptors: KeymapPresetDescriptors = [{identity:"us-intl",label:"US International (AltGr)",definition:"input/keymap-default"},{identity:"us",label:"US",definition:"input/keymap-us"},{identity:"uk",label:"UK",definition:"input/keymap-uk"},{identity:"german",label:"German",definition:"input/keymap-german"},{identity:"french",label:"French",definition:"input/keymap-french"},{identity:"spanish",label:"Spanish",definition:"input/keymap-spanish"}]
) {
}
