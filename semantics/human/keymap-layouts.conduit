# Authored keyboard presets: XKB us(altgr-intl), us, gb, de, fr, es.
# Each preset defines four modifier levels; later layers contain lock/keypad policy.
# Later layers override earlier bindings with the same usage/shift/altgr.
# In the default US International preset, dead keys are exclusively on AltGr;
# plain ASCII punctuation stays literal. Other presets retain native dead keys.
# HID keyboard usages are physical keys. CapsLock and NumLock are authored
# actions; the portable interpreter retains both lock states, initially off.
# Unicode NFC is generic infrastructure; stroke exceptions below are authored.
type KeymapDead = {
    spacing: Text <= 4B
    combining: U32
}
type KeymapCapsText = {
    ordinary: Text <= 8B
    locked: Text <= 8B
}
type KeymapAction =
    none
    | text Text <= 8B
    | caps_text KeymapCapsText
    | caps_lock
    | num_lock
    | keypad Text <= 8B
    | dead KeymapDead

type KeymapBinding = {
    usage: U8
    shift: Boolean
    altgr: Boolean
    action: KeymapAction
}
type KeymapLayer = sequence KeymapBinding <= 128
type KeymapComposition = {
    combining: U32
    base: U32
    result: U32
}
type KeymapLayout = {
    layers: sequence KeymapLayer in 1..=4
    compositions: sequence KeymapComposition <= 64
}

