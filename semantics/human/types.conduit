# Authoritative portable human-experience meaning. Rust consumes generated bindings.

type KeyTransition =
    pressed
    | released

type KeyModifiers = U8

type KeyEvent = {
    usage: U8
    transition: KeyTransition
    left_control_after: Boolean
    left_shift_after: Boolean
    left_alt_after: Boolean
    left_gui_after: Boolean
    right_control_after: Boolean
    right_shift_after: Boolean
    right_alt_after: Boolean
    right_gui_after: Boolean
    where (.usage >= 4 && .usage <= 164) || (.usage >= 224 && .usage <= 231)
    where .usage != 224 || .left_control_after == (variant/tag(.transition) == "pressed")
    where .usage != 225 || .left_shift_after == (variant/tag(.transition) == "pressed")
    where .usage != 226 || .left_alt_after == (variant/tag(.transition) == "pressed")
    where .usage != 227 || .left_gui_after == (variant/tag(.transition) == "pressed")
    where .usage != 228 || .right_control_after == (variant/tag(.transition) == "pressed")
    where .usage != 229 || .right_shift_after == (variant/tag(.transition) == "pressed")
    where .usage != 230 || .right_alt_after == (variant/tag(.transition) == "pressed")
    where .usage != 231 || .right_gui_after == (variant/tag(.transition) == "pressed")
}

type KeymapRefusal =
    unknown_compose_sequence
    | empty_unicode_entry
    | unicode_entry_overflow
    | invalid_unicode_scalar

type HumanMediaKind =
    camera
    | microphone

type VisualImpressionDisposition =
    complete
    | truncated {
        original_bytes: U32
    }

type ImageTextMetadata = {
    key: Text <= 64B not in [""]
    value: Text <= 256B
}

type ImageRegion = {
    x: U16
    y: U16
    width: U16
    height: U16
}

type ImageObservationReference = {
    content: ResourceRef
    width: U16 in 1..=4096
    height: U16 in 1..=4096
}

code human/key-transition = KeyTransition as u8

type ChordPhase =
    triggered

code human/chord-phase = ChordPhase as u8 from 2

type CoreChordId =
    cancel_or_escape
    | clear_or_refresh
    | repeat_or_replan
    | palette
    | inspect
    | plan
    | command
    | activate

code human/core-chord-id = CoreChordId as u8 from 1

type ExperienceDomain =
    visual
    | auditory
    | location
    | body_state
    | human_utterance
    | recollection

type ExperienceOrigin =
    observation
    | human_reported
    | remembered
    | model_derived
    | imagined

type ExperienceTemporalRole =
    current
    | recent
    | stale
    | historical

type ExperienceTemporalPolicy = {
    maximum_current_age_ticks: U64
    maximum_recent_age_ticks: U64
}

type ExperienceAvailability =
    present
    | not_observed
    | source_unavailable

type ExperienceCertainty =
    certain
    | uncertain

type ExperienceRelationKind =
    relates
    | contradicts

type SourceAvailability =
    present
    | missing
    | unavailable

type VisualEvidenceClass =
    deterministic_derived
    | statistical_candidate
    | model_derived

type VisualExperienceRelationKind =
    relates
    | supports
    | contradicts

type InteractionRefusal =
    invalid_identity
    | invalid_contract
    | invalid_domain
    | invalid_current_state
    | value_bound_exceeded
    | wrong_value_kind
    | malformed_value
    | stale_state
    | removed_option
    | unavailable_option
    | invalid_cardinality
    | invalid_combination
    | concurrent_state_change
    | out_of_range
    | unsupported_granularity
    | duplicate_proposal
    | queue_pressure
    | result_pressure
    | unknown_proposal

type InteractionBoundKind =
    inclusive
    | exclusive

type OptionAvailability =
    available
    | unavailable {
        reason_code: Text <= 128B not in [""]
    }

type InteractionApplicationOutcome =
    accepted {
        resulting_state_identity: Text <= 128B not in [""]
    }
    | refused {
        reason_code: Text <= 128B not in [""]
    }
    | failed {
        reason_code: Text <= 128B not in [""]
    }
    | cancelled

type RealizationRangePolicy =
    refuse
    | clamp

type ScalarQuantization =
    exact
    | nearest
