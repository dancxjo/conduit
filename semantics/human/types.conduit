# Authoritative portable human-experience meaning. Rust consumes generated bindings.

type KeyTransition =
    pressed
    | released

type KeyModifiers = U8

type KeyEvent = {
    usage: U8
    transition: KeyTransition
    left_control_after: Boolean
    left_shift_after: Boolean
    left_alt_after: Boolean
    left_gui_after: Boolean
    right_control_after: Boolean
    right_shift_after: Boolean
    right_alt_after: Boolean
    right_gui_after: Boolean
    where (.usage >= 4 && .usage <= 164) || (.usage >= 224 && .usage <= 231)
    where .usage != 224 || .left_control_after == (.transition is pressed)
    where .usage != 225 || .left_shift_after == (.transition is pressed)
    where .usage != 226 || .left_alt_after == (.transition is pressed)
    where .usage != 227 || .left_gui_after == (.transition is pressed)
    where .usage != 228 || .right_control_after == (.transition is pressed)
    where .usage != 229 || .right_shift_after == (.transition is pressed)
    where .usage != 230 || .right_alt_after == (.transition is pressed)
    where .usage != 231 || .right_gui_after == (.transition is pressed)
}

type KeymapRefusal =
    unknown_compose_sequence
    | empty_unicode_entry
    | unicode_entry_overflow
    | invalid_unicode_scalar

# One Unicode scalar emitted by the portable keymap. The Rust binding encodes
# it into at most four UTF-8 bytes at the consumer boundary without allocation.
type TextFragment =
    basic U32 in 0..=55295
    | supplementary U32 in 57344..=1114111

type KeymapDisposition =
    no_text
    | text TextFragment
    | cancelled
    | refused KeymapRefusal

type HumanMediaKind =
    camera
    | microphone

type VisualImpressionDisposition =
    complete
    | truncated {
        original_bytes: U32
    }

type ImageTextMetadata = {
    key: Text <= 64B not in [""]
    value: Text <= 256B
}

type ImageRegion = {
    x: U16
    y: U16
    width: U16
    height: U16
}

type ImageObservationReference = {
    content: ResourceRef
    width: U16 in 1..=4096
    height: U16 in 1..=4096
}

type ImageObservationRefusal =
    invalid_resource
    | wrong_profile
    | invalid_dimensions
    | content_too_large

type ImageTextMetadataEntries = sequence ImageTextMetadata <= 8

type ImageTextContentDigest = collection U8 = 32

type ImageTextRecord = {
    image: ImageObservationReference
    caption: Text <= 512B not in [""]
    metadata: ImageTextMetadataEntries
    content_digest: ImageTextContentDigest
}

type ImageTextRefusal =
    invalid_image
    | wrong_image_profile
    | invalid_image_dimensions
    | image_too_large
    | empty_caption
    | caption_too_large
    | too_many_metadata_entries
    | empty_metadata_key
    | metadata_key_too_large
    | metadata_value_too_large
    | duplicate_metadata_key
    | integrity_mismatch

form human/key-transition = KeyTransition as u8

type ChordPhase =
    triggered

form human/chord-phase = ChordPhase as u8 from 2

type CoreChordId =
    cancel_or_escape
    | clear_or_refresh
    | repeat_or_replan
    | palette
    | inspect
    | plan
    | command
    | activate

form human/core-chord-id = CoreChordId as u8 from 1

type ControlChordModifier =
    left
    | right
    | both

# The eight exact chord meanings. Usage, phase and compact-form fields are
# derived compatibility facts rather than redundant authored payload.
type ChordInfo =
    cancel_or_escape ControlChordModifier
    | clear_or_refresh ControlChordModifier
    | repeat_or_replan ControlChordModifier
    | palette
    | inspect
    | plan
    | command
    | activate

type ExperienceDomain =
    visual
    | auditory
    | location
    | body_state
    | human_utterance
    | recollection

type ExperienceOrigin =
    observation
    | human_reported
    | remembered
    | model_derived
    | imagined

type ExperienceTemporalRole =
    current
    | indeterminate
    | recent
    | stale
    | historical

type ExperienceTemporalPolicy = {
    maximum_current_age_ticks: U64
    maximum_recent_age_ticks: U64
    where .maximum_current_age_ticks < .maximum_recent_age_ticks
}

type ExperienceTemporalRefusal =
    invalid_policy
    | invalid_instant
    | incomparable_clock
    | interval_overflow
    | future_observation
    | indeterminate_age

type ExperienceRefusal =
    invalid-limits
    | empty-identity
    | duplicate-identity
    | item-capacity
    | temporal-role-capacity
    | domain-capacity
    | model-derived-capacity
    | selected-memory-capacity
    | item-bytes
    | encoded-bytes
    | source-capacity
    | duplicate-source
    | relationship-capacity
    | unknown-relationship-endpoint
    | duplicate-relationship
    | conflict-alternative-capacity
    | invalid-epistemic-combination
    | identity-bytes
    | invalid-source
    | invalid-time
    | invalid-temporal-context
    | temporal-classification ExperienceTemporalRefusal
    | temporal-role-mismatch
    | arithmetic-overflow

type ExperienceUpdateRefusal =
    invalid-limits
    | pending-update-capacity
    | stale-revision
    | future-revision
    | revision-overflow
    | no-semantic-change
    | experience ExperienceRefusal

type CurrentExperienceInspectionError =
    empty-item-identity
    | unknown-item

type ExperienceAvailability =
    present
    | not_observed
    | source_unavailable

type ExperienceCertainty =
    certain
    | uncertain

type ExperienceRelationKind =
    relates
    | contradicts

type SourceAvailability =
    present
    | missing
    | unavailable

# Inputs remain nominally distinct because their provenance is meaning, even
# though each source carries the same finite observation shape.
type ExperienceHumanInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceBodyInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceMemoryInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceInferenceInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceHypothesisInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceSourceStatus = {
    source_identity: Text
    availability: SourceAvailability
}

type CurrentExperienceProjection = {
    revision: Count
    item_identities: collection Text = 32
    provenance_revision: Text
}

# An explicit selection, not a replacement for CurrentExperienceProjection.
# Evidence is supplied through the Cord; identities never authorize a lookup.
type ExperienceEvidenceIdentity = Text <= 128B not in [""]
type ExperienceEvidenceContent = Bytes <= 2048B
type ExperienceEvidenceIdentities = sequence ExperienceEvidenceIdentity <= 8
type ExperienceEvidenceSource =
    source ExperienceEvidenceIdentity
    | sign ExperienceEvidenceIdentity
    | human_statement ExperienceEvidenceIdentity
    | memory_record ExperienceEvidenceIdentity
    | resource ResourceRef
    | implementation_run {
        implementation: ExperienceEvidenceIdentity
        provider_instance: ExperienceEvidenceIdentity
        artifact: ExperienceEvidenceIdentity
        run: ExperienceEvidenceIdentity
    }
    | temporal_context {
        observed_at: TemporalInstant
        reference_at: TemporalInstant
        policy: ExperienceTemporalPolicy
    }

type ExperienceEvidenceSources = sequence ExperienceEvidenceSource <= 4
type ExperienceEvidenceItem = {
    identity: ExperienceEvidenceIdentity
    revision: U64
    provenance_revision: ExperienceEvidenceIdentity
    content_kind: ExperienceEvidenceIdentity
    encoded_content: ExperienceEvidenceContent
    domain: ExperienceDomain
    origin: ExperienceOrigin
    temporal_role: ExperienceTemporalRole
    availability: ExperienceAvailability
    certainty: ExperienceCertainty
    sources: ExperienceEvidenceSources
}

type ExperienceEvidenceItems = sequence ExperienceEvidenceItem <= 8
type ExperienceEvidenceSelection = {
    revision: U64
    provenance_revision: ExperienceEvidenceIdentity
    item_identities: ExperienceEvidenceIdentities
}

type ExperienceEvidenceRequest = {
    selection: ExperienceEvidenceSelection
    evidence: ExperienceEvidenceItems
}

# Inspectable evidence only, never model instructions or authority.
type ExperienceEvidenceContext = {
    selection: ExperienceEvidenceSelection
    items: ExperienceEvidenceItems
}

# Snapshot revisions are integration lineage; original provenance stays in sources.
type ExperienceIntegrationOperation =
    upsert ExperienceEvidenceItem
    | remove ExperienceEvidenceIdentity
    | replace_snapshot ExperienceEvidenceItems

type ExperienceIntegrationUpdate = {
    expected_revision: U64
    provenance_revision: ExperienceEvidenceIdentity
    operation: ExperienceIntegrationOperation
}

# Explicit finite autobiography. Original epistemic classes and source nodes
# remain nested in observation; actual model envelopes have a distinct origin.
type ExperienceAutobiographyResponse =
    model_derived Bytes <= 8192B
type ExperienceAutobiographyRecord = {
    episode: U64
    observation: ExperienceEvidenceRequest
    response: ExperienceAutobiographyResponse
}
type ExperienceAutobiographyRecords = sequence ExperienceAutobiographyRecord <= 2
type ExperienceAutobiographyState = {
    completed: U64
    records: ExperienceAutobiographyRecords
}
# Retention selection is typed input, never instructions inside evidence.
type ExperienceAutobiographyEvent = {
    observation: ExperienceEvidenceRequest
    retain: Boolean
}
type ExperienceAutobiographyPending = {
    expected_completed: U64
    observation: ExperienceEvidenceRequest
    previous: ExperienceAutobiographyState
    retain: Boolean
}

type ExperienceEvidenceRefusal =
    malformed
    | byte_bound
    | item_bound
    | identity_bound
    | duplicate_selection
    | duplicate_evidence
    | unselected_evidence
    | missing_evidence
    | stale_revision
    | future_revision
    | provenance_mismatch
    | source_bound
    | invalid_epistemic_combination

type VisualEvidenceClass =
    deterministic_derived
    | statistical_candidate
    | model_derived

type VisualExperienceRelationKind =
    relates
    | supports
    | contradicts

type InteractionValueKind = Text <= 128B not in [""]
type InteractionTypeDigest = collection U8 = 32
type InteractionCanonicalBytes = Bytes <= 65536B

type InteractionValue = {
    value-kind: InteractionValueKind
    canonical-bytes: InteractionCanonicalBytes
}

type InteractionValues = sequence InteractionValue <= 64

type InteractionProposalPayload =
    activate
    | values InteractionValues
    | relative {
        value: InteractionValue
    }

type InteractionFamily =
    activate
    | boolean
    | choose-one {
        value-kind: InteractionValueKind
        maximum-options: U16
    }
    | choose-many {
        value-kind: InteractionValueKind
        maximum-options: U16
        minimum-selections: U16
        maximum-selections: U16
    }
    | scalar {
        unit: Unit
        minimum: I64
        minimum-bound: InteractionBoundKind
        maximum: I64
        maximum-bound: InteractionBoundKind
        granularity: I64
    }
    | relative-adjustment {
        unit: Unit
        minimum-delta: I64
        maximum-delta: I64
        granularity: I64
    }
    | text {
        maximum-bytes: U32
        allow-empty: Boolean
    }
    | structured {
        value-kind: InteractionValueKind
        type-digest: InteractionTypeDigest
        maximum-bytes: U32
    }

type VisualObservationRefusal =
    invalid-image
    | wrong-image-profile
    | invalid-image-dimensions
    | image-too-large
    | invalid-region
    | empty-text
    | text-bound
    | confidence-bound
    | empty-identity
    | identity-bound
    | invalid-observation-time
    | wrong-evidence-class
    | observation-ref-bound
    | duplicate-observation-ref

type VisualImpressionRefusal =
    invalid-source-image
    | empty-text
    | text-bound
    | empty-identity
    | identity-bound
    | observation-ref-bound
    | duplicate-observation-ref
    | invalid-truncation
    | wrong-evidence-class
    | invalid-provenance VisualObservationRefusal

type VisualExperienceRefusal =
    invalid-limits
    | invalid-source-image
    | wrong-source-image
    | observation-capacity
    | observation-kind-capacity
    | text-capacity
    | duplicate-observation
    | invalid-observation VisualObservationRefusal
    | invalid-impression VisualImpressionRefusal
    | relation-capacity
    | unknown-relation-endpoint
    | self-relation
    | duplicate-relation
    | arithmetic-overflow

type ExperienceSourceRefusal =
    invalid-visual-observation VisualObservationRefusal
    | invalid-visual-impression VisualImpressionRefusal
    | empty-value
    | value-bound
    | invalid-identity
    | invalid-time
    | source-bound

type InteractionRefusal =
    invalid_identity
    | invalid_contract
    | invalid_domain
    | invalid_current_state
    | value_bound_exceeded
    | wrong_value_kind
    | malformed_value
    | stale_state
    | removed_option
    | unavailable_option
    | invalid_cardinality
    | invalid_combination
    | concurrent_state_change
    | out_of_range
    | unsupported_granularity
    | duplicate_proposal
    | queue_pressure
    | result_pressure
    | unknown_proposal

type InteractionBoundKind =
    inclusive
    | exclusive

type OptionAvailability =
    available
    | unavailable {
        reason_code: Text <= 128B not in [""]
    }

type InteractionApplicationOutcome =
    accepted {
        resulting_state_identity: Text <= 128B not in [""]
    }
    | refused {
        reason_code: Text <= 128B not in [""]
    }
    | failed {
        reason_code: Text <= 128B not in [""]
    }
    | cancelled

type RealizationRangePolicy =
    refuse
    | clamp

type ScalarQuantization =
    exact
    | nearest

type InputPressurePolicy =
    coalesce_latest_state
    | ordered_transitions

type InputPressure = {
    coalesced: U64
    dropped: U64
    policy: InputPressurePolicy
    queue_capacity: U64 in 1..
}

type InputButtonPhase =
    pressed
    | released

type InputButtonTransition = {
    button_identity: Text
    phase: InputButtonPhase
    sequence: U64
}

type InputButtonState = {
    button_identity: Text
    pressed: Boolean
}

type InputButtonSlot =
    button InputButtonState
    | unused
type InputButtonSlots = collection InputButtonSlot = 8

type InputAxisState = {
    axis_identity: Text
    range_profile: Text
    value: Ratio
}

type InputAxisSlot =
    axis InputAxisState
    | unused
type InputAxisSlots = collection InputAxisSlot = 4

type InputSurfacePoint = {
    frame: Text
    x: Ratio
    y: Ratio
}

type InputSurfaceVector = {
    frame: Text
    x: Ratio
    y: Ratio
}

type PointerEvent = {
    buttons: InputButtonSlots
    delta: InputSurfaceVector
    position: InputSurfacePoint
    pressure: InputPressure
    sequence: U64
}

type TouchContactPhase =
    begin
    | end
    | moving

type TouchContact = {
    contact_identity: Text
    phase: TouchContactPhase
    position: InputSurfacePoint
    pressure: Ratio
}

type TouchContactSlot =
    contact TouchContact
    | unused
type TouchContacts = collection TouchContactSlot = 5

type TouchFrame = {
    contacts: TouchContacts
    pressure: InputPressure
    sequence: U64
}

type RotaryDirection =
    clockwise
    | counterclockwise

type RotaryStep = {
    control_identity: Text
    direction: RotaryDirection
    sequence: U64
    steps: U64
}

type GamepadState = {
    axes: InputAxisSlots
    buttons: InputButtonSlots
    pressure: InputPressure
    sequence: U64
    source_profile: Text
}

# Explicit temporal selection before memory-informed interpretation. Missing
# and unavailable sources carry absent time, never a fabricated observation.
type ExperienceSituationTime =
    at {
        instant: TemporalInstant
    }
    | absent

type ExperienceSituationObservation = {
    evidence: ExperienceEvidenceItem
    time: ExperienceSituationTime
}
type ExperienceSituationObservations = sequence ExperienceSituationObservation <= 8

type ExperienceSituationFrame = {
    reference: TemporalInstant
    policy: ExperienceTemporalPolicy
    selection: ExperienceEvidenceSelection
    observations: ExperienceSituationObservations
    retain: Boolean
}
