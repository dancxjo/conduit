# Authoritative portable human-experience meaning. Rust consumes generated bindings.

type KeyTransition =
    pressed
    | released

type KeyModifiers = U8

type KeyEvent = {
    usage: U8
    transition: KeyTransition
    left_control_after: Boolean
    left_shift_after: Boolean
    left_alt_after: Boolean
    left_gui_after: Boolean
    right_control_after: Boolean
    right_shift_after: Boolean
    right_alt_after: Boolean
    right_gui_after: Boolean
    where (.usage >= 4 && .usage <= 164) || (.usage >= 224 && .usage <= 231)
    where .usage != 224 || .left_control_after == (.transition is pressed)
    where .usage != 225 || .left_shift_after == (.transition is pressed)
    where .usage != 226 || .left_alt_after == (.transition is pressed)
    where .usage != 227 || .left_gui_after == (.transition is pressed)
    where .usage != 228 || .right_control_after == (.transition is pressed)
    where .usage != 229 || .right_shift_after == (.transition is pressed)
    where .usage != 230 || .right_alt_after == (.transition is pressed)
    where .usage != 231 || .right_gui_after == (.transition is pressed)
}

type KeymapRefusal =
    unknown_compose_sequence
    | empty_unicode_entry
    | unicode_entry_overflow
    | invalid_unicode_scalar

# One Unicode scalar emitted by the portable keymap. The Rust binding encodes
# it into at most four UTF-8 bytes at the consumer boundary without allocation.
type TextFragment =
    basic U32 in 0..=55295
    | supplementary U32 in 57344..=1114111

type KeymapDisposition =
    no_text
    | text TextFragment
    | cancelled
    | refused KeymapRefusal

type HumanMediaKind =
    camera
    | microphone

type VisualImpressionDisposition =
    complete
    | truncated {
        original_bytes: U32
    }

type ImageTextMetadata = {
    key: Text <= 64B not in [""]
    value: Text <= 256B
}

type ImageRegion = {
    x: U16
    y: U16
    width: U16
    height: U16
}

type ImageObservationReference = {
    content: ResourceRef
    width: U16 in 1..=4096
    height: U16 in 1..=4096
}

type ImageObservationRefusal =
    invalid_resource
    | wrong_profile
    | invalid_dimensions
    | content_too_large

type ImageTextMetadataEntries = sequence ImageTextMetadata <= 8

type ImageTextContentDigest = collection U8 = 32

type ImageTextRecord = {
    image: ImageObservationReference
    caption: Text <= 512B not in [""]
    metadata: ImageTextMetadataEntries
    content_digest: ImageTextContentDigest
}

type ImageTextRefusal =
    invalid_image
    | wrong_image_profile
    | invalid_image_dimensions
    | image_too_large
    | empty_caption
    | caption_too_large
    | too_many_metadata_entries
    | empty_metadata_key
    | metadata_key_too_large
    | metadata_value_too_large
    | duplicate_metadata_key
    | integrity_mismatch

code human/key-transition = KeyTransition as u8

type ChordPhase =
    triggered

code human/chord-phase = ChordPhase as u8 from 2

type CoreChordId =
    cancel_or_escape
    | clear_or_refresh
    | repeat_or_replan
    | palette
    | inspect
    | plan
    | command
    | activate

code human/core-chord-id = CoreChordId as u8 from 1

type ControlChordModifier =
    left
    | right
    | both

# The eight exact chord meanings. Usage, phase and compact-code fields are
# derived compatibility facts rather than redundant authored payload.
type ChordInfo =
    cancel_or_escape ControlChordModifier
    | clear_or_refresh ControlChordModifier
    | repeat_or_replan ControlChordModifier
    | palette
    | inspect
    | plan
    | command
    | activate

type ExperienceDomain =
    visual
    | auditory
    | location
    | body_state
    | human_utterance
    | recollection

type ExperienceOrigin =
    observation
    | human_reported
    | remembered
    | model_derived
    | imagined

type ExperienceTemporalRole =
    current
    | recent
    | stale
    | historical

type ExperienceTemporalPolicy = {
    maximum_current_age_ticks: U64
    maximum_recent_age_ticks: U64
    where .maximum_current_age_ticks < .maximum_recent_age_ticks
}

type ExperienceTemporalRefusal =
    invalid_policy
    | invalid_instant
    | incomparable_clock
    | interval_overflow
    | future_observation
    | indeterminate_age

type ExperienceRefusal =
    invalid-limits
    | empty-identity
    | duplicate-identity
    | item-capacity
    | temporal-role-capacity
    | domain-capacity
    | model-derived-capacity
    | selected-memory-capacity
    | item-bytes
    | encoded-bytes
    | source-capacity
    | duplicate-source
    | relationship-capacity
    | unknown-relationship-endpoint
    | duplicate-relationship
    | conflict-alternative-capacity
    | invalid-epistemic-combination
    | identity-bytes
    | invalid-source
    | invalid-time
    | invalid-temporal-context
    | temporal-classification ExperienceTemporalRefusal
    | temporal-role-mismatch
    | arithmetic-overflow

type ExperienceUpdateRefusal =
    invalid-limits
    | pending-update-capacity
    | stale-revision
    | future-revision
    | revision-overflow
    | no-semantic-change
    | experience ExperienceRefusal

type CurrentExperienceInspectionError =
    empty-item-identity
    | unknown-item

type ExperienceAvailability =
    present
    | not_observed
    | source_unavailable

type ExperienceCertainty =
    certain
    | uncertain

type ExperienceRelationKind =
    relates
    | contradicts

type SourceAvailability =
    present
    | missing
    | unavailable

# Inputs remain nominally distinct because their provenance is meaning, even
# though each source carries the same finite observation shape.
type ExperienceHumanInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceBodyInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceMemoryInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceInferenceInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceHypothesisInput = {
    item_identity: Text
    source_identity: Text
    observed_at: Text
    content: Text
}

type ExperienceSourceStatus = {
    source_identity: Text
    availability: SourceAvailability
}

type CurrentExperienceProjection = {
    revision: Count
    item_identities: collection Text = 32
    provenance_revision: Text
}

type VisualEvidenceClass =
    deterministic_derived
    | statistical_candidate
    | model_derived

type VisualExperienceRelationKind =
    relates
    | supports
    | contradicts

type VisualObservationRefusal =
    invalid-image
    | wrong-image-profile
    | invalid-image-dimensions
    | image-too-large
    | invalid-region
    | empty-text
    | text-bound
    | confidence-bound
    | empty-identity
    | identity-bound
    | invalid-observation-time
    | wrong-evidence-class
    | observation-ref-bound
    | duplicate-observation-ref

type VisualImpressionRefusal =
    invalid-source-image
    | empty-text
    | text-bound
    | empty-identity
    | identity-bound
    | observation-ref-bound
    | duplicate-observation-ref
    | invalid-truncation
    | wrong-evidence-class
    | invalid-provenance VisualObservationRefusal

type VisualExperienceRefusal =
    invalid-limits
    | invalid-source-image
    | wrong-source-image
    | observation-capacity
    | observation-kind-capacity
    | text-capacity
    | duplicate-observation
    | invalid-observation VisualObservationRefusal
    | invalid-impression VisualImpressionRefusal
    | relation-capacity
    | unknown-relation-endpoint
    | self-relation
    | duplicate-relation
    | arithmetic-overflow

type ExperienceSourceRefusal =
    invalid-visual-observation VisualObservationRefusal
    | invalid-visual-impression VisualImpressionRefusal
    | empty-value
    | value-bound
    | invalid-identity
    | invalid-time
    | source-bound

type InteractionRefusal =
    invalid_identity
    | invalid_contract
    | invalid_domain
    | invalid_current_state
    | value_bound_exceeded
    | wrong_value_kind
    | malformed_value
    | stale_state
    | removed_option
    | unavailable_option
    | invalid_cardinality
    | invalid_combination
    | concurrent_state_change
    | out_of_range
    | unsupported_granularity
    | duplicate_proposal
    | queue_pressure
    | result_pressure
    | unknown_proposal

type InteractionBoundKind =
    inclusive
    | exclusive

type OptionAvailability =
    available
    | unavailable {
        reason_code: Text <= 128B not in [""]
    }

type InteractionApplicationOutcome =
    accepted {
        resulting_state_identity: Text <= 128B not in [""]
    }
    | refused {
        reason_code: Text <= 128B not in [""]
    }
    | failed {
        reason_code: Text <= 128B not in [""]
    }
    | cancelled

type RealizationRangePolicy =
    refuse
    | clamp

type ScalarQuantization =
    exact
    | nearest

type InputPressurePolicy =
    coalesce_latest_state
    | ordered_transitions

type InputPressure = {
    coalesced: U64
    dropped: U64
    policy: InputPressurePolicy
    queue_capacity: U64 in 1..
}

type InputButtonPhase =
    pressed
    | released

type InputButtonTransition = {
    button_identity: Text
    phase: InputButtonPhase
    sequence: U64
}

type InputButtonState = {
    button_identity: Text
    pressed: Boolean
}

type InputButtonSlot =
    button InputButtonState
    | unused
type InputButtonSlots = collection InputButtonSlot = 8

type InputAxisState = {
    axis_identity: Text
    range_profile: Text
    value: Ratio
}

type InputAxisSlot =
    axis InputAxisState
    | unused
type InputAxisSlots = collection InputAxisSlot = 4

type InputSurfacePoint = {
    frame: Text
    x: Ratio
    y: Ratio
}

type InputSurfaceVector = {
    frame: Text
    x: Ratio
    y: Ratio
}

type PointerEvent = {
    buttons: InputButtonSlots
    delta: InputSurfaceVector
    position: InputSurfacePoint
    pressure: InputPressure
    sequence: U64
}

type TouchContactPhase =
    begin
    | end
    | moving

type TouchContact = {
    contact_identity: Text
    phase: TouchContactPhase
    position: InputSurfacePoint
    pressure: Ratio
}

type TouchContactSlot =
    contact TouchContact
    | unused
type TouchContacts = collection TouchContactSlot = 5

type TouchFrame = {
    contacts: TouchContacts
    pressure: InputPressure
    sequence: U64
}

type RotaryDirection =
    clockwise
    | counterclockwise

type RotaryStep = {
    control_identity: Text
    direction: RotaryDirection
    sequence: U64
    steps: U64
}

type GamepadState = {
    axes: InputAxisSlots
    buttons: InputButtonSlots
    pressure: InputPressure
    sequence: U64
    source_profile: Text
}
