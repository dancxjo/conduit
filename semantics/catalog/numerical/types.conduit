# Exact source meaning and admitted absolute numerical error.
type NumericalRequest = {
    value: MathematicalValue
    maximum-error: MathematicalValue
}

# The selected operation order uses these explicit rounding directions.
type NumericalRounding =
    nearest_ties_even
    | toward_zero
    | toward_positive
    | toward_negative

type NumericalErrorClaim =
    exact_distance
    | certified_bound

type NumericalRepresentation =
    exact_rational
    | outward_i64
    | binary64 {
        target: F64 finite
        rounding: NumericalRounding
        any-inexact: Boolean
        any-tiny-inexact: Boolean
        step-count: U8
        error-claim: NumericalErrorClaim
    }

type NumericalResult = {
    source: MathematicalValue
    lower: MathematicalValue
    upper: MathematicalValue
    maximum-error: MathematicalValue
    representation: NumericalRepresentation
}

# Explicit IEEE operations return exceptions as values, independently of
# mathematical projection error or observation uncertainty.
type IeeeBinary64Operation =
    add
    | subtract
    | multiply
    | divide
type IeeeBinary64QuietPredicate =
    equal
    | less
    | less_equal
    | unordered
type IeeeBinary64Flags = {
    invalid: Boolean
    divide-by-zero: Boolean
    overflow: Boolean
    underflow: Boolean
    inexact: Boolean
}
type IeeeBinary64Result = {
    value: F64
    flags: IeeeBinary64Flags
}
type IeeeBinary64ComparisonResult = {
    value: Boolean
    flags: IeeeBinary64Flags
}

# Qualified numerical output retains its exact physical source separately from
# the selected numerical representation. It is not an exact Quantity alias.
type NearQuantityRole =
    linear
    | point
    | delta
type NearQuantityErrorClaim =
    exact_distance
    | certified_bound
type NearQuantityRepresentation =
    exact_rational MathematicalValue
    | binary32 {
        target: F32 finite
        rounding: NumericalRounding
    }
type NearQuantity = {
    source: MathematicalValue
    source-wire: Bytes <= 1800B
    requested-limit: Quantity
    unit: Unit
    role: NearQuantityRole
    maximum-error: MathematicalValue
    limit: MathematicalValue
    claim: NearQuantityErrorClaim
    representation: NearQuantityRepresentation
}
