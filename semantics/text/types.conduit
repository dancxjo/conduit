# Authoritative portable text meaning. Rust consumes generated bindings.

type MorseKeyPhase =
    pressed
    | released

type MorseSegment = {
    level: Boolean
    units: U8
}

type MorseSegments = sequence MorseSegment in 1..=320

type MorsePattern = {
    unit-millis: U16 in 40..=2000
    segments: MorseSegments
}

type MorseKeyTransition = {
    clock_basis: Text <= 96B not in [""]
    monotonic_micros: U64
    phase: MorseKeyPhase
    sequence: U64
}

type AddressDetectionRefusal =
    recognized_text_too_large

type AddressName = Text <= 64B not in [""]

type AddressNames = sequence AddressName in 1..=8

type AddressSet = {
    names: AddressNames
}

type AddressDetection =
    not_addressed
    | addressed {
        matched_name_index: U8 in 0..=7
        utterance: Text <= 256B
    }

type AddressConfigurationError =
    empty
    | too_many_names
    | empty_name
    | name_too_large
    | invalid_name
    | duplicate_name

type AddressValueError =
    bound_exceeded
    | malformed
    | non_canonical
    | invalid_value

type MorseError =
    empty
    | text_too_long
    | unsupported_character
    | invalid_word_gap
    | invalid_unit_millis
    | segment_capacity
    | output_capacity
    | malformed_encoding
    | non_canonical_encoding
    | invalid_pattern

type MorseKeyRefusal =
    invalid_unit_millis
    | invalid_transition_capacity
    | invalid_clock_basis
    | clock_basis_mismatch
    | duplicate_sequence
    | sequence_gap
    | non_monotonic_time
    | wrong_phase
    | ambiguous_duration
    | transition_pressure
    | empty
    | incomplete
    | cancelled
    | invalid_pattern {
        error: MorseError
    }
