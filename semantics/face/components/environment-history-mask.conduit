# Bounded history renderer. Source owns selection; Hosts own realization and acknowledgement.
plot environment-history-component (
 look: LookInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Room conditions history", recipe = {gutter: 12, identity: "conduit.face/environment-history@1", maximum_columns: 1, reflow_width: 720, regions: [{group: 0, identity: "history", maximum_subjects: 1, selector: bound({subject: "environment-history", role: role("Collection"), properties: [{name: "schema", kind: "text", value_kind: ""}, {name: "clock", kind: "text", value_kind: ""}, {name: "producer-host", kind: "identity", value_kind: ""}, {name: "producer-boot", kind: "identity", value_kind: ""}, {name: "producer-plan", kind: "identity", value_kind: ""}, {name: "producer-play", kind: "identity", value_kind: ""}, {name: "visible-samples", kind: "count", value_kind: ""}, {name: "samples-outside-view", kind: "count", value_kind: ""}], actions: []})}], version: 1}, look = look)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}

plot environment-history-mask (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: environment-history-component(look = {generative: none(empty), identity: "conduit.look/editorial-compact@1", quantity: none(empty), spoken: none(empty), version: 3, visual: some({expression: {density: compact(empty), identity: "conduit.look/editorial-compact@1", motion: none(empty), palette: editorial(empty), text_scale_percent: 100, typography: editorial(empty), version: 2}, tokens: {background: {blue: 231, green: 240, red: 244}, bootstrap_surface: {blue: 245, green: 252, red: 255}, emphasis: {blue: 46, green: 69, red: 121}, failure: {blue: 50, green: 40, red: 163}, focus: {blue: 158, green: 92, red: 0}, focus_width_px: 3, line_height_percent: 150, muted: {blue: 83, green: 102, red: 113}, radius_control_px: 7, radius_panel_px: 10, reading_paper: {blue: 245, green: 252, red: 255}, space_control_block_px: 9, space_control_inline_px: 12, space_panel_px: 16, space_unit_px: 4, structure_primary: {blue: 82, green: 99, red: 56}, structure_secondary: {blue: 153, green: 173, red: 183}, success: {blue: 66, green: 102, red: 40}, surface: {blue: 245, green: 252, red: 255}, text_primary: {blue: 41, green: 45, red: 41}, text_secondary: {blue: 87, green: 96, red: 91}, type_body_px: 16, type_small_px: 14, warning: {blue: 0, green: 80, red: 128}, workbench_canvas: {blue: 231, green: 240, red: 244}}})})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
