# Checked component structure over exact semantic Face subjects. The stable
# template bindings are specialized by the source owner before ordinary
# checking/planning; they are neither deployed subject IDs nor runtime guesses.
# The complete generic fallback keeps all unmatched meaning and actions.
plot ambient-clock-component (
    look: LookInfo
    >> face: Face
    show: Show >>
    interaction: FaceInteraction...| >>
) {
    renderer: face/component-mask(label = "Picture frame", recipe = {gutter: 12, identity: "conduit.face/ambient-clock@1", maximum_columns: 1, reflow_width: 720, regions: [ {group: 0, identity: "clock", maximum_subjects: 1, selector: bound({subject: "clock/date-time", role: semantic("time/civil-observation"), properties: [{name: "local-date", kind: "text", value_kind: ""}, {name: "local-time", kind: "text", value_kind: ""}, {name: "timezone", kind: "text", value_kind: ""}], actions: []})}, {group: 1, identity: "weather", maximum_subjects: 1, selector: bound({subject: "clock/weather", role: semantic("weather/conditions"), properties: [{name: "availability", kind: "text", value_kind: ""}], actions: []})}, {group: 2, identity: "image", maximum_subjects: 1, selector: bound({subject: "wallpaper/image", role: semantic("media/image"), properties: [{name: "image", kind: "typed", value_kind: "structured-info/profile-12743e581217140cd7bc442b6846bbec60e1b05cd3ba5dcc483c6a402b27158a@1"}], actions: []})} ], version: 1}, layout = {candidates: [{nodes: [column({block_alignment: stretch(empty), break_policy: accessible_continuation(empty), children: [{block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 1}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 4}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 5}], gap_em_sixteenths: 8, inline_grow: 0, inline_alignment: stretch(empty), padding_em_sixteenths: 8, inline_shrink: 1, minimum_inline_em_sixteenths: 0}), row({block_alignment: stretch(empty), break_policy: accessible_continuation(empty), children: [{block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 2}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 3}], gap_em_sixteenths: 8, inline_grow: 0, inline_alignment: stretch(empty), padding_em_sixteenths: 0, inline_shrink: 1, minimum_inline_em_sixteenths: 0}), region(0), region(1), region(2), fallback(empty)], root: 0}, {nodes: [column({block_alignment: stretch(empty), break_policy: accessible_continuation(empty), children: [{block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 1}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 2}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 3}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 4}], gap_em_sixteenths: 8, inline_grow: 0, inline_alignment: stretch(empty), padding_em_sixteenths: 8, inline_shrink: 1, minimum_inline_em_sixteenths: 0}), region(0), region(1), region(2), fallback(empty)], root: 0}], identity: "conduit.face/ambient-clock-layout@1", recipe_identity: "conduit.face/ambient-clock@1", version: 1}, look = look)
    face >> renderer.face
    renderer.show >> show
    renderer.interaction >> interaction
}

