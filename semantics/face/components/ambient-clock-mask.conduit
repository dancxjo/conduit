# Checked component structure over exact semantic Face subjects. The stable
# template bindings are specialized by the source owner before ordinary
# checking/planning; they are neither deployed subject IDs nor runtime guesses.
# The complete generic fallback keeps all unmatched meaning and actions.
plot ambient-clock-component (
    look: LookInfo
    >> face: Face
    show: Show >>
    interaction: FaceInteraction...| >>
) {
    renderer: face/component-mask(label = "Picture frame", recipe = {gutter: 12, identity: "conduit.face/ambient-clock@1", maximum_columns: 1, reflow_width: 720, regions: [
        {group: 0, identity: "clock", maximum_subjects: 1, selector: bound({subject: "clock/date-time", role: semantic("time/civil-observation"), properties: [{name: "local-date", kind: "text", value_kind: ""}, {name: "local-time", kind: "text", value_kind: ""}, {name: "timezone", kind: "text", value_kind: ""}], actions: []})},
        {group: 1, identity: "weather", maximum_subjects: 1, selector: bound({subject: "clock/weather", role: semantic("weather/conditions"), properties: [{name: "availability", kind: "text", value_kind: ""}], actions: []})},
        {group: 2, identity: "image", maximum_subjects: 1, selector: bound({subject: "wallpaper/image", role: semantic("media/image"), properties: [{name: "image", kind: "typed", value_kind: "structured-info/profile-12743e581217140cd7bc442b6846bbec60e1b05cd3ba5dcc483c6a402b27158a@1"}], actions: []})}
    ], version: 1}, layout = {candidates: [{nodes: [
        column({block_alignment: stretch(empty), break_policy: accessible_continuation(empty), children: [
            {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 1},
            {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 2},
            {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 3},
            {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 4}
        ], gap_em_sixteenths: 8, inline_grow: 0, inline_alignment: stretch(empty), padding_em_sixteenths: 8, inline_shrink: 1, minimum_inline_em_sixteenths: 0}),
        region(0), region(1), region(2), fallback(empty)
    ], root: 0}], identity: "conduit.face/ambient-clock-layout@1", recipe_identity: "conduit.face/ambient-clock@1", version: 1}, look = look)
    face >> renderer.face
    renderer.show >> show
    renderer.interaction >> interaction
}

plot ambient-clock-mask (
    >> face: Face
    show: Show >>
    interaction: FaceInteraction...| >>
) {
    component: ambient-clock-component(look = {generative: some({register: neutral(empty), verbosity: brief(empty)}), identity: "conduit.look/picture-frame@1", spoken: some({delivery: neutral(empty), verbosity: brief(empty)}), version: 2, visual: some({expression: {density: compact(empty), identity: "conduit.look/picture-frame@1", motion: none(empty), palette: phosphor(empty), text_scale_percent: 100, typography: editorial(empty), version: 2}, tokens: {background: {blue: 11, green: 7, red: 5}, bootstrap_surface: {blue: 22, green: 13, red: 9}, emphasis: {blue: 37, green: 163, red: 233}, failure: {blue: 114, green: 114, red: 255}, focus: {blue: 0, green: 196, red: 244}, focus_width_px: 3, line_height_percent: 125, muted: {blue: 25, green: 76, red: 140}, radius_control_px: 6, radius_panel_px: 9, reading_paper: {blue: 28, green: 18, red: 12}, space_control_block_px: 7, space_control_inline_px: 10, space_panel_px: 13, space_unit_px: 4, structure_primary: {blue: 246, green: 216, red: 13}, structure_secondary: {blue: 135, green: 31, red: 10}, success: {blue: 155, green: 214, red: 99}, surface: {blue: 22, green: 13, red: 9}, text_primary: {blue: 247, green: 210, red: 147}, text_secondary: {blue: 201, green: 142, red: 87}, type_body_px: 28, type_small_px: 14, warning: {blue: 113, green: 189, red: 242}, workbench_canvas: {blue: 11, green: 7, red: 5}}})})
    face >> component.face
    component.show >> show
    component.interaction >> interaction
}

