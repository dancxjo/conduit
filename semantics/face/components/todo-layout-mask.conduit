# Version-three checked composition; ordinary @2 sources remain unchanged.
plot todo-component-flat (
 expression: VisualExpressionInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Component view", recipe = {gutter: 12, identity: "conduit.face/todo-flat@1", maximum_columns: 1, reflow_width: 720, regions: [{group: 0, identity: "collection", maximum_subjects: 1, selector: role("Collection")}, {group: 0, identity: "items", maximum_subjects: 20, selector: role("Item")}, {group: 0, identity: "entry", maximum_subjects: 1, selector: role("TextEntry")}], version: 1}, layout = { candidates: [ {nodes: [ column({block_alignment: stretch(empty), break_policy: accessible_continuation(empty), children: [{block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 1}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 2}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 3}, {block_span: 1, block_track: 0, inline_span: 1, inline_track: 0, node: 4}], gap_em_sixteenths: 8, inline_grow: 0, inline_alignment: stretch(empty), padding_em_sixteenths: 0, inline_shrink: 1}), fallback(empty), region(0), region(1), region(2) ], root: 0} ], identity: "conduit.face/todo-flat-layout@1", recipe_identity: "conduit.face/todo-flat@1", version: 1 }, expression = expression)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}
plot todo-mask-flat-compact (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: todo-component-flat(expression = {density: compact(empty), identity: "conduit.face/compact@1", motion: none(empty), palette: phosphor(empty), text_scale_percent: 100, typography: engineering(empty), version: 2})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
plot todo-mask-flat-spacious (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: todo-component-flat(expression = {density: spacious(empty), identity: "conduit.face/spacious@1", motion: none(empty), palette: editorial(empty), text_scale_percent: 125, typography: editorial(empty), version: 2})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
