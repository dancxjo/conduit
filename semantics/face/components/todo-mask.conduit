plot todo-component-flat (
 expression: VisualExpressionInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Component view", recipe = {gutter: 12, identity: "conduit.face/todo-flat@1", maximum_columns: 1, reflow_width: 720, regions: [{group: 0, identity: "collection", maximum_subjects: 1, selector: role("Collection")}, {group: 0, identity: "items", maximum_subjects: 20, selector: role("Item")}, {group: 0, identity: "entry", maximum_subjects: 1, selector: role("TextEntry")}], version: 1}, expression = expression)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}
plot todo-mask-flat-compact (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: todo-component-flat(expression = {density: compact(empty), identity: "conduit.face/compact@1", motion: none(empty), palette: phosphor(empty), text_scale_percent: 100, typography: engineering(empty), version: 2})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
plot todo-mask-flat-spacious (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: todo-component-flat(expression = {density: spacious(empty), identity: "conduit.face/spacious@1", motion: none(empty), palette: editorial(empty), text_scale_percent: 125, typography: editorial(empty), version: 2})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
plot todo-component-grouped (
 expression: VisualExpressionInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Component view", recipe = {gutter: 12, identity: "conduit.face/todo-grouped@1", maximum_columns: 2, reflow_width: 720, regions: [{group: 0, identity: "collection", maximum_subjects: 1, selector: role("Collection")}, {group: 1, identity: "items", maximum_subjects: 20, selector: role("Item")}, {group: 2, identity: "entry", maximum_subjects: 1, selector: role("TextEntry")}], version: 1}, expression = expression)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}
