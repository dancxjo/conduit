plot creche-component-single (
 expression: VisualExpressionInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Crèche", recipe = {gutter: 12, identity: "conduit.face/creche-single@1", maximum_columns: 1, reflow_width: 720, regions: [{group: 0, identity: "fields", maximum_subjects: 3, selector: text_entry(32)}, {group: 0, identity: "information", maximum_subjects: 2, selector: collection({mode: "information", maximum_items: 16})}, {group: 0, identity: "exclusive", maximum_subjects: 1, selector: collection({mode: "exclusive", maximum_items: 32})}, {group: 0, identity: "independent", maximum_subjects: 1, selector: collection({mode: "independent", maximum_items: 16})}, {group: 0, identity: "plots", maximum_subjects: 16, selector: role("Plot")}, {group: 0, identity: "review", maximum_subjects: 20, selector: role("Status")}], version: 1}, expression = expression)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}
plot creche-mask-single (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: creche-component-single(expression = {density: compact(empty), identity: "conduit.face/compact@1", motion: none(empty), palette: phosphor(empty), text_scale_percent: 100, version: 1})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
plot creche-component-columns (
 expression: VisualExpressionInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Crèche", recipe = {gutter: 12, identity: "conduit.face/creche-columns@1", maximum_columns: 2, reflow_width: 720, regions: [{group: 0, identity: "fields", maximum_subjects: 3, selector: text_entry(32)}, {group: 2, identity: "information", maximum_subjects: 2, selector: collection({mode: "information", maximum_items: 16})}, {group: 0, identity: "exclusive", maximum_subjects: 1, selector: collection({mode: "exclusive", maximum_items: 32})}, {group: 1, identity: "independent", maximum_subjects: 1, selector: collection({mode: "independent", maximum_items: 16})}, {group: 1, identity: "plots", maximum_subjects: 16, selector: role("Plot")}, {group: 2, identity: "review", maximum_subjects: 20, selector: role("Status")}], version: 1}, expression = expression)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}
plot creche-mask-columns (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: creche-component-columns(expression = {density: compact(empty), identity: "conduit.face/compact@1", motion: none(empty), palette: phosphor(empty), text_scale_percent: 100, version: 1})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
