plot creche-component-single (
 expression: VisualExpressionInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Crèche", recipe = {gutter: 12, identity: "conduit.face/creche-single@1", maximum_columns: 1, reflow_width: 720, regions: [{group: 0, identity: "body-name", maximum_subjects: 1, selector: action_target("creche.name")}, {group: 0, identity: "naming", maximum_subjects: 1, selector: action_target("creche.naming")}, {group: 0, identity: "search", maximum_subjects: 1, selector: action_target("creche.search")}, {group: 0, identity: "selection", maximum_subjects: 1, selector: role("Collection")}, {group: 0, identity: "plots", maximum_subjects: 16, selector: role("Plot")}, {group: 0, identity: "review", maximum_subjects: 20, selector: role("Status")}], version: 1}, expression = expression)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}
plot creche-mask-single (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: creche-component-single(expression = {density: compact(empty), identity: "conduit.face/compact@1", motion: none(empty), palette: phosphor(empty), text_scale_percent: 100, typography: editorial(empty), version: 2})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}
