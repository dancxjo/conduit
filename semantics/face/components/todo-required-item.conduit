# One source-backed Todo item contract. The surrounding Mask still preserves
# every unmatched subject and acknowledges the final Show.
plot todo-required-item (
 look: LookInfo
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 renderer: face/component-mask(label = "Todo item", recipe = {gutter: 12, identity: "conduit.face/todo-required-item@1", maximum_columns: 1, reflow_width: 720, regions: [{group: 0, identity: "item", maximum_subjects: 1, selector: bound({subject: "todo/item/task-1", role: role("Item"), properties: [{name: "complete", kind: "flag", value_kind: ""}], actions: [{identity: "todo.complete.task-1", intent: "todo/complete@1", arguments: []}]})}], version: 1}, look = look)
 face >> renderer.face
 renderer.show >> show
 renderer.interaction >> interaction
}

plot todo-mask-required-item-compact (
 >> face: Face
 show: Show >>
 interaction: FaceInteraction...| >>
) {
 component: todo-required-item(look = {generative: some({register: neutral(empty), verbosity: brief(empty)}), identity: "conduit.look/phosphor@1", spoken: some({delivery: neutral(empty), verbosity: brief(empty)}), version: 2, visual: some({expression: {density: compact(empty), identity: "conduit.look/phosphor@1", motion: none(empty), palette: phosphor(empty), text_scale_percent: 100, typography: editorial(empty), version: 2}, tokens: {background: {blue: 11, green: 7, red: 5}, bootstrap_surface: {blue: 22, green: 13, red: 9}, emphasis: {blue: 37, green: 163, red: 233}, failure: {blue: 114, green: 114, red: 255}, focus: {blue: 0, green: 196, red: 244}, focus_width_px: 3, line_height_percent: 150, muted: {blue: 25, green: 76, red: 140}, radius_control_px: 6, radius_panel_px: 9, reading_paper: {blue: 28, green: 18, red: 12}, space_control_block_px: 7, space_control_inline_px: 10, space_panel_px: 13, space_unit_px: 4, structure_primary: {blue: 246, green: 216, red: 13}, structure_secondary: {blue: 135, green: 31, red: 10}, success: {blue: 155, green: 214, red: 99}, surface: {blue: 22, green: 13, red: 9}, text_primary: {blue: 247, green: 210, red: 147}, text_secondary: {blue: 201, green: 142, red: 87}, type_body_px: 16, type_small_px: 14, warning: {blue: 113, green: 189, red: 242}, workbench_canvas: {blue: 11, green: 7, red: 5}}})})
 face >> component.face
 component.show >> show
 component.interaction >> interaction
}

