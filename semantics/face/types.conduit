# Authoritative portable face meaning. Rust consumes generated bindings.

type Point2 = {
    frame: Text
    x: Quantity
    y: Quantity
}

type Point3 = {
    frame: Text
    x: Quantity
    y: Quantity
    z: Quantity
}

type Vector2 = {
    frame: Text
    x: Quantity
    y: Quantity
}

type Vector3 = {
    frame: Text
    x: Quantity
    y: Quantity
    z: Quantity
}

type Extent2 = {
    height: Quantity
    width: Quantity
}

type Rect2 = {
    extent: Extent2
    origin: Point2
}

type Transform2 = {
    from_frame: Text
    offset_x: Quantity
    offset_y: Quantity
    to_frame: Text
}

type Path2Four = {
    points: collection Point2 = 4
}

type RoboticsPose2 = {
    heading: Quantity
    position: Point2
}

type ImageRegion2 = {
    label: Text
    region: Rect2
}

type ImagePixelExtent = {
    height: U64
    width: U64
}

type ImageFormat =
    gray8
    | jpeg
    | png
    | rgba8

type ImageColorProfile =
    absent
    | named Text

type ImageResource = {
    color_profile: ImageColorProfile
    content: ResourceRef
    extent: ImagePixelExtent
    format: ImageFormat
    image_frame: Text
}

type VisionEvidenceClass =
    heuristic
    | model_derived

type VisionProvenance = {
    evidence_class: VisionEvidenceClass
    profile: Text
    revision: Text
    source: Text
}

type VisionKeypoint = {
    confidence: Ratio
    name: Text
    point: Point2
}

type VisionLandmarkSlot =
    keypoint VisionKeypoint
    | unused

type VisionLandmarks = collection VisionLandmarkSlot = 8

type VisionRgbSample = {
    blue: U8
    green: U8
    point: Point2
    red: U8
}

type VisionColorSample =
    absent
    | rgb VisionRgbSample

type VisionDetection = {
    classification: Text
    color_sample: VisionColorSample
    confidence: Ratio
    image_identity: Text
    landmarks: VisionLandmarks
    provenance: VisionProvenance
    region: Rect2
}

type VisionDetectionSlot =
    detection VisionDetection
    | unused

type VisionDetectionsFour = collection VisionDetectionSlot = 4

type VisionPixelRegion = {
    height: U64
    width: U64
    x: U64
    y: U64
}

type VisionOptionalPixelRegion =
    absent
    | present VisionPixelRegion

type VisionObservationEvidenceClass =
    deterministic_derived
    | model_derived
    | statistical_candidate

type VisionObservationProvenance = {
    artifact: Text
    evidence_class: VisionObservationEvidenceClass
    implementation: Text
    observation_sign: Text
    observed_at: TemporalInstant
    provider_instance: Text
    run: Text
}

type VisionObjectObservation = {
    candidate_label: Text
    confidence_permille: U64
    provenance: VisionObservationProvenance
    region: VisionPixelRegion
    source_image: ImageObservationReference
}

type VisionMotionObservation = {
    change_permille: U64
    changed_region: VisionPixelRegion
    provenance: VisionObservationProvenance
    source_image: ImageObservationReference
}

type VisionVisibleTextObservation = {
    confidence_permille: U64
    provenance: VisionObservationProvenance
    region: VisionOptionalPixelRegion
    source_image: ImageObservationReference
    text: Text
}

type VisionObservationSigns = sequence Text <= 16

type VisionTrackObservation = {
    continuity_confidence_permille: U64
    contributing_observation_signs: VisionObservationSigns
    current_region: VisionPixelRegion
    provenance: VisionObservationProvenance
    source_image: ImageObservationReference
    track: Text
    tracking_context: Text
}

type VisionMotionsFour = sequence VisionMotionObservation <= 4
type VisionObjectObservations = sequence VisionObjectObservation <= 4
type VisionTextsEight = sequence VisionVisibleTextObservation <= 8
type VisionTracksFour = sequence VisionTrackObservation <= 4

type VisualImpressionDisposition =
    complete
    | truncated U64

type VisualSelectedObservationSigns = sequence Text <= 24

type VisualImpression = {
    disposition: VisualImpressionDisposition
    model: Text
    prompt_contract_revision: Text
    provenance: VisionObservationProvenance
    selected_observation_signs: VisualSelectedObservationSigns
    source_image: ImageObservationReference
    text: Text
}

type VisualExperienceObservation =
    impression VisualImpression
    | motion VisionMotionObservation
    | object VisionObjectObservation
    | track VisionTrackObservation
    | visible_text VisionVisibleTextObservation

type VisualExperienceObservations = sequence VisualExperienceObservation <= 24

type VisualExperienceRelation = {
    kind: Text
    object_sign: Text
    subject_sign: Text
}

type VisualExperienceRelations = sequence VisualExperienceRelation <= 32

type VisualExperience = {
    observations: VisualExperienceObservations
    relations: VisualExperienceRelations
    source_image: ImageObservationReference
}

type GraphicsCommandKind =
    rect
    | text
    | icon
    | orthogonal_path

form face/graphics-command-kind = GraphicsCommandKind as u8 from 1

type GraphicsPaintRole =
