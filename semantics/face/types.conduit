    | separator

form face/application-component = ApplicationComponent as u8 from 1

type ApplicationNodeState =
    ready
    | busy
    | unavailable

form face/application-node-state = ApplicationNodeState as u8 from 1

type ApplicationEventKind =
    activate
    | change
    | input
    | toggle
    | submit

type ApplicationAction = {
    id: Text <= 48B not in [""]
    event: ApplicationEventKind
}

form face/application-event-kind = ApplicationEventKind as u8 from 1

type ApplicationViewRefusal =
    empty
    | too_many_nodes
    | too_deep
    | duplicate_key
    | unknown_parent
    | text_too_long
    | invalid_control_value
    | too_many_actions
    | action_id_too_long
    | duplicate_action
    | unknown_action
    | invalid_node_state
    | malformed_encoding
    | oversized_encoding
    | unsupported_version
    | stale_revision
    | event_too_large
    | queue_pressure

# Initial finite visual Look facet. Semantic selectors and topology are absent.
# These canonical values are startup configuration, not a common multimodal Look.
type VisualDensityPreference =
    compact
    | spacious

type VisualPalettePreference =
    phosphor
    | editorial

type VisualMotionPreference =
    none
    | restrained

type VisualExpressionInfo = {
    density: VisualDensityPreference
    identity: Text <= 128B not in ["", "conduit.face/phosphor@1", "conduit.presentation/phosphor@1"]
    motion: VisualMotionPreference
    palette: VisualPalettePreference
    text_scale_percent: U16 in 100..=200
    version: U16 in 1..=1
}

# Structural selectors refer to existing Face classifications; they are not
# widgets, paint roles, or replacement semantic subjects/actions.
# Required semantic slots in a component recipe bind original Face truth.
# These references grant no interaction authority; the acknowledged Show still
# validates every returned action and argument against the current Face.
type ComponentArgumentBinding = {
    name: Text <= 64B not in [""]
    value_kind: Text <= 128B not in [""]
    contract_digest: Text <= 64B not in [""]
}

type ComponentActionBinding = {
    identity: Text <= 256B not in [""]
    intent: Text <= 256B not in [""]
    arguments: sequence ComponentArgumentBinding <= 4
}

type ComponentPropertyBinding = {
    name: Text <= 64B not in [""]
    kind: Text <= 8B in ["flag", "count", "signed", "text", "identity", "typed"]
    value_kind: Text <= 128B
}

type ComponentBindingRole =
    role Text <= 256B not in [""]
    | semantic Text <= 256B not in [""]

type ComponentSubjectBinding = {
    subject: Text <= 256B not in [""]
    role: ComponentBindingRole
    properties: sequence ComponentPropertyBinding <= 8
    actions: sequence ComponentActionBinding <= 2
}

type ComponentSubjectSelector =
    subject Text <= 256B not in [""]
    | bound ComponentSubjectBinding
    | action_target Text <= 256B not in [""]
    | role Text in ["Document", "Body", "Part", "Candidate", "Plot", "Gear", "Port", "Cord", "Plan", "Play", "Host", "Capability", "Line", "Manifestation", "Route", "Diagnostic", "Sign", "Info", "Region", "Collection", "Item", "TextEntry", "Status", "Action"]

type ComponentRegionInfo = {
    group: U8 in 0..=7
    identity: Text <= 64B not in [""]
    maximum_subjects: U16 in 1..=20
    selector: ComponentSubjectSelector
}

type ComponentRecipeInfo = {
    gutter: U16 in 0..=24
    identity: Text <= 128B not in [""]
    maximum_columns: U16 in 1..=2
    reflow_width: U16 in 280..=900
    regions: sequence ComponentRegionInfo <= 8
    version: U16 in 1..=1
}

# Proposed current input mapping, outside Face and Look. Construction is not
# admission: the checked input Plot, current Host offer, Face and Show must
# establish the binding before its control label can become an instruction.
type ActionInputBindingProposalInfo = {
    available: Boolean
    boot_id: Text <= 128B not in [""]
    control_identity: Text <= 128B not in [""]
    control_label: Text <= 64B not in [""]
    face_identity: Text <= 128B not in [""]
    host_id: Text <= 128B not in [""]
    input_plan_id: Text <= 128B not in [""]
    mapping_revision: U64 in 1..=18446744073709551615
    offered_action: GeneratedActionAffordance
    show_identity: Text <= 128B not in [""]
    version: U16 in 1..=1
}
