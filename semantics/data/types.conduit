# Authoritative portable data meaning. Rust consumes generated bindings.

type FullWindowPolicy =
    reject
    | drop_oldest

code data/full-window-policy = FullWindowPolicy as u8

type MeasurementPlotOverflowPolicy =
    reject
    | evenly_spaced

type MeasurementPlotPoint = {
    source-index: U64
    time-millionths: I64 in 0..=1000000
    value-millionths: I64 in 0..=1000000
}

type MeasurementPlotProfile = {
    point-capacity: U16 in 1..=32
    overflow-policy: MeasurementPlotOverflowPolicy
}

type MeasurementPlotSeries = {
    projected-points: sequence MeasurementPlotPoint in 1..=32
    source-sample-count: U64 in 1..=18446744073709551615
    omitted-sample-count: U64
}

type MeasurementWindowRefusal =
    capacity_out_of_bounds
    | invalid_clock_profile
    | invalid_range
    | invalid_timestamp
    | unit_mismatch
    | uncertainty_unit_mismatch
    | negative_uncertainty
    | clock_mismatch
    | timestamp_regression
    | out_of_range
    | full
    | discard_count_overflow

type MeasurementPlotRefusal =
    invalid_point_capacity
    | empty_window
    | full
    | degenerate_value_range
    | arithmetic_overflow
    | invalid_projection

type MeasurementSummaryRefusal =
    empty_window
    | unit_mismatch
    | arithmetic_overflow
    | inexact_mean

type MeasurementThresholdRefusal =
    policy_unit_mismatch
    | invalid_policy_order
    | summary_unit_mismatch

type MeasurementThresholdState =
    below
    | above

type MeasurementThresholdPolicy = {
    lower: Quantity
    upper: Quantity
}

type MeasurementRange = {
    minimum: Quantity
    maximum: Quantity
}

type MeasurementSample = {
    value: Quantity
    observed-at: TemporalInstant
    uncertainty: Quantity?
}

type MeasurementWindowProfile = {
    capacity: U8 in 1..=64
    range: MeasurementRange
    clock-basis: Text <= 128B not in [""]
    full-policy: FullWindowPolicy
}

type MeasurementHysteresisProfile = {
    policy: MeasurementThresholdPolicy
    initial-state: MeasurementThresholdState
}

type MeasurementSummary = {
    sample-count: U64 in 1..=18446744073709551615
    first-observed-at: TemporalInstant
    last-observed-at: TemporalInstant
    minimum: Quantity
    maximum: Quantity
    range: Quantity
    mean: Quantity
}

type MeasurementThresholdTransition =
    rose_above
    | fell_below

type MeasurementThresholdDecision = {
    state: MeasurementThresholdState
    transition: MeasurementThresholdTransition?
    evaluated-value: Quantity
    first-observed-at: TemporalInstant
    last-observed-at: TemporalInstant
}

type TensorElement =
    i8
    | u8
    | i16
    | i24
    | u16
    | i32
    | u32
    | i64
    | u64
    | f32
    | f64

type TensorAxisRole =
    batch
    | time
    | feature
    | sensor
    | spatial_coordinate
    | frequency
    | channel
    | other {
        identity: Text <= 64B not in [""]
    }

type ClockRelationQuality =
    exact
    | estimated {
        maximum-error: Duration
    }

type ClockRelation = {
    identity: Text <= 128B not in [""]
    source-clock: Text <= 128B not in [""]
    target-clock: Text <= 128B not in [""]
    source-anchor: U64
    target-anchor: U64
    source-ticks: U64 in 1..=18446744073709551615
    target-ticks: U64 in 1..=18446744073709551615
    quality: ClockRelationQuality
}

type SampledSignalRefusal =
    invalid_clock
    | invalid_start
    | invalid_cadence
    | invalid_continuity
    | empty_signal
    | tensor_invalid
    | sample_count_mismatch
    | missing_sample_axis
    | window_out_of_bounds
    | temporal_overflow
    | incompatible_signals
    | noncontiguous_signals
    | too_many_parts

type SignalContinuity =
    continuous
    | discontinuous {
        gap-identity: Text <= 128B not in [""]
    }
    | clock-reset {
        prior-clock: Text <= 128B not in [""]
    }

type SignalStart =
    sample-index {
        index: U64
    }
    | instant {
        value: TemporalInstant
    }

type SignalWindow = {
    source-signal: collection U8 = 32
    source-offset: U64
    sample-count: U64 in 1..=18446744073709551615
    start: SignalStart
}

type SignalSummary = {
    clock-identity: Text <= 128B not in [""]
    start: SignalStart
    sample-count: U64 in 1..=18446744073709551615
    continuity: SignalContinuity
    shape: sequence U64 in 1..=8
    bytes: U64 in 1..=1125899906842624
    content-digest: collection U8 = 32
}

type RangePolicy =
    refuse
    | clamp

type QuantizationPolicy =
    exact
    | nearest

type QuantityMappingRefusal =
    invalid-range
    | out-of-range
    | inexact
    | overflow

type ScalarComparison =
    less
    | less-or-equal
    | equal
    | not-equal
    | greater-or-equal
    | greater

type MathScalarRefusal =
    invalid-configuration
    | overflow

type NormalizedQuantityRefusal =
    malformed-or-wrong-type
    | incompatible-unit
    | out-of-domain

type DataSaveTextTerminal =
    value_too_large
    | generation_capacity_exhausted
    | byte_capacity_exhausted
    | wrong_content_kind

type DataLoadTextTerminal =
    malformed_reference
    | wrong_content_kind
    | wrong_access_class
    | expiring_generation
    | item_extent
    | generation_not_retained
    | extent_mismatch

type TensorRefusal =
    rank_out_of_bounds
    | zero_dimension
    | axis_count_mismatch
    | axis_identity_invalid
    | shape_overflow
    | byte_bound_exceeded
    | inline_payload_too_large
    | payload_length_mismatch
    | resource_profile_mismatch
    | resource_extent_mismatch
    | content_identity_mismatch
    | invalid_resource
    | unsupported_encoding_version
    | unsupported_element
    | unsupported_axis_role
    | unsupported_unit
    | malformed_encoding

type ScientificObservationRefusal =
    missing_identity
    | invalid_identity
    | invalid_value
    | clock_mismatch
    | missing_source
    | too_many_sources
    | empty_observation_set
    | too_many_observations
    | duplicate_observation
    | invalid_mask
    | mask_shape_mismatch
    | unknown_masked_observation
    | duplicate_mask

type ScientificCorpusRefusal =
    observation {
        refusal: ScientificObservationRefusal
    }
    | invalid_manifest
    | missing_manifest
    | empty_corpus
    | too_many_shards
    | duplicate_shard
    | invalid_split
    | too_many_splits
    | duplicate_split
    | empty_membership
    | too_many_members
    | duplicate_member
    | dataset_mismatch
    | unknown_split
    | split_leakage
    | missing_resource

type ScientificAlignmentRefusal =
    observation {
        refusal: ScientificObservationRefusal
    }
    | invalid_relation
    | incompatible_clock_relation
    | unknown_source_observation
    | invalid_coordinate_frame
    | invalid_calibration
    | calibration_frame_mismatch
    | calibration_shape_mismatch
    | missing_calibration_source
    | derived_clock_mismatch
    | derived_provenance_mismatch

type DataReferenceRefusal =
    malformed
    | wrong_reference_kind
    | wrong_content_kind
    | wrong_access_class
    | expiring_generation
    | item_extent

type DataGenerationNamespaceRefusal =
    empty
    | too_large

type DataGenerationDigest = collection U8 = 32

type DataGenerationNamespace = {
    identity: DataGenerationDigest
}

type DataGenerationValue<T> = {
    namespace: DataGenerationNamespace
    value: T
}

type DataGenerationTextValue = DataGenerationValue<Text <= 4096B>

type DatasetDescriptor = {
    identity: collection U8 = 32
    schema-profile: Text <= 128B not in [""]
    citation-identity: Text <= 128B not in [""]?
    license-profile: Text <= 128B not in [""]?
    example-count: U64 in 1..=18446744073709551615
    manifest: ResourceRef
    shards: sequence ResourceRef in 1..=64
    split-identities: sequence Text in 1..=16
}

type TabularColumnType =
    boolean
    | count
    | optional_text
    | text

type TabularColumnSpec = {
    name: Text <= 4096B
    value_type: TabularColumnType
}

type TabularSchemaFour = {
    columns: collection TabularColumnSpec = 4
    identity: Text <= 4096B
}

type TabularOptionalText =
    null
    | value Text <= 4096B

type TabularPersonRow = {
    active: Boolean
    id: Count
    name: Text <= 4096B
    nickname: TabularOptionalText
}

type TabularPersonRowSlot =
    row TabularPersonRow
    | unused

type TabularPersonRowsFour = collection TabularPersonRowSlot = 4

type TabularQueryCompletion = {
    emitted_rows: Count
    end_of_results: Boolean
}

type TabularQueryError = {
    code: Text <= 4096B
    message: Text <= 4096B
}

type TabularQueryStatus =
    complete TabularQueryCompletion
    | error TabularQueryError

type TabularQueryResultFour = {
    rows: TabularPersonRowsFour
    schema: TabularSchemaFour
    status: TabularQueryStatus
}

type TabularQueryOutcomeFour =
    inline TabularQueryResultFour
    | materialized ResourceRef

type FileCopyOutcome =
    cancelled Quantity
    | cleanup_failed Quantity
    | denied
    | destination_exists
    | oversized Quantity
    | partial Quantity
    | stale
    | success Quantity

type FileCopyResult = {
    outcome: FileCopyOutcome
}

code data/save-text-terminal = DataSaveTextTerminal as u8

code data/load-text-terminal = DataLoadTextTerminal as u8

code data/measurement-threshold-state = MeasurementThresholdState as u8
