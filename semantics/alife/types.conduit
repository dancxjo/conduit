# Authoritative portable artificial-life meaning. Rust consumes generated bindings.

type LeniaBoundary =
    wrap

type LeniaParameters = {
    kernel-radius: U16 in 1..=16
    kernel-mu-q16: U32 in 0..=65536
    kernel-sigma-q16: U32 in 1..=65536
    growth-mu-q16: U32 in 0..=65536
    growth-sigma-q16: U32 in 1..=65536
    dt-q16: U32 in 1..=65536
    boundary: LeniaBoundary
}

type GrayScottParameters = {
    diffusion-u-ppm: U32 in 1..=1000000
    diffusion-v-ppm: U32 in 1..=1000000
    feed-ppm: U32 in 0..=1000000
    kill-ppm: U32 in 0..=1000000
    time-step-ppm: U32 in 1..=1000000
    where .feed-ppm <= 1000000 - .kill-ppm
}

type ReactionDiffusionFieldId = collection U8 = 16

type ReactionDiffusionCell = {
    u-ppm: U32 in 0..=1000000
    v-ppm: U32 in 0..=1000000
}

type ReactionDiffusionEvolveRequest = {
    field-id: ReactionDiffusionFieldId
    expected-generation: U64
    generations: U16 in 1..=64
    admitted-cell-generations: U32
}

type LeniaFieldId = collection U8 = 16

type LeniaValueRefusal =
    invalid-dimensions
    | cell-count-mismatch
    | cell-out-of-range
    | invalid-parameters
    | generation-overflow
    | arithmetic-overflow
    | invalid-seed

type ReactionDiffusionValueRefusal =
    invalid-dimensions
    | cell-count-mismatch
    | concentration-out-of-range
    | invalid-parameters
    | wrong-field-identity
    | stale-generation {
        expected: U64
        actual: U64
    }
    | invalid-generation-count
    | generation-overflow
    | work-limit-exceeded {
        required: U32
        admitted: U32
    }
    | arithmetic-overflow

type LeniaRegionChunkKind =
    work
    | result

form alife/lenia-region-chunk-kind = LeniaRegionChunkKind as u8 from 1

type ReactionDiffusionBoundaryEdge =
    north
    | south
    | west
    | east

form alife/reaction-diffusion-boundary-edge = ReactionDiffusionBoundaryEdge as u8

type ReactionDiffusionRegionId = U16

type ReactionDiffusionRegion = {
    region-id: ReactionDiffusionRegionId
    origin-x: U16
    origin-y: U16
    width: U16
    height: U16
}

type ReactionDiffusionPartition = {
    regions: sequence ReactionDiffusionRegion in 1..=16
}

type FieldBitmapRefusal =
    invalid-field
    | invalid-bitmap

type GardenEvolutionRefusal =
    malformed-state
    | malformed-clock-observation
    | malformed-contact-observation
    | malformed-enriched-observation
    | step-capacity-exceeded
    | arithmetic-overflow

type GardenState = {
    vitality: Scalar in 0.000000..=1.000000
    activity: Scalar in 0.000000..=1.000000
    step: U16 in 0..=16
}

type GardenClockObservation = {
    phase: Scalar in 0.000000..=1.000000
}

type GardenContactObservation = {
    intensity: Scalar in 0.000000..=1.000000
}

type GardenEnrichedObservation = {
    clock: GardenClockObservation
    contact: GardenContactObservation
}
