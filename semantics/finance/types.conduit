# Authoritative portable finance meaning. Rust consumes generated bindings.

type FinanceCurrency =
    eur
    | gbp
    | usd

type FinanceMoneyComparison =
    equal
    | greater
    | less

type FinanceCurrencyPair = {
    base: FinanceCurrency
    quote: FinanceCurrency
}

type FinanceFixedDecimal = {
    coefficient: I64
    scale: U8 in 0..=9
}

type FinanceMoney = {
    amount: FinanceFixedDecimal
    currency: FinanceCurrency
}

type FinanceRateSource = Text <= 256B not in [""]

type FinanceRateProfile = Text <= 256B not in [""]

type FinanceRateObservation = {
    base: FinanceCurrency
    quote: FinanceCurrency
    rate: FinanceFixedDecimal
    observed_ticks: U64
    source: FinanceRateSource
    profile: FinanceRateProfile
}

# Finance quotes use one exact clock instead of carrying an open-ended scale
# record: Unix UTC seconds are part of this nominal meaning.
type FinanceObservedInstant = U64

type FinanceQuoteSource = Text <= 256B not in [""]

type FinanceOrderIdentity = Text <= 256B not in [""]

type FinanceRejectionReason = Text <= 256B not in [""]

type FinanceQuoteFreshness =
    fresh {
        age: Duration
        reference: FinanceObservedInstant
    }
    | stale {
        age: Duration
        reference: FinanceObservedInstant
    }

type FinanceQuote = {
    ask: FinanceMoney
    bid: FinanceMoney
    freshness: FinanceQuoteFreshness
    instrument: FinanceCurrencyPair
    observed-at: FinanceObservedInstant
    source: FinanceQuoteSource
}

type FinanceTransactionEvent =
    placed {
        amount: FinanceMoney
        observed-at: FinanceObservedInstant
        order-id: FinanceOrderIdentity
    }
    | filled {
        amount: FinanceMoney
        observed-at: FinanceObservedInstant
        order-id: FinanceOrderIdentity
        price: FinanceMoney
    }
    | rejected {
        observed-at: FinanceObservedInstant
        order-id: FinanceOrderIdentity
        reason: FinanceRejectionReason
    }

type FinanceTransactionEventsThree = {
    events: collection FinanceTransactionEvent = 3
}
