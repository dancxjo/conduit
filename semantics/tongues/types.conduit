# Authoritative portable speech meaning. Rust consumes generated bindings.

type SpeechCommitReason =
    tongues_boundary
    | final_flush

type SpeechCommitRefusal =
    empty_stream_identity
    | empty_delta
    | pending_bound_exceeded
    | segment_bound_exceeded
    | segment_queue_full
    | already_closed

type SpeakableSegment = {
    stream_identity: Text <= 256B not in [""]
    sequence: U32
    text: Text <= 1024B not in [""]
    reason: SpeechCommitReason
}

type CommittedUserMessage = {
    turn_identity: Text <= 256B not in [""]
    role: Text <= 32B not in [""]
    source: Text <= 64B not in [""]
    text: Text <= 256B not in [""]
}

type SpeechRecognitionDisposition =
    recognized
    | no_speech

type SpeechRecognitionRefusal =
    empty_fixtures
    | too_many_fixtures
    | empty_transcript
    | transcript_too_large
    | duplicate_audio
    | audio_too_large
    | invalid_pcm
    | unsupported_pcm_profile

type SpeechRecognitionValueError =
    bound_exceeded
    | malformed
    | non_canonical
    | invalid_value

type RecognitionTextRefusal =
    invalid_result
    | not_recognized

type StreamingRecognitionRefusal =
    bound_exceeded
    | invalid_event

type SpeechRecognitionAudioDigest = collection U8 = 32

type SpeechRecognitionProviderIdentity = Text <= 128B not in [""]

type RecognizedSpeechText = Text <= 256B not in [""]

type SpeechRecognitionResult =
    recognized {
        audio-extent-bytes: U32 in 0..=786432
        audio-sha256: SpeechRecognitionAudioDigest
        provider-identity: SpeechRecognitionProviderIdentity
        text: RecognizedSpeechText
    }
    | no-speech {
        audio-extent-bytes: U32 in 0..=786432
        audio-sha256: SpeechRecognitionAudioDigest
        provider-identity: SpeechRecognitionProviderIdentity
    }

type SpeechRecognitionAttempt =
    result SpeechRecognitionResult
    | resource-unavailable
    | failed SpeechRecognitionAudioDigest

type LiveConversationSpeechRequirements = {
    recognition-audio-bytes: U32
    recognized-text-bytes: U16
    speakable-segment-bytes: U32
    synthesized-pcm-bytes: U32
}

# One finite provider-neutral model request projected from addressed House context.
# The identity is the fixed `house-model-request/` prefix plus a SHA-256 digest.
type HouseGenerationRequest = {
    request-identity: Text <= 84B not in [""]
    encoded-request: Text <= 128KiB not in [""]
    maximum-output-bytes: U64 in 1..=65536
}
