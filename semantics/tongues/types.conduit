# Authoritative portable speech meaning. Rust consumes generated bindings.

type SpeechCommitReason =
    tongues_boundary
    | final_flush

type SpeechCommitRefusal =
    empty_stream_identity
    | empty_delta
    | pending_bound_exceeded
    | segment_bound_exceeded
    | segment_queue_full
    | already_closed

type SpeechRecognitionDisposition =
    recognized
    | no_speech

type SpeechRecognitionRefusal =
    empty_fixtures
    | too_many_fixtures
    | empty_transcript
    | transcript_too_large
    | duplicate_audio
    | audio_too_large
    | invalid_pcm
    | unsupported_pcm_profile

type SpeechRecognitionValueError =
    bound_exceeded
    | malformed
    | non_canonical
    | invalid_value

type RecognitionTextRefusal =
    invalid_result
    | not_recognized

type StreamingRecognitionRefusal =
    bound_exceeded
    | invalid_event

type LiveConversationSpeechRequirements = {
    recognition-audio-bytes: U32
    recognized-text-bytes: U16
    speakable-segment-bytes: U32
    synthesized-pcm-bytes: U32
}

# One finite provider-neutral model request projected from addressed House context.
# The identity is the fixed `house-model-request/` prefix plus a SHA-256 digest.
type HouseGenerationRequest = {
    request-identity: Text <= 84B not in [""]
    encoded-request: Text <= 128KiB not in [""]
    maximum-output-bytes: U64 in 1..=65536
}
