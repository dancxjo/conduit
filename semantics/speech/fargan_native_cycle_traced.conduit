# Optional exact Source diagnostic composition; default plot remains unchanged.
# All three causal states return from the same final selected-model PCM16 result.
plot speech/flow-fargan-native-cycle-traced (
    selected: FarganModelFrameAnchor
    >> signal_seed: FarganSignalEpochFeedback...|
    >> conditioning_seed: FarganConditioningEpochFeedback...|
    >> feature_seed: FeatureAdmittedState...|
    >> events: FeatureAdmittedEvent...|
    >> band_weights: NumericF32MatrixRef161x18
    >> band_bias: NumericF32BiasRef18
    >> dct_weights: NumericF32MatrixRef18x18
    >> conditioning_embedding_weights: NumericEmbedding224x12
    >> conditioning_dense1_weights: NumericF32MatrixRef32x64
    >> conditioning_dense1_bias: NumericF32BiasRef64
    >> conditioning_conv_weights: NumericF32MatrixRef192x128
    >> conditioning_conv_bias: NumericF32BiasRef128
    >> conditioning_dense2_weights: NumericF32MatrixRef128x320
    >> conditioning_dense2_bias: NumericF32BiasRef320
    >> gain_weights: NumericF32MatrixRef80x1
    >> gain_bias: NumericF32BiasRef1
    >> conv_weights: NumericF32MatrixRef328x192
    >> conv_bias: NumericF32BiasRef192
    >> conv_glu_weights: NumericF32MatrixRef192x192
    >> conv_glu_bias: NumericF32BiasRef192
    >> pitch_gate_weights: NumericF32MatrixRef192x4
    >> pitch_gate_bias: NumericF32BiasRef4
    >> gru1_input_weights: NumericF32MatrixRef272x480
    >> gru1_recurrent_weights: NumericF32MatrixRef160x480
    >> gru2_input_weights: NumericF32MatrixRef240x384
    >> gru2_recurrent_weights: NumericF32MatrixRef128x384
    >> gru3_input_weights: NumericF32MatrixRef208x384
    >> gru3_recurrent_weights: NumericF32MatrixRef128x384
    >> gru1_glu_weights: NumericF32MatrixRef160x160
    >> gru1_glu_bias: NumericF32BiasRef160
    >> gru2_glu_weights: NumericF32MatrixRef128x128
    >> gru2_glu_bias: NumericF32BiasRef128
    >> gru3_glu_weights: NumericF32MatrixRef128x128
    >> gru3_glu_bias: NumericF32BiasRef128
    >> skip_weights: NumericF32MatrixRef688x128
    >> skip_bias: NumericF32BiasRef128
    >> skip_glu_weights: NumericF32MatrixRef128x128
    >> skip_glu_bias: NumericF32BiasRef128
    >> output_weights: NumericF32MatrixRef128x40
    >> output_bias: NumericF32BiasRef40
    result: FarganPcm16EpochResult...| >>
    feature_trace: FarganFeatureConditionTrace...| >>
    history_trace: FarganConditionHistoryTrace...| >>
    pcm_trace: FarganCommittedResultTrace...| >>
) {
    feature: speech/flow-fargan-feature-cycle (selected = selected)
    model: speech/flow-fargan-compound-cycle-traced (selected = selected)
    feature_seed >> feature.seed
    events >> feature.events
    band_weights >> feature.band_weights
    band_bias >> feature.band_bias
    dct_weights >> feature.dct_weights
    feature.result >> model.events
    model.result >> feature.accepted
    model.result >> result
    model.feature_trace >> feature_trace
    model.history_trace >> history_trace
    model.pcm_trace >> pcm_trace
    signal_seed >> model.signal_seed
    conditioning_seed >> model.conditioning_seed
    conditioning_embedding_weights >> model.conditioning_embedding_weights
    conditioning_dense1_weights >> model.conditioning_dense1_weights
    conditioning_dense1_bias >> model.conditioning_dense1_bias
    conditioning_conv_weights >> model.conditioning_conv_weights
    conditioning_conv_bias >> model.conditioning_conv_bias
    conditioning_dense2_weights >> model.conditioning_dense2_weights
    conditioning_dense2_bias >> model.conditioning_dense2_bias
    gain_weights >> model.gain_weights
    gain_bias >> model.gain_bias
    conv_weights >> model.conv_weights
    conv_bias >> model.conv_bias
    conv_glu_weights >> model.conv_glu_weights
    conv_glu_bias >> model.conv_glu_bias
    pitch_gate_weights >> model.pitch_gate_weights
    pitch_gate_bias >> model.pitch_gate_bias
    gru1_input_weights >> model.gru1_input_weights
    gru1_recurrent_weights >> model.gru1_recurrent_weights
    gru2_input_weights >> model.gru2_input_weights
    gru2_recurrent_weights >> model.gru2_recurrent_weights
    gru3_input_weights >> model.gru3_input_weights
    gru3_recurrent_weights >> model.gru3_recurrent_weights
    gru1_glu_weights >> model.gru1_glu_weights
    gru1_glu_bias >> model.gru1_glu_bias
    gru2_glu_weights >> model.gru2_glu_weights
    gru2_glu_bias >> model.gru2_glu_bias
    gru3_glu_weights >> model.gru3_glu_weights
    gru3_glu_bias >> model.gru3_glu_bias
    skip_weights >> model.skip_weights
    skip_bias >> model.skip_bias
    skip_glu_weights >> model.skip_glu_weights
    skip_glu_bias >> model.skip_glu_bias
    output_weights >> model.output_weights
    output_bias >> model.output_bias
}
