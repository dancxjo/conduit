# This English profile reads ASCII digit sequences as individual digit names.
# Leading zeroes remain spoken. Cardinal, ordinal, decimal, date and locale
# interpretations are not inferred from a string of digits.
type EnglishNormalizedDigit = {
    phonemes: EnglishWordPhonemes
    origin: EnglishPronunciationOrigin
    before: EnglishTextClass
    after: EnglishTextClass
}
type EnglishDigitDecision =
    normalized EnglishNormalizedDigit
    | unsupported
