plot speech/flow-fargan-glu128 (
    >> value: NumericF32Vector128...|
    >> weights: NumericF32MatrixRef128x128
    >> bias: NumericF32BiasRef128
    result: NumericF32Vector128...| >>
) {
    gate: numeric/flow-dense128x128
    activation: numeric/flow-sigmoid128
    multiply: numeric/flow-multiply128
    value >> gate.value
    weights >> gate.weights
    bias >> gate.bias
    gate.result >> activation.value
    value >> multiply.left
    activation.result >> multiply.right
    multiply.result >> result
}

