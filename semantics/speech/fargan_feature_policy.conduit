# Explicit causal linear2x resampling of native8k PCM represented exactly as f32.
# Midpoint then current sample gives a half-native-sample analysis delay.
# previous_raw is the last I16-derived sample from the prior committed block;
# the160 output values are normalized by32768. This does not restore >4k content.
type FarganFormantResampleInput = {
    samples_raw: NumericF32Vector80
    previous_raw: F32
}
type FarganFormantResampleResult = {
    samples: NumericRawF32Vector160
    next_previous_raw: F32
}
plot speech/fargan-formant-linear2x (
    >> value: FarganFormantResampleInput
    result: FarganFormantResampleResult >>
) = ({samples: [ (.previous_raw + (sequence/at(.samples_raw, 0) + 0x00000000)) * 0x37800000, sequence/at(.samples_raw, 0) * 0x38000000, (sequence/at(.samples_raw, 0) + sequence/at(.samples_raw, 1)) * 0x37800000, sequence/at(.samples_raw, 1) * 0x38000000, (sequence/at(.samples_raw, 1) + sequence/at(.samples_raw, 2)) * 0x37800000, sequence/at(.samples_raw, 2) * 0x38000000, (sequence/at(.samples_raw, 2) + sequence/at(.samples_raw, 3)) * 0x37800000, sequence/at(.samples_raw, 3) * 0x38000000, (sequence/at(.samples_raw, 3) + sequence/at(.samples_raw, 4)) * 0x37800000, sequence/at(.samples_raw, 4) * 0x38000000, (sequence/at(.samples_raw, 4) + sequence/at(.samples_raw, 5)) * 0x37800000, sequence/at(.samples_raw, 5) * 0x38000000, (sequence/at(.samples_raw, 5) + sequence/at(.samples_raw, 6)) * 0x37800000, sequence/at(.samples_raw, 6) * 0x38000000, (sequence/at(.samples_raw, 6) + sequence/at(.samples_raw, 7)) * 0x37800000, sequence/at(.samples_raw, 7) * 0x38000000, (sequence/at(.samples_raw, 7) + sequence/at(.samples_raw, 8)) * 0x37800000, sequence/at(.samples_raw, 8) * 0x38000000, (sequence/at(.samples_raw, 8) + sequence/at(.samples_raw, 9)) * 0x37800000, sequence/at(.samples_raw, 9) * 0x38000000, (sequence/at(.samples_raw, 9) + sequence/at(.samples_raw, 10)) * 0x37800000, sequence/at(.samples_raw, 10) * 0x38000000, (sequence/at(.samples_raw, 10) + sequence/at(.samples_raw, 11)) * 0x37800000, sequence/at(.samples_raw, 11) * 0x38000000, (sequence/at(.samples_raw, 11) + sequence/at(.samples_raw, 12)) * 0x37800000, sequence/at(.samples_raw, 12) * 0x38000000, (sequence/at(.samples_raw, 12) + sequence/at(.samples_raw, 13)) * 0x37800000, sequence/at(.samples_raw, 13) * 0x38000000, (sequence/at(.samples_raw, 13) + sequence/at(.samples_raw, 14)) * 0x37800000, sequence/at(.samples_raw, 14) * 0x38000000, (sequence/at(.samples_raw, 14) + sequence/at(.samples_raw, 15)) * 0x37800000, sequence/at(.samples_raw, 15) * 0x38000000, (sequence/at(.samples_raw, 15) + sequence/at(.samples_raw, 16)