    stage16: speech/fargan-feature-floor-16
    stage17: speech/fargan-feature-floor-17
    value >> seed.value
    seed.result >> stage0.value
    stage0.result >> stage1.value
    stage1.result >> stage2.value
    stage2.result >> stage3.value
    stage3.result >> stage4.value
    stage4.result >> stage5.value
    stage5.result >> stage6.value
    stage6.result >> stage7.value
    stage7.result >> stage8.value
    stage8.result >> stage9.value
    stage9.result >> stage10.value
    stage10.result >> stage11.value
    stage11.result >> stage12.value
    stage12.result >> stage13.value
    stage13.result >> stage14.value
    stage14.result >> stage15.value
    stage15.result >> stage16.value
    stage16.result >> stage17.value
    stage17.result >> (.values) >> result
}

# Explicit causal linear2x resampling of native8k PCM represented exactly as f32.
# Midpoint then current sample gives a half-native-sample analysis delay.
# previous_raw is the last I16-derived sample from the prior committed block;
# the160 output values are normalized by32768. This does not restore >4k content.
type FarganFormantResampleInput = {
    samples_raw: NumericF32Vector80
    previous_raw: F32
}
type FarganFormantResampleResult = {
    samples: NumericRawF32Vector160
    next_previous_raw: F32
}
