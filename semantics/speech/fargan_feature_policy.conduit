# These ordinary resource ports admit the public profile manifest's exact
# band/DCT tensors. They carry no trained model weights. Band normalization is
# (32768/320)^2 for normalized PCM and an unnormalized generic real DFT.
plot speech/fargan-feature-spectrum (
    >> samples: NumericF32Vector320
    >> band_weights: NumericF32MatrixRef161x18
    >> band_bias: NumericF32BiasRef18
    >> dct_weights: NumericF32MatrixRef18x18
    result: NumericF32Vector18 >>
) {
    window: speech/fargan-feature-window
    admitted_window: numeric/finite-vector320
    transform: numeric/real-dft320
    power: numeric/magnitude-squared161
    bands: numeric/dense161x18
    logarithm: numeric/log10-18
    floor: speech/fargan-feature-floor
    admitted_floor: numeric/finite-vector18
    cepstrum: numeric/linear18x18
    admitted_cepstrum: numeric/finite-vector18
    samples >> window.value
    window.result >> admitted_window.value
    admitted_window.result >> transform.value
    transform.result >> power.value
    power.result >> bands.value
    band_weights >> bands.weights
    band_bias >> bands.bias
    bands.result >> logarithm.value
    logarithm.result >> floor.value
    floor.result >> admitted_floor.value
    admitted_floor.result >> cepstrum.value
    dct_weights >> cepstrum.weights
    cepstrum.result >> ([.0 - 0x40800000, .1 + 0x00000000, .2 + 0x00000000, .3 + 0x00000000, .4 + 0x00000000, .5 + 0x00000000, .6 + 0x00000000, .7 + 0x00000000, .8 + 0x00000000, .9 + 0x00000000, .10 + 0x00000000, .11 + 0x00000000, .12 + 0x00000000, .13 + 0x00000000, .14 + 0x00000000, .15 + 0x00000000, .16 + 0x00000000, .17 + 0x00000000]) >> admitted_cepstrum.value
    admitted_cepstrum.result >> result
}

plot speech/fargan-feature-period-u16 (
    >> value: FarganPeriod
    result: U16 >>
) = (. - 32 + 32)

plot speech/fargan-feature-log-pitch (
    >> period: FarganPeriod
    result: NumericF32Vector1 >>
) {
    primitive: speech/fargan-feature-period-u16
    convert: numeric/u16-to-f32
    admitted_ratio: numeric/finite-vector1
    logarithm: numeric/log10-1
    admitted_pitch: numeric/finite-vector1
    period >> primitive.value
    primitive.result >> convert.value
    convert.result >> ([0x43800000 / (.0 + 0x00000000)]) >> admitted_ratio.value
    admitted_ratio.result >> logarithm.value
    logarithm.result >> ([.0 / 0x3e9a209b - 0x3fc00000]) >> admitted_pitch.value
    admitted_pitch.result >> result
}

# Caller supplies a source-correlated normalized correlation in [-1,1].
# Its lag selection and energy normalization remain separate authored policy.
plot speech/fargan-feature-correlation (
    >> value: NumericF32Vector1
    result: NumericF32Vector1 >>
) {
    admitted_argument: numeric/finite-vector1
    exponential: numeric/exp1
    admitted_sum: numeric/finite-vector1
    logarithm: numeric/log10-1
    admitted_correlation: numeric/finite-vector1
    value >> ([((.0 < 0xbf800000 ? 0xbf800000 : (.0 > 0x3f800000 ? 0x3f800000 : (.0 + 0x00000000)))) * 0x40a00000]) >> admitted_argument.value
    admitted_argument.result >> exponential.value
    exponential.result >> ([.0 + 0x3f800000]) >> admitted_sum.value
    admitted_sum.result >> logarithm.value
    logarithm.result >> ([.0 * 0x40135d8e / 0x40a03703 - 0x3f000000]) >> admitted_correlation.value
    admitted_correlation.result >> result
}

plot speech/fargan-feature20 (
    >> cepstrum: NumericF32Vector18
    >> pitch: NumericF32Vector1
    >> correlation: NumericF32Vector1
    result: NumericF32Vector20 >>
) {
    append_pitch: numeric/concatenate18x1
    append_correlation: numeric/concatenate19x1
    cepstrum >> append_pitch.left
    pitch >> append_pitch.right
    append_pitch.result >> append_correlation.left
    correlation >> append_correlation.right
    append_correlation.result >> result
}

