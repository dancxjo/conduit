# Temporal acoustic realization of one already selected phone. Acoustic
# destinations below are this profile's spectral models, not new segment IDs.
# Progress holds the initial quarter, glides over half, then holds the last
# quarter. This approximate coefficient interpolation is not coarticulation.
type SpeechTrajectoryInput = {
    phone: EnglishPhone
    frame: I32
    target: SpeechAcousticTarget
}
# The same authored equations specialize to endpoint-only or synthesis requests.
# Endpoint requests have no invented frame history or neighbor context.
type SpeechEndpointContext =
    model_only
type SpeechTemporalContext = {
    stress: EnglishStress
    state: SpeechFrameState
    previous_place: SpeechStopPlace
    previous: SpeechNeighborModel
    next: SpeechNeighborModel
}
type SpeechTrajectoryCarry<C> = {
    trajectory: SpeechTrajectoryInput
    context: C
}
type SpeechTrajectoryTransition<C> = {
    input: SpeechTrajectoryCarry<C>
    destination: SpeechAcousticTarget
    progress: I32
}
type SpeechTrajectoryResult<C> = {
    input: SpeechTrajectoryCarry<C>
    target: SpeechAcousticTarget
}
type SpeechEndpointRequest = SpeechTrajectoryCarry<SpeechEndpointContext>
type SpeechEndpointTransition = SpeechTrajectoryTransition<SpeechEndpointContext>
type SpeechEndpointResult = SpeechTrajectoryResult<SpeechEndpointContext>
type SpeechTemporalRequest = SpeechTrajectoryCarry<SpeechTemporalContext>
type SpeechTemporalTransition = SpeechTrajectoryTransition<SpeechTemporalContext>
type SpeechTemporalResult = SpeechTrajectoryResult<SpeechTemporalContext>
plot speech/trajectory-prepare (
    item: type
    output: type
    >> value: item
    result: output >>
) = ({input: ., destination: (.trajectory.phone is ey || (.trajectory.phone is ay || .trajectory.phone is oy)) ? { f1: 270, f2: 2290, f3: 3010, b1: 31165, b2: -7114, b3: -22103, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, voiced: 1, frication: 0, frames: 960, closure: 0 } : (.trajectory.phone is ow || .trajectory.phone is aw) ? { f1: 300, f2: 870, f3: 2240, b1: 30999, b2: 24433, b3: -5812, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, voiced: 1, frication: 0, frames: 960, closure: 0 } : .trajectory.target, progress: .trajectory.frame < .trajectory.target.frames / 4 ? 0 : .trajectory.frame >= .trajectory.target.frames * 3 / 4 ? 256 : (.trajectory.frame - .trajectory.target.frames / 4) * 512 / .trajectory.target.frames})
plot speech/trajectory-blend (
    item: type
    output: type
    >> value: item
    result: output >>
) = ({context: .input.context, trajectory: {phone: .input.trajectory.phone, frame: .input.trajectory.frame, target: {f1: .input.trajectory.target.f1 + (.destination.f1 - .input.trajectory.target.f1) * .progress / 256, f2: .input.trajectory.target.f2 + (.destination.f2 - .input.trajectory.target.f2) * .progress / 256, f3: .input.trajectory.target.f3 + (.destination.f3 - .input.trajectory.target.f3) * .progress / 256, b1: .input.trajectory.target.b1 + (.destination.b1 - .input.trajectory.target.b1) * .progress / 256, b2: .input.trajectory.target.b2 + (.destination.b2 - .input.trajectory.target.b2) * .progress / 256, b3: .input.trajectory.target.b3 + (.destination.b3 - .input.trajectory.target.b3) * .progress / 256, c1: .input.trajectory.target.c1 + (.destination.c1 - .input.trajectory.target.c1) * .progress / 256, c2: .input.trajectory.target.c2 + (.destination.c2 - .input.trajectory.target.c2) * .progress / 256, c3: .input.trajectory.target.c3 + (.destination.c3 - .input.trajectory.target.c3) * .progress / 256, gain1: .input.trajectory.target.gain1 + (.destination.gain1 - .input.trajectory.target.gain1) * .progress / 256, gain2: .input.trajectory.target.gain2 + (.destination.gain2 - .input.trajectory.target.gain2) * .progress / 256, gain3: .input.trajectory.target.gain3 + (.destination.gain3 - .input.trajectory.target.gain3) * .progress / 256, voiced: .input.trajectory.target.voiced, frication: .input.trajectory.target.frication, frames: .input.trajectory.target.frames, closure: .input.trajectory.target.closure}}})
# Closure precedes a finite 96-frame release-noise window. Aspirated stops and
# affricates retain their declared frication after that window. A plain stop
# no longer disappears merely because its steady target has no frication.
plot speech/trajectory-release (
    item: type
    output: type
    >> value: item
    result: output >>
) = ({input: ., target: {f1: .trajectory.target.f1, f2: .trajectory.target.f2, f3: .trajectory.target.f3, b1: .trajectory.target.b1, b2: .trajectory.target.b2, b3: .trajectory.target.b3, c1: .trajectory.target.c1, c2: .trajectory.target.c2, c3: .trajectory.target.c3, gain1: .trajectory.target.gain1, gain2: .trajectory.target.gain2, gain3: .trajectory.target.gain3, voiced: .trajectory.frame < .trajectory.target.closure ? 0 : .trajectory.target.voiced, frication: .trajectory.frame < .trajectory.target.closure ? 0 : (.trajectory.target.closure > 0 && .trajectory.frame < .trajectory.target.closure + 96) ? 1 : .trajectory.target.frication, frames: .trajectory.target.frames, closure: .trajectory.target.closure}})
plot speech/phone-frame-target (
    >> value: SpeechTrajectoryInput
    result: SpeechAcousticTarget >>
) {
    prepare: speech/trajectory-prepare(item = SpeechEndpointRequest, output = SpeechEndpointTransition)
    blend: speech/trajectory-blend(item = SpeechEndpointTransition, output = SpeechEndpointRequest)
    release: speech/trajectory-release(item = SpeechEndpointRequest, output = SpeechEndpointResult)
    value >> ({trajectory: ., context: SpeechEndpointContext.model_only}) >> prepare.value
    prepare.result >> blend.value
    blend.result >> release.value
    release.result >> (.target) >> result
}

plot speech/temporal-connected-input (
    >> value: SpeechTemporalResult
    result: SpeechConnectedInput >>
) = ({phone: .input.trajectory.phone, stress: .input.context.stress, state: .input.context.state, previous_place: .input.context.previous_place, target: .target, frame: .input.trajectory.frame, previous: {relation: .input.context.previous.relation, model: .input.context.previous.relation is segment ? .input.context.previous.model : .target}, next: {relation: .input.context.next.relation, model: .input.context.next.relation is segment ? .input.context.next.model : .target}})

plot speech/temporal-frame (
    >> value: SpeechTemporalRequest
    result: SpeechFrameResult >>
) {
    prepare: speech/trajectory-prepare(item = SpeechTemporalRequest, output = SpeechTemporalTransition)
    blend: speech/trajectory-blend(item = SpeechTemporalTransition, output = SpeechTemporalRequest)
    release: speech/trajectory-release(item = SpeechTemporalRequest, output = SpeechTemporalResult)
    context: speech/temporal-connected-input
    synthesize: speech/connected-frame
    value >> prepare.value
    prepare.result >> blend.value
    blend.result >> release.value
    release.result >> context.value
    context.result >> synthesize.value
    synthesize.result >> result
}

# Endpoint side belongs to the adjacent segment's acoustic query. It does not
# create another phone occurrence or skip intervening boundary events.
type SpeechEndpointSide =
    start
    | end
type SpeechNeighborEndpointInput = {
    phone: EnglishPhone
    target: SpeechAcousticTarget
    side: SpeechEndpointSide
}
type SpeechNeighborCueRequest = SpeechStopPlaceCarry<SpeechNeighborEndpointInput>
type SpeechNeighborCueResult = SpeechStopPlaceResult<SpeechNeighborEndpointInput>
type SpeechNeighborTrajectoryRequest = SpeechTrajectoryCarry<SpeechStopPlace>
type SpeechNeighborTrajectoryTransition = SpeechTrajectoryTransition<SpeechStopPlace>
type SpeechNeighborTrajectoryResult = SpeechTrajectoryResult<SpeechStopPlace>
type SpeechNeighborEndpointResult = {
    neighbor: SpeechNeighborModel
    place: SpeechStopPlace
}
plot speech/neighbor-trajectory-input (
    >> value: SpeechNeighborCueResult
    result: SpeechNeighborTrajectoryRequest >>
) = ({trajectory: {phone: .input.phone, target: .input.context.target, frame: .input.context.side is end ? .input.context.target.frames - 1 : 0}, context: .place})
plot speech/neighbor-endpoint (
    >> value: SpeechNeighborEndpointInput
    result: SpeechNeighborEndpointResult >>
) {
    cue: speech/stop-place-cue(item = SpeechNeighborCueRequest, output = SpeechNeighborCueResult)
    input: speech/neighbor-trajectory-input
    prepare: speech/trajectory-prepare(item = SpeechNeighborTrajectoryRequest, output = SpeechNeighborTrajectoryTransition)
    blend: speech/trajectory-blend(item = SpeechNeighborTrajectoryTransition, output = SpeechNeighborTrajectoryRequest)
    release: speech/trajectory-release(item = SpeechNeighborTrajectoryRequest, output = SpeechNeighborTrajectoryResult)
    value >> ({phone: .phone, context: .}) >> cue.value
    cue.result >> input.value
    input.result >> prepare.value
    prepare.result >> blend.value
    blend.result >> release.value
    release.result >> ({neighbor: {relation: SpeechNeighborRelation.segment, model: .target}, place: .input.context}) >> result
}
