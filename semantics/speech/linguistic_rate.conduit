# Linguistic event density, not oscillation frequency or a second Audio clock.
# This admitted subset supplies one complete constant utterance span starting at
# its declared Audio origin. No schedule, overlap, gap or inferred segmentation.
type SpeechLinguisticRateProfile = constant_full_utterance_u32

type SpeechLinguisticRateScope = {
 basis: SpeechTokenSequenceBasis
 source: LanguageTextSegmentRef
 anchor: AudioTrajectoryAnchor
 where .source.kind is utterance
 where .source.language == .basis.language
}
type SpeechLinguisticRateTarget = {
 scope: SpeechLinguisticRateScope
 profile: SpeechLinguisticRateProfile
 syllable_count: U64 in 1..=64
 span: AudioExactTimeOffset
 provenance: SpeechEvidenceProvenance
 where .span.numerator_seconds > 0
 where .span.numerator_seconds <= 4294967295
 where .span.denominator <= 4294967295
}
# A symbolic exact density. Original count and unreduced Audio span are retained
# in its admission; these fields are not public acoustic Hz or normalized F0.
type SpeechSyllablesPerSecond = {
 numerator_syllables: U64 in 1..=274877906880
 denominator_seconds: U64 in 1..=4294967295
}
type SpeechLinguisticRateAdmission = {
 target: SpeechLinguisticRateTarget
 actual_syllable_count: U64 in 1..=64
 where .actual_syllable_count == .target.syllable_count
}
# Private raw expression result; public admission below remains owner checked.
type SpeechLinguisticRateRawProjection = {
 numerator_syllables: U64
 denominator_seconds: U64
}
plot speech/linguistic-rate (
 >> request: SpeechLinguisticRateAdmission
 result: SpeechLinguisticRateRawProjection >>
) = ({numerator_syllables: .target.syllable_count * .target.span.denominator, denominator_seconds: .target.span.numerator_seconds})
