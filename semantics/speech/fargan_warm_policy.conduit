# Exact existing typed pairs assemble state without a host state copier.
plot speech/fargan-warm-pack (
    >> source: FarganSubframeResult
    >> pitch: NumericF32Vector256
    >> deemphasis: NumericF32Vector1
    result: FarganSubframeState >>
) {
    join1: numeric/pair40x164
    join2: numeric/pair40-164x160
    join3: numeric/pair40-164-160x128
    join4: numeric/pair40-164-160-128x128
    join5: numeric/pair40-164-160-128-128x256
    join6: numeric/pair40-164-160-128-128-256x1
    aggregate: speech/fargan-subframe-result
    source >> (.pcm_f32) >> join1.left
    source >> (.next_state.signal.conv_history) >> join1.right
    join1.result >> join2.left
    source >> (.next_state.signal.gru1) >> join2.right
    join2.result >> join3.left
    source >> (.next_state.signal.gru2) >> join3.right
    join3.result >> join4.left
    source >> (.next_state.signal.gru3) >> join4.right
    join4.result >> join5.left
    pitch >> join5.right
    join5.result >> join6.left
    deemphasis >> join6.right
    join6.result >> aggregate.value
    aggregate.result >> (.next_state) >> result
}

# Generated raw pitch tail is replaced with teacher PCM AFTER each subframe.
plot speech/fargan-warm-teacher (
    >> source: FarganSubframeResult
    >> teacher: NumericF32Vector40
    >> deemphasis: NumericF32Vector1
    result: FarganSubframeState >>
) {
    tail: numeric/slice256x216
    append: numeric/concatenate216x40
    pack: speech/fargan-warm-pack
    source >> (.next_state.pitch_history) >> tail.value
    teacher >> (0) >> tail.start
    tail.result >> append.left
    teacher >> append.right
    source >> pack.source
    append.result >> pack.pitch
    deemphasis >> pack.deemphasis
    pack.result >> result
}
