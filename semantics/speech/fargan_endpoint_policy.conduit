# Proposed exact50epoch endpoint-extension subset, not an installed speech Back.
# All50 actual original cycle ratios must be identical (no ratio normalization).
# A successful gate must be executed and retained; caller-provided Boolean is not
# admission. Outer preparation still binds complete carrier/Audio/model receipts.
type SpeechFarganEndpointCycles50 = collection SpeechFundamentalCycle = 50
plot speech/fargan-endpoint-constant-cycles50 (
 >> value: SpeechFarganEndpointCycles50
 result: Boolean >>
) = (
 ((((((sequence/at(., 1).numerator_seconds == sequence/at(., 0).numerator_seconds && sequence/at(., 1).denominator == sequence/at(., 0).denominator) &&
