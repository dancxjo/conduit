# Index is admitted by the actual Native owner before execution.
type SpeechFarganEndpointStepInput = {
 raw_index: U64 in 0..=50
}
# Raw checked-Source result, not a newly constructed refined native value.
type SpeechFarganEndpointRawStep = {
 raw_index: U64
 feature_source_index: U64
 endpoint_feature_copy: Boolean
 period_source_index: U64
 endpoint_period_copy: Boolean
 keep_start: U64
 keep_count: U64
 audible_start: U64
}
# Calls0..48 supply actual features1..49. Calls49,50 explicitly retain feature49.
# Prior-control index0..49 stays actual; final call copies admitted period49.
# Initial80/final80 lie outside source duration and are explicitly unheard.
plot speech/fargan-endpoint-step50 (
 >> value: SpeechFarganEndpointStepInput
 result: SpeechFarganEndpointRawStep >>
) = ({raw_index: .raw_index, feature_source_index: .raw_index < 49 ? .raw_index + 1 : 49, endpoint_feature_copy: .raw_index >= 49, period_source_index: .raw_index < 50 ? .raw_index : 49, endpoint_period_copy: .raw_index == 50, keep_start: .raw_index == 0 ? 80 : 0, keep_count: (.raw_index == 0 || .raw_index == 50) ? 80 : 160, audible_start: .raw_index == 0 ? 0 : .raw_index * 160 - 80})
