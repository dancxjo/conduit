    conv_bias >> sub3.conv_bias
    conv_glu_weights >> sub3.conv_glu_weights
    conv_glu_bias >> sub3.conv_glu_bias
    pitch_gate_weights >> sub3.pitch_gate_weights
    pitch_gate_bias >> sub3.pitch_gate_bias
    gru1_input_weights >> sub3.gru1_input_weights
    gru1_recurrent_weights >> sub3.gru1_recurrent_weights
    gru2_input_weights >> sub3.gru2_input_weights
    gru2_recurrent_weights >> sub3.gru2_recurrent_weights
    gru3_input_weights >> sub3.gru3_input_weights
    gru3_recurrent_weights >> sub3.gru3_recurrent_weights
    gru1_glu_weights >> sub3.gru1_glu_weights
    gru1_glu_bias >> sub3.gru1_glu_bias
    gru2_glu_weights >> sub3.gru2_glu_weights
    gru2_glu_bias >> sub3.gru2_glu_bias
    gru3_glu_weights >> sub3.gru3_glu_weights
    gru3_glu_bias >> sub3.gru3_glu_bias
    skip_weights >> sub3.skip_weights
    skip_bias >> sub3.skip_bias
    skip_glu_weights >> sub3.skip_glu_weights
    skip_glu_bias >> sub3.skip_glu_bias
    output_weights >> sub3.output_weights
    output_bias >> sub3.output_bias
    sub3.result >> replace3.value
    replace3.result >> final.value
    final.result >> result
}
