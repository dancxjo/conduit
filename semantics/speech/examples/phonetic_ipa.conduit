# Real Unicode IPA; neither an inventory nor universal phone identity is inferred.
plot ipa-authoring (
 outcome: SpeechPhoneticIpaOutcome...| <= 262144B >>
) {
 admit: speech/phonetic-from-ipa(request = { original: "ˈt͡ʃtʰn̩ãː.ˌd͡ʒ", profile: { identity: "ipa/authoring-subset@1", revision: "revision/1", units: [{ identity: "ipa/unit/0", spelling: "t͡ʃ", kind: segment(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/1", spelling: "d͡ʒ", kind: segment(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/2", spelling: "tʰ", kind: segment(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/3", spelling: "n̩", kind: segment(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/4", spelling: "ã", kind: segment(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/5", spelling: "ˈ", kind: primary_stress(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/6", spelling: "ˌ", kind: secondary_stress(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/7", spelling: "ː", kind: length(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }, { identity: "ipa/unit/8", spelling: ".", kind: syllable_boundary(""), provenance: { source: manual(""), method: "authored IPA", version: none("") } }], aliases: [{ source: "ã", target: "ipa/unit/4", provenance: { source: manual(""), method: "authored IPA", version: none("") } }], provenance: { source: manual(""), method: "authored IPA", version: none("") } }, provenance: { source: manual(""), method: "authored IPA", version: none("") } })
 admit.outcome >> outcome
}.
