# Full explicit inventory, variety, revision and spelling bindings. No voice,
# inferred contrast, allophone selection or playback authority is requested.
plot quoted-phonemic (
    value: SpeechPhonemicTranscription <= 262144B >>
) {
    parsed: speech/phonemic-from-ipa( request = {original: "ˈt͡ʃaː", provenance: {method: "quoted phonemic fixture", source: manual(""), version: none("")}}, inventory = {identity: "inventory/test", language: "language/test", phones: [], phonemes: [ {identity: "phoneme/ch", notation: "t͡ʃ", features: [], aliases: [], default_phone: none(""), possible_phones: [], allophones: [], status: core("")}, {identity: "phoneme/long-a", notation: "aː", features: [], aliases: [], default_phone: none(""), possible_phones: [], allophones: [], status: core("")} ]}, basis = {inventory_id: "inventory/test", language: "language/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, profile: { identity: "notation/test", inventory_id: "inventory/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, aliases: [], provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}, units: [ {identity: "unit/ch", spelling: "t͡ʃ", kind: segment(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/a", spelling: "a", kind: segment(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/length", spelling: "ː", kind: length(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/stress", spelling: "ˈ", kind: primary_stress(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}} ] }}, phone-bindings = {values: []}, phoneme-bindings = {values: [ {phoneme: "phoneme/ch", units: ["unit/ch"], provenance: {method: "declared contrast", source: manual(""), version: none("")}}, {phoneme: "phoneme/long-a", units: ["unit/a", "unit/length"], provenance: {method: "declared contrast", source: manual(""), version: none("")}} ]} )
    parsed.value >> value
}.
