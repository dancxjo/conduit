# Full explicit inventory, variety, revision and spelling bindings. No voice,
# inferred contrast, allophone selection or playback authority is requested.
plot quoted-phonemic (
    value: SpeechPhonemicTranscription <= 262144B >>
) {
    parsed: speech/phonemic-from-ipa( request = {original: "ˈt͡ʃaː", provenance: {method: "quoted phonemic fixture", source: manual(empty), version: none(empty)}}, inventory = {identity: "inventory/test", language: "language/test", phones: [], phonemes: [ {identity: "phoneme/ch", notation: "t͡ʃ", features: [], aliases: [], default_phone: none(empty), possible_phones: [], allophones: [], status: core(empty)}, {identity: "phoneme/long-a", notation: "aː", features: [], aliases: [], default_phone: none(empty), possible_phones: [], allophones: [], status: core(empty)} ]}, basis = {inventory_id: "inventory/test", language: "language/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, profile: { identity: "notation/test", inventory_id: "inventory/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, aliases: [], provenance: {method: "explicit notation fixture", source: manual(empty), version: none(empty)}, units: [ {identity: "unit/ch", spelling: "t͡ʃ", kind: segment(empty), provenance: {method: "explicit notation fixture", source: manual(empty), version: none(empty)}}, {identity: "unit/a", spelling: "a", kind: segment(empty), provenance: {method: "explicit notation fixture", source: manual(empty), version: none(empty)}}, {identity: "unit/length", spelling: "ː", kind: length(empty), provenance: {method: "explicit notation fixture", source: manual(empty), version: none(empty)}}, {identity: "unit/stress", spelling: "ˈ", kind: primary_stress(empty), provenance: {method: "explicit notation fixture", source: manual(empty), version: none(empty)}} ] }}, phone-bindings = {values: []}, phoneme-bindings = {values: [ {phoneme: "phoneme/ch", units: ["unit/ch"], provenance: {method: "declared contrast", source: manual(empty), version: none(empty)}}, {phoneme: "phoneme/long-a", units: ["unit/a", "unit/length"], provenance: {method: "declared contrast", source: manual(empty), version: none(empty)}} ]} )
    parsed.value >> value
}.
