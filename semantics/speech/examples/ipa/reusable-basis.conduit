# One declared immutable reviewed scope; ordinary exact typed locals.
# Universal phonetic notation remains independent of this inventory.
plot reusable-basis (
    first: SpeechPhonemicTranscription <= 262144B >>
    second: SpeechPhonemicTranscription <= 262144B >>
    unit: SpeechPhonemeNotation <= 262144B >>
) {
    reviewed-inventory = {identity: "inventory/test", language: "language/test", phones: [], phonemes: [ {identity: "phoneme/ch", notation: "t͡ʃ", features: [], aliases: [], default_phone: none(""), possible_phones: [], allophones: [], status: core("")}, {identity: "phoneme/long-a", notation: "aː", features: [], aliases: [], default_phone: none(""), possible_phones: [], allophones: [], status: core("")} ]}
    reviewed-basis = {inventory_id: "inventory/test", language: "language/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, profile: { identity: "notation/test", inventory_id: "inventory/test", revision: "revision/test", variety: {identity: "variety/test", language: "language/test"}, aliases: [], provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}, units: [ {identity: "unit/ch", spelling: "t͡ʃ", kind: segment(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/a", spelling: "a", kind: segment(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/length", spelling: "ː", kind: length(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}}, {identity: "unit/stress", spelling: "ˈ", kind: primary_stress(""), provenance: {method: "explicit notation fixture", source: manual(""), version: none("")}} ] }}
    reviewed-phone-bindings = {values: []}
    reviewed-phoneme-bindings = {values: [ {phoneme: "phoneme/ch", units: ["unit/ch"], provenance: {method: "declared contrast", source: manual(""), version: none("")}}, {phoneme: "phoneme/long-a", units: ["unit/a", "unit/length"], provenance: {method: "declared contrast", source: manual(""), version: none("")}} ]}
    one: speech/phonemic-from-ipa( request = {original: "ˈt͡ʃaː", provenance: {method: "reusable basis one", source: manual(""), version: none("")}}, inventory = reviewed-inventory, basis = reviewed-basis, phone-bindings = reviewed-phone-bindings, phoneme-bindings = reviewed-phoneme-bindings )
    two: speech/phonemic-from-ipa( request = {original: "aːt͡ʃ", provenance: {method: "reusable basis two", source: manual(""), version: none("")}}, inventory = reviewed-inventory, basis = reviewed-basis, phone-bindings = reviewed-phone-bindings, phoneme-bindings = reviewed-phoneme-bindings )
    single: speech/phoneme-from-ipa( request = {original: "t͡ʃ", provenance: {method: "reusable basis single", source: manual(""), version: none("")}}, inventory = reviewed-inventory, basis = reviewed-basis, phone-bindings = reviewed-phone-bindings, phoneme-bindings = reviewed-phoneme-bindings )
    one.value >> first
    two.value >> second
    single.value >> unit
}.
