# Explicit semantic choice policy; it is not capture or execution authority.
type SpeechAllophoneChoicePolicy = {
    productive: Boolean
    lexicalized: Boolean
    optional: Boolean
    style_dependent: Boolean
    experimental: Boolean
    allow_default: Boolean
}
type SpeechRuleStatusChoiceInput = {
    status: SpeechRuleStatus
    policy: SpeechAllophoneChoicePolicy
}
plot speech/rule-status-choice (
    >> value: SpeechRuleStatusChoiceInput
    result: Boolean >>
) = (.status is productive ? .policy.productive : .status is lexicalized ? .policy.lexicalized : .status is optional ? .policy.optional : .status is style_dependent ? .policy.style_dependent : .policy.experimental)

type SpeechAllophoneChoiceOutcome =
    none
    | selected_allophone
    | deferred
    | selected_default

# The pure transition carrier has exactly the meaningful states. A deferred
# case cannot carry a match or mismatch reason; none/default carry no index.
type SpeechAllophoneCandidateIndex = {
    index: U32 in 0..=7
}
type SpeechAllophoneChoiceFold =
    none
    | selected_allophone SpeechAllophoneCandidateIndex
    | requirement_deferred SpeechAllophoneCandidateIndex
    | observation_deferred SpeechAllophoneCandidateIndex
    | selected_default

# The preparation receipt retains the public outcome/reason vocabulary, with
# native law validation. Pure Plots construct the sum carrier above instead.
type SpeechAllophoneChoiceState = {
    outcome: SpeechAllophoneChoiceOutcome
    index: U32 in 0..=7
    reason: SpeechContextDecision
    where .outcome is deferred ? (.reason is requirement_unresolved || .reason is observation_unresolved) : true
    where .outcome is selected_allophone ? .reason is matched : true
    where .outcome is selected_default ? (.index == 0 && .reason is matched) : true
    where .outcome is none ? (.index == 0 && .reason is mismatched) : true
}
type SpeechAllophoneChoiceInput = {
    state: SpeechAllophoneChoiceFold
    index: U32 in 0..=7
    admitted: Boolean
    decision: SpeechContextDecision
}
plot speech/allophone-choice-step (
    >> value: SpeechAllophoneChoiceInput
    result: SpeechAllophoneChoiceFold >>
) = (!(.state is none) || !.admitted || .decision is mismatched ? .state : .decision is matched ? SpeechAllophoneChoiceFold.selected_allophone({index: .index}) : .decision is requirement_unresolved ? SpeechAllophoneChoiceFold.requirement_deferred({index: .index}) : SpeechAllophoneChoiceFold.observation_deferred({index: .index}))

type SpeechAllophoneChoiceFinishInput = {
    state: SpeechAllophoneChoiceFold
    allow_default: Boolean
    default_available: Boolean
}
plot speech/allophone-choice-finish (
    >> value: SpeechAllophoneChoiceFinishInput
    result: SpeechAllophoneChoiceFold >>
) = (.state is none && .allow_default && .default_available ? SpeechAllophoneChoiceFold.selected_default : .state)

# A Known phone remains a constraint, not permission to replace it. Unspecified
# is the explicit unconstrained request; other states are unresolved/refused.
plot speech/phone-choice-requirement-supported (
    >> value: SpeechSpecificationState
    result: Boolean >>
) = (. is known || . is unspecified)

type SpeechAllophoneCandidateEligibility = {
    status_allowed: Boolean
    phone_compatible: Boolean
}
plot speech/allophone-candidate-eligible (
    >> value: SpeechAllophoneCandidateEligibility
    result: Boolean >>
) = (.status_allowed && .phone_compatible)
