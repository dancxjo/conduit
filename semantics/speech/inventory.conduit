# Definition lookup binds an exact material basis to a supplied inventory.
# A symbol, IPA string or identical ordinal does not establish membership.
type SpeechPhoneInventoryBasis = {
    basis: SpeechTokenSequenceBasis
    inventory_id: SpeechInventoryId
    inventory_language: LanguageId
    where .basis.inventory_id == .inventory_id
    where .basis.language == .inventory_language
}
type SpeechPhoneDefinitionMatch = {
    requested: PhoneId
    definition: PhoneId
    where .requested == .definition
}

# Intent is a requested realization, not an observed material token.
type SpeechIntentInventoryBasis = {
    intent_inventory_id: SpeechInventoryId
    intent_language: LanguageId
    inventory_id: SpeechInventoryId
    inventory_language: LanguageId
    where .intent_inventory_id == .inventory_id
    where .intent_language == .inventory_language
}

# Phoneme and phone identity remain different domains even when their spelling
# is identical. This law checks only exact supplied phoneme definition lookup.
type SpeechPhonemeDefinitionMatch = {
    requested: PhonemeId
    definition: PhonemeId
    where .requested == .definition
}

type SpeechFeatureValueMatch = {
    requested: SpeechFeatureValue
    observed: SpeechFeatureValue
    where .requested == .observed
}

type SpeechFeatureIdentityMatch = {
    requested: SpeechFeatureId
    observed: SpeechFeatureId
    where .requested == .observed
}

# Pattern evidence compares observed identities; it does not assert a definition
# lookup, inventory membership, notation equivalence or phone/phoneme coercion.
type SpeechPhonemePatternIdentity = {
    required: PhonemeId
    observed: PhonemeId
    where .required == .observed
}
type SpeechPhonePatternIdentity = {
    required: PhoneId
    observed: PhoneId
    where .required == .observed
}

# Explicit current-feature evidence remains occurrence-scoped and provenance-
# bearing. This is an observation claim, not authenticity or authority.
type SpeechOccurrenceFeatureObservation = {
    occurrence: LanguageSpeechTokenRef
    features: SpeechFeatureBundle
    provenance: SpeechEvidenceProvenance
}
type SpeechOccurrenceObservationMatch = {
    expected: LanguageSpeechTokenRef
    observed: LanguageSpeechTokenRef
    where .expected == .observed
}

# Explicit ordered global rules for one supplied inventory/language profile.
# This does not establish inventory membership or status permission.
type SpeechAllophoneRuleProfile = {
    inventory_id: SpeechInventoryId
    language: LanguageId
    rules: sequence SpeechAllophoneRule <= 8
}
