 10304, b3: -9715, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, bypass_gain: 0, voiced: 0, frication: 1, frames: 640, closure: 0 } : { f1: 500, f2: 1300, f3: 2400, b1: 26386, b2: 13264, b3: -6837, c1: -12446, c2: -9834, c3: -7470, gain1: 2104, gain2: 2215, gain3: 1862, bypass_gain: 0, voiced: 0, frication: 1, frames: 640, closure: 240 })) : (.phone is t_aspirated ? { f1: 1000, f2: 3000, f3: 3700, b1: 19417, b2: -19040, b3: -24205, c1: -11506, c2: -11063, c3: -9455, gain1: 398, gain2: 2921, gain3: 4725, bypass_gain: 0, voiced: 0, frication: 1, frames: 640, closure: 240 } : (.phone is k_aspirated ? { f1: 600, f2: 2000, f3: 2700, b1: 25952, b2: 0, b3: -14632, c1: -12945, c2: -13463, c3: -11967, gain1: 455, gain2: 1685, gain3: 1548, bypass_gain: 0, voiced: 0, frication: 1, frames: 640, closure: 240 } : { f1: 400, f2: 1600, f3: 2600, b1: 27162, b2: 8321, b3: -11525, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, bypass_gain: 0, voiced: 1, frication: 0, frames: 640, closure: 0 }))))))})

plot speech/voice-target (
    >> value: EnglishPhone
    result: SpeechAcousticTarget >>
) {
    lookup: speech/voice-model(item = SpeechPhoneOnlyRequest, output = SpeechPhoneOnlyModel)
    value >> ({phone: ., context: SpeechEndpointContext.model_only}) >> lookup.value
    lookup.result >> (.target) >> result
}

plot speech/segment-model (
    >> value: RealizationInput
    result: SpeechSegmentModel >>
) {
    realize: speech/realize
    selected: speech/selected-segment-model
    value >> realize.value
    realize.result >> selected.value
    selected.result >> result
}


# Consume an explicit selected realization without running phonology again.
# This preserves the supplied derivation; it does not attest its provenance.
plot speech/selected-segment-model (
    >> value: RealizationResult
    result: SpeechSegmentModel >>
) {
    lookup: speech/voice-model(item = SpeechRealizedRequest, output = SpeechRealizedModel)
    value >> ({phone: .phone, context: .}) >> lookup.value
    lookup.result >> ({realization: .input.context, target: .target}) >> result
}


# A directly supplied phone has no invented source phoneme or word position.
type SpeechPhoneInput = {
    phone: EnglishPhone
    stress: EnglishStress
}
type SpeechRenderSegment = {
    phone: EnglishPhone
    stress: EnglishStress
    target: SpeechAcousticTarget
}
type SpeechDirectPhoneRequest = SpeechPhoneCarry<SpeechPhoneInput>
type SpeechDirectPhoneModel = SpeechPhoneModel<SpeechPhoneInput>
plot speech/direct-phone-model (
    >> value: SpeechPhoneInput
    result: SpeechRenderSegment >>
) {
    lookup: speech/voice-model(item = SpeechDirectPhoneRequest, output = SpeechDirectPhoneModel)
    value >> ({phone: .phone, context: .}) >> lookup.value
    lookup.result >> ({phone: .input.phone, stress: .input.context.stress, target: .target}) >> result
}
# Project rendering coordinates without discarding the event tape's realization.
# The shared target lookup does not need phonemic input or derivation metadata.
plot speech/realization-render-segment (
    >> value: RealizationResult
    result: SpeechRenderSegment >>
) {
    model: speech/direct-phone-model
    value >> ({phone: .phone, stress: .input.stress}) >> model.value
    model.result >> result
}
plot speech/render-segment (
    >> value: SpeechSegmentModel
    result: SpeechRenderSegment >>
) = ({phone: .realization.phone, stress: .realization.input.stress, target: .target})


type DriveInput = {
    sample: I32
    gain: I32
}
plot speech/drive (
    >> value: DriveInput
    result: I32 >>
) = (.sample * .gain)

type EnvelopeInput = {
    attack: Boolean
    release: Boolean
    frame: I32
    total: I32
    closure: I32
}
plot speech/envelope (
    >> value: EnvelopeInput
    result: I32 >>
) = (.frame < .closure ? 0 : .closure > 0 ? (.release && .total - .frame < 64 ? (.total - .frame) * 4 : 256) : .attack && .frame - .closure < 64 ? (.frame - .closure) * 4 : .release && .total - .frame < 64 ? (.total - .frame) * 4 : 256)

# A boundary is not a phone and an absence is not silence.
type VoiceBoundary =
    word
    | phrase
    | turn

type VoiceEvent =
    segment RealizationInput
    | pronounced TextSpeechSegment
    | boundary VoiceBoundary
    | selected RealizationResult
    | phone SpeechPhoneInput

plot speech/pause (
    >> value: VoiceBoundary
    result: I32 >>
) = (. is word ? 240 : . is phrase ? 1200 : 2000)

# Composition is authored connectivity, not a Rust sequence of DSP calls.
plot speech/filter-limit (
    >> value: ResonatorInput
    result: I32 >>
) {
    filter: speech/resonator
    limit: speech/limit
    value >> filter.value
    filter.result >> limit.value
    limit.result >> result
}

# State is an exact value carried through one bounded sample transition.
type SpeechFrameState = {
    voicing: I32
    phase: I32
    noise: I32
    first1: I32
    first2: I32
    second1: I32
    second2: I32
    third1: I32
    third2: I32
}
# The explicit-cycle realization uses Q8 sample coordinates. Profile selection
# remains distinct; a zero period never stands for an unknown cycle or silence.
type SpeechCycleControlMode =
    profile
    | resolved
# Private numeric realization carrier; native cycle specifications and retained
# projection receipts own semantic meaning. Mode distinguishes profile choice.
type SpeechFrameCycleControl = {
    mode: SpeechCycleControlMode
    phase_q8: I32
    period_q8: I32
}
type SpeechFrameInput = {
    cycle: SpeechFrameCycleControl
    attack: Boolean
    release: Boolean
    target: SpeechAcousticTarget
    period: I32
    frame: I32
    state: SpeechFrameState
}
type SpeechFrameWorking = {
    phase_q8: I32
    input: SpeechFrameInput
    voicing: I32
    upper_excitation: I32
    phase: I32
    noise: I32
    excitation: I32
    first: I32
    second: I32
    third: I32
    envelope: I32
}
type SpeechFrameResult = {
    phase_q8: I32
    state: SpeechFrameState
    sample: I32
}
type SpeechFrameSourceRequest = SpeechSubframeSourceCarry<SpeechFrameInput>
type SpeechFrameSourcePhase = SpeechSubframeSourcePhase<SpeechFrameInput>
type SpeechFrameSourceFlow = SpeechSubframeSourceFlow<SpeechFrameInput>
type SpeechFrameSourceResult = SpeechSubframeSourceResult<SpeechFrameInput>
# Subframe phonation retains the existing separate voicing/noise roles.
plot speech/frame-source-result (
    >> value: SpeechFrameSourceResult
    result: SpeechFrameWorking >>
) = ({phase_q8: .input.context.cycle.mode is profile ? (.input.context.state.phase + 1 >= .input.context.period ? 0 : .input.context.state.phase + 1) * 256 : (.input.source.phase_q8 + 256) % .input.source.period_q8, input: .input.context, voicing: .voicing, upper_excitation: (.input.context.target.voiced == 1 && .input.context.target.frication == 1 && .input.context.target.closure == 0) ? .sample - .voicing : (.input.context.target.voiced == 1 && .input.context.target.frication == 0) ? .voicing - .input.context.state.voicing : .sample, phase: .input.context.cycle.mode is profile ? (.input.context.state.phase + 1 >= .input.context.period ? 0 : .input.context.state.phase + 1) : ((.input.source.phase_q8 + 256) % .input.source.period_q8) / 256, noise: .input.source.noise, excitation: .sample, first: 0, second: 0, third: 0, envelope: (.input.context.frame < .input.context.target.closure ? 0 : .input.context.target.closure > 0 ? (.input.context.release && .input.context.target.frames - .input.context.frame < 64 ? (.input.context.target.frames - .input.context.frame) * 4 : 256) : .input.context.attack && .input.context.frame - .input.context.target.closure < 64 ? (.input.context.frame - .input.context.target.closure) * 4 : .input.context.release && .input.context.target.frames - .input.context.frame < 64 ? (.input.context.target.frames - .input.context.frame) * 4 : 256)})
plot speech/frame-excite (
    >> value: SpeechFrameInput
    result: SpeechFrameWorking >>
) {
    phase: speech/subframe-source-phase(item = SpeechFrameSourceRequest, output = SpeechFrameSourcePhase)
    flow: speech/source-flow(item = SpeechFrameSourcePhase, output = SpeechFrameSourceFlow)
    mix: speech/source-mix(item = SpeechFrameSourceFlow, output = SpeechFrameSourceResult)
    finish: speech/frame-source-result
    value >> ({source: {phase_q8: .cycle.mode is profile ? .state.phase * 256 : .cycle.phase_q8, period_q8: .cycle.mode is profile ? .period * 256 : .cycle.period_q8, open_q8: .cycle.mode is profile ? (.period * 3 / 4) * 256 : (.cycle.period_q8 * 3 / 4 / 256) * 256, noise: (.state.noise * 25173 + 13849) % 65536, voiced: .target.voiced, frication: .target.frication}, context: .}) >> phase.value
    phase.result >> flow.value
    flow.result >> mix.value
    mix.result >> finish.value
    finish.result >> result
}
plot speech/frame-first (
    >> value: SpeechFrameWorking
    result: SpeechFrameWorking >>
) = ({phase_q8: .phase_q8, input: .input, voicing: .voicing, upper_excitation: .upper_excitation, phase: .phase, noise: .noise, excitation: .excitation, first: (((((.input.target.voiced == 1 && .input.target.frication == 1 && .input.target.closure == 0) ? .voicing : .excitation) * .input.target.gain1 + .input.target.b1 * .input.state.first1 + .input.target.c1 * .input.state.first2) / 16384) < -32767 ? -32767 : ((((.input.target.voiced == 1 && .input.target.frication == 1 && .input.target.closure == 0) ? .voicing : .excitation) * .input.target.gain1 + .input.target.b1 * .input.state.first1 + .input.target.c1 * .input.state.first2) / 16384) > 32767 ? 32767 : ((((.input.target.voiced == 1 && .input.target.frication == 1 && .input.target.closure == 0) ? .voicing : .excitation) * .input.target.gain1 + .input.target.b1 * .input.state.first1 + .input.target.c1 * .input.state.first2) / 16384)), second: .second, third: .third, envelope: .envelope})
plot speech/frame-second (
    >> value: SpeechFrameWorking
    result: SpeechFrameWorking >>
) = ({phase_q8: .phase_q8, input: .input, voicing: .voicing, upper_excitation: .upper_excitation, phase: .phase, noise: .noise, excitation: .excitation, first: .first, second: (((.upper_excitation * .input.target.gain2 + .input.target.b2 * .input.state.second1 + .input.target.c2 * .input.state.second2) / 16384) < -32767 ? -32767 : ((.upper_excitation * .input.target.gain2 + .input.target.b2 * .input.state.second1 + .input.target.c2 * .input.state.second2) / 16384) > 32767 ? 32767 : ((.upper_excitation * .input.target.gain2 + .input.target.b2 * .input.state.second1 + .input.target.c2 * .input.state.second2) / 16384)), third: .third, envelope: .envelope})
plot speech/frame-third (
    >> value: SpeechFrameWorking
    result: SpeechFrameWorking >>
) = ({phase_q8: .phase_q8, input: .input, voicing: .voicing, upper_excitation: .upper_excitation, phase: .phase, noise: .noise, excitation: .excitation, first: .first, second: .second, third: (((.upper_excitation * .input.target.gain3 + .input.target.b3 * .input.state.third1 + .input.target.c3 * .input.state.third2) / 16384) < -32767 ? -32767 : ((.upper_excitation * .input.target.gain3 + .input.target.b3 * .input.state.third1 + .input.target.c3 * .input.state.third2) / 16384) > 32767 ? 32767 : ((.upper_excitation * .input.target.gain3 + .input.target.b3 * .input.state.third1 + .input.target.c3 * .input.state.third2) / 16384)), envelope: .envelope})
plot speech/frame-result (
    >> value: SpeechFrameWorking
    result: SpeechFrameResult >>
) = ({phase_q8: .phase_q8, state: {voicing: .voicing, phase: .phase, noise: .noise, first1: .first, first2: .input.state.first1, second1: .second, second2: .input.state.second1, third1: .third, third2: .input.state.third1}, sample: ((.first + .second / 2 + .third / 4 + (.input.target.bypass_gain == 0 ? 0 : .upper_excitation * .input.target.bypass_gain / 256)) * 16 * .envelope / 256) < -32767 ? -32767 : ((.first + .second / 2 + .third / 4 + (.input.target.bypass_gain == 0 ? 0 : .upper_excitation * .input.target.bypass_gain / 256)) * 16 * .envelope / 256) > 32767 ? 32767 : ((.first + .second / 2 + .third / 4 + (.input.target.bypass_gain == 0 ? 0 : .upper_excitation * .input.target.bypass_gain / 256)) * 16 * .envelope / 256)})

plot speech/frame (
    >> value: SpeechFrameInput
    result: SpeechFrameResult >>
) {
    excite: speech/frame-excite
    first: speech/frame-first
    second: speech/frame-second
    third: speech/frame-third
    finish: speech/frame-result
    value >> excite.value
    excite.result >> first.value
    first.result >> second.value
    second.result >> third.value
    third.result >> finish.value
    finish.result >> result
}

# Starting excitation history is source policy, not an ambient random seed.
type SpeechStart =
    begin
    | reset
plot speech/initial-state (
    >> value: SpeechStart
    result: SpeechFrameState >>
) = ({voicing: 0, phase: 0, noise: 1, first1: 0, first2: 0, second1: 0, second2: 0, third1: 0, third2: 0})

# Pauses preserve phase and filter history; silence is an explicit output.
type SpeechBoundaryFrameInput = {
    state: SpeechFrameState
    phase_q8: I32
}
plot speech/boundary-frame (
    >> value: SpeechBoundaryFrameInput
    result: SpeechFrameResult >>
) = ({phase_q8: .phase_q8, state: .state, sample: 0})

# These are this compact voice profile's preparation and block admission limits.
# The acoustic coefficients above are authored for exactly this sample rate.
type SpeechRenderProfile = {
    sample_rate_hz: U32
    maximum_events: U32
    maximum_block_frames: U32
    maximum_utterance_frames: U64
    maximum_text_bytes: U32
    maximum_word_bytes: U32
}
plot speech/profile (
    >> value: SpeechStart
    result: SpeechRenderProfile >>
) = ({sample_rate_hz: 8000, maximum_events: 256, maximum_block_frames: 128, maximum_utterance_frames: 240000, maximum_text_bytes: 512, maximum_word_bytes: 32})
