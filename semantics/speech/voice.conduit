type EnglishPhoneme =
    iy
    | ih
    | ey
    | eh
    | ae
    | aa
    | ao
    | ow
    | uh
    | uw
    | ah
    | ax
    | er
    | ay
    | aw
    | oy
    | p
    | b
    | t
    | d
    | k
    | g
    | f
    | v
    | th
    | dh
    | s
    | z
    | sh
    | zh
    | ch
    | jh
    | m
    | n
    | ng
    | l
    | r
    | w
    | y
    | h

type EnglishPhone =
    iy
    | ih
    | ey
    | eh
    | ae
    | aa
    | ao
    | ow
    | uh
    | uw
    | ah
    | ax
    | er
    | ay
    | aw
    | oy
    | p
    | b
    | t
    | d
    | k
    | g
    | f
    | v
    | th
    | dh
    | s
    | z
    | sh
    | zh
    | ch
    | jh
    | m
    | n
    | ng
    | l
    | r
    | w
    | y
    | h
    | p_aspirated
    | t_aspirated
    | k_aspirated
    | alveolar_flap

type EnglishStress =
    primary
    | secondary
    | unstressed
    | reduced
    | unknown
    | unspecified

type EnglishPosition =
    initial
    | medial
    | final
    | isolated
    | unknown

type EnglishDerivation =
    allophone_rule
    | voice_profile

# All excitation, resonator, limiting and spelling policy lives in checked plots.
# Q14 coefficients; explicit state in/out, no ambient clock or random source.
type ResonatorInput = {
    drive: I32
    b: I32
    c: I32
    y1: I32
    y2: I32
}
plot speech/resonator (
    >> value: ResonatorInput
    result: I32 >>
) = ((.drive + .b * .y1 + .c * .y2) / 16384)

plot speech/limit (
    >> value: I32
    result: I32 >>
) = (. < -32767 ? -32767 : . > 32767 ? 32767 : .)

plot speech/lowercase (
    >> value: I32
    result: I32 >>
) = (. >= 65 && . <= 90 ? . + 32 : .)

type ExcitationInput = {
    phase: I32
    period: I32
    noise: I32
    voiced: I32
    frication: I32
}

plot speech/noise (
    >> value: I32
    result: I32 >>
) = ((. * 25173 + 13849) % 65536)

type PhaseInput = {
    phase: I32
    period: I32
}
plot speech/phase (
    >> value: PhaseInput
    result: I32 >>
) = (.phase + 1 >= .period ? 0 : .phase + 1)

type MixInput = {
    first: I32
    second: I32
    third: I32
    bypass: I32
    envelope: I32
}
# Fixed profile output level; the final limiter remains explicit.
plot speech/mix (
    >> value: MixInput
    result: I32 >>
) = ((.first + .second / 2 + .third / 4 + .bypass) * 16 * .envelope / 256)

# Phoneme identity is never a Phone identity. This is the selected English
# realization policy, not an acoustic observation or inventory universal.
type RealizationInput = {
    phoneme: EnglishPhoneme
    stress: EnglishStress
    position: EnglishPosition
}
type RealizationResult = {
    input: RealizationInput
    phone: EnglishPhone
    derivation: EnglishDerivation
}
plot speech/realize (
    >> value: RealizationInput
    result: RealizationResult >>
) = ({input: ., phone: (((((.phoneme is iy || .phoneme is ih) || (.phoneme is ey || (.phoneme is eh || .phoneme is ae))) || ((.phoneme is aa || .phoneme is ao) || (.phoneme is ow || (.phoneme is uh || .phoneme is uw)))) || (((.phoneme is ah || .phoneme is ax) || (.phoneme is er || (.phoneme is ay || .phoneme is aw))) || ((.phoneme is oy || .phoneme is p) || (.phoneme is b || (.phoneme is t || .phoneme is d))))) ? ((((.phoneme is iy || .phoneme is ih) || (.phoneme is ey || (.phoneme is eh || .phoneme is ae))) || ((.phoneme is aa || .phoneme is ao) || (.phoneme is ow || (.phoneme is uh || .phoneme is uw)))) ? (((.phoneme is iy || .phoneme is ih) || (.phoneme is ey || (.phoneme is eh || .phoneme is ae))) ? ((.phoneme is iy || .phoneme is ih) ? (.phoneme is iy ? EnglishPhone.iy : EnglishPhone.ih) : (.phoneme is ey ? EnglishPhone.ey : (.phoneme is eh ? EnglishPhone.eh : EnglishPhone.ae))) : ((.phoneme is aa || .phoneme is ao) ? (.phoneme is aa ? EnglishPhone.aa : EnglishPhone.ao) : (.phoneme is ow ? EnglishPhone.ow : (.phoneme is uh ? EnglishPhone.uh : EnglishPhone.uw)))) : (((.phoneme is ah || .phoneme is ax) || (.phoneme is er || (.phoneme is ay || .phoneme is aw))) ? ((.phoneme is ah || .phoneme is ax) ? (.phoneme is ah ? EnglishPhone.ah : EnglishPhone.ax) : (.phoneme is er ? EnglishPhone.er : (.phoneme is ay ? EnglishPhone.ay : EnglishPhone.aw))) : ((.phoneme is oy || .phoneme is p) ? (.phoneme is oy ? EnglishPhone.oy : (.position is initial && .stress is primary ? EnglishPhone.p_aspirated : EnglishPhone.p)) : (.phoneme is b ? EnglishPhone.b : (.phoneme is t ? (.position is initial && .stress is primary ? EnglishPhone.t_aspirated : EnglishPhone.t) : EnglishPhone.d))))) : ((((.phoneme is k || .phoneme is g) || (.phoneme is f || (.phoneme is v || .phoneme is th))) || ((.phoneme is dh || .phoneme is s) || (.phoneme is z || (.phoneme is sh || .phoneme is zh)))) ? (((.phoneme is k || .phoneme is g) || (.phoneme is f || (.phoneme is v || .phoneme is th))) ? ((.phoneme is k || .phoneme is g) ? (.phoneme is k ? (.position is initial && .stress is primary ? EnglishPhone.k_aspirated : EnglishPhone.k) : EnglishPhone.g) : (.phoneme is f ? EnglishPhone.f : (.phoneme is v ? EnglishPhone.v : EnglishPhone.th))) : ((.phoneme is dh || .phoneme is s) ? (.phoneme is dh ? EnglishPhone.dh : EnglishPhone.s) : (.phoneme is z ? EnglishPhone.z : (.phoneme is sh ? EnglishPhone.sh : EnglishPhone.zh)))) : (((.phoneme is ch || .phoneme is jh) || (.phoneme is m || (.phoneme is n || .phoneme is ng))) ? ((.phoneme is ch || .phoneme is jh) ? (.phoneme is ch ? EnglishPhone.ch : EnglishPhone.jh) : (.phoneme is m ? EnglishPhone.m : (.phoneme is n ? EnglishPhone.n : EnglishPhone.ng))) : ((.phoneme is l || .phoneme is r) ? (.phoneme is l ? EnglishPhone.l : EnglishPhone.r) : (.phoneme is w ? EnglishPhone.w : (.phoneme is y ? EnglishPhone.y : EnglishPhone.h)))))), derivation: .position is initial && .stress is primary && (.phoneme is p || .phoneme is t || .phoneme is k) ? EnglishDerivation.allophone_rule : EnglishDerivation.voice_profile})

type SpeechAcousticTarget = {
    f1: I32
    f2: I32
    f3: I32
    b1: I32
    b2: I32
    b3: I32
    c1: I32
    c2: I32
    c3: I32
    gain1: I32
    gain2: I32
    gain3: I32
    bypass_gain: I32
    voiced: I32
    frication: I32
    frames: I32
    closure: I32
}

# Continuous diffuse fricatives use a Q8 direct-noise bypass; sibilants
# suppress the low noise band. Voiced partners retain their low voicing bar.
# Other source classes keep bypass_gain zero, including closure/release models.
# Stop spectra are self-authored reduced-bandwidth models. Q14 coefficients
# are rounded from radius=exp(-pi*bandwidth/8000), b=2*radius*cos(2*pi*f/8000),
# c=-radius*radius; gain sets each parallel branch's relative level. Plain
# voiceless stops release near their end; voiced releases leave a voiced tail.
# Models (Hz bandwidths, relative branch levels): p/b 350,650,1000; 1,.6,.35;
# t/d 450,500,700; .15,1,1.2; k/g 300,250,400; .25,1.1,.65.
# These profile defaults are not context-dependent phonetic measurements.
# A model-only query and a realized-segment query share one table policy.
type SpeechPhoneCarry<C> = {
    phone: EnglishPhone
    context: C
}
type SpeechPhoneModel<C> = {
    input: SpeechPhoneCarry<C>
    target: SpeechAcousticTarget
}
type SpeechPhoneOnlyRequest = SpeechPhoneCarry<SpeechEndpointContext>
type SpeechPhoneOnlyModel = SpeechPhoneModel<SpeechEndpointContext>
type SpeechRealizedRequest = SpeechPhoneCarry<RealizationResult>
type SpeechRealizedModel = SpeechPhoneModel<RealizationResult>
type SpeechSegmentModel = {
    realization: RealizationResult
    target: SpeechAcousticTarget
}
plot speech/voice-model (
    item: type
    output: type
    >> value: item
    result: output >>
) = ({input: ., target: (((((.phone is iy || .phone is ih) || (.phone is ey || (.phone is eh || .phone is ae))) || ((.phone is aa || (.phone is ao || .phone is ow)) || (.phone is uh || (.phone is uw || .phone is ah)))) || (((.phone is ax || .phone is er) || (.phone is ay || (.phone is aw || .phone is oy))) || ((.phone is p || (.phone is b || .phone is t)) || (.phone is d || (.phone is k || .phone is g))))) ? ((((.phone is iy || .phone is ih) || (.phone is ey || (.phone is eh || .phone is ae))) || ((.phone is aa || (.phone is ao || .phone is ow)) || (.phone is uh || (.phone is uw || .phone is ah)))) ? (((.phone is iy || .phone is ih) || (.phone is ey || (.phone is eh || .phone is ae))) ? ((.phone is iy || .phone is ih) ? (.phone is iy ? { f1: 270, f2: 2290, f3: 3010, b1: 31165, b2: -7114, b3: -22103, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : { f1: 390, f2: 1990, f3: 2550, b1: 30396, b2: 247, b3: -12985, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 }) : (.phone is ey ? { f1: 450, f2: 2050, f3: 2700, b1: 29909, b2: -1237, b3: -16205, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : (.phone is eh ? { f1: 530, f2: 1840, f3: 2480, b1: 29157, b2: 3949, b3: -11417, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : { f1: 660, f2: 1720, f3: 2410, b1: 27692, b2: 6873, b3: -9816, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 }))) : ((.phone is aa || (.phone is ao || .phone is ow)) ? (.phone is aa ? { f1: 730, f2: 1090, f3: 2440, b1: 26782, b2: 20649, b3: -10506, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : (.phone is ao ? { f1: 570, f2: 840, f3: 2410, b1: 28738, b2: 24895, b3: -9816, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : { f1: 500, f2: 900, f3: 2400, b1: 29453, b2: 23957, b3: -9584, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 })) : (.phone is uh ? { f1: 440, f2: 1020, f3: 2240, b1: 29995, b2: 21926, b3: -5812, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : (.phone is uw ? { f1: 300, f2: 870, f3: 2240, b1: 30999, b2: 24433, b3: -5812, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : { f1: 640, f2: 1190, f3: 2390, b1: 27936, b2: 18718, b3: -9352, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 })))) : (((.phone is ax || .phone is er) || (.phone is ay || (.phone is aw || .phone is oy))) ? ((.phone is ax || .phone is er) ? (.phone is ax ? { f1: 500, f2: 1500, f3: 2500, b1: 29453, b2: 12057, b3: -11869, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : { f1: 490, f2: 1350, f3: 1690, b1: 29548, b2: 15395, b3: 7477, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 }) : (.phone is ay ? { f1: 730, f2: 1090, f3: 2440, b1: 26782, b2: 20649, b3: -10506, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : (.phone is aw ? { f1: 730, f2: 1090, f3: 2440, b1: 26782, b2: 20649, b3: -10506, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 } : { f1: 570, f2: 840, f3: 2410, b1: 28738, b2: 24895, b3: -9816, c1: -15508, c2: -15146, c3: -14678, gain1: 444, gain2: 631, gain3: 876, bypass_gain: 0, voiced: 1, frication: 0, frames: 960, closure: 0 }))) : ((.phone is p || (.phone is b || .phone is t)) ? (.phone is p ? { f1: 500, f2: 1300, f3: 2400, b1: 26386, b2: 13264, b3: -6837, c1: -12446, c2: -9834, c3: -7470, gain1: 2104, gain2: 2215, gain3: 1862, bypass_gain: 0, voiced: 0, frication: 0, frames: 640, closure: 512 } : (.phone is b ? { f1: 500, f2: 1300, f3: 2400, b1: 26386, b2: 13264, b3: -6837, c1: -12446, c2: -9834, c3: -7470, gain1: 2104, gain2: 2215, gain3: 1862, bypass_gain: 0, voiced: 1, frication: 0, frames: 640, closure: 256 } : { f1: 1000, f2: 3000, f3: 3700, b1: 19417, b2: -19040, b3: -24205, c1: -11506, c2: -11063, c3: -9455, gain1: 398, gain2: 2921, gain3: 4725, bypass_gain: 0, voiced: 0, frication: 0, frames: 640, closure: 512 })) : (.phone is d ? { f1: 1000, f2: 3000, f3: 3700, b1: 19417, b2: -19040, b3: -24205, c1: -11506, c2: -11063, c3: -9455, gain1: 398, gain2: 2921, gain3: 4725, bypass_gain: 0, voiced: 1, frication: 0, frames: 640, closure: 256 } : (.phone is k ? { f1: 600, f2: 2000, f3: 2700, b1: 25952, b2: 0, b3: -14632, c1: -12945, c2: -13463, c3: -11967, gain1: 455, gain2: 1685, gain3: 1548, bypass_gain: 0, voiced: 0, frication: 0, frames: 640, closure: 512 } : { f1: 600, f2: 2000, f3: 2700, b1: 25952, b2: 0, b3: -14632, c1: -12945, c2: -13463, c3: -11967, gain1: 455, gain2: 1685, gain3: 1548, bypass_gain: 0, voiced: 1, frication: 0, frames: 640, closure: 256 }))))) : ((((.phone is f || .phone is v) || (.phone is th || (.phone is dh || .phone is s))) || ((.phone is z || (.phone is sh || .phone is zh)) || (.phone is ch || (.phone is jh || .phone is m)))) ? (((.phone is f || .phone is v) || (.phone is th || (.phone is dh || .phone is s))) ? ((.phone is f || .phone is v) ? (.phone is f ? { f1: 1000, f2: 2800, f3: 3600, b1: 20195, b2: -15827, b3: -24144, c1: -12446, c2: -11063, c3: -9834, gain1: 0, gain2: 0, gain3: 0, bypass_gain: 64, voiced: 0, frication: 1, frames: 640, closure: 0 } : { f1: 250, f2: 2800, f3: 3600, b1: 30419, b2: -15827, b3: -24144, c1: -14678, c2: -11063, c3: -9834, gain1: 876, gain2: 0, gain3: 0, bypass_gain: 64, voiced: 1, frication: 1, frames: 640, closure: 0 }) : (.phone is th ? { f1: 900, f2: 2500, f3: 3300, b1: 21717, b2: -10304, b3: -21645, c1: -12446, c2: -11063, c3: -9834, gain1: 0, gain2: 0, gain3: 0, bypass_gain: 48, voiced: 0, frication: 1, frames: 640, closure: 0 } : (.phone is dh ? { f1: 250, f2: 2500, f3: 3300, b1: 30419, b2: -10304, b3: -21645, c1: -14678, c2: -11063, c3: -9834, gain1: 876, gain2: 0, gain3: 0, bypass_gain: 48, voiced: 1, frication: 1, frames: 640, closure: 0 } : { f1: 1200, f2: 3200, f3: 3800, b1: 16787, b2: -21784, b3: -25073, c1: -12446, c2: -11063, c3: -9834, gain1: 0, gain2: 2921, gain3: 3691, bypass_gain: 0, voiced: 0, frication: 1, frames: 640, closure: 0 }))) : ((.phone is z || (.phone is sh || .phone is zh)) ? (.phone is z ? { f1: 250, f2: 3200, f3: 3800, b1: 30419, b2: -21784, b3: -25073, c1: -14678, c2: -11063, c3: -9834, gain1: 876, gain2: 2921, gain3: 3691, bypass_gain: 0, voiced: 1, frication: 1, frames: 640, closure: 0 } : (.phone is sh ? { f1: 1000, f2: 2100, f3: 3000, b1: 20195, b2: -2113, b3: -17951, c1: -12446, c2: -11063, c3: -9834, gain1: 0, gain2: 2921, gain3: 3691, bypass_gain: 0, voiced: 0, frication: 1, frames: 640, closure: 0 } : { f1: 250, f2: 2100, f3: 3000, b1: 30419, b2: -2113, b3: -17951, c1: -14678, c2: -11063, c3: -9834, gain1: 876, gain2: 2921, gain3: 3691, bypass_gain: 0, voiced: 1, frication: 1, frames: 640, closure: 0 })) : (.phone is ch ? { f1: 1000, f2: 2100, f3: 3000, b1: 20195, b2: -2113, b3: -17951, c1: -12446, c2: -11063, c3: -9834, gain1: 2104, gain2: 2921, gain3: 3691, bypass_gain: 0, voiced: 0, frication: 1, 