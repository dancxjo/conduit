# Acoustic onset context is derived from the selected preceding phone. It is
# neither a new phone occurrence nor a measured articulatory feature.
type SpeechStopPlace =
    not_stop
    | labial
    | alveolar
    | velar
type SpeechPhoneCueContext =
    phone_only
type SpeechStopPlaceCarry<C> = {
    phone: EnglishPhone
    context: C
}
type SpeechStopPlaceResult<C> = {
    input: SpeechStopPlaceCarry<C>
    place: SpeechStopPlace
}
type SpeechStopPlaceOnlyRequest = SpeechStopPlaceCarry<SpeechPhoneCueContext>
type SpeechStopPlaceOnlyResult = SpeechStopPlaceResult<SpeechPhoneCueContext>
plot speech/stop-place-cue (
    item: type
    output: type
    >> value: item
    result: output >>
) = ({input: ., place: ((.phone is p || (.phone is b || .phone is p_aspirated)) ? SpeechStopPlace.labial : (.phone is t || (.phone is d || .phone is t_aspirated)) ? SpeechStopPlace.alveolar : (.phone is k || (.phone is g || .phone is k_aspirated)) ? SpeechStopPlace.velar : SpeechStopPlace.not_stop)})
plot speech/stop-place (
    >> phone: EnglishPhone
    result: SpeechStopPlace >>
) {
    cue: speech/stop-place-cue(item = SpeechStopPlaceOnlyRequest, output = SpeechStopPlaceOnlyResult)
    phone >> ({phone: ., context: SpeechPhoneCueContext.phone_only}) >> cue.value
    cue.result >> (.place) >> result
}

type SpeechVowelOnsetInput = {
    phone: EnglishPhone
    prosody: SpeechProsodyInput
    previous_place: SpeechStopPlace
    relation: SpeechNeighborRelation
}
# Self-authored reduced onset models: F1 begins at 200 Hz; labial/alveolar F2
# endpoints use 800/1800 Hz at the existing 100 Hz bandwidth. The velar model
# brings F2/F3 coefficients together relative to the current vowel. Linear
# coefficient interpolation is approximate; it is not frequency-exact motion.
# Restore the current temporal target within 160 frames (20 ms at 8 kHz).
type SpeechVowelOnsetWorking = {
    input: SpeechVowelOnsetInput
    endpoint: SpeechAcousticTarget
    weight: I32
}
plot speech/vowel-onset-prepare (
    >> value: SpeechVowelOnsetInput
    result: SpeechVowelOnsetWorking >>
) = (.relation is segment && (!(.previous_place is not_stop) && (.prosody.frame < 160 && ((((.phone is iy || .phone is ih) || (.phone is ey || .phone is eh)) || ((.phone is ae || .phone is aa) || (.phone is ao || .phone is ow))) || (((.phone is uh || .phone is uw) || (.phone is ah || .phone is ax)) || ((.phone is er || .phone is ay) || (.phone is aw || .phone is oy)))))) ? {input: ., endpoint: {f1: 200, f2: .previous_place is labial ? 800 : .previous_place is alveolar ? 1800 : (.prosody.target.f2 + .prosody.target.f3) / 2, f3: .previous_place is velar ? (.prosody.target.f2 + .prosody.target.f3) / 2 : .prosody.target.f3, b1: 31487, b2: .previous_place is labial ? 25489 : .previous_place is alveolar ? 4929 : (.prosody.target.b2 + .prosody.target.b3) / 2, b3: .previous_place is velar ? (.prosody.target.b2 + .prosody.target.b3) / 2 : .prosody.target.b3, c1: .prosody.target.c1, c2: .previous_place is velar ? (.prosody.target.c2 + .prosody.target.c3) / 2 : .prosody.target.c2, c3: .previous_place is velar ? (.prosody.target.c2 + .prosody.target.c3) / 2 : .prosody.target.c3, gain1: .prosody.target.gain1, gain2: .prosody.target.gain2, gain3: .prosody.target.gain3, voiced: .prosody.target.voiced, frication: .prosody.target.frication, frames: .prosody.target.frames, closure: .prosody.target.closure}, weight: 256 - .prosody.frame * 256 / 160} : {input: ., endpoint: .prosody.target, weight: 0})
# Keep unchanged coefficients and gains directly; do not interpolate equal
# endpoints or duplicate the connected-model envelope policy.
plot speech/vowel-onset-blend (
    >> value: SpeechVowelOnsetWorking
    result: SpeechProsodyInput >>
) = ({stress: .input.prosody.stress, attack: .input.prosody.attack, release: .input.prosody.release, target: .weight == 0 ? .input.prosody.target : {f1: (.input.prosody.target.f1 * (256 - .weight) + .endpoint.f1 * .weight) / 256, f2: (.input.prosody.target.f2 * (256 - .weight) + .endpoint.f2 * .weight) / 256, f3: (.input.prosody.target.f3 * (256 - .weight) + .endpoint.f3 * .weight) / 256, b1: (.input.prosody.target.b1 * (256 - .weight) + .endpoint.b1 * .weight) / 256, b2: (.input.prosody.target.b2 * (256 - .weight) + .endpoint.b2 * .weight) / 256, b3: (.input.prosody.target.b3 * (256 - .weight) + .endpoint.b3 * .weight) / 256, c1: .input.prosody.target.c1, c2: (.input.prosody.target.c2 * (256 - .weight) + .endpoint.c2 * .weight) / 256, c3: (.input.prosody.target.c3 * (256 - .weight) + .endpoint.c3 * .weight) / 256, gain1: .input.prosody.target.gain1, gain2: .input.prosody.target.gain2, gain3: .input.prosody.target.gain3, voiced: .input.prosody.target.voiced, frication: .input.prosody.target.frication, frames: .input.prosody.target.frames, closure: .input.prosody.target.closure}, frame: .input.prosody.frame, state: .input.prosody.state})
plot speech/vowel-onset (
    >> value: SpeechVowelOnsetInput
    result: SpeechProsodyInput >>
) {
    prepare: speech/vowel-onset-prepare
    blend: speech/vowel-onset-blend
    value >> prepare.value
    prepare.result >> blend.value
    blend.result >> result
}.

# All retained frame facts travel with the onset result into prosody and DSP.
plot speech/contextual-frame (
    >> value: SpeechVowelOnsetInput
    result: SpeechFrameResult >>
) {
    onset: speech/vowel-onset
    synthesize: speech/prosodic-frame
    value >> onset.value
    onset.result >> synthesize.value
    synthesize.result >> result
}
