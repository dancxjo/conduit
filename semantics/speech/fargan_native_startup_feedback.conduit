with structure/native-profile/5cbb3e49ff3f8201cbf3755ccc0d934419219f95387db61a0c330b55e60552db/result as NativeFeatureSeed
plot speech/fargan-native-signal-seed (
 value: RawSignalStartup >> result: SignalSeedCandidate
) = {state: .state, conditioned_period: .conditioned_period, next_epoch: (.first_epoch + 1)}
plot speech/fargan-native-conditioning-seed (
 value: RawConditioningStartup >> result: ConditioningSeedCandidate
) = {history: .history, next_epoch: (.first_epoch + 1)}
plot speech/fargan-native-feature-seed (
 value: RawFirstFeature >> result: FeatureSeedCandidate
) = {history: .history, previous_raw: .previous_raw, previous_normalized: .previous_normalized, next_epoch: (.epoch + 1)}
plot speech/fargan-native-startup-feedback (
 >> signal: NativeSignalStartup
 >> conditioning: NativeConditioningStartup
 >> feature: NativeFirstFeature
 signal_seed: NativeSignalSeed >>
 conditioning_seed: NativeConditioningSeed >>
 feature_seed: NativeFeatureSeed >>
) {
 signal_raw: structure/nominal-weakening/typed-a88a5263cd1a4bdc91622e2088fe2f5a6a8af86d096d7aca0602e08d5f0f4011c74f34e2340ec6b336f005000e0a8a2baa76560e44fa0636cd07c978c56966f5
