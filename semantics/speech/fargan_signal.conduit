# Pinned xiph/opus503d81b138d76621aae4b12786e90de48aa8db3a.
# One signal subframe=40 samples; caller owns cadence and atomic PCM/state commit.
# Explicit z,r,h slices implement upstream reset-after GRU; no hidden gate order.
# This source proves topology only, not executable synthesis.
plot speech/fargan-gru272x160 (
    >> value: NumericF32Vector272
    >> prior: NumericF32Vector160
    >> input_weights: NumericF32MatrixRef272x480
    >> recurrent_weights: NumericF32MatrixRef160x480
    next_state: NumericF32Vector160 >>
) {
    input_affine: numeric/linear272x480
    recurrent_affine: numeric/linear160x480
    z_input: numeric/slice480x160
    z_recurrent: numeric/slice480x160
    r_input: numeric/slice480x160
    r_recurrent: numeric/slice480x160
    h_input: numeric/slice480x160
    h_recurrent: numeric/slice480x160
    z_sum: numeric/add160
    z_sigmoid: numeric/sigmoid160
    r_sum: numeric/add160
    r_sigmoid: numeric/sigmoid160
    reset: numeric/multiply160
    candidate_sum: numeric/add160
    candidate: numeric/tanh160
    complement: numeric/complement160
    retained: numeric/multiply160
    updated: numeric/multiply160
    blend: numeric/add160
    value >> input_affine.value
    input_weights >> input_affine.weights
    prior >> recurrent_affine.value
    recurrent_weights >> recurrent_affine.weights
    input_affine.result >> z_input.value
    prior >> (0) >> z_input.start
    recurrent_affine.result >> z_recurrent.value
    prior >> (0) >> z_recurrent.start
    input_affine.result >> r_input.value
    prior >> (160) >> r_input.start
    recurrent_affine.result >> r_recurrent.value
    prior >> (160) >> r_recurrent.start
    input_affine.result >> h_input.value
    prior >> (320) >> h_input.start
    recurrent_affine.result >> h_recurrent.value
    prior >> (320) >> h_recurrent.start
    z_input.result >> z_sum.left
    z_recurrent.result >> z_sum.right
    z_sum.result >> z_sigmoid.value
    r_input.result >> r_sum.left
    r_recurrent.result >> r_sum.right
    r_sum.result >> r_sigmoid.value
    r_sigmoid.result >> reset.left
    h_recurrent.result >> reset.right
    h_input.result >> candidate_sum.left
    reset.result >> candidate_sum.right
    candidate_sum.result >> candidate.value
    z_sigmoid.result >> complement.value
    z_sigmoid.result >> retained.left
    prior >> retained.right
    complement.result >> updated.left
    candidate.result >> updated.right
    retained.result >> blend.left
    updated.result >> blend.right
    blend.result >> next_state
}

