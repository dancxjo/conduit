    >> conv_bias: NumericF32BiasRef192
    >> conv_glu_weights: NumericF32MatrixRef192x192
    >> conv_glu_bias: NumericF32BiasRef192
    >> pitch_gate_weights: NumericF32MatrixRef192x4
    >> pitch_gate_bias: NumericF32BiasRef4
    >> gru1_input_weights: NumericF32MatrixRef272x480
    >> gru1_recurrent_weights: NumericF32MatrixRef160x480
    >> gru2_input_weights: NumericF32MatrixRef240x384
    >> gru2_recurrent_weights: NumericF32MatrixRef128x384
    >> gru3_input_weights: NumericF32MatrixRef208x384
    >> gru3_recurrent_weights: NumericF32MatrixRef128x384
    >> gru1_glu_weights: NumericF32MatrixRef160x160
    >> gru1_glu_bias: NumericF32BiasRef160
    >> gru2_glu_weights: NumericF32MatrixRef128x128
    >> gru2_glu_bias: NumericF32BiasRef128
    >> gru3_glu_weights: NumericF32MatrixRef128x128
    >> gru3_glu_bias: NumericF32BiasRef128
    >> skip_weights: NumericF32MatrixRef688x128
    >> skip_bias: NumericF32BiasRef128
    >> skip_glu_weights: NumericF32MatrixRef128x128
    >> skip_glu_bias: NumericF32BiasRef128
    >> output_weights: NumericF32MatrixRef128x40
    >> output_bias: NumericF32BiasRef40
    result: FarganSignalResult >>
) {
    join1: numeric/pair40x164
    join2: numeric/pair40-164x160
    join3: numeric/pair40-164-160x128
    join4: numeric/pair40-164-160-128x128
    aggregate: speech/fargan-signal-result
    condition_prediction: numeric/concatenate80x44
    input: numeric/concatenate124x40
    window: numeric/concatenate164x164
    conv: numeric/dense328x192
    conv_tanh: numeric/tanh192
    conv_glu: speech/fargan-glu192
    pitch_gate: numeric/dense192x4
    pitch_sigmoid: numeric/sigmoid4
    prediction_center: numeric/slice44x40
    pitch1: numeric/slice4x1
    prediction1: numeric/scale40
    input1a: numeric/concatenate192x40
    input1b: numeric/concatenate232x40
    gru1: speech/fargan-gru272x160
    glu1: speech/fargan-glu160
    pitch2: numeric/slice4x1
    prediction2: numeric/scale40
    input2a: numeric/concatenate160x40
    input2b: numeric/concatenate200x40
    gru2: speech/fargan-gru240x128
    glu2: speech/fargan-glu128
    pitch3: numeric/slice4x1
    prediction3: numeric/scale40
    input3a: numeric/concatenate128x40
    input3b: numeric/concatenate168x40
    gru3: speech/fargan-gru208x128
    glu3: speech/fargan-glu128
    pitch4: numeric/slice4x1
    prediction4: numeric/scale40
    skip1: numeric/concatenate160x128
    skip2: numeric/concatenate288x128
    skip3: numeric/concatenate416x192
    skip4: numeric/concatenate608x40
    skip5: numeric/concatenate648x40
    skip: numeric/dense688x128
    skip_tanh: numeric/tanh128
    skip_glu: speech/fargan-glu128
    output: numeric/dense128x40
    output_tanh: numeric/tanh40
    output_gain: numeric/scale40
    condition >> condition_prediction.left
    prediction >> condition_prediction.right
    condition_prediction.result >> input.left
    previous >> input.right
    input.result >> join1.right
    conv_history >> window.left
    input.result >> window.right
    window.result >> conv.value
    conv_weights >> conv.weights
    conv_bias >> conv.bias
    conv.result >> conv_tanh.value
    conv_tanh.result >> conv_glu.value
    conv_glu_weights >> conv_glu.weights
    conv_glu_bias >> conv_glu.bias
    conv_glu.result >> pitch_gate.value
    pitch_gate_weights >> pitch_gate.weights
    pitch_gate_bias >> pitch_gate.bias
    pitch_gate.result >> pitch_sigmoid.value
    prediction >> prediction_center.value
    prediction >> (2) >> prediction_center.start
    pitch_sigmoid.result >> pitch1.value
    prediction >> (0) >> pitch1.start
    prediction_center.result >> prediction1.value
    pitch1.result >> prediction1.scale
    conv_glu.result >> input1a.left
    prediction1.result >> input1a.right
    input1a.result >> input1b.left
    previous >> input1b.right
    input1b.result >> gru1.value
    gru1_state >> gru1.prior
    gru1_input_weights >> gru1.input_weights
    gru1_recurrent_weights >> gru1.recurrent_weights
    gru1.next_state >> join2.right
    gru1.next_state >> glu1.value
    gru1_glu_weights >> glu1.weights
    gru1_glu_bias >> glu1.bias
    pitch_sigmoid.result >> pitch2.value
    prediction >> (1) >> pitch2.start
    prediction_center.result >> prediction2.value
    pitch2.result >> prediction2.scale
    glu1.result >> input2a.left
    prediction2.result >> input2a.right
    input2a.result >> input2b.left
    previous >> input2b.right
    input2b.result >> gru2.value
    gru2_state >> gru2.prior
    gru2_input_weights >> gru2.input_weights
    gru2_recurrent_weights >> gru2.recurrent_weights
    gru2.next_state >> join3.right
    gru2.next_state >> glu2.value
    gru2_glu_weights >> glu2.weights
    gru2_glu_bias >> glu2.bias
    pitch_sigmoid.result >> pitch3.value
    prediction >> (2) >> pitch3.start
    prediction_center.result >> prediction3.value
    pitch3.result >> prediction3.scale
    glu2.result >> input3a.left
    prediction3.result >> input3a.right
    input3a.result >> input3b.left
    previous >> input3b.right
    input3b.result >> gru3.value
    gru3_state >> gru3.prior
    gru3_input_weights >> gru3.input_weights
    gru3_recurrent_weights >> gru3.recurrent_weights
    gru3.next_state >> join4.right
    gru3.next_state >> glu3.value
    gru3_glu_weights >> glu3.weights
    gru3_glu_bias >> glu3.bias
    pitch_sigmoid.result >> pitch4.value
    prediction >> (3) >> pitch4.start
    prediction_center.result >> prediction4.value
    pitch4.result >> prediction4.scale
    glu1.result >> skip1.left
    glu2.result >> skip1.right
    skip1.result >> skip2.left
    glu3.result >> skip2.right
    skip2.result >> skip3.left
    conv_glu.result >> skip3.right
    skip3.result >> skip4.left
    prediction4.result >> skip4.right
    skip4.result >> skip5.left
    previous >> skip5.right
    skip5.result >> skip.value
    skip_weights >> skip.weights
    skip_bias >> skip.bias
    skip.result >> skip_tanh.value
    skip_tanh.result >> skip_glu.value
    skip_glu_weights >> skip_glu.weights
    skip_glu_bias >> skip_glu.bias
    skip_glu.result >> output.value
    output_weights >> output.weights
    output_bias >> output.bias
    output.result >> output_tanh.value
    output_tanh.result >> output_gain.value
    gain >> output_gain.scale
    output_gain.result >> join1.left
    join1.result >> join2.left
    join2.result >> join3.left
    join3.result >> join4.left
    join4.result >> aggregate.value
    aggregate.result >> result
}
