type FarganSignalState = {
    conv_history: NumericF32Vector164
    gru1: NumericF32Vector160
    gru2: NumericF32Vector128
    gru3: NumericF32Vector128
}
# Minimal numerical state:128 conditioning+164 signal-history+416 GRU+256 pitch
# +1 deemphasis=965 f32 values, plus previous_period. Source/control basis,
# initialization, finite progression, and lifecycle belong to the outer Play.
type FarganNetworkState = {
    conditioning_history: NumericHistory2x64
    signal: FarganSignalState
    pitch_history: NumericF32Vector256
    deemphasis: NumericF32Vector1
    previous_period: FarganPeriod
}
type FarganSignalResult = {
    raw_pcm: NumericF32Vector40
    next_state: FarganSignalState
}
plot speech/fargan-signal-result (
    >> value: NumericPair40_164_160_128x128
    result: FarganSignalResult >>
) = ({raw_pcm: .0.0.0.0, next_state: {conv_history: .0.0.0.1, gru1: .0.0.1, gru2: .0.1, gru3: .1}})

plot speech/fargan-signal-subframe (
    >> condition: NumericF32Vector80
    >> prediction: NumericF32Vector44
    >> previous: NumericF32Vector40
    >> gain: NumericF32Vector1
    >> conv_history: NumericF32Vector164
