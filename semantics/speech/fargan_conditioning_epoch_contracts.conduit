# Conditioning input and deferred history are separate bounded domains.
# Deferred history is released only by the final canonical PCM16 epoch ACK.
type FarganFeatureConditionEpoch = {
    features: NumericF32Vector20
    period: FarganPeriod
    epoch: U64
}
type FarganConditioningInputEpoch = {
    features: NumericF32Vector20
    period: FarganPeriod
    history: NumericHistory2x64
    epoch: U64
}
type FarganConditioningPendingHistory = {
    history: NumericHistory2x64
    epoch: U64
}

# This aggregate keeps provisional numerical history attached to its exact epoch.
# Only the separately accepted final canonical PCM16 epoch releases its feedback.
type FarganConditioningProposalEpoch = {
    condition: NumericF32Vector320
    history: NumericHistory2x64
    period: FarganPeriod
    epoch: U64
}
