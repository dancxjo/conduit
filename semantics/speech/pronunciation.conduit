type EnglishTextSegmentContext = {
    pronunciation: EnglishPronouncedPhoneme
    ordinal: U32
    count: U32
}
plot speech/text-realization (
    >> value: EnglishTextSegmentContext
    result: RealizationInput >>
) = ({phoneme: .pronunciation.phoneme, stress: .pronunciation.stress, position: .count == 1 ? EnglishPosition.isolated : .ordinal == 0 ? EnglishPosition.initial : .ordinal + 1 == .count ? EnglishPosition.final : EnglishPosition.medial})

# Scalar ranges are scoped to the exact source retained by the text preparation.
type TextSpeechSegment = {
    realization: RealizationInput
    source_scalar_start: U32
    source_scalar_end: U32
    origin: EnglishPronunciationOrigin
}
type EnglishTextTail =
    empty
    | segment
    | word_boundary
    | phrase_boundary
    | turn_boundary

type EnglishTextBoundaryContext = {
    class: EnglishTextClass
    prior: EnglishTextTail
}
type EnglishTextBoundary = {
    boundary: VoiceBoundary
    tail: EnglishTextTail
}
type EnglishTextBoundaryDecision =
    omitted
    | emitted EnglishTextBoundary

plot speech/text-boundary (
    >> value: EnglishTextBoundaryContext
    result: EnglishTextBoundaryDecision >>
) = (.prior is empty ? EnglishTextBoundaryDecision.omitted : .class is word_gap ? (.prior is segment ? EnglishTextBoundaryDecision.emitted({boundary: VoiceBoundary.word, tail: EnglishTextTail.word_boundary}) : EnglishTextBoundaryDecision.omitted) : .class is phrase_gap ? (.prior is phrase_boundary || .prior is turn_boundary ? EnglishTextBoundaryDecision.omitted : EnglishTextBoundaryDecision.emitted({boundary: VoiceBoundary.phrase, tail: EnglishTextTail.phrase_boundary})) : .class is turn_gap ? (.prior is turn_boundary ? EnglishTextBoundaryDecision.omitted : EnglishTextBoundaryDecision.emitted({boundary: VoiceBoundary.turn, tail: EnglishTextTail.turn_boundary})) : EnglishTextBoundaryDecision.omitted)
