# Compact English orthography profile. This is pronunciation meaning, not a
# universal inventory or proof that a guessed word pronunciation is correct.
type EnglishWord = Text <= 32B
type EnglishPronunciationOrigin =
    dictionary
    | spelling_rule
    | punctuation
    | digit_name

type EnglishPronouncedPhoneme = {
    phoneme: EnglishPhoneme
    stress: EnglishStress
}
type EnglishPhonemeSlot =
    absent
    | present EnglishPronouncedPhoneme

type EnglishWordPhonemes = {
    phoneme1: EnglishPhonemeSlot
    phoneme2: EnglishPhonemeSlot
    phoneme3: EnglishPhonemeSlot
    phoneme4: EnglishPhonemeSlot
    phoneme5: EnglishPhonemeSlot
    phoneme6: EnglishPhonemeSlot
    phoneme7: EnglishPhonemeSlot
    phoneme8: EnglishPhonemeSlot
    phoneme9: EnglishPhonemeSlot
    phoneme10: EnglishPhonemeSlot
    phoneme11: EnglishPhonemeSlot
    phoneme12: EnglishPhonemeSlot
}
type EnglishLexiconDecision =
    matched EnglishWordPhonemes
    | unknown

type EnglishTextClass =
    letter
    | digit
    | apostrophe
    | word_gap
    | phrase_gap
    | turn_gap
    | ignored
    | unsupported

plot speech/text-class (
    >> value: I32
    result: EnglishTextClass >>
) = (. >= 97 && . <= 122 ? EnglishTextClass.letter : . >= 48 && . <= 57 ? EnglishTextClass.digit : . == 39 ? EnglishTextClass.apostrophe : . == 32 || . == 9 || . == 45 ? EnglishTextClass.word_gap : . == 44 || . == 59 || . == 58 ? EnglishTextClass.phrase_gap : . == 46 || . == 33 || . == 63 || . == 10 || . == 13 ? EnglishTextClass.turn_gap : . == 34 || . == 40 || . == 41 ? EnglishTextClass.ignored : EnglishTextClass.unsupported)

