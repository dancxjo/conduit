plot speech/fargan-feature-normalized-correlation (
    >> waveform: NumericF32Vector640
    >> period: FarganPeriod
    result: NumericF32Vector1 >>
) {
    current_indices: speech/fargan-feature-current-indices
    lag_indices: speech/fargan-feature-lag-indices
    current: numeric/gather640x160
    delayed: numeric/gather640x160
    current_energy: numeric/dot160
    delayed_energy: numeric/dot160
    cross: numeric/dot160
    energies: numeric/concatenate1x1
    admitted_product: numeric/finite-vector1
    norm: numeric/sqrt1
    normalized_pair: numeric/concatenate1x1
    admitted_correlation: numeric/finite-vector1
    transform: speech/fargan-feature-correlation
    period >> current_indices.period
    period >> lag_indices.period
    waveform >> current.value
    current_indices.result >> current.indices
    waveform >> delayed.value
    lag_indices.result >> delayed.indices
    current.result >> current_energy.left
    current.result >> current_energy.right
    delayed.result >> delayed_energy.left
    delayed.result >> delayed_energy.right
    current.result >> cross.left
    delayed.result >> cross.right
    current_energy.result >> energies.left
    delayed_energy.result >> energies.right
    energies.result >> ([sequence/at(., 0) * sequence/at(., 1) + 0x26901d7d]) >> admitted_product.value
    admitted_product.result >> norm.value
    norm.result >> normalized_pair.left
    cross.result >> normalized_pair.right
    normalized_pair.result >> ([sequence/at(., 1) / sequence/at(., 0)]) >> admitted_correlation.value
    admitted_correlation.result >> transform.value
    transform.result >> result
}

