plot speech/fargan-feature-frame (
    >> waveform: NumericF32Vector640
    >> period: FarganPeriod
    >> band_weights: NumericF32MatrixRef161x18
    >> band_bias: NumericF32BiasRef18
    >> dct_weights: NumericF32MatrixRef18x18
    result: NumericF32Vector20 >>
) {
    basis: speech/fargan-feature-window-basis
    spectrum: speech/fargan-feature-spectrum
    pitch: speech/fargan-feature-log-pitch
    correlation: speech/fargan-feature-normalized-correlation
    append: speech/fargan-feature20
    waveform >> basis.waveform
    basis.result >> spectrum.samples
    band_weights >> spectrum.band_weights
    band_bias >> spectrum.band_bias
    dct_weights >> spectrum.dct_weights
    period >> pitch.period
    waveform >> correlation.waveform
    period >> correlation.period
    spectrum.result >> append.cepstrum
    pitch.result >> append.pitch
    correlation.result >> append.correlation
    append.result >> result
}
