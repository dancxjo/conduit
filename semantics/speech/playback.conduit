    where (sequence/length(.occurrences) > 0 ? (sequence/at(.occurrences, 0).linguistic_index < sequence/length(.linguistic_bases) ? (sequence/at(.occurrences, 0).source == sequence/at(.linguistic_bases, sequence/at(.occurrences, 0).linguistic_index).source && sequence/at(.occurrences, 0).token == sequence/at(.linguistic_bases, sequence/at(.occurrences, 0).linguistic_index).token && sequence/at(.occurrences, 0).prosody.language == sequence/at(.linguistic_bases, sequence/at(.occurrences, 0).linguistic_index).source.language && sequence/at(.occurrences, 0).prosody.pitch.segment.occurrence.language == sequence/at(.linguistic_bases, sequence/at(.occurrences, 0).linguistic_index).source.language) : false) : true) && (sequence/length(.occurrences) > 1 ? (sequence/at(.occurrences, 1).linguistic_index < sequence/length(.linguistic_bases) ? (sequence/at(.occurrences, 1).source == sequence/at(.linguistic_bases, sequence/at(.occurrences, 1).linguistic_index).source && sequence/at(.occurrences, 1).token == sequence/at(.linguistic_bases, sequence/at(.occurrences, 1).linguistic_index).token && sequence/at(.occurrences, 1).prosody.language == sequence/at(.linguistic_bases, sequence/at(.occurrences, 1).linguistic_index).source.language && sequence/at(.occurrences, 1).prosody.pitch.segment.occurrence.language == sequence/at(.linguistic_bases, sequence/at(.occurrences, 1).linguistic_index).source.language) : false) : true) && (sequence/length(.occurrences) > 2 ? (sequence/at(.occurrences, 2).linguistic_index < sequence/length(.linguistic_bases) ? (sequence/at(.occurrences, 2).source == sequence/at(.linguistic_bases, sequence/at(.occurrences, 2).linguistic_index).source && sequence/at(.occurrences, 2).token == sequence/at(.linguistic_bases, sequence/at(.occurrences, 2).linguistic_index).token && sequence/at(.occurrences, 2).prosody.language == sequence/at(.linguistic_bases, sequence/at(.occurrences, 2).linguistic_index).source.language && sequence/at(.occurrences, 2).prosody.pitch.seg