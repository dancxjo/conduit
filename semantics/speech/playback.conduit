# Source/analysis identity and queue acceptance do not attest physical playback.
type SpeechPlaybackProsodyMode =
    rich
    | fallback
# Exact canonical-hex@1 checked Language receipt bytes retain alternatives/profile/UD
# without increasing native Type nesting. Only prepared tape admission supplies
# them; this opaque evidence field alone does not establish a Language fact.
type SpeechPlaybackAnalysisSpecification = SpeechSpec<LanguageAnalysisRevisionId>
# One full receipt per lexical source; phonetic occurrences refer to it exactly.
type SpeechPlaybackLinguisticBasis = {
    material: LanguageTextRevision
    linguistic_evidence: Text <= 65536B
    linguistic_evidence_encoding: Text <= 64B in ["canonical-hex@1"]
    linguistic_evidence_profile: Text <= 96B not in [""]
    token: LinguisticTokenIdentity
    source: LanguageTextSegmentRef
    analysis: SpeechPlaybackAnalysisSpecification
    mode: SpeechPlaybackProsodyMode
    where .token.text_identity == .source.text_id
    where .token.text_revision == .source.revision_id
    where .material.material.language == .source.language
    where .material.material.identity == .source.text_id
    where .material.material.revision == .source.revision_id
    where .mode is rich ? .analysis is known : .analysis is unspecified
}
type SpeechPlaybackOccurrenceBasis = {
    event: U64 in 0..=255
    prosody: SpeechLinguisticTrajectoryAdmission
    linguistic_index: U64 in 0..=31
    source: LanguageTextSegmentRef
    token: LinguisticTokenIdentity
    where .token.text_identity == .source.text_id
    where .token.text_revision == .source.revision_id
    where (sequence/length(.prosody.pitch.segment.sources) > 0 ? (sequence/at(.prosody.pitch.segment.sources, 0) is text ? sequence/at(.prosody.pitch.segment.sources, 0).text == .source : false) : false) || (sequence/length(.prosody.pitch.segment.sources) > 1 ? (sequence/at(.prosody.pitch.segment.sources, 1) is text ? sequence/at(.prosody.pitch.segment.sources, 1).text == .source : false) : false) || (sequence/length(.prosody.pitch.segment.sources) > 2 ? (sequence/at(.prosody.pitch.segment.sources, 2) is text ? sequence/at(.prosody.pitch.segment.sources, 2).text == .source : false) : false) || (sequence/length(.prosody.pitch.segment.sources) > 3 ? (sequence/at(.prosody.pitch.segment.sources, 3) is text ? sequence/at(.prosody.pitch.segment.sources, 3).text == .source : false) : false) || (sequence/length(.prosody.pitch.segment.sources) > 4 ? (sequence/at(.prosody.pitch.segment.sources, 4) is text ? sequence/at(.prosody.pitch.segment.sources, 4).text == .source : false) : false) || (sequence/length(.prosody.pitch.segment.sources) > 5 ? (sequence/at(.prosody.pitch.segment.sources, 5) is text ? sequence/at(.prosody.pitch.segment.sources, 5).text == .source : false) : false) || (sequence/length(.prosody.pitch.segment.sources) > 6 ? (sequence/at(.prosody.pitch.segment.sources, 6) is text ? sequence/at(.prosody.pitch.segment.sources, 6).text == .source : false) : false) || (sequence/length(.prosody.pitch.segment.sources) > 7 ? (sequence/at(.prosody.pitch.segment.sources, 7) is text ? sequence/at(.prosody.pitch.segment.sources, 7).text == .source : false) : false)
}
type SpeechPlaybackLinks = {
