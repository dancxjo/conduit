# Reviewed playback profile: at most 32 phonetic occurrences.
# This admits the reviewed four-word by eight-phone capacity.
# The separate renderer still supports its independent 256-event capacity.
type SpeechPlaybackBasis = {
    intent: SpeechUtteranceIntent
    voice_profile: SpeechFormantVoiceProfile
    clock_id: U64 in 1..=18446744073709551615
    links: SpeechPlaybackLinks
}
type SpeechPlaybackDisposition =
    queued
    | played
type SpeechPlaybackAcknowledgement = {
    basis: SpeechPlaybackBasis
    first_frame: U64
    through_frame: U64
    disposition: SpeechPlaybackDisposition
    provenance: SpeechEvidenceProvenance
    where .through_frame > .first_frame
}
# Scoped anchors do not replace the complete immutable prepared basis receipts.
# A revision epoch uses one exact text material, checked against every table row.
type SpeechPlaybackRevisionAnchor = {
    material: LanguageTextRevision
    utterance_id: SpeechUtteranceId
    revision_id: SpeechSegmentRevisionId
    language: LanguageId
    inventory_id: SpeechInventoryId
    clock_id: U64 in 1..=18446744073709551615
    voice_profile: Text <= 64B not in [""]
}
type SpeechPlaybackAnchorMatch = {
    basis: SpeechPlaybackBasis
    anchor: SpeechPlaybackRevisionAnchor
    where .anchor.utterance_id == .basis.intent.utterance_id
    where .anchor.revision_id == .basis.intent.revision_id
    where .anchor.language == .basis.intent.language
    where .anchor.inventory_id == .basis.intent.inventory_id
    where .anchor.clock_id == .basis.clock_id
    where .anchor.voice_profile == .basis.voice_profile.identity
    where sequence/length(.basis.links.linguistic_bases) > 0 ? .anchor.material == sequence/at(.basis.links.linguistic_bases, 0).material : false
}
type SpeechPlaybackAnchorMaterialMatch = {
    material: LanguageTextRevision
    anchor: SpeechPlaybackRevisionAnchor
    where .material == .anchor.material
}
# Each full basis is admitted independently; an aggregate is not a snapshot.
# Unchanged exact material allows analysis/prosody reinterpretation. Changed
# material requires a distinct revision and exact canonical Language lineage.
type SpeechPlaybackInterpretationChange = {
    lineage: LanguageTextRevisionLineage?
    prior: SpeechPlaybackRevisionAnchor?
    next: SpeechPlaybackRevisionAnchor
    where .prior is some ? .prior.some.utterance_id == .next.utterance_id : true
    where .prior is some ? .prior.some.language == .next.language : true
    where .prior is some ? .prior.some.clock_id == .next.clock_id : true
    where .prior is some ? .prior.some.material.material.identity == .next.material.material.identity : true
    where .prior is some ? .lineage is some : .lineage is none
    where .prior is some ? (.lineage is some ? .lineage.some.previous == .prior.some.material : false) : true
    where .prior is some ? (.lineage is some ? .lineage.some.next == .next.material : false) : true
}
type SpeechPlaybackWithdrawal = {
    basis: SpeechPlaybackRevisionAnchor
}
# Corrections retain both complete receipts privately; old frames are unchanged.
type SpeechPlaybackCorrection = {
    lineage: LanguageTextRevisionLineage
    previous: SpeechPlaybackRevisionAnchor
    replacement: SpeechPlaybackRevisionAnchor
    where .previous.utterance_id == .replacement.utterance_id
    where .previous.language == .replacement.language
    where .previous.clock_id == .replacement.clock_id
    where .previous.material.material.identity == .replacement.material.material.identity
    where .lineage.previous == .previous.material
    where .lineage.next == .replacement.material
}
