# Named centered-conditioning alignment for the admitted native epoch grid.
# After Source warm initialization, epochs1..native_epochs+1 emit160 samples.
# Keep the last80 of epoch1 and first80 of the final continuation; middle
# epochs retain160. This removes the explicit80-sample leading/trailing delay.
# No sample repetition, duration padding or PCM gain occurs here.
# Alignment follows pinned xiph/opus503d81b138d76621aae4b12786e90de48aa8db3a
# dnn/fargan_demo.c: MODE_FARGAN_SYNTHESIS first skip and stop==2 half-frame.
# PCM rounding remains the separately declared Source nearest-away profile.
type FarganAlignedPcmBlock = {
    epoch: U64
    samples: sequence I16 in 80..=160
}
plot speech/fargan-native-pcm-alignment (
    native_epochs: U64
    >> value: FarganPcm16EpochResult
    result: FarganAlignedPcmBlock >>
