# Explicit period policy for admitted 16 kHz Q8 cycle quantities. Clamp before
# rounding, preserving bounded addition even for the largest U64 quantity.
plot speech/fargan-period-q8-round (
    >> value: U64
    result: U64 >>
) = ((. < 8192 ? 8192 : . > 65280 ? 65280 : .) + 128) / 256
plot speech/flow-fargan-period-q8-round (
    >> value: U64...|
    result: U64...| >>
) = ((. < 8192 ? 8192 : . > 65280 ? 65280 : .) + 128) / 256
plot speech/flow-fargan-period-from-q8 (
    >> value: U64...|
    result: FarganPeriod...| >>
) {
    round: speech/flow-fargan-period-q8-round
    narrow: numeric/flow-u64-to-u16
    admit: numeric/flow-u16-profile/sha256-f4eb9415fba33bd2fbdce32589206170e385077064534431b8a3a00112b85fbc
    value >> round.value
    round.result >> narrow.value
    narrow.result >> admit.value
    admit.result >> result
}
# Source chooses normalized PCM saturation, explicit 32768 scaling and the
# separately named nearest-ties-away signed16 converter. Multiplication by one
# exposes the bare finite arithmetic result and preserves signed zero. No Back adds gain.
