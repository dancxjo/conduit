# Pitch carries the actual synthesis context, never an independent value
# implicitly synchronized with a called result. Unknown/unspecified stress
# remains neutral; this profile does not infer stress or measured intonation.
type SpeechProsodyInput = {
    stress: EnglishStress
    attack: Boolean
    release: Boolean
    target: SpeechAcousticTarget
    frame: I32
    state: SpeechFrameState
}
type SpeechProsodyWorking = {
    input: SpeechProsodyInput
    base_period: I32
}
plot speech/pitch-prepare (
    >> value: SpeechProsodyInput
    result: SpeechProsodyWorking >>
) = ({input: ., base_period: .stress is primary ? 61 : .stress is secondary ? 64 : 67})

plot speech/pitch-contour (
    >> value: SpeechProsodyWorking
    result: SpeechFrameInput >>
) = ({attack: .input.attack, release: .input.release, target: .input.target, frame: .input.frame, state: .input.state, period: .input.stress is primary ? .base_period - 3 + .input.frame * 8 / (.input.target.frames - 1) : .input.stress is secondary ? .base_period - 2 + .input.frame * 5 / (.input.target.frames - 1) : (.input.stress is unstressed || .input.stress is reduced) ? .base_period + .input.frame * 2 / (.input.target.frames - 1) : .base_period})

plot speech/pitch (
    >> value: SpeechProsodyInput
    result: SpeechFrameInput >>
) {
    prepare: speech/pitch-prepare
    contour: speech/pitch-contour
    value >> prepare.value
    prepare.result >> contour.value
    contour.result >> result
}

# Bounded relative sonorant intensity for known stress only. These are profile
# defaults, not measured loudness or inferred syllable stress. Unknown and
# unspecified retain the exact neutral model; stops/frication remain neutral.
type SpeechIntensityWorking = {
    input: SpeechProsodyInput
    level: I32
}
plot speech/intensity-prepare (
    >> value: SpeechProsodyInput
    result: SpeechIntensityWorking >>
) = ({input: ., level: (.target.voiced == 1 && (.target.frication == 0 && .target.closure == 0)) ? (.stress is secondary ? 224 : .stress is unstressed ? 192 : .stress is reduced ? 160 : 256) : 256})
# Bring each segment edge back to neutral over 128 frames, so this local
# intensity cue does not introduce a gain step at a connected sonorant join.
plot speech/intensity-contour (
    >> value: SpeechIntensityWorking
    result: SpeechIntensityWorking >>
) = (.level == 256 ? . : {input: .input, level: .input.frame < 128 ? 256 - (256 - .level) * .input.frame / 128 : .input.target.frames - .input.frame < 128 ? 256 - (256 - .level) * (.input.target.frames - .input.frame) / 128 : .level})
plot speech/intensity-apply (
    >> value: SpeechIntensityWorking
    result: SpeechProsodyInput >>
) = (.level == 256 ? .input : {stress: .input.stress, attack: .input.attack, release: .input.release, frame: .input.frame, state: .input.state, target: {f1: .input.target.f1, f2: .input.target.f2, f3: .input.target.f3, b1: .input.target.b1, b2: .input.target.b2, b3: .input.target.b3, c1: .input.target.c1, c2: .input.target.c2, c3: .input.target.c3, gain1: .input.target.gain1 * .level / 256, gain2: .input.target.gain2 * .level / 256, gain3: .input.target.gain3 * .level / 256, bypass_gain: .input.target.bypass_gain, voiced: .input.target.voiced, frication: .input.target.frication, frames: .input.target.frames, closure: .input.target.closure}})
plot speech/stress-intensity (
    >> value: SpeechProsodyInput
    result: SpeechProsodyInput >>
) {
    prepare: speech/intensity-prepare
    contour: speech/intensity-contour
    apply: speech/intensity-apply
    value >> prepare.value
    prepare.result >> contour.value
    contour.result >> apply.value
    apply.result >> result
}

plot speech/prosodic-frame (
    >> value: SpeechProsodyInput
    result: SpeechFrameResult >>
) {
    intensity: speech/stress-intensity
    pitch: speech/pitch
    frame: speech/frame
    value >> intensity.value
    intensity.result >> pitch.value
    pitch.result >> frame.value
    frame.result >> result
}
