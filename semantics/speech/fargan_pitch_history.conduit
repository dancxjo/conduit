plot speech/fargan-pitch-conditioning (
    >> condition: NumericF32Vector80
    >> period: FarganPeriod
    >> pitch_history: NumericF32Vector256
    >> gain_weights: NumericF32MatrixRef80x1
    >> gain_bias: NumericF32BiasRef1
    prediction: NumericF32Vector44 >>
    previous: NumericF32Vector40 >>
    gain: NumericF32Vector1 >>
) {
    gain_affine: numeric/dense80x1
    gain_exp: numeric/exp1
    normalize: numeric/reciprocal-offset1
    indices: speech/fargan-pitch-indices
    prediction_gather: numeric/gather256x44
    previous_slice: numeric/slice256x40
    prediction_scale: numeric/scale44
    previous_scale: numeric/scale40
    prediction_clamp: numeric/clamp44
    previous_clamp: numeric/clamp40
    condition >> gain_affine.value
    gain_weights >> gain_affine.weights
    gain_bias >> gain_affine.bias
    gain_affine.result >> gain_exp.value
    gain_exp.result >> gain
    gain_exp.result >> normalize.value
    condition >> ([0x3727c5ac]) >> normalize.offset
    period >> indices.value
    pitch_history >> prediction_gather.value
    indices.result >> prediction_gather.indices
    pitch_history >> previous_slice.value
    period >> (216) >> previous_slice.start
    prediction_gather.result >> prediction_scale.value
    normalize.result >> prediction_scale.scale
    previous_slice.result >> previous_scale.value
    normalize.result >> previous_scale.scale
    prediction_scale.result >> prediction_clamp.value
    previous_scale.result >> previous_clamp.value
    condition >> ([0xbf800000]) >> prediction_clamp.minimum
    condition >> ([0x3f800000]) >> prediction_clamp.maximum
    condition >> ([0xbf800000]) >> previous_clamp.minimum
    condition >> ([0x3f800000]) >> previous_clamp.maximum
    prediction_clamp.result >> prediction
    previous_clamp.result >> previous
}
plot speech/fargan-history-deemphasis (
    >> raw_pcm: NumericF32Vector40
    >> pitch_history: NumericF32Vector256
    >> deemphasis_state: NumericF32Vector1
    result: NumericOnePole40Result >>
    next_pitch_history: NumericF32Vector256 >>
) {
    history_tail: numeric/slice256x216
    history_append: numeric/concatenate216x40
    deemphasis: numeric/one-pole40
    pitch_history >> history_tail.value
    raw_pcm >> (40) >> history_tail.start
    history_tail.result >> history_append.left
    raw_pcm >> history_append.right
    history_append.result >> next_pitch_history
    raw_pcm >> deemphasis.value
    deemphasis_state >> deemphasis.prior
    raw_pcm >> ([0x3f59999a]) >> deemphasis.coefficient
    deemphasis.result >> result
}

# 100Hz condition frame -> four sequential 40-sample subframes at16kHz.
# The bounded outer progression owner supplies index0..3 and retains basis.
type FarganSubframeIndex = U16 in 0..=3
plot speech/fargan-condition-subframe (
    >> condition: NumericF32Vector320
    >> index: FarganSubframeIndex
    result: NumericF32Vector80 >>
) {
    slice: numeric/slice320x80
    condition >> slice.value
    index >> ((. + 0) * 80) >> slice.start
    slice.result >> result
}
