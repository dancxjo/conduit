# Existing exact generic integer conversion; no PCM8k carrier is involved.
plot speech/fargan-direct16k-pcm-normalize (
    >> value: NumericI16Vector160
    result: FarganDirect16kNormalizationResult >>
) {
    integer: numeric/i16-to-f32-160
    normalize: speech/fargan-direct16k-normalize
    value >> integer.value
    integer.result >> normalize.value
    normalize.result >> result
}
plot speech/flow-fargan-direct16k-pcm-normalize (
    >> value: NumericI16Vector160...|
    result: FarganDirect16kNormalizationResult...| >>
) {
    integer: numeric/flow-i16-to-f32-160
    normalize: speech/flow-fargan-direct16k-normalize
    value >> integer.value
    integer.result >> normalize.value
    normalize.result >> result
}
