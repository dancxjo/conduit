# Named direct16k entrance: exact integer-derived finite floats, no resampling.
# Caller must retain original admitted PCM160 plus exact generic conversion proof.
# Normalization by32768 is exact for every I16; previous_raw remains raw I16 scale.
# This is not upstream feature parity or authority to infer pitch from PCM.
type FarganDirect16kNormalizationResult = {
    samples: NumericRawF32Vector160
    next_previous_raw: F32
}
