# Causal feature state has two independent scalar memories: raw interpolation
# and normalized preemphasis. The 640-sample waveform is preemphasized history.
# Provisional replacements remain attached to the utterance's exact 10 ms epoch.
# The final admitted PCM16 epoch, rather than feature publication, releases ACK.
type FarganFeaturePcmEpoch = {
    samples: NumericI16Vector80
    period: FarganPeriod
    epoch: U64
}
type FarganFeaturePendingState = {
    history: NumericF32Vector640
    previous_raw: NumericFiniteF32
    previous_normalized: NumericFiniteF32
    epoch: U64
}

# The entry aggregates one admitted native PCM epoch with the previous causal
# state. Epoch equality is asserted by the authored feedback composition.
type FarganFeatureInputEpoch = {
    samples: NumericI16Vector80
    history: NumericF32Vector640
    previous_raw: NumericFiniteF32
    previous_normalized: NumericFiniteF32
    period: FarganPeriod
    epoch: U64
}
# Neither spectral publication nor these provisional scalar memories ACKs the
# native epoch. The final canonical PCM16 result selects the replacement.
type FarganFeatureProposalEpoch = {
    features: NumericF32Vector20
    history: NumericF32Vector640
    previous_raw: NumericFiniteF32
    previous_normalized: NumericFiniteF32
    period: FarganPeriod
    epoch: U64
}
