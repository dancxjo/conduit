# Authoritative portable chat state meaning. Rust consumes generated bindings.

type ChatConnectionState =
    connected
    | connecting
    | disconnected

type ChatStateRefusal =
    invalid_configuration
    | empty_message
    | oversize_message
    | malformed_message
    | sequence_exhausted
    | invalid_presentation

type PresenceState =
    available
    | away
    | offline
    | unknown

type BodyChatRole =
    human
    | body

code chat/body-role = BodyChatRole as u8

type BodyChatMessage = Text <= 4096B not in [""]

type BodyChatHistoryItem = {
    role: BodyChatRole
    text: BodyChatMessage
}

type BodyConversationalSummary = {
    schema: Text <= 64B not in [""]
    display_name: Text <= 128B not in [""]
    lifecycle: Text <= 16B not in [""]
    present_hosts: U16
    offline_hosts: U16
    active_forms: U16
    execution: Text <= 16B not in [""]
    ready_lines: U16
    unavailable_lines: U16
    unknown_lines: U16
}

type BodyChatRefusal =
    empty_message
    | message_bound_exceeded
    | context_bound_exceeded
    | malformed_context
    | wrong_context_schema
    | history_bound_exceeded
    | prompt_bound_exceeded
    | encoding

# Privacy-preserving evidence for the exact Body truth consumed by one request.
# The private prompt is named only by its digest and is never retained here.
type ConversationRequestEvidence = {
    request-identity: Text <= 82B not in [""]
    body-id: Text <= 256B not in [""]
    wake-id: Text <= 256B not in [""]
    wake-sequence: U64
    context-revision: U64
    model-context-sha256: Text <= 64B not in [""]
    private-prompt-retained: Boolean
}

# Portable messaging meaning. Addresses and provider profiles remain semantic
# text; transports, retries, and provider acknowledgements remain realization.

type MessageOptionalDisplayName =
    absent
    | provided Text <= 4096B

type MessageOptionalSender =
    absent
    | provided Text <= 4096B

type MessageOptionalSubject =
    absent
    | provided Text <= 4096B

type MessageRecipient = {
    address: Text <= 4096B
    address_profile: Text <= 4096B
    display_name: MessageOptionalDisplayName
}

type MessageRecipientSlot =
    recipient MessageRecipient
    | unused

type MessageMetadataEntry = {
    key: Text <= 4096B
    value: Text <= 4096B
}

type MessageMetadataSlot =
    entry MessageMetadataEntry
    | unused

type MessageAttachment = {
    content: ResourceRef
    filename: Text <= 4096B
    media_type: Text <= 4096B
}

type MessageAttachmentSlot =
    attachment MessageAttachment
    | unused

type PortableMessage = {
    attachments: collection MessageAttachmentSlot = 2
    body: Text <= 4096B
    message_identity: Text <= 4096B
    metadata: collection MessageMetadataSlot = 4
    recipients: collection MessageRecipientSlot = 4
    sender: MessageOptionalSender
    subject: MessageOptionalSubject
}

type DeliveryAuthority =
    absent
    | grant Text <= 4096B

type DeliveryRequest = {
    attempt: Count
    authority: DeliveryAuthority
    correlation_identity: Text <= 4096B
    message: PortableMessage
    request_identity: Text <= 4096B
}

type DeliveryEvidence =
    end_recipient Text <= 4096B
    | local_queue Text <= 4096B
    | provider_acknowledgement Text <= 4096B

type DeliveryState =
    cancelled Text <= 4096B
    | delivered DeliveryEvidence
    | duplicate Text <= 4096B
    | expired Text <= 4096B
    | failed Text <= 4096B
    | queued DeliveryEvidence
    | refused Text <= 4096B
    | sent DeliveryEvidence

type DeliveryUpdate = {
    request_identity: Text <= 4096B
    state: DeliveryState
}

type NotificationEvent = {
    notification_identity: Text <= 4096B
    source_request_identity: Text <= 4096B
    summary: Text <= 4096B
}

type PresenceEvent = {
    state: PresenceState
    subject_identity: Text <= 4096B
}
