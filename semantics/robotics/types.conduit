# Authoritative portable robotics meaning. Mechanism codecs remain explicit.

type BeaconKind =
    virtual_wall
    | infrared_code

type BeaconObservation = {
    kind: BeaconKind
    code: U8
    where variant/tag(.kind) != "virtual_wall" || .code == 0
}

code robotics/beacon-kind = BeaconKind as u8

type ChargingState =
    not_charging
    | reconditioning
    | full
    | trickle
    | waiting
    | fault

type ChargingObservation = {
    state: ChargingState
    sources: U8 in 0..=3
    millivolts: U16
    milliamps: I16
    temperature_celsius: I8
    charge_mah: U16
    capacity_mah: U16
    where .charge_mah <= .capacity_mah
}

code robotics/charging-state = ChargingState as u8

type RoboticsSimulationAvailability =
    fresh
    | missing
    | stale

type AccelerationObservation = {
    x-forward-mm-s2: I32 in -200000..=200000
    y-left-mm-s2: I32 in -200000..=200000
    z-up-mm-s2: I32 in -200000..=200000
}

type ProximityObservation = {
    active-body-sectors: U8 in 0..=31
}

type ContactObservation = {
    sectors: U8 in 0..=31
}

type WheelDropObservation = {
    wheels: U8 in 0..=7
}

type CliffSignal =
    unavailable
    | observed {
        value: U16
    }

type CliffObservation = {
    active_sectors: U8 in 0..=15
    left_signal: CliffSignal
    front_left_signal: CliffSignal
    front_right_signal: CliffSignal
    right_signal: CliffSignal
}

type RangeObservation = {
    distance-mm: U32 in 0..=1000000
    age-ms: U32 in 0..=60000
}

type OdometryObservation = {
    forward-mm: I32 in -10000000..=10000000
    lateral-mm: I32 in -10000000..=10000000
    yaw-microradians: I32 in -3141593..=3141593
}

type ButtonSetObservation = {
    bits: U32
}

type BatteryObservation = {
    charge-permille: U16 in 0..=1000
    millivolts: U16 in 0..=60000
}

type OrientationObservation = {
    roll-microradians: I32 in -3141593..=3141593
    pitch-microradians: I32 in -1570797..=1570797
    yaw-microradians: I32 in -3141593..=3141593
}
