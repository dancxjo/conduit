# Authoritative portable application-network vocabulary.

type NetworkAttachmentId = Text <= 96B not in [""]

type NetworkTransport =
    tcp
    | udp

type DnsRecordKind =
    a
    | aaaa
    | address

type DnsTtl =
    known-seconds {
        seconds: U32
    }
    | unavailable

type DnsQuery = {
    name: Text <= 253B not in [""]
    port: U16 in 1..=65535
    record_kind: DnsRecordKind
    transport: NetworkTransport
}

type NetworkAddress =
    dns-name Text <= 253B not in [""]
    | ipv4 collection U8 = 4
    | ipv6 collection U8 = 16

type ResolvedNetworkAddress =
    ipv4 collection U8 = 4
    | ipv6 collection U8 = 16

type NetworkEndpoint = {
    address: NetworkAddress
    port: U16 in 1..=65535
    transport: NetworkTransport
}

type ResolvedNetworkEndpoint = {
    address: ResolvedNetworkAddress
    port: U16 in 1..=65535
    transport: NetworkTransport
}

type DnsResolution = {
    canonical-name: Text <= 253B not in [""]
    candidates: sequence ResolvedNetworkEndpoint in 0..=4
    ttl: DnsTtl
}

type NetworkReason = Text <= 4096B

type DnsResult =
    current DnsResolution
    | stale {
        resolution: DnsResolution
        age-seconds: U64
    }
    | refused NetworkReason
    | provider-lost NetworkReason

type NetworkConnectionState =
    requested NetworkEndpoint
    | resolving Text <= 253B not in [""]
    | connecting NetworkEndpoint
    | connected {
        local: NetworkEndpoint
        peer: NetworkEndpoint
    }
    | stale-endpoint NetworkEndpoint
    | refused NetworkReason
    | lost NetworkReason
    | closed

type ApplicationNetworkRefusal =
    empty-name
    | name-too-large
    | invalid-port
    | too-many-candidates
    | candidate-transport-mismatch

type NetworkJoinError =
    malformed-request
    | credential-too-large
    | stale-host-boot
    | unsupported
    | missing-resource
    | resource-mismatch
    | missing-authority
    | stale-authority
    | authority-mismatch
    | invalid-attachment
    | output-too-small

type RecordTranscriptDirection =
    sent
    | received

type RecordTranscriptTerminal =
    completed
    | cancelled
    | transport-unavailable
    | disconnected
    | timed-out
    | refused {
        code: U16
    }
    | failed {
        code: U16
    }
