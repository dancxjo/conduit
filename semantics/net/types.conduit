# Authoritative portable application-network vocabulary.

type NetworkAttachmentId = Text <= 96B not in [""]

type NetworkTransport =
    tcp
    | udp

type DnsRecordKind =
    a
    | aaaa
    | address

type DnsTtl =
    known-seconds {
        seconds: U32
    }
    | unavailable

type DnsQuery = {
    name: Text <= 253B not in [""]
    port: U16 in 1..=65535
    record_kind: DnsRecordKind
    transport: NetworkTransport
}

type ApplicationNetworkRefusal =
    empty-name
    | name-too-large
    | invalid-port
    | too-many-candidates
    | candidate-transport-mismatch

type NetworkJoinError =
    malformed-request
    | credential-too-large
    | stale-host-boot
    | unsupported
    | missing-resource
    | resource-mismatch
    | missing-authority
    | stale-authority
    | authority-mismatch
    | invalid-attachment
    | output-too-small

type RecordTranscriptDirection =
    sent
    | received

type RecordTranscriptTerminal =
    completed
    | cancelled
    | transport-unavailable
    | disconnected
    | timed-out
    | refused {
        code: U16
    }
    | failed {
        code: U16
    }
