# Authoritative portable application-network vocabulary.

type NetworkTransport =
    tcp
    | udp

type DnsRecordKind =
    a
    | aaaa
    | address

type DnsTtl =
    known-seconds {
        seconds: U32
    }
    | unavailable

type ApplicationNetworkRefusal =
    empty-name
    | name-too-large
    | invalid-port
    | too-many-candidates
    | candidate-transport-mismatch

type RecordTranscriptDirection =
    sent
    | received

type RecordTranscriptTerminal =
    completed
    | cancelled
    | transport-unavailable
    | disconnected
    | timed-out
    | refused {
        code: U16
    }
    | failed {
        code: U16
    }
