    | form_field
    | choice_group
    | navigation
    | navigation_link
    | link
    | stepper
    | progress
    | artifact
    | download
    | device_choice
    | patchbay_canvas

type StatusKind =
    ordinary
    | warning
    | failure
    | success

type EvidenceDisposition =
    missing
    | stale
    | refused
    | failed
    | succeeded

type ChoiceMultiplicity =
    independent
    | exclusive

type AdmittedNavigationDestination =
    home
    | tour
    | creche
    | patchbay
    | source

type FaceUtteranceClauseKind =
    subject
    | relationship
    | property
    | composition
    | text
    | action
    | action_argument

type FaceUtteranceProvenance =
    subject {
        identity: Text <= 256B not in [""]
    }
    | relationship {
        index: U32
    }
    | composition {
        identity: Text <= 256B not in [""]
    }
    | text {
        index: U32
    }
    | action {
        identity: Text <= 256B not in [""]
    }
    | action_argument {
        action_identity: Text <= 256B not in [""]
        argument_name: Text <= 256B not in [""]
    }
    | property {
        index: U32
    }

type PresentationDisclosureLevel =
    primary
    | current_action
    | context
    | selected_detail
    | exact_provenance

type PresentationTemporalRole =
    event
    | observation
    | ingestion

# Renderer-neutral rhetoric among exact Presentation subjects. The open
# semantic case names meaning; it does not prescribe layout or a renderer.
type PresentationCompositionKind =
    group
    | contrast
    | juxtapose
    | emphasize
    | subordinate
    | associate
    | reveal_after
    | semantic {
        identity: Text <= 256B not in [""]
    }

type PresentationCompositionRelation = {
    identity: Text <= 256B not in [""]
    source: Text <= 256B not in [""]
    target: Text <= 256B not in [""]
    kind: PresentationCompositionKind
}

type LayoutAxis =
    horizontal
    | vertical

type LayoutAlignment =
    start
    | center
    | end

type LayoutRect = {
    x: I16
    y: I16
    width: U16
    height: U16
}

type LayoutFrame = {
    viewport: LayoutRect
    child_count: U8
    children: collection LayoutRect = 8
}

type LayoutError =
    too_many_children
    | extent_out_of_bounds
    | undersized_extent
    | coordinate_overflow
    | malformed_encoding
    | non_canonical_encoding

type GraphicsClipClass =
    fully_visible
    | partially_clipped
    | fully_clipped

type ThemeColor = {
    red: U8
    green: U8
    blue: U8
}

type GraphicsPoint = {
    x: I16
    y: I16
}

type GeneratedManifestationDisposition =
    produced
    | truncated
    | refused
    | failed
    | cancelled
    | provider_lost

type GeneratedContentRole =
    speech
    | presented_thought

type PresentationPlace =
    entrance
    | program
    | body

code presentation/place = PresentationPlace as u8

type PresentationAspect =
    structure
    | plan
    | play
    | signs

code presentation/aspect = PresentationAspect as u8

type PresentationDepth =
