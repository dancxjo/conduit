# Authoritative portable presentation meaning. Rust consumes generated bindings.

type GraphicsCommandKind =
    rect
    | text
    | icon
    | orthogonal_path

code presentation/graphics-command-kind = GraphicsCommandKind as u8 from 1

type GraphicsPaintRole =
    background
    | foreground
    | accent
    | status
    | muted
    | success
    | warning
    | danger
    | focus
    | hovered
    | selected

code presentation/graphics-paint-role = GraphicsPaintRole as u8 from 1

