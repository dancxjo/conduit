type AdmittedNavigationDestination =
    home
    | tour
    | creche
    | patchbay
    | source

type FaceUtteranceClauseKind =
    subject
    | relationship
    | property
    | composition
    | text
    | action
    | action_argument

type FaceUtteranceProvenance =
    subject {
        identity: Text <= 256B not in [""]
    }
    | relationship {
        index: U32
    }
    | composition {
        identity: Text <= 256B not in [""]
    }
    | text {
        index: U32
    }
    | action {
        identity: Text <= 256B not in [""]
    }
    | action_argument {
        action_identity: Text <= 256B not in [""]
        argument_name: Text <= 256B not in [""]
    }
    | property {
        index: U32
    }

type PresentationDisclosureLevel =
    primary
    | current_action
    | context
    | selected_detail
    | exact_provenance

type PresentationTemporalRole =
    event
    | observation
    | ingestion

type LayoutAxis =
    horizontal
    | vertical

type LayoutAlignment =
    start
    | center
    | end

type GraphicsClipClass =
    fully_visible
    | partially_clipped
    | fully_clipped

type ThemeColor = {
    red: U8
    green: U8
    blue: U8
}

type GraphicsPoint = {
    x: I16
    y: I16
}

type GeneratedManifestationDisposition =
    produced
    | truncated
    | refused
    | failed
    | cancelled
    | provider_lost

type GeneratedContentRole =
    speech
    | presented_thought

type GeneratedActionAffordance = {
    action_identity: Text <= 128B not in [""]
    source_presentation_revision: U64
}

