    image
    | group
    | status

code presentation/composition-role = CompositionRole as u8 from 1

type PresentationMechanismKind =
    shell
    | workbench
    | panel
    | heading
    | separator
    | grid
    | action_group
    | action
    | status
    | disclosure
    | evidence
    | definition_table
