# Authoritative portable presentation meaning. Rust consumes generated bindings.

type GraphicsCommandKind =
    rect
    | text
    | icon
    | orthogonal_path

representation presentation/graphics-command-kind = GraphicsCommandKind as u8 from 1

type GraphicsPaintRole =
    background
    | foreground
    | accent
    | status
    | muted
    | success
    | warning
    | danger
    | focus
    | hovered
    | selected

representation presentation/graphics-paint-role = GraphicsPaintRole as u8 from 1

type GraphicsShapeStyle =
    fill
    | stroke
    | rounded_fill
    | rounded_stroke

representation presentation/graphics-shape-style = GraphicsShapeStyle as u8 from 1

type GraphicsTextRole =
    body
    | title
    | heading
    | label
    | code
    | status
    | warning
    | action
    | muted

representation presentation/graphics-text-role = GraphicsTextRole as u8 from 1

type CompositionItemKind =
    icon
    | frame
    | badge

representation presentation/composition-item-kind = CompositionItemKind as u8 from 1

type CompositionRole =
    image
    | group
    | status

representation presentation/composition-role = CompositionRole as u8 from 1

type PresentationMechanismKind =
    shell
    | workbench
    | panel
    | heading
    | separator
    | grid
    | action_group
    | action
    | status
    | disclosure
    | evidence
    | definition_table
    | definition
    | code_block
    | form_field
    | choice_group
    | navigation
    | navigation_link
    | link
    | stepper
    | progress
    | artifact
    | download
    | device_choice
    | patchbay_canvas

type StatusKind =
    ordinary
    | warning
    | failure
    | success

type EvidenceDisposition =
    missing
    | stale
    | refused
    | failed
    | succeeded

type ChoiceMultiplicity =
    independent
    | exclusive

type AdmittedNavigationDestination =
    home
    | tour
    | creche
    | patchbay
    | source

type FaceUtteranceClauseKind =
    subject
    | relationship
    | property
    | composition
    | text
    | action
    | action_argument

type PresentationDisclosureLevel =
    primary
    | current_action
    | context
    | selected_detail
    | exact_provenance

type PresentationTemporalRole =
    event
    | observation
    | ingestion
