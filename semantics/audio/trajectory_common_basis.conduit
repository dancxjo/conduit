# Common time denominators make numerator comparison exact in every domain.
plot audio/trajectory-common-basis-valid (
    >> value: AudioTrajectoryCommonBasisU32
    result: Boolean >>
) = (.input.start.numerator_seconds < .input.end.numerator_seconds)

# Right-continuous ownership: the next segment owns a shared boundary, while
# only a final segment includes its end. Out-of-range queries return false.
plot audio/trajectory-common-basis-covers (
    >> value: AudioTrajectoryCommonBasisU32
    result: Boolean >>
) = (.input.start.numerator_seconds <= .input.query.numerator_seconds && (.input.query.numerator_seconds < .input.end.numerator_seconds || (.input.final_segment && .input.query.numerator_seconds == .input.end.numerator_seconds)))

# Covered Native admission ensures nonnegative weights whose sum is span.
# Each numerator is <= U32MAX, so the weighted sum is <= U32MAX * span;
# span <= U32MAX, hence the sum <= (2^32-1)^2 < U64MAX. The denominator
# has the same product bound and is positive. No floating point or reduction
# occurs. Endpoint branches retain the original authored fractions exactly.
# Output remains a raw ratio; final quantity Native admission is separate.
plot audio/trajectory-common-basis-interpolate (
    >> value: AudioTrajectoryCommonBasisCovered
    result: AudioTrajectoryRatio >>
) = (.request.input.query.numerator_seconds == .request.input.start.numerator_seconds ? .request.input.left : .request.input.query.numerator_seconds == .request.input.end.numerator_seconds ? .request.input.right : {numerator: .request.input.left.numerator * (.request.input.end.numerator_seconds - .request.input.query.numerator_seconds) + .request.input.right.numerator * (.request.input.query.numerator_seconds - .request.input.start.numerator_seconds), denominator: .request.input.left.denominator * (.request.input.end.numerator_seconds - .request.input.start.numerator_seconds), domain: .request.input.left.domain})
