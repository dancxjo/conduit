# Exact supported capability only: no logarithm approximation or normalization.
plot audio/decibel-ratio-working (
    >> value: AudioLevelRatio
    result: AudioDecibelRatioWorking >>
) = (. is amplitude ? (.amplitude.numerator == 0 ? {quotient: 0, remainder: 0, reciprocal: false, zero: true} : .amplitude.numerator >= .amplitude.denominator ? {quotient: .amplitude.numerator / .amplitude.denominator, remainder: .amplitude.numerator % .amplitude.denominator, reciprocal: false, zero: false} : {quotient: .amplitude.denominator / .amplitude.numerator, remainder: .amplitude.denominator % .amplitude.numerator, reciprocal: true, zero: false}) : (.power.numerator == 0 ? {quotient: 0, remainder: 0, reciprocal: false, zero: true} : .power.numerator >= .power.denominator ? {quotient: .power.numerator / .power.denominator, remainder: .power.numerator % .power.denominator, reciprocal: false, zero: false} : {quotient: .power.denominator / .power.numerator, remainder: .power.denominator % .power.numerator, reciprocal: true, zero: false}))

plot audio/decibel-recognize-power-of-ten (
    >> value: AudioDecibelRatioWorking
    result: AudioExactPowerOfTen >>
) = ({supported: .zero || (.remainder == 0 && ((((.quotient == 1 || .quotient == 10) || (.quotient == 100 || .quotient == 1000)) || ((.quotient == 10000 || .quotient == 100000) || (.quotient == 1000000 || (.quotient == 10000000 || .quotient == 100000000)))) || (((.quotient == 1000000000 || .quotient == 10000000000) || (.quotient == 100000000000 || (.quotient == 1000000000000 || .quotient == 10000000000000))) || ((.quotient == 100000000000000 || .quotient == 1000000000000000) || (.quotient == 10000000000000000 || (.quotient == 100000000000000000 || .quotient == 1000000000000000000)))))), exponent: .reciprocal ? 0 - (.quotient == 1000000000 ? 9 : (.quotient < 1000000000 ? (.quotient == 10000 ? 4 : (.quotient < 10000 ? (.quotient == 100 ? 2 : (.quotient < 100 ? (.quotient == 10 ? 1 : (.quotient < 10 ? (.quotient == 1 ? 0 : (.quotient < 1 ? 0 : 0)) : 0)) : (.quotient == 1000 ? 3 : (.quotient < 1000 ? 0 : 0)))) : (.quotient == 10000000 ? 7 : (.quotient < 10000000 ? (.quotient == 1000000 ? 6 : (.quotient < 1000000 ? (.quotient == 100000 ? 5 : (.quotient < 100000 ? 0 : 0)) : 0)) : (.quotient == 100000000 ? 8 : (.quotient < 100000000 ? 0 : 0)))))) : (.quotient == 100000000000000 ? 14 : (.quotient < 100000000000000 ? (.quotient == 1000000000000 ? 12 : (.quotient < 1000000000000 ? (.quotient == 100000000000 ? 11 : (.quotient < 100000000000 ? (.quotient == 10000000000 ? 10 : (.quotient < 10000000000 ? 0 : 0)) : 0)) : (.quotient == 10000000000000 ? 13 : (.quotient < 10000000000000 ? 0 : 0)))) : (.quotient == 100000000000000000 ? 17 : (.quotient < 100000000000000000 ? (.quotient == 10000000000000000 ? 16 : (.quotient < 10000000000000000 ? (.quotient == 1000000000000000 ? 15 : (.quotient < 1000000000000000 ? 0 : 0)) : 0)) : (.quotient == 1000000000000000000 ? 18 : (.quotient < 1000000000000000000 ? 0 : 0)))))))) : (.quotient == 1000000000 ? 9 : (.quotient < 1000000000 ? (.quotient == 10000 ? 4 : (.quotient < 10000 ? (.quotient == 100 ? 2 : (.quotient < 100 ? (.quotient == 10 ? 1 : (.quotient < 10 ? (.quotient == 1 ? 0 : (.quotient < 1 ? 0 : 0)) : 0)) : (.quotient == 1000 ? 3 : (.quotient < 1000 ? 0 : 0)))) : (.quotient == 10000000 ? 7 : (.quotient < 10000000 ? (.quotient == 1000000 ? 6 : (.quotient < 1000000 ? (.quotient == 100000 ? 5 : (.quotient < 100000 ? 0 : 0)) : 0)) : (.quotient == 100000000 ? 8 : (.quotient < 100000000 ? 0 : 0)))))) : (.quotient == 100000000000000 ? 14 : (.quotient < 100000000000000 ? (.quotient == 1000000000000 ? 12 : (.quotient < 1000000000000 ? (.quotient == 100000000000 ? 11 : (.quotient < 100000000000 ? (.quotient == 10000000000 ? 10 : (.quotient < 10000000000 ? 0 : 0)) : 0)) : (.quotient == 10000000000000 ? 13 : (.quotient < 10000000000000 ? 0 : 0)))) : (.quotient == 100000000000000000 ? 17 : (.quotient < 100000000000000000 ? (.quotient == 10000000000000000 ? 16 : (.quotient < 10000000000000000 ? (.quotient == 1000000000000000 ? 15 : (.quotient < 1000000000000000 ? 0 : 0)) : 0)) : (.quotient == 1000000000000000000 ? 18 : (.quotient < 1000000000000000000 ? 0 : 0)))))))), zero: .zero})

plot audio/decibel-from-power-of-ten (
    >> value: AudioExactPowerOfTenEligible
    result: AudioDecibelValue >>
) = (.recognition.zero ? AudioDecibelValue.negative_infinity : AudioDecibelValue.finite({numerator_db: .recognition.exponent * (.convention is power_ten_log10 ? 10 : 20), denominator: 1}))

plot audio/decibel-inverse-recognize (
    >> value: AudioDecibelInverseInput
    result: AudioExactPowerOfTen >>
) = (.value is negative_infinity ? {supported: true, exponent: 0, zero: true} : .convention is power_ten_log10 ? {supported: .value.finite.denominator == 1 && .value.finite.numerator_db % 10 == 0 && .value.finite.numerator_db / 10 >= -18 && .value.finite.numerator_db / 10 <= 18, exponent: .value.finite.numerator_db / 10, zero: false} : {supported: .value.finite.denominator == 1 && .value.finite.numerator_db % 20 == 0 && .value.finite.numerator_db / 20 >= -18 && .value.finite.numerator_db / 20 <= 18, exponent: .value.finite.numerator_db / 20, zero: false})

plot audio/decibel-to-power-of-ten (
    >> value: AudioExactPowerOfTenEligible
    result: AudioDecibelRatioRaw >>
) = ({numerator: .recognition.zero ? 0 : (.recognition.exponent == 10 ? 10000000000 : (.recognition.exponent < 10 ? (.recognition.exponent == 5 ? 100000 : (.recognition.exponent < 5 ? (.recognition.exponent == 3 ? 1000 : (.recognition.exponent < 3 ? (.recognition.exponent == 2 ? 100 : (.recognition.exponent < 2 ? (.recognition.exponent == 1 ? 10 : (.recognition.exponent < 1 ? 1 : 1)) : 1)) : (.recognition.exponent == 4 ? 10000 : (.recognition.exponent < 4 ? 1 : 1)))) : (.recognition.exponent == 8 ? 100000000 : (.recognition.exponent < 8 ? (.recognition.exponent == 7 ? 10000000 : (.recognition.exponent < 7 ? (.recognition.exponent == 6 ? 1000000 : (.recognition.exponent < 6 ? 1 : 1)) : 1)) : (.recognition.exponent == 9 ? 1000000000 : (.recognition.exponent < 9 ? 1 : 1)))))) : (.recognition.exponent == 15 ? 1000000000000000 : (.recognition.exponent < 15 ? (.recognition.exponent == 13 ? 10000000000000 : (.recognition.exponent < 13 ? (.recognition.exponent == 12 ? 1000000000000 : (.recognition.exponent < 12 ? (.recognition.exponent == 11 ? 100000000000 : (.recognition.exponent < 11 ? 1 : 1)) : 1)) : (.recognition.exponent == 14 ? 100000000000000 : (.recognition.exponent < 14 ? 1 : 1)))) : (.recognition.exponent == 17 ? 100000000000000000 : (.recognition.exponent < 17 ? (.recognition.exponent == 16 ? 10000000000000000 : (.recognition.exponent < 16 ? 1 : 1)) : (.recognition.exponent == 18 ? 1000000000000000000 : (.recognition.exponent < 18 ? 1 : 1)))))))), denominator: .recognition.zero ? 1 : (.recognition.exponent == -9 ? 1000000000 : (.recognition.exponent < -9 ? (.recognition.exponent == -14 ? 100000000000000 : (.recognition.exponent < -14 ? (.recognition.exponent == -16 ? 10000000000000000 : (.recognition.exponent < -16 ? (.recognition.exponent == -17 ? 100000000000000000 : (.recognition.exponent < -17 ? (.recognition.exponent == -18 ? 1000000000000000000 : (.recognition.exponent < -18 ? 1 : 1)) : 1)) : (.recognition.exponent == -15 ? 1000000000000000 : (.recognition.exponent < -15 ? 1 : 1)))) : (.recognition.exponent == -11 ? 100000000000 : (.recognition.exponent < -11 ? (.recognition.exponent == -12 ? 1000000000000 : (.recognition.exponent < -12 ? (.recognition.exponent == -13 ? 10000000000000 : (.recognition.exponent < -13 ? 1 : 1)) : 1)) : (.recognition.exponent == -10 ? 10000000000 : (.recognition.exponent < -10 ? 1 : 1)))))) : (.recognition.exponent == -4 ? 10000 : (.recognition.exponent < -4 ? (.recognition.exponent == -6 ? 1000000 : (.recognition.exponent < -6 ? (.recognition.exponent == -7 ? 10000000 : (.recognition.exponent < -7 ? (.recognition.exponent == -8 ? 100000000 : (.recognition.exponent < -8 ? 1 : 1)) : 1)) : (.recognition.exponent == -5 ? 100000 : (.recognition.exponent < -5 ? 1 : 1)))) : (.recognition.exponent == -2 ? 100 : (.recognition.exponent < -2 ? (.recognition.exponent == -3 ? 1000 : (.recognition.exponent < -3 ? 1 : 1)) : (.recognition.exponent == -1 ? 10 : (.recognition.exponent < -1 ? 1 : 1))))))))})
