# Authoritative portable audio meaning. Rust consumes generated bindings.

type AudioToneTerminal =
    cancelled

type Gate =
    on
    | off

type ModulationDestination =
    pitch
    | filter-cutoff
    | amplitude

type MusicalControl =
    sustain {
        down: Boolean
    }
    | pitch-bend {
        amount-millionths: I32 in -1000000..=1000000
        range-microcents: U32 in 0..=2400000000
    }
    | modulation {
        amount-millionths: U32 in 0..=1000000
        destination: ModulationDestination
    }

type MusicalControlEvent = {
    control: MusicalControl
    event-time-micros: U64 in 0..=18446744073709551614
    order: U32
}

type MusicalPitch = {
    frequency-millihertz: U64 in 8000..=40000000
    a4-reference-millihertz: U64 in 400000..=480000
    detune-microcents: I32 in -24000000..=24000000
}

type NoteOccurrenceId = U64 in 1..=18446744073709551615

type MusicalNoteEvent = {
    occurrence: NoteOccurrenceId
    pitch: MusicalPitch
    gate: Gate
    velocity: U16
    event-time-micros: U64 in 0..=18446744073709551614
    order: U32
}

type ToneIntent = {
    correlation: U64 in 1..=18446744073709551615
    pitch: MusicalPitch
    gate: Gate
    event-time-micros: U64 in 0..=18446744073709551614
    order: U32
}

type BeatReference = {
    beat: U64
    expected_time_micros: U64
}

type TimingClassification =
    on-time
    | early
    | late
    | missed

type RhythmRecoveryState =
    interrupted
    | recovered
    | on-beat
    | recovering
    | displaced

type TimingFeedback = {
    beat: U64
    classification: TimingClassification
    delta_micros: I64
    expected_time_micros: U64
    observed: Boolean
    observed_time_micros: U64
    recovery_state: RhythmRecoveryState
}

type InstrumentPitchMillihertz = collection U64 = 8

type InstrumentMapping = {
    expression_control: U64
    modulation_control: U64
    pitch_millihertz: InstrumentPitchMillihertz
    sustain_button: U64
}

type InstrumentButtonEvent = {
    down: Boolean
    event_time_micros: U64
    index: U64
    occurrence: U64
}

type InstrumentAnalogEvent = {
    event_time_micros: U64
    index: U64
    value: U64
}

type InstrumentControl =
    analog InstrumentAnalogEvent
    | button InstrumentButtonEvent

type PcmSampleRepresentation =
    signed16-little-endian
    | signed24-little-endian
    | float32-little-endian

type PcmChannelLayout =
    mono
    | stereo-left-right

type PcmFrameHeader = {
    representation: PcmSampleRepresentation
    sample-rate-hz: U32 in 8000..=192000
    layout: PcmChannelLayout
    frame-count: U16 in 1..=2048
    clock-id: U64 in 1..=18446744073709551615
    start-frame: U64
    discontinuity: Boolean
    payload-bytes: U32 in 1..=65536
    where .payload-bytes == value/u32(.frame-count) * (.layout is mono ? 1 : 2) * (.representation is signed16-little-endian ? 2 : .representation is signed24-little-endian ? 3 : 4)
}

type AudioRenderDemand = {
    clock-id: U64 in 1..=18446744073709551615
    start-frame: U64
    frame-count: U16 in 1..=65535
    sequence: U32
    where .start-frame <= 18446744073709551615 - value/u64(.frame-count)
}

type PcmClipProfile = {
    representation: PcmSampleRepresentation
    sample-rate-hz: U32 in 8000..=192000
    layout: PcmChannelLayout
    clock-id: U64 in 1..=18446744073709551615
}

type PressureDisposition =
    wait_without_consumption
    | refuse_before_play

type CancellationDisposition =
    cancel_and_release_finite_state
    | drain_then_complete

type SoundTerminalBehavior =
    completes_when_inputs_close
    | drains_admitted_output_then_completes

type SoundSeam =
    tone
    | musical_events
    | synthesis
    | pcm_playback

type PcmCompatibilityProfile = {
    representation: PcmSampleRepresentation
    sample-rate-hz: U32
    layout: PcmChannelLayout
    maximum-frames-per-block: U16
    maximum-frame-bytes: U32
}

type IncompatibilityReason =
    wrong-semantic-seam
    | pitch-range-unsupported
    | polyphony-exceeds-offer
    | event-rate-exceeds-offer
    | velocity-unsupported
    | sustain-unsupported
    | pitch-bend-unsupported
    | pitch-bend-range-exceeds-offer
    | modulation-unsupported
    | microtonal-pitch-unsupported
    | subtractive-filter-unsupported
    | pcm-profile-missing
    | pcm-representation-mismatch
    | pcm-sample-rate-mismatch
    | pcm-layout-mismatch
    | pcm-block-exceeds-offer

type SoundStreamState =
    open
    | draining
    | cancelled
    | closed

code audio/tone-terminal = AudioToneTerminal as u8

code audio/pcm-sample-representation = PcmSampleRepresentation as u8

code audio/pcm-channel-layout = PcmChannelLayout as u8

code audio/gate = Gate as u8
    off
    on

code audio/modulation-destination = ModulationDestination as u8
