# Exact media-frame controls, independent of device clocks and scheduling.
# MixerPair / MixerQuad are checked typed tuples prepared from MixerChannel.
type MixerChannel = {
    sample: I32
    gain_q8: I32
    timeline: I32
    frame: I32
    rate_hz: I32
}
type MixerOutcome =
    sample I32
    | invalid_profile
    | timebase_mismatch

# Balanced checks preserve the existing finite expression-depth profile.
# Weight each channel with truncation toward zero, sum, then saturate once.
plot dsp/mix-two (
    >> paired: MixerPair...|
    result: MixerOutcome...| >>
) = (((((.0.sample < -32768 || .0.sample > 32767) || (.0.gain_q8 < 0 || .0.gain_q8 > 4096)) || ((.0.timeline < 0 || .0.frame < 0) || (.0.frame > 65535 || (.0.rate_hz < 1 || .0.rate_hz > 192000)))) || (((.1.sample < -32768 || .1.sample > 32767) || (.1.gain_q8 < 0 || .1.gain_q8 > 4096)) || ((.1.timeline < 0 || .1.frame < 0) || (.1.frame > 65535 || (.1.rate_hz < 1 || .1.rate_hz > 192000))))) ? MixerOutcome.invalid_profile : (.1.timeline != .0.timeline || (.1.frame != .0.frame || .1.rate_hz != .0.rate_hz)) ? MixerOutcome.timebase_mismatch : MixerOutcome.sample(((.0.sample * .0.gain_q8 / 256) + (.1.sample * .1.gain_q8 / 256)) < -32767 ? -32767 : ((.0.sample * .0.gain_q8 / 256) + (.1.sample * .1.gain_q8 / 256)) > 32767 ? 32767 : ((.0.sample * .0.gain_q8 / 256) + (.1.sample * .1.gain_q8 / 256))))

# Balanced checks preserve the existing finite expression-depth profile.
# Weight each channel with truncation toward zero, sum, then saturate once.
plot dsp/mix-four (
    >> paired: MixerQuad...|
    result: MixerOutcome...| >>
) = ((((((.0.0.sample < -32768 || .0.0.sample > 32767) || (.0.0.gain_q8 < 0 || .0.0.gain_q8 > 4096)) || ((.0.0.timeline < 0 || .0.0.frame < 0) || (.0.0.frame > 65535 || (.0.0.rate_hz < 1 || .0.0.rate_hz > 192000)))) || (((.0.1.sample < -32768 || .0.1.sample > 32767) || (.0.1.gain_q8 < 0 || .0.1.gain_q8 > 4096)) || ((.0.1.timeline < 0 || .0.1.frame < 0) || (.0.1.frame > 65535 || (.0.1.rate_hz < 1 || .0.1.rate_hz > 192000))))) || ((((.1.0.sample < -32768 || .1.0.sample > 32767) || (.1.0.gain_q8 < 0 || .1.0.gain_q8 > 4096)) || ((.1.0.timeline < 0 || .1.0.frame < 0) || (.1.0.frame > 65535 || (.1.0.rate_hz < 1 || .1.0.rate_hz > 192000)))) || (((.1.1.sample < -32768 || .1.1.sample > 32767) || (.1.1.gain_q8 < 0 || .1.1.gain_q8 > 4096)) || ((.1.1.timeline < 0 || .1.1.frame < 0) || (.1.1.frame > 65535 || (.1.1.rate_hz < 1 || .1.1.rate_hz > 192000)))))) ? MixerOutcome.invalid_profile : (((.0.1.timeline != .0.0.timeline || .0.1.frame != .0.0.frame) || (.0.1.rate_hz != .0.0.rate_hz || .1.0.timeline != .0.0.timeline)) || ((.1.0.frame != .0.0.frame || .1.0.rate_hz != .0.0.rate_hz) || (.1.1.timeline != .0.0.timeline || (.1.1.frame != .0.0.frame || .1.1.rate_hz != .0.0.rate_hz)))) ? MixerOutcome.timebase_mismatch : MixerOutcome.sample((((.0.0.sample * .0.0.gain_q8 / 256) + (.0.1.sample * .0.1.gain_q8 / 256)) + ((.1.0.sample * .1.0.gain_q8 / 256) + (.1.1.sample * .1.1.gain_q8 / 256))) < -32767 ? -32767 : (((.0.0.sample * .0.0.gain_q8 / 256) + (.0.1.sample * .0.1.gain_q8 / 256)) + ((.1.0.sample * .1.0.gain_q8 / 256) + (.1.1.sample * .1.1.gain_q8 / 256))) > 32767 ? 32767 : (((.0.0.sample * .0.0.gain_q8 / 256) + (.0.1.sample * .0.1.gain_q8 / 256)) + ((.1.0.sample * .1.0.gain_q8 / 256) + (.1.1.sample * .1.1.gain_q8 / 256)))))
